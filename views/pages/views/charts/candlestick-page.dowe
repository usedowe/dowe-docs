type Candle
  time:number
  open:number
  high:number
  low:number
  close:number

page CandlestickPage
  signal candles type:Candle[] value:[
    { time:1719792000 open:184.2 high:188.6 low:182.4 close:187.9 },
    { time:1719878400 open:187.9 high:191.3 low:186.8 close:189.4 },
    { time:1719964800 open:189.4 high:190.1 low:184.6 close:185.2 },
    { time:1720051200 open:185.2 high:187.7 low:181.9 close:183.6 },
    { time:1720137600 open:183.6 high:188.9 low:182.8 close:188.1 },
    { time:1720224000 open:188.1 high:193.7 low:187.2 close:192.5 },
    { time:1720310400 open:192.5 high:195.4 low:189.8 close:191.7 },
    { time:1720396800 open:191.7 high:197.2 low:190.9 close:196.8 },
  ]
  signal emptyCandles type:Candle[] value:[]
  const candlestickProps:
    value:[
      { prop:"data" type:"Signal array path" defaultValue:"—" },
      { prop:"stream" type:"SSE path or HTTPS URL" defaultValue:"—" },
      { prop:"variant" type:"solid | soft | outlined | ghost" defaultValue:"solid" },
      { prop:"scheme" type:"Dowe color family" defaultValue:"surface" },
      { prop:"upColor" type:"Dowe color token" defaultValue:"success" },
      { prop:"downColor" type:"Dowe color token" defaultValue:"danger" },
      { prop:"emptyLabel" type:"string" defaultValue:"No candle data" },
      { prop:"maxPoints" type:"positive number" defaultValue:"240" },
    ]
  Section id:"candlestick-introduction" py:{ xs:6 md:10 }
    Grid columns:{ xs:1 md:"1fr auto" } gap:5 align:"end"
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "CHARTS"
        Title size:{ xs:"3xl" md:"6xl" } weight:"black"
          "Candlestick"
        Text size:"lg" color:"muted"
          "OHLC market data with deterministic candles, native rendering, and an optional SSE stream."
      Card variant:"soft" scheme:"success" p:5 rounded:"lg" minW:56
        Grid columns:1 gap:1
          Text size:"xs" weight:"bold" spacing:"widest"
            "PORTABLE OHLC"
          Title size:"xl" weight:"black"
            "One candle contract"
          Text size:"sm"
            "The same time, open, high, low, and close fields drive web, Android, and iOS."
  Section id:"candlestick-data" p:{ xs:5 md:7 }
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "DATA MODEL"
        Title size:"3xl" weight:"black"
          "Validate OHLC before rendering"
        Text size:"sm" color:"muted"
          "data points to a typed Signal array. Dowe preserves Signal order and ignores invalid runtime candles without breaking the remaining chart."
      Candlestick:
        data:candles
        variant:"soft"
        scheme:"surface"
        h:72
        rounded:"lg"
        border:1
        upColor:"success"
        downColor:"danger"
        maxPoints:240
      Code language:"dowe" variant:"soft" scheme:"surface" copyLabel:"Copy Dowe" copiedLabel:"Copied" content:"""
        type Candle
          time:number
          open:number
          high:number
          low:number
          close:number

        signal candles type:Candle[] value:[{ time:1719792000 open:184.2 high:188.6 low:182.4 close:187.9 }]

        Candlestick data:candles variant:"soft" scheme:"surface" upColor:"success" downColor:"danger" maxPoints:240
      """
  Section id:"candlestick-stream" py:{ xs:7 md:10 }
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "REAL-TIME STREAMS"
        Title size:"3xl" weight:"black"
          "Keep the latest market window"
        Text size:"sm" color:"muted"
          "stream connects to a Server-Sent Events endpoint. A candle with the latest time replaces the last point; a new time appends until maxPoints is reached."
      Grid columns:{ xs:1 md:2 } gap:4
        Candlestick:
          data:candles
          variant:"outlined"
          scheme:"primary"
          h:64
          rounded:"md"
          upColor:"info"
          downColor:"warning"
          maxPoints:120
        Card variant:"soft" scheme:"info" p:5 rounded:"md"
          Grid columns:1 gap:3
            Text size:"xs" weight:"bold" spacing:"widest"
              "STREAM PAYLOAD"
            Text size:"sm"
              "Each event may contain one candle, an array, or a data wrapper. The client keeps only valid OHLC entries."
            Text size:"sm" color:"muted"
              "Use a relative path for a same-origin endpoint or an HTTPS URL for an external public feed."
      Code language:"dowe" variant:"soft" scheme:"surface" copyLabel:"Copy Dowe" copiedLabel:"Copied" content:"""
        signal candles type:Candle[] value:[]

        Candlestick data:candles stream:"/api/market/candles" variant:"soft" scheme:"surface" upColor:"success" downColor:"danger" maxPoints:240 emptyLabel:"Waiting for market data"
      """
  Section id:"candlestick-states" p:{ xs:5 md:7 }
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "STATES AND STYLING"
        Title size:"3xl" weight:"black"
          "Make market context visible"
        Text size:"sm" color:"muted"
          "Use semantic colors for direction, a surface variant for emphasis, and explicit empty copy when a feed has not produced data yet."
      Grid columns:{ xs:1 md:3 } gap:4
        Candlestick data:candles variant:"solid" scheme:"surface" h:56 rounded:"sm" upColor:"success" downColor:"danger"
        Candlestick data:candles variant:"soft" scheme:"primary" h:56 rounded:"md" upColor:"primary" downColor:"secondary"
        Candlestick data:emptyCandles variant:"outlined" scheme:"warning" h:56 rounded:"md" emptyLabel:"No session data"
      Code language:"dowe" variant:"soft" scheme:"surface" copyLabel:"Copy Dowe" copiedLabel:"Copied" content:"""
        Candlestick data:candles variant:"solid" scheme:"surface" h:56 rounded:"sm" upColor:"success" downColor:"danger"
        Candlestick data:candles variant:"soft" scheme:"primary" h:56 rounded:"md" upColor:"primary" downColor:"secondary"
        Candlestick data:emptyCandles variant:"outlined" scheme:"warning" h:56 rounded:"md" emptyLabel:"No session data"
      """
  Section id:"candlestick-props" py:{ xs:7 md:10 }
    Grid columns:1 gap:5
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "API"
        Title size:"3xl" weight:"black"
          "Props"
        Text size:"sm" color:"muted"
          "Candlestick also accepts applicable common identity, spacing, sizing, visibility, radius, border, and accessibility props."
      Table:
        data:candlestickProps
        variant:"soft"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"prop" label:"Prop" width:"1fr"
        column field:"type" label:"Type" width:"3fr"
        column field:"defaultValue" label:"Default" width:"1fr"
