type ChartSlice
  label:string
  value:number

page ArcChartPage
  signal allocation type:ChartSlice[] value:[
    { label:"Product" value:42 },
    { label:"Operations" value:26 },
    { label:"Growth" value:19 },
    { label:"Support" value:13 },
  ]
  signal progress type:ChartSlice[] value:[
    { label:"Delivered" value:68 },
    { label:"Remaining" value:32 },
  ]
  signal emptySlices type:ChartSlice[] value:[]
  const arcProps:
    value:[
      { prop:"data" type:"Signal array path" defaultValue:"—" },
      { prop:"variant" type:"solid | soft | outlined | ghost" defaultValue:"solid" },
      { prop:"scheme" type:"Dowe color family" defaultValue:"surface" },
      { prop:"size" type:"sm | md | lg | xl" defaultValue:"md" },
      { prop:"palette" type:"default | rainbow | ocean | sunset | forest | neon" defaultValue:"default" },
      { prop:"legendPosition" type:"top | right | bottom | left | none" defaultValue:"right" },
      { prop:"centerText, centerValue" type:"string" defaultValue:"—" },
      { prop:"thickness, gap" type:"positive numbers" defaultValue:"—" },
      { prop:"startAngle, endAngle" type:"degrees" defaultValue:"0, 360" },
      { prop:"showInlineLabels, hideValues, showGlow" type:"boolean" defaultValue:"false" },
      { prop:"emptyLabel, loading, hideLegend" type:"string, boolean, boolean" defaultValue:"No data, false, false" },
    ]
  Section id:"arc-chart-introduction" py:{ xs:6 md:10 }
    Grid columns:{ xs:1 md:"1fr auto" } gap:5 align:"end"
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "CHARTS"
        Title size:{ xs:"3xl" md:"6xl" } weight:"black"
          "ArcChart"
        Text size:"lg" color:"muted"
          "Multi-arc circular summaries for progress, allocation, and proportional status."
      Card variant:"soft" scheme:"secondary" p:5 rounded:"lg" minW:56
        Grid columns:1 gap:1
          Text size:"xs" weight:"bold" spacing:"widest"
            "CATEGORICAL SIGNAL"
          Title size:"xl" weight:"black"
            "A ring of validated values"
          Text size:"sm"
            "Each item contributes a labeled value and can opt into a Dowe color token."
  Section id:"arc-chart-basic" p:{ xs:5 md:7 }
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "DATA AND LEGEND"
        Title size:"3xl" weight:"black"
          "Show a readable allocation"
        Text size:"sm" color:"muted"
          "ArcChart reads label and value from a Signal array. Use legendPosition and showInlineLabels together when the chart must remain understandable at a glance."
      ArcChart:
        data:allocation
        variant:"soft"
        scheme:"surface"
        size:"lg"
        palette:"ocean"
        legendPosition:"right"
        centerText:"Q2 mix"
        centerValue:"100%"
        thickness:22
        gap:4
        showInlineLabels:true
        showGlow:true
        rounded:"lg"
      Code language:"dowe" variant:"soft" scheme:"surface" copyLabel:"Copy Dowe" copiedLabel:"Copied" content:"""
        type ChartSlice
          label:string
          value:number
        signal allocation type:ChartSlice[] value:[{ label:"Product" value:42 }]

        ArcChart data:allocation variant:"soft" scheme:"surface" size:"lg" palette:"ocean" legendPosition:"right" centerText:"Q2 mix" centerValue:"100%" thickness:22 gap:4 showInlineLabels:true
      """
  Section id:"arc-chart-angles" py:{ xs:7 md:10 }
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "PROGRESS AND ANGLES"
        Title size:"3xl" weight:"black"
          "Turn the arc into a progress signal"
        Text size:"sm" color:"muted"
          "startAngle and endAngle create a deliberate gauge-like sweep. Keep the center value explicit so the percentage never depends on reading the graphic alone."
      Grid columns:{ xs:1 md:2 } gap:4
        ArcChart:
          data:progress
          variant:"outlined"
          scheme:"success"
          size:"lg"
          palette:"forest"
          legendPosition:"bottom"
          centerText:"Release"
          centerValue:"68%"
          thickness:26
          gap:6
          startAngle:-90
          endAngle:270
          hideValues:true
          showGlow:true
        ArcChart:
          data:allocation
          variant:"solid"
          scheme:"surface"
          size:"lg"
          palette:"sunset"
          legendPosition:"none"
          centerText:"Focus"
          centerValue:"4 teams"
          thickness:16
          gap:2
          startAngle:180
          endAngle:540
          showInlineLabels:true
          hideLegend:true
      Code language:"dowe" variant:"soft" scheme:"surface" copyLabel:"Copy Dowe" copiedLabel:"Copied" content:"""
        ArcChart data:progress variant:"outlined" scheme:"success" size:"lg" palette:"forest" centerText:"Release" centerValue:"68%" thickness:26 startAngle:-90 endAngle:270 hideValues:true showGlow:true
        ArcChart data:allocation variant:"solid" scheme:"surface" size:"lg" palette:"sunset" legendPosition:"none" centerText:"Focus" centerValue:"4 teams" thickness:16 gap:2 startAngle:180 endAngle:540 showInlineLabels:true hideLegend:true
      """
  Section id:"arc-chart-states" p:{ xs:5 md:7 }
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "STATES"
        Title size:"3xl" weight:"black"
          "Loading and empty data stay thematic"
        Text size:"sm" color:"muted"
          "Use loading for an in-flight data request and emptyLabel for a valid empty Signal. Both states preserve the chart surface and accessibility context."
      Grid columns:{ xs:1 md:2 } gap:4
        ArcChart data:allocation variant:"soft" scheme:"info" size:"md" loading:true centerText:"Syncing" centerValue:"—"
        ArcChart data:emptySlices variant:"outlined" scheme:"warning" size:"md" emptyLabel:"No allocation yet" centerText:"Empty" centerValue:"0"
  Section id:"arc-chart-props" py:{ xs:7 md:10 }
    Grid columns:1 gap:5
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "API"
        Title size:"3xl" weight:"black"
          "Props"
        Text size:"sm" color:"muted"
          "ArcChart also accepts applicable common identity, spacing, sizing, visibility, radius, border, and accessibility props."
      Table:
        data:arcProps
        variant:"soft"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"prop" label:"Prop" width:"1.2fr"
        column field:"type" label:"Type" width:"3fr"
        column field:"defaultValue" label:"Default" width:"1.2fr"
