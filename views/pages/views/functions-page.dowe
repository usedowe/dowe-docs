page FunctionsPage
  signal panelOpen value:false
  fn togglePanel
    set panelOpen value:!panelOpen
  fn openViews
    redirect path:"/docs/views"
  Section id:"functions-introduction" py:{ xs:6 md:10 }
    Grid columns:1 gap:3
      Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
        "LOGIC"
      Title size:{ xs:"3xl" md:"6xl" } weight:"black"
        "Functions"
      Text size:"lg" color:"muted"
        "Use fn to name target-neutral reactive behavior and dispatch it from a component event."
  Section id:"functions-example" p:{ xs:5 md:7 }
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "INTERACTIVE EXAMPLE"
        Title size:"3xl" weight:"black"
          "Name a state transition"
        Text size:"sm" color:"muted"
          "A function contains ordered request, branch, state, feedback, and internal redirect statements."
      Card variant:"outlined" p:{ xs:5 md:7 } border:1
        Grid columns:1 gap:4
          Button onClick:togglePanel
            "Toggle panel"
          Button onClick:openViews variant:"soft" scheme:"secondary"
            "Open Views overview"
          Card show:panelOpen variant:"soft" scheme:"info" p:4
            Text
              "The Button dispatches togglePanel, which updates this page Signal."
      Code:
        language:"dowe"
        variant:"soft"
        scheme:"surface"
        copyLabel:"Copy Dowe"
        copiedLabel:"Copied"
        content:"""
          signal panelOpen value:false

          fn togglePanel
            set panelOpen value:!panelOpen

          Button onClick:togglePanel
            "Toggle panel"

          fn finish
            redirect path:"/docs/views"
        """
