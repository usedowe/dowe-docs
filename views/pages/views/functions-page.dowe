page FunctionsPage
  const functionModelRows:
    value:[
      { part:"Declaration" meaning:"fn gives a named workflow a target-neutral identity." },
      { part:"Body" meaning:"Statements run in order and can request, branch, update Signals, show feedback, or redirect." },
      { part:"Dispatch" meaning:"An event prop such as onClick names the function that owns the transition." },
      { part:"Ownership" meaning:"The page or layout owns its Signals; fn coordinates them but does not create a second state model." },
    ]
  signal panelOpen value:false
  fn togglePanel
    set panelOpen value:!panelOpen
  fn openViews
    redirect path:"/docs/views"
  Section id:"functions-introduction" py:{ xs:6 md:10 }
    Grid columns:1 gap:3
      Text size:"xs" weight:"bold" spacing:"widest"
        "LOGIC"
      Title size:{ xs:"3xl" md:"6xl" } weight:"black"
        "Functions"
      Text size:"lg"
        "Use fn to name target-neutral reactive behavior and dispatch it from a component event."
  Section id:"functions-example" p:{ xs:5 md:7 }
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest"
          "INTERACTIVE EXAMPLE"
        Title size:"3xl" weight:"black"
          "Name a state transition"
        Text size:"sm"
          "A function contains ordered request, branch, state, feedback, and internal redirect statements."
      Card variant:"solid" p:{ xs:5 md:7 } border:1
        Grid columns:1 gap:4
          Button onClick:togglePanel
            "Toggle panel"
          Button onClick:openViews variant:"solid" scheme:"secondary"
            "Open Views overview"
          Card show:panelOpen variant:"solid" scheme:"info" p:4
            Text
              "The Button dispatches togglePanel, which updates this page Signal."
      Code:
        language:"dowe"
        variant:"solid"
        scheme:"surface"
        copyLabel:"Copy Dowe"
        copiedLabel:"Copied"
        content:"""
          signal panelOpen value:false

          fn togglePanel
            set panelOpen value:!panelOpen

          Button onClick:togglePanel
            "Toggle panel"

          fn finish
            redirect path:"/docs/views"
        """
      Table:
        data:functionModelRows
        variant:"solid"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"part" label:"Part" width:"2fr"
        column field:"meaning" label:"Responsibility" width:"5fr"
