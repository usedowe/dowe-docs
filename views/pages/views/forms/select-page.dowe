page SelectPage
  signal selectedRole value:"editor"
  signal requiredRole value:""
  const roleOptions:
    value:[
      {
        id:"admin"
        value:"admin"
        label:"Administrator"
        description:"Manage workspace members, settings, and billing."
      },
      {
        id:"editor"
        value:"editor"
        label:"Editor"
        description:"Create, update, and publish workspace content."
      },
      {
        id:"viewer"
        value:"viewer"
        label:"Viewer"
        description:"Read workspace content without making changes."
      },
    ]
  const selectProps:
    value:[
      {
        prop:"bind"
        type:"string Signal path"
        defaultValue:"—"
      },
      {
        prop:"label"
        type:"string"
        defaultValue:"—"
      },
      {
        prop:"placeholder"
        type:"string"
        defaultValue:"—"
      },
      {
        prop:"labelFloating"
        type:"boolean"
        defaultValue:"false"
      },
      {
        prop:"size"
        type:"sm | md | lg"
        defaultValue:"md"
      },
      {
        prop:"variant"
        type:"solid | soft | outlined | ghost"
        defaultValue:"solid"
      },
      {
        prop:"scheme"
        type:"primary | secondary | tertiary | muted | success | info | warning | danger"
        defaultValue:"primary"
      },
      {
        prop:"Option value"
        type:"static string | number | boolean"
        defaultValue:"required"
      },
      {
        prop:"Option label"
        type:"non-empty string"
        defaultValue:"required"
      },
      {
        prop:"Option description"
        type:"string"
        defaultValue:"—"
      },
      {
        prop:"helpText / errorText"
        type:"string"
        defaultValue:"—"
      },
      {
        prop:"validate"
        type:"direct child"
        defaultValue:"—"
      },
    ]
  Section id:"select-introduction" py:{ xs:6 md:10 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest"
          "FORM"
        Title size:{ xs:"3xl" md:"6xl" } weight:"black"
          "Select"
        Text size:"lg"
          "Select lets users make one clear choice from a portable list of static options."
  Section id:"select-playground" p:{ xs:5 md:7 }
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest"
          "PLAYGROUND"
        Title size:"3xl" weight:"black"
          "Choose a workspace role"
        Text size:"sm"
          "bind keeps the selected string in a Signal while each renders a validated catalog of Option children."
      Card variant:"outlined" p:{ xs:5 md:7 } border:1
        Grid columns:1 gap:4
          Select:
            bind:selectedRole
            label:"Workspace role"
            placeholder:"Choose a role"
            labelFloating:true
            w:"full"
            each in:roleOptions as:option key:option.id
              Option value:option.value label:option.label description:option.description
          Text size:"sm"
            "The current selection remains a string Signal that other view controls can bind to."
      Code:
        language:"dowe"
        variant:"solid"
        scheme:"surface"
        copyLabel:"Copy Dowe"
        copiedLabel:"Copied"
        content:"""
          signal selectedRole value:"editor"

          Select:
            bind:selectedRole
            label:"Workspace role"
            placeholder:"Choose a role"
            labelFloating:true
            Option:
              value:"admin"
              label:"Administrator"
              description:"Manage workspace members, settings, and billing."
            Option:
              value:"editor"
              label:"Editor"
              description:"Create, update, and publish workspace content."
            Option:
              value:"viewer"
              label:"Viewer"
              description:"Read workspace content without making changes."
        """
  Section id:"select-labels" py:{ xs:7 md:10 }
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest"
          "LABELS"
        Title size:"3xl" weight:"black"
          "Fixed or floating"
        Text size:"sm"
          "A fixed label stays above the trigger. A floating label rests inside an empty control, activates when the list opens, and stays active after a choice is made. Its active origin matches the selected text and is not moved by the trailing arrow."
      Grid columns:{ xs:1 md:3 } gap:4
        Select label:"Role" placeholder:"Choose a role" w:"full"
          Option value:"admin" label:"Administrator"
          Option value:"editor" label:"Editor"
          Option value:"viewer" label:"Viewer"
        Select:
          label:"Role"
          placeholder:"Choose a role"
          labelFloating:true
          w:"full"
          Option value:"admin" label:"Administrator"
          Option value:"editor" label:"Editor"
          Option value:"viewer" label:"Viewer"
      Code:
        language:"dowe"
        variant:"solid"
        scheme:"surface"
        copyLabel:"Copy Dowe"
        copiedLabel:"Copied"
        content:"""
          Select label:"Role" placeholder:"Choose a role"
            Option value:"admin" label:"Administrator"

          Select:
            label:"Role"
            placeholder:"Choose a role"
            labelFloating:true
            Option value:"admin" label:"Administrator"
        """
  Section id:"select-sizes" py:{ xs:7 md:10 }
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest"
          "SIZES"
        Title size:"3xl" weight:"black"
          "The same trigger height everywhere"
        Text size:"sm"
          "Small, medium, and large triggers are 32, 40, and 48 logical units, and their selected text scales through body sm, md, and lg. A floating label adds exactly 8 units."
      Grid columns:{ xs:1 md:3 } gap:4
        Select label:"Small" placeholder:"32 + 8" labelFloating:true size:"sm" w:"full"
          Option value:"small" label:"Small option"
        Select label:"Medium" placeholder:"40 + 8" labelFloating:true w:"full"
          Option value:"medium" label:"Medium option"
        Select label:"Large" placeholder:"48 + 8" labelFloating:true size:"lg" w:"full"
          Option value:"large" label:"Large option"
  Section id:"select-variants" p:{ xs:5 md:7 }
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest"
          "VARIANTS"
        Title size:"3xl" weight:"black"
          "Four control surfaces"
        Text size:"sm"
          "Variant changes the trigger treatment while the option list, arrow, labels, and single-choice behavior stay consistent."
      Grid columns:{ xs:1 md:3 } gap:4
        Select label:"Solid" placeholder:"Choose a role" variant:"solid" w:"full"
          Option value:"admin" label:"Administrator"
        Select label:"Soft" placeholder:"Choose a role" variant:"solid" w:"full"
          Option value:"editor" label:"Editor"
        Select label:"Outlined" placeholder:"Choose a role" w:"full"
          Option value:"viewer" label:"Viewer"
        Select label:"Ghost" placeholder:"Choose a role" variant:"ghost" w:"full"
          Option value:"guest" label:"Guest"
  Section id:"select-schemes" py:{ xs:7 md:10 }
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest"
          "SCHEMES"
        Title size:"3xl" weight:"black"
          "Every semantic family"
        Text size:"sm"
          "Outlined controls keep a neutral resting border while scheme controls their foreground, focus, and selected-option accent."
      Grid columns:{ xs:2 md:4 } gap:4
        Select label:"Primary" placeholder:"Choose" w:"full"
          Option value:"primary" label:"Primary"
        Select label:"Secondary" placeholder:"Choose" scheme:"secondary" w:"full"
          Option value:"secondary" label:"Secondary"
        Select label:"Tertiary" placeholder:"Choose" scheme:"tertiary" w:"full"
          Option value:"tertiary" label:"Tertiary"
        Select label:"Muted" placeholder:"Choose" scheme:"muted" w:"full"
          Option value:"muted" label:"Muted"
        Select label:"Success" placeholder:"Choose" scheme:"success" w:"full"
          Option value:"success" label:"Success"
        Select label:"Info" placeholder:"Choose" scheme:"info" w:"full"
          Option value:"info" label:"Info"
        Select label:"Warning" placeholder:"Choose" scheme:"warning" w:"full"
          Option value:"warning" label:"Warning"
        Select label:"Danger" placeholder:"Choose" scheme:"danger" w:"full"
          Option value:"danger" label:"Danger"
  Section id:"select-contract" p:{ xs:5 md:7 }
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest"
          "BEHAVIOR"
        Title size:"3xl" weight:"black"
          "One authored list, every target"
        Text size:"sm"
          "Dowe owns the trigger and option popover instead of delegating selection to platform-native menus, pickers, or spinners."
      Grid columns:{ xs:1 md:3 } gap:5
        Flex direction:"column" gap:2
          Text size:"xs" weight:"bold"
            "SINGLE CHOICE"
          Title size:"lg" weight:"bold"
            "String binding"
          Text size:"sm"
            "A selected Option writes its normalized string value to bind. Duplicate values are invalid."
        Flex direction:"column" gap:2
          Text size:"xs" weight:"bold"
            "STRUCTURE"
          Title size:"lg" weight:"bold"
            "Direct children"
          Text size:"sm"
            "Option is valid only as a direct Select child, with a non-empty label and optional description."
        Flex direction:"column" gap:2
          Text size:"xs" weight:"bold"
            "TARGETS"
          Title size:"lg" weight:"bold"
            "Adaptive popover"
          Text size:"sm"
            "Web positions the list by available space; iOS and Android keep it content-sized and scroll long catalogs."
  Section id:"select-validation" py:{ xs:7 md:10 }
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest"
          "VALIDATION"
        Title size:"3xl" weight:"black"
          "Require a deliberate choice"
        Text size:"sm"
          "validate and Option are both direct Select children. Closing an empty list or making a selection marks the control as touched."
      Select bind:requiredRole label:"Approval role" placeholder:"Choose a role" helpText:"Select the role that can approve releases." w:"full"
        validate rule:"required" message:"Choose an approval role."
        Option value:"admin" label:"Administrator"
        Option value:"editor" label:"Editor"
      Code:
        language:"dowe"
        variant:"solid"
        scheme:"surface"
        copyLabel:"Copy Dowe"
        copiedLabel:"Copied"
        content:"""
          Select bind:requiredRole label:"Approval role" helpText:"Select the role that can approve releases."
            validate rule:"required" message:"Choose an approval role."
            Option value:"admin" label:"Administrator"
            Option value:"editor" label:"Editor"
        """
  Section id:"select-props" py:{ xs:7 md:10 }
    Grid columns:1 gap:5
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest"
          "API"
        Title size:"3xl" weight:"black"
          "Props"
        Text size:"sm"
          "Select also accepts the applicable common spacing, sizing, font, visibility, accessibility, and shadow props."
      Table:
        data:selectProps
        variant:"solid"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"prop" label:"Prop" width:"1fr"
        column field:"type" label:"Type" width:"3fr"
        column field:"defaultValue" label:"Default" width:"1fr"
