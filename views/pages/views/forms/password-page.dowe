page PasswordPage
  signal accountPassword value:""
  const passwordProps:
    value:[
      {
        prop:"bind / value"
        type:"string Signal path / string"
        defaultValue:"—"
      },
      {
        prop:"label / placeholder"
        type:"string"
        defaultValue:"—"
      },
      {
        prop:"labelFloating"
        type:"boolean"
        defaultValue:"false"
      },
      {
        prop:"hideStrength"
        type:"boolean"
        defaultValue:"false"
      },
      {
        prop:"weakLabel / mediumLabel / strongLabel"
        type:"string"
        defaultValue:"Weak / Medium / Strong"
      },
      {
        prop:"disabled / readonly"
        type:"boolean"
        defaultValue:"false"
      },
      {
        prop:"variant"
        type:"solid | soft | outlined | line"
        defaultValue:"outlined"
      },
      {
        prop:"scheme"
        type:"primary | secondary | tertiary | muted | success | info | warning | danger"
        defaultValue:"primary"
      },
      {
        prop:"size"
        type:"sm | md | lg"
        defaultValue:"md"
      },
      {
        prop:"name / helpText / errorText"
        type:"string"
        defaultValue:"—"
      },
    ]
  Section id:"password-introduction" py:{ xs:6 md:10 }
    Grid columns:{ xs:1 md:"1fr auto" } gap:5 align:"end"
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "FORM"
        Title size:{ xs:"3xl" md:"6xl" } weight:"black"
          "Password"
        Text size:"lg" color:"muted"
          "Password combines secure entry, an Icon-based eye reveal action, deterministic strength feedback, floating labels, and string Signal binding. The control renders no visible Show or Hide text, and its sm, md, and lg sizes scale both control height and secure-entry text on every target."
  Section id:"password-playground" p:{ xs:5 md:7 }
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "PLAYGROUND"
        Title size:"3xl" weight:"black"
          "Create a resilient account password"
        Text size:"sm" color:"muted"
          "Type a password to exercise reveal behavior and the six-point strength model across length, letter case, digits, and symbols."
      Card variant:"outlined" scheme:"surface" p:{ xs:5 md:7 } rounded:"md" border:1
        Grid columns:1 gap:5
          Password:
            bind:accountPassword
            label:"Account password"
            placeholder:"Create a secure password"
            labelFloating:true
            hideStrength:false
            weakLabel:"Needs work"
            mediumLabel:"Almost there"
            strongLabel:"Ready to use"
            helpText:"Use at least 12 characters with uppercase, lowercase, a number, and a symbol."
            variant:"outlined"
            scheme:"primary"
            size:"lg"
            name:"account-password"
          Flex wrap:true justify:"end" align:"center" gap:3
            Button variant:"ghost" scheme:"muted" size:"sm"
              "Generate suggestion"
            Button variant:"solid" scheme:"primary" size:"sm" iconEnd:"alt-arrow-right"
              "Continue securely"
      Code:
        language:"dowe"
        variant:"soft"
        scheme:"surface"
        copyLabel:"Copy Dowe"
        copiedLabel:"Copied"
        content:"""
          signal accountPassword value:""

          Password bind:accountPassword label:"Account password" placeholder:"Create a secure password" labelFloating:true hideStrength:false weakLabel:"Needs work" mediumLabel:"Almost there" strongLabel:"Ready to use" helpText:"Use at least 12 characters with uppercase, lowercase, a number, and a symbol." variant:"outlined" scheme:"primary" size:"lg" name:"account-password"
        """
  Section id:"password-contexts" py:{ xs:7 md:10 }
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "WORKFLOWS"
        Title size:"3xl" weight:"black"
          "Show strength only when it helps"
        Text size:"sm" color:"muted"
          "Registration benefits from guidance. Sign-in usually needs a quieter surface with the same reveal affordance."
      Grid columns:{ xs:1 md:2 } gap:5
        Password:
          value:"Dowe#Launch2026"
          label:"New workspace password"
          placeholder:"Create password"
          labelFloating:true
          hideStrength:false
          helpText:"Strength feedback updates as the value changes."
          variant:"soft"
          scheme:"success"
          size:"md"
          name:"workspace-password"
        Password:
          label:"Current password"
          placeholder:"Enter password"
          labelFloating:true
          hideStrength:true
          helpText:"Reveal remains available without the creation-oriented meter."
          variant:"line"
          scheme:"secondary"
          size:"md"
          name:"current-password"
      Code:
        language:"dowe"
        variant:"soft"
        scheme:"surface"
        copyLabel:"Copy Dowe"
        copiedLabel:"Copied"
        content:"""
          Password value:"Dowe#Launch2026" label:"New workspace password" labelFloating:true hideStrength:false variant:"soft" scheme:"success" size:"md"

          Password label:"Current password" placeholder:"Enter password" labelFloating:true hideStrength:true variant:"line" scheme:"secondary" size:"md"
        """
  Section id:"password-states" p:{ xs:5 md:7 }
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "STATES AND DENSITY"
        Title size:"3xl" weight:"black"
          "Make security feedback actionable"
        Text size:"sm" color:"muted"
          "Use errorText for a failed requirement, readonly for visible stored values, and disabled for unavailable identity flows."
      Grid columns:{ xs:1 md:2 } gap:5
        Password:
          value:"short"
          label:"Recovery password"
          labelFloating:true
          hideStrength:false
          errorText:"Use at least 12 characters before continuing."
          variant:"outlined"
          scheme:"danger"
          size:"md"
          name:"recovery-password"
        Password:
          value:"ManagedIdentity2026!"
          label:"Managed password"
          labelFloating:true
          hideStrength:true
          readonly:true
          helpText:"This value is managed by your identity provider."
          variant:"solid"
          scheme:"muted"
          size:"md"
          name:"managed-password"
      Text size:"sm" color:"muted"
        "The base heights are 32, 40, and 48; labelFloating adds 8 logical units without moving the reveal control."
      Flex wrap:true justify:"center" align:"center" gap:4
        Password label:"Small" labelFloating:true hideStrength:true variant:"soft" scheme:"primary" size:"sm"
        Password label:"Medium" labelFloating:true hideStrength:true variant:"soft" scheme:"primary" size:"md"
        Password label:"Large" labelFloating:true hideStrength:true variant:"soft" scheme:"primary" size:"lg"
  Section id:"password-contract" py:{ xs:7 md:10 }
    Grid columns:1 gap:5
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "BEHAVIOR"
        Title size:"3xl" weight:"black"
          "Predictable strength and reveal behavior"
        Text size:"sm" color:"muted"
          "The generated control owns visibility toggling and calculates strength locally from the same shared rules on every target."
      Grid columns:{ xs:1 md:3 } gap:4
        Card variant:"soft" scheme:"surface" p:5 rounded:"md"
          Grid columns:1 gap:2
            Text size:"xs" weight:"bold" color:"muted"
              "SCORE"
            Title size:"lg" weight:"bold"
              "Six deterministic checks"
            Text size:"sm" color:"muted"
              "Length thresholds, lowercase, uppercase, digits, and symbols produce weak, medium, or strong."
        Card variant:"soft" scheme:"surface" p:5 rounded:"md"
          Grid columns:1 gap:2
            Text size:"xs" weight:"bold" color:"muted"
              "VISIBILITY"
            Title size:"lg" weight:"bold"
              "Generated reveal control"
            Text size:"sm" color:"muted"
              "The reveal action changes presentation without changing the bound password string."
        Card variant:"soft" scheme:"surface" p:5 rounded:"md"
          Grid columns:1 gap:2
            Text size:"xs" weight:"bold" color:"muted"
              "TARGETS"
            Title size:"lg" weight:"bold"
              "Portable secure entry"
            Text size:"sm" color:"muted"
              "Web, SwiftUI, and Compose preserve labels, feedback, visibility, strength, and read-only state. The floating label stays aligned with password text instead of the trailing reveal action."
  Section id:"password-props" py:{ xs:7 md:10 }
    Grid columns:1 gap:5
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "API"
        Title size:"3xl" weight:"black"
          "Props"
        Text size:"sm" color:"muted"
          "Password also accepts the applicable common spacing, sizing, visibility, accessibility, and shadow props."
      Table:
        data:passwordProps
        variant:"soft"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"prop" label:"Prop" width:"1fr"
        column field:"type" label:"Type" width:"3fr"
        column field:"defaultValue" label:"Default" width:"1fr"
