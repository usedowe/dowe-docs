page EditorPage
  signal articleContent value:""
  const editorProps:
    value:[
      {
        prop:"bind / value"
        type:"string Signal path / string"
        defaultValue:"—"
      },
      {
        prop:"label / placeholder"
        type:"string"
        defaultValue:"—"
      },
      {
        prop:"minHeight"
        type:"80–2000 pixels"
        defaultValue:"200"
      },
      {
        prop:"hideToolbar / disabled / readonly"
        type:"boolean"
        defaultValue:"false"
      },
      {
        prop:"variant"
        type:"solid | soft | outlined | line"
        defaultValue:"outlined"
      },
      {
        prop:"scheme"
        type:"primary | secondary | tertiary | muted | success | info | warning | danger"
        defaultValue:"primary"
      },
      {
        prop:"size"
        type:"sm | md | lg"
        defaultValue:"md"
      },
      {
        prop:"name"
        type:"string"
        defaultValue:"—"
      },
      {
        prop:"helpText / errorText"
        type:"string"
        defaultValue:"—"
      },
    ]
  Section id:"editor-introduction" py:{ xs:6 md:10 }
    Grid columns:{ xs:1 md:"1fr auto" } gap:5 align:"end"
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "FORM"
        Title size:{ xs:"3xl" md:"6xl" } weight:"black"
          "Editor"
        Text size:"lg" color:"muted"
          "Editor combines rich text entry, formatting commands, validation feedback, and portable string binding in one authored control."
  Section id:"editor-playground" p:{ xs:5 md:7 }
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "PLAYGROUND"
        Title size:"3xl" weight:"black"
          "Draft a release article"
        Text size:"sm" color:"muted"
          "The toolbar exposes formatting, headings, alignment, lists, links, history, and clear formatting while bind keeps the authored value in a string Signal."
      Card variant:"outlined" p:{ xs:5 md:7 } border:1
        Grid columns:1 gap:5
          Editor:
            bind:articleContent
            label:"Release article"
            placeholder:"Explain what changed, why it matters, and how teams can adopt it."
            minHeight:320
            hideToolbar:false
            helpText:"Use headings for sections and lists for migration steps."
            variant:"outlined"
            scheme:"primary"
            size:"lg"
            name:"release-article"
          Flex wrap:true justify:"end" align:"center" gap:3
            Button variant:"ghost" scheme:"muted" size:"sm"
              "Save draft"
            Button size:"sm" iconEnd:"alt-arrow-right"
              "Publish article"
      Code:
        language:"dowe"
        variant:"soft"
        scheme:"surface"
        copyLabel:"Copy Dowe"
        copiedLabel:"Copied"
        content:"""
          signal articleContent value:""

          Editor bind:articleContent label:"Release article" placeholder:"Explain what changed, why it matters, and how teams can adopt it." minHeight:320 hideToolbar:false helpText:"Use headings for sections and lists for migration steps." variant:"outlined" scheme:"primary" size:"lg" name:"release-article"
        """
  Section id:"editor-workflows" py:{ xs:7 md:10 }
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "AUTHORING MODES"
        Title size:"3xl" weight:"black"
          "Match the editing surface to the task"
        Text size:"sm" color:"muted"
          "A compact editor keeps short responses focused. A read-only editor preserves the same content surface for review."
      Grid columns:{ xs:1 md:2 } gap:5
        Editor:
          value:"Thanks for the detailed report. I reproduced the issue and added it to the next release."
          label:"Support reply"
          placeholder:"Write a response"
          minHeight:140
          hideToolbar:true
          helpText:"Plain responses do not need formatting controls."
          variant:"soft"
          scheme:"secondary"
          size:"sm"
          name:"support-reply"
        Editor:
          value:"The deployment completed successfully. All services are healthy and the migration audit is available."
          label:"Deployment summary"
          minHeight:180
          readonly:true
          helpText:"Read-only content remains selectable for review."
          variant:"line"
          scheme:"success"
          size:"md"
          name:"deployment-summary"
      Code:
        language:"dowe"
        variant:"soft"
        scheme:"surface"
        copyLabel:"Copy Dowe"
        copiedLabel:"Copied"
        content:"""
          Editor value:"Thanks for the detailed report." label:"Support reply" minHeight:140 hideToolbar:true variant:"soft" scheme:"secondary" size:"sm"

          Editor value:"The deployment completed successfully." label:"Deployment summary" minHeight:180 readonly:true variant:"line" scheme:"success" size:"md"
        """
  Section id:"editor-states" p:{ xs:5 md:7 }
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "STATES"
        Title size:"3xl" weight:"black"
          "Keep constraints close to the content"
        Text size:"sm" color:"muted"
          "Use errorText for actionable validation and disabled when the complete editing workflow is unavailable."
      Grid columns:{ xs:1 md:2 } gap:5
        Editor:
          label:"Incident update"
          placeholder:"Add the customer-facing update"
          minHeight:160
          errorText:"Add a summary before resolving the incident."
          variant:"outlined"
          scheme:"danger"
          size:"md"
          name:"incident-update"
        Editor:
          value:"This approved notice is locked while the campaign is active."
          label:"Campaign notice"
          minHeight:160
          disabled:true
          helpText:"Pause the campaign before editing this notice."
          variant:"solid"
          scheme:"muted"
          size:"md"
          name:"campaign-notice"
  Section id:"editor-contract" py:{ xs:7 md:10 }
    Grid columns:1 gap:5
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "BEHAVIOR"
        Title size:"3xl" weight:"black"
          "One command model across targets"
        Text size:"sm" color:"muted"
          "Dowe owns toolbar commands, keyboard shortcuts, editor state, and generated target behavior without executing user-authored JavaScript."
      Grid columns:{ xs:1 md:3 } gap:4
        Card variant:"soft" p:5
          Grid columns:1 gap:2
            Text size:"xs" weight:"bold" color:"muted"
              "VALUE"
            Title size:"lg" weight:"bold"
              "String binding"
            Text size:"sm" color:"muted"
              "bind reads and writes one string Signal while value provides deterministic initial content."
        Card variant:"soft" p:5
          Grid columns:1 gap:2
            Text size:"xs" weight:"bold" color:"muted"
              "COMMANDS"
            Title size:"lg" weight:"bold"
              "Generated toolbar"
            Text size:"sm" color:"muted"
              "Formatting, lists, headings, alignment, insertion, history, and clearing remain Dowe-owned."
        Card variant:"soft" p:5
          Grid columns:1 gap:2
            Text size:"xs" weight:"bold" color:"muted"
              "TARGETS"
            Title size:"lg" weight:"bold"
              "Native editing"
            Text size:"sm" color:"muted"
              "Web, SwiftUI, and Compose preserve the toolbar, content surface, feedback, and read-only state."
  Section id:"editor-props" py:{ xs:7 md:10 }
    Grid columns:1 gap:5
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "API"
        Title size:"3xl" weight:"black"
          "Props"
        Text size:"sm" color:"muted"
          "Editor also accepts the applicable common spacing, sizing, visibility, accessibility, and shadow props."
      Table:
        data:editorProps
        variant:"soft"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"prop" label:"Prop" width:"1fr"
        column field:"type" label:"Type" width:"3fr"
        column field:"defaultValue" label:"Default" width:"1fr"
