page SliderPage
  signal volume value:40
  signal playbackSpeed value:1
  signal opacity value:72
  const sliderProps:
    value:[
      {
        prop:"bind"
        type:"number Signal path"
        defaultValue:"—"
      },
      {
        prop:"value"
        type:"number"
        defaultValue:"0"
      },
      {
        prop:"min"
        type:"number"
        defaultValue:"0"
      },
      {
        prop:"max"
        type:"number greater than min"
        defaultValue:"100"
      },
      {
        prop:"step"
        type:"positive number"
        defaultValue:"—"
      },
      {
        prop:"label"
        type:"string"
        defaultValue:"—"
      },
      {
        prop:"name"
        type:"non-empty string"
        defaultValue:"—"
      },
      {
        prop:"hideLabel"
        type:"boolean"
        defaultValue:"false"
      },
      {
        prop:"scheme"
        type:"primary | secondary | tertiary | muted | success | info | warning | danger"
        defaultValue:"primary"
      },
      {
        prop:"size"
        type:"sm | md | lg"
        defaultValue:"md"
      },
    ]
  Section id:"slider-introduction" py:{ xs:6 md:10 }
    Grid columns:{ xs:1 md:"1fr auto" } gap:5 align:"end"
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "FORM"
        Title size:{ xs:"3xl" md:"6xl" } weight:"black"
          "Slider"
        Text size:"lg" color:"muted"
          "Sliders let people choose a numeric value from a clear, bounded range."
      Button variant:"soft" scheme:"success" size:"sm" rounded:"full" iconStart:"copy"
        "Copy LLM"
  Section id:"slider-playground" p:{ xs:5 md:7 }
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "PLAYGROUND"
        Title size:"3xl" weight:"black"
          "Adjust live numeric values"
        Text size:"sm" color:"muted"
          "Each Slider reads and writes a numeric Signal. The label row always reflects the current value unless hideLabel is enabled."
      Card variant:"outlined" scheme:"surface" p:{ xs:5 md:7 } rounded:"md" border:1
        Grid columns:1 gap:6
          Slider bind:volume min:0 max:100 step:5 label:"Volume" name:"volume" scheme:"warning" size:"lg"
          Slider bind:playbackSpeed value:1 min:0.5 max:2 step:0.25 label:"Playback speed" name:"playback-speed" scheme:"info" size:"md"
          Slider bind:opacity min:0 max:100 step:1 label:"Layer opacity" name:"opacity" scheme:"secondary" size:"sm"
      Code:
        language:"dowe"
        variant:"soft"
        scheme:"surface"
        copyLabel:"Copy Dowe"
        copiedLabel:"Copied"
        content:"""
          signal volume value:40

          Slider bind:volume min:0 max:100 step:5 label:"Volume" name:"volume" scheme:"warning" size:"lg"
        """
  Section id:"slider-range" py:{ xs:7 md:10 }
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "RANGE AND STEP"
        Title size:"3xl" weight:"black"
          "Make valid values obvious"
        Text size:"sm" color:"muted"
          "min and max define the inclusive range. step controls the increments available while dragging or using a keyboard."
      Grid columns:{ xs:1 md:2 } gap:5
        Slider value:25 min:0 max:50 step:5 label:"Seats" name:"seats" scheme:"primary" size:"md"
        Slider value:18 min:-24 max:24 step:1 label:"Temperature offset" name:"temperature-offset" scheme:"danger" size:"md"
      Code:
        language:"dowe"
        variant:"soft"
        scheme:"surface"
        copyLabel:"Copy Dowe"
        copiedLabel:"Copied"
        content:"""
          Slider value:25 min:0 max:50 step:5 label:"Seats" name:"seats" scheme:"primary"
          Slider value:18 min:-24 max:24 step:1 label:"Temperature offset" name:"temperature-offset" scheme:"danger"
        """
  Section id:"slider-schemes" p:{ xs:5 md:7 }
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "SCHEMES"
        Title size:"3xl" weight:"black"
          "One accent, one progress track"
        Text size:"sm" color:"muted"
          "scheme colors the active track and thumb while the remaining track stays muted for contrast."
      Grid columns:{ xs:1 md:2 } gap:5
        Slider value:65 min:0 max:100 label:"Primary" scheme:"primary" size:"md"
        Slider value:65 min:0 max:100 label:"Secondary" scheme:"secondary" size:"md"
        Slider value:65 min:0 max:100 label:"Tertiary" scheme:"tertiary" size:"md"
        Slider value:65 min:0 max:100 label:"Muted" scheme:"muted" size:"md"
        Slider value:65 min:0 max:100 label:"Success" scheme:"success" size:"md"
        Slider value:65 min:0 max:100 label:"Info" scheme:"info" size:"md"
        Slider value:65 min:0 max:100 label:"Warning" scheme:"warning" size:"md"
        Slider value:65 min:0 max:100 label:"Danger" scheme:"danger" size:"md"
  Section id:"slider-sizes" py:{ xs:7 md:10 }
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "SIZES"
        Title size:"3xl" weight:"black"
          "Three touch densities"
        Text size:"sm" color:"muted"
          "size adjusts the track and thumb together, preserving the same range and interaction contract."
      Grid columns:1 gap:5
        Slider value:45 min:0 max:100 label:"Small" scheme:"primary" size:"sm"
        Slider value:45 min:0 max:100 label:"Medium" scheme:"primary" size:"md"
        Slider value:45 min:0 max:100 label:"Large" scheme:"primary" size:"lg"
  Section id:"slider-labels" p:{ xs:5 md:7 }
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "LABELS"
        Title size:"3xl" weight:"black"
          "Show the value when context needs it"
        Text size:"sm" color:"muted"
          "The default label row pairs the field label with the current number. hideLabel removes that row when surrounding content already supplies the context."
      Grid columns:{ xs:1 md:2 } gap:5
        Slider value:72 min:0 max:100 step:1 label:"Opacity" scheme:"success" size:"md"
        Slider value:72 min:0 max:100 step:1 hideLabel:true scheme:"success" size:"md"
      Code:
        language:"dowe"
        variant:"soft"
        scheme:"surface"
        copyLabel:"Copy Dowe"
        copiedLabel:"Copied"
        content:"""
          Slider value:72 min:0 max:100 step:1 label:"Opacity" scheme:"success"
          Slider value:72 min:0 max:100 step:1 hideLabel:true scheme:"success"
        """
  Section id:"slider-contract" py:{ xs:7 md:10 }
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "BEHAVIOR"
        Title size:"3xl" weight:"black"
          "One range contract, every target"
        Text size:"sm" color:"muted"
          "Dowe lowers the same bounded numeric control to web, Android, and iOS while keeping range, stepping, accent color, and label behavior aligned."
      Grid columns:{ xs:1 md:3 } gap:4
        Card variant:"soft" scheme:"surface" p:5 rounded:"md"
          Grid columns:1 gap:2
            Text size:"xs" weight:"bold" color:"muted"
              "BINDING"
            Title size:"lg" weight:"bold"
              "Numeric Signals"
            Text size:"sm" color:"muted"
              "bind accepts numeric Signal paths only, so changes stay typed without running user JavaScript."
        Card variant:"soft" scheme:"surface" p:5 rounded:"md"
          Grid columns:1 gap:2
            Text size:"xs" weight:"bold" color:"muted"
              "VALIDATION"
            Title size:"lg" weight:"bold"
              "Bounded values"
            Text size:"sm" color:"muted"
              "max must exceed min, and value must remain inside the declared range. step must be positive."
        Card variant:"soft" scheme:"surface" p:5 rounded:"md"
          Grid columns:1 gap:2
            Text size:"xs" weight:"bold" color:"muted"
              "TARGETS"
            Title size:"lg" weight:"bold"
              "Native interaction"
            Text size:"sm" color:"muted"
              "Web, SwiftUI, and Compose each provide native range interaction from the same authored component."
  Section id:"slider-props" py:{ xs:7 md:10 }
    Grid columns:1 gap:5
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "API"
        Title size:"3xl" weight:"black"
          "Props"
        Text size:"sm" color:"muted"
          "Slider also accepts the applicable common spacing, sizing, font, visibility, and accessibility props."
      Table:
        data:sliderProps
        variant:"soft"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"prop" label:"Prop" width:"1fr"
        column field:"type" label:"Type" width:"3fr"
        column field:"defaultValue" label:"Default" width:"1fr"
