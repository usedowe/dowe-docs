page PinPage
  signal verificationCode value:""
  const pinProps:
    value:[
      {
        prop:"bind / value"
        type:"string Signal path / string"
        defaultValue:"—"
      },
      {
        prop:"length"
        type:"integer 1–12"
        defaultValue:"6"
      },
      {
        prop:"type"
        type:"text | password | number"
        defaultValue:"text"
      },
      {
        prop:"label"
        type:"string"
        defaultValue:"—"
      },
      {
        prop:"variant"
        type:"solid | soft | outlined | line"
        defaultValue:"outlined"
      },
      {
        prop:"scheme"
        type:"primary | secondary | tertiary | muted | success | info | warning | danger"
        defaultValue:"primary"
      },
      {
        prop:"size"
        type:"sm | md | lg"
        defaultValue:"md"
      },
      {
        prop:"name"
        type:"string"
        defaultValue:"—"
      },
      {
        prop:"helpText / errorText"
        type:"string"
        defaultValue:"—"
      },
      {
        prop:"validate"
        type:"direct child"
        defaultValue:"—"
      },
    ]
  Section id:"pin-introduction" py:{ xs:6 md:10 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "FORM"
        Title size:{ xs:"3xl" md:"6xl" } weight:"black"
          "Pin"
        Text size:"lg" color:"muted"
          "Pin coordinates segmented entry, focus movement, paste distribution, masking, and one joined string value."
  Section id:"pin-playground" p:{ xs:5 md:7 }
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "PLAYGROUND"
        Title size:"3xl" weight:"black"
          "Verify a high-value action"
        Text size:"sm" color:"muted"
          "Enter or paste a six-digit code. Focus advances per character, Backspace returns to the previous empty field, and Android keeps every cell inside narrow containers."
      Card variant:"outlined" p:{ xs:5 md:7 } border:1
        Grid columns:1 gap:5
          Grid columns:1 gap:2
            Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
              "TRANSFER VERIFICATION"
            Title size:"2xl" weight:"black"
              "Confirm the security code"
            Text size:"sm" color:"muted"
              "A six-digit code was sent to the verified contact method."
          Pin:
            bind:verificationCode
            length:6
            type:"number"
            label:"Verification code"
            helpText:"The code expires in ten minutes. You can paste all six digits at once."
            size:"lg"
            name:"transfer-code"
            validate rule:"required" message:"Enter the verification code."
            validate rule:"min:6" message:"Enter all six digits."
            validate rule:"max:6" message:"Enter only six digits."
            validate rule:"numeric" message:"Use digits only."
          Flex wrap:true justify:"end" align:"center" gap:3
            Button variant:"ghost" scheme:"muted" size:"sm"
              "Send another code"
            Button size:"sm" iconEnd:"alt-arrow-right"
              "Verify transfer"
      Code:
        language:"dowe"
        variant:"soft"
        scheme:"surface"
        copyLabel:"Copy Dowe"
        copiedLabel:"Copied"
        content:"""
          signal verificationCode value:""

          Pin bind:verificationCode length:6 type:"number" label:"Verification code" helpText:"The code expires in ten minutes. You can paste all six digits at once." size:"lg" name:"transfer-code"
            validate rule:"required" message:"Enter the verification code."
            validate rule:"min:6" message:"Enter all six digits."
            validate rule:"max:6" message:"Enter only six digits."
            validate rule:"numeric" message:"Use digits only."
        """
  Section id:"pin-modes" py:{ xs:7 md:10 }
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "ENTRY MODES"
        Title size:"3xl" weight:"black"
          "Choose the right code contract"
        Text size:"sm" color:"muted"
          "Numeric codes suit one-time verification, password mode masks sensitive access keys, and text mode accepts alphanumeric recovery codes."
      Grid columns:{ xs:1 md:3 } gap:4
        Pin:
          value:"5821"
          length:4
          type:"number"
          label:"Device code"
          helpText:"Short numeric pairing code."
          variant:"soft"
          scheme:"info"
          size:"sm"
          name:"device-code"
        Pin:
          value:"749205"
          length:6
          type:"password"
          label:"Vault PIN"
          helpText:"Masked while preserving the joined value."
          variant:"solid"
          scheme:"secondary"
          name:"vault-pin"
        Pin:
          value:"A7K9Q2M4"
          length:8
          type:"text"
          label:"Recovery key"
          helpText:"Text mode accepts an alphanumeric key."
          variant:"line"
          scheme:"success"
          name:"recovery-key"
      Code:
        language:"dowe"
        variant:"soft"
        scheme:"surface"
        copyLabel:"Copy Dowe"
        copiedLabel:"Copied"
        content:"""
          Pin value:"5821" length:4 type:"number" label:"Device code" variant:"soft" scheme:"info" size:"sm"

          Pin value:"749205" length:6 type:"password" label:"Vault PIN" variant:"solid" scheme:"secondary"

          Pin value:"A7K9Q2M4" length:8 type:"text" label:"Recovery key" variant:"line" scheme:"success"
        """
  Section id:"pin-states" p:{ xs:5 md:7 }
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "VALIDATION AND SCALE"
        Title size:"3xl" weight:"black"
          "Respond to the complete code"
        Text size:"sm" color:"muted"
          "Validation applies to the joined value, so feedback stays attached to the complete segmented control."
      Grid columns:{ xs:1 md:2 } gap:5
        Pin:
          value:"1840"
          length:6
          type:"number"
          label:"Expired verification code"
          errorText:"This code is incomplete or has expired. Request a new one."
          scheme:"danger"
          name:"expired-code"
        Pin:
          length:8
          type:"text"
          label:"Enrollment key"
          helpText:"Paste the complete eight-character key from the enrollment screen."
          variant:"soft"
          scheme:"warning"
          name:"enrollment-key"
      Grid columns:{ xs:1 md:3 } gap:4
        Pin length:4 type:"number" label:"Small" variant:"soft" size:"sm"
        Pin length:4 type:"number" label:"Medium" variant:"soft"
        Pin length:4 type:"number" label:"Large" variant:"soft" size:"lg"
  Section id:"pin-contract" py:{ xs:7 md:10 }
    Grid columns:1 gap:5
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "BEHAVIOR"
        Title size:"3xl" weight:"black"
          "Segmented input, one value"
        Text size:"sm" color:"muted"
          "Dowe coordinates entry across individual cells and exposes a single predictable value to the surrounding form."
      Grid columns:{ xs:1 md:3 } gap:5
        Flex direction:"column" gap:2
          Text size:"xs" weight:"bold" color:"muted"
            "KEYBOARD"
          Title size:"lg" weight:"bold"
            "Managed focus"
          Text size:"sm" color:"muted"
            "Character entry advances focus and Backspace returns to the previous empty cell."
        Flex direction:"column" gap:2
          Text size:"xs" weight:"bold" color:"muted"
            "PASTE"
          Title size:"lg" weight:"bold"
            "Distributed input"
          Text size:"sm" color:"muted"
            "Pasting fills consecutive cells up to length and updates the joined value once."
        Flex direction:"column" gap:2
          Text size:"xs" weight:"bold" color:"muted"
            "TARGETS"
          Title size:"lg" weight:"bold"
            "Portable code entry"
          Text size:"sm" color:"muted"
            "Web, SwiftUI, Android Compose, and the Android launcher preserve cell count, type, focus, paste, feedback, 40/44/52-unit widths, 32/40/48-unit heights, and Input typography. Numeric entry uses a numeric keyboard without browser number spinners."
  Section id:"pin-props" py:{ xs:7 md:10 }
    Grid columns:1 gap:5
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "API"
        Title size:"3xl" weight:"black"
          "Props"
        Text size:"sm" color:"muted"
          "Pin also accepts the applicable common spacing, sizing, visibility, accessibility, and shadow props."
      Table:
        data:pinProps
        variant:"soft"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"prop" label:"Prop" width:"1fr"
        column field:"type" label:"Type" width:"3fr"
        column field:"defaultValue" label:"Default" width:"1fr"
