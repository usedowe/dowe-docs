page TogglePage
  signal notificationsEnabled value:true
  const toggleProps:
    value:[
      {
        prop:"bind"
        type:"bool Signal path"
        defaultValue:"—"
      },
      {
        prop:"checked"
        type:"boolean"
        defaultValue:"false"
      },
      {
        prop:"label"
        type:"string"
        defaultValue:"—"
      },
      {
        prop:"labelLeft"
        type:"string"
        defaultValue:"—"
      },
      {
        prop:"labelRight"
        type:"string"
        defaultValue:"—"
      },
      {
        prop:"name"
        type:"string"
        defaultValue:"—"
      },
      {
        prop:"disabled"
        type:"boolean"
        defaultValue:"false"
      },
      {
        prop:"scheme"
        type:"primary | secondary | tertiary | muted | success | info | warning | danger"
        defaultValue:"primary"
      },
    ]
  Section id:"toggle-introduction" py:{ xs:6 md:10 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "FORM"
        Title size:{ xs:"3xl" md:"6xl" } weight:"black"
          "Toggle"
        Text size:"lg" color:"muted"
          "Toggles let people turn one independent setting on or off with a compact, familiar switch."
  Section id:"toggle-playground" p:{ xs:5 md:7 }
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "PLAYGROUND"
        Title size:"3xl" weight:"black"
          "Bind one boolean setting"
        Text size:"sm" color:"muted"
          "bind connects Toggle to a boolean Signal. Changing the switch writes the new value without executing user JavaScript."
      Card variant:"outlined" p:{ xs:5 md:7 } border:1
        Grid columns:1 gap:4
          Toggle:
            bind:notificationsEnabled
            label:"Release notifications"
            name:"release-notifications"
            scheme:"primary"
          Text size:"sm" color:"muted"
            "Use the same Signal anywhere the current on or off setting needs to be reflected."
      Code:
        language:"dowe"
        variant:"soft"
        scheme:"surface"
        copyLabel:"Copy Dowe"
        copiedLabel:"Copied"
        content:"""
          signal notificationsEnabled value:true

          Toggle bind:notificationsEnabled label:"Release notifications" name:"release-notifications" scheme:"primary"
        """
  Section id:"toggle-schemes" py:{ xs:7 md:10 }
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "SCHEMES"
        Title size:"3xl" weight:"black"
          "Every semantic family"
        Text size:"sm" color:"muted"
          "The active track and thumb use the selected scheme while the off state remains neutral and legible."
      Grid columns:1 gap:5
        Toggle checked:true label:"Primary" scheme:"primary"
        Toggle checked:true label:"Secondary" scheme:"secondary"
        Toggle checked:true label:"Tertiary" scheme:"tertiary"
        Toggle checked:true label:"Muted" scheme:"muted"
        Toggle checked:true label:"Success" scheme:"success"
        Toggle checked:true label:"Info" scheme:"info"
        Toggle checked:true label:"Warning" scheme:"warning"
        Toggle checked:true label:"Danger" scheme:"danger"
      Code:
        language:"dowe"
        variant:"soft"
        scheme:"surface"
        copyLabel:"Copy Dowe"
        copiedLabel:"Copied"
        content:"""
          Toggle checked:true label:"Primary" scheme:"primary"
          Toggle checked:true label:"Success" scheme:"success"
          Toggle checked:true label:"Danger" scheme:"danger"
        """
  Section id:"toggle-side-labels" p:{ xs:5 md:7 }
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "SIDE LABELS"
        Title size:"3xl" weight:"black"
          "Make both states clear"
        Text size:"sm" color:"muted"
          "labelLeft appears before the switch and labelRight after it. The active side stays emphasized as the boolean value changes."
      Grid columns:1 gap:5
        Toggle:
          checked:false
          labelLeft:"Off"
          labelRight:"On"
          label:"Email alerts"
          name:"email-alerts"
          scheme:"primary"
        Toggle:
          checked:true
          labelLeft:"Private"
          labelRight:"Public"
          label:"Profile visibility"
          name:"profile-visibility"
          scheme:"success"
      Code:
        language:"dowe"
        variant:"soft"
        scheme:"surface"
        copyLabel:"Copy Dowe"
        copiedLabel:"Copied"
        content:"""
          Toggle checked:false labelLeft:"Off" labelRight:"On" label:"Email alerts" scheme:"primary"
          Toggle checked:true labelLeft:"Private" labelRight:"Public" label:"Profile visibility" scheme:"success"
        """
  Section id:"toggle-states" py:{ xs:7 md:10 }
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "STATES"
        Title size:"3xl" weight:"black"
          "On, off, and unavailable"
        Text size:"sm" color:"muted"
          "Use checked for a fixed initial state. disabled keeps the value visible while preventing interaction."
      Grid columns:1 gap:5
        Toggle checked:true label:"Enabled and on" scheme:"success"
        Toggle checked:false label:"Enabled and off" scheme:"primary"
        Toggle checked:true disabled:true label:"Disabled and on" scheme:"muted"
        Toggle checked:false disabled:true label:"Disabled and off" scheme:"muted"
      Code:
        language:"dowe"
        variant:"soft"
        scheme:"surface"
        copyLabel:"Copy Dowe"
        copiedLabel:"Copied"
        content:"""
          Toggle checked:true label:"Enabled and on" scheme:"success"
          Toggle checked:false label:"Enabled and off" scheme:"primary"
          Toggle checked:true disabled:true label:"Disabled and on" scheme:"muted"
          Toggle checked:false disabled:true label:"Disabled and off" scheme:"muted"
        """
  Section id:"toggle-contract" p:{ xs:5 md:7 }
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "BEHAVIOR"
        Title size:"3xl" weight:"black"
          "One boolean contract, every target"
        Text size:"sm" color:"muted"
          "Dowe lowers the same boolean switch to web, iOS, and Android, keeping labels, scheme, state, and disabled behavior aligned."
      Grid columns:1 gap:4
        Card variant:"soft" p:5
          Grid columns:1 gap:2
            Text size:"xs" weight:"bold" color:"muted"
              "BINDING"
            Title size:"lg" weight:"bold"
              "Boolean only"
            Text size:"sm" color:"muted"
              "bind accepts a bool Signal path and writes true or false when the user changes the switch."
        Card variant:"soft" p:5
          Grid columns:1 gap:2
            Text size:"xs" weight:"bold" color:"muted"
              "STATE CONTEXT"
            Title size:"lg" weight:"bold"
              "Labels on both sides"
            Text size:"sm" color:"muted"
              "label, labelLeft, and labelRight explain the setting and both of its available states."
        Card variant:"soft" p:5
          Grid columns:1 gap:2
            Text size:"xs" weight:"bold" color:"muted"
              "TARGETS"
            Title size:"lg" weight:"bold"
              "Portable switch"
            Text size:"sm" color:"muted"
              "Web, SwiftUI, and Compose render the same checked, unchecked, and disabled model."
  Section id:"toggle-props" py:{ xs:7 md:10 }
    Grid columns:1 gap:5
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "API"
        Title size:"3xl" weight:"black"
          "Props"
        Text size:"sm" color:"muted"
          "Toggle also accepts the applicable common spacing, sizing, font, visibility, accessibility, and shadow props."
      Table:
        data:toggleProps
        variant:"soft"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"prop" label:"Prop" width:"1fr"
        column field:"type" label:"Type" width:"3fr"
        column field:"defaultValue" label:"Default" width:"1fr"
