page CheckboxPage
  signal notificationsEnabled value:true
  const checkboxProps:
    value:[
      {
        prop:"bind"
        type:"bool Signal path"
        defaultValue:"—"
      },
      {
        prop:"checked"
        type:"boolean"
        defaultValue:"false"
      },
      {
        prop:"label"
        type:"string"
        defaultValue:"—"
      },
      {
        prop:"name"
        type:"string"
        defaultValue:"—"
      },
      {
        prop:"disabled"
        type:"boolean"
        defaultValue:"false"
      },
      {
        prop:"scheme"
        type:"primary | secondary | tertiary | muted | success | info | warning | danger"
        defaultValue:"primary"
      },
    ]
  Section id:"checkbox-introduction" py:{ xs:6 md:10 }
    Grid columns:{ xs:1 md:"1fr auto" } gap:5 align:"end"
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "FORM"
        Title size:{ xs:"3xl" md:"6xl" } weight:"black"
          "Checkbox"
        Text size:"lg" color:"muted"
          "Checkboxes let people opt into a single independent boolean choice with a clear label and portable state."
  Section id:"checkbox-playground" p:{ xs:5 md:7 }
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "PLAYGROUND"
        Title size:"3xl" weight:"black"
          "Bind one boolean value"
        Text size:"sm" color:"muted"
          "bind connects the checkbox to a boolean Signal. Tapping the control updates that value without executing user JavaScript."
      Card variant:"outlined" p:{ xs:5 md:7 } border:1
        Grid columns:1 gap:4
          Checkbox bind:notificationsEnabled label:"Send me release notifications" name:"release-notifications"
          Text size:"sm" color:"muted"
            "Use a boolean Signal whenever another part of the view needs the same opt-in state."
      Code:
        language:"dowe"
        variant:"soft"
        scheme:"surface"
        copyLabel:"Copy Dowe"
        copiedLabel:"Copied"
        content:"""
          signal notificationsEnabled value:true

          Checkbox bind:notificationsEnabled label:"Send me release notifications" name:"release-notifications"
        """
  Section id:"checkbox-schemes" py:{ xs:7 md:10 }
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "SCHEMES"
        Title size:"3xl" weight:"black"
          "Every semantic family"
        Text size:"sm" color:"muted"
          "The selected state uses the chosen scheme while the unchecked square stays neutral and legible."
      Grid columns:{ xs:1 md:2 } gap:5
        Checkbox checked:true label:"Primary"
        Checkbox checked:true label:"Secondary" scheme:"secondary"
        Checkbox checked:true label:"Tertiary" scheme:"tertiary"
        Checkbox checked:true label:"Muted" scheme:"muted"
        Checkbox checked:true label:"Success" scheme:"success"
        Checkbox checked:true label:"Info" scheme:"info"
        Checkbox checked:true label:"Warning" scheme:"warning"
        Checkbox checked:true label:"Danger" scheme:"danger"
      Code:
        language:"dowe"
        variant:"soft"
        scheme:"surface"
        copyLabel:"Copy Dowe"
        copiedLabel:"Copied"
        content:"""
          Checkbox checked:true label:"Primary"
          Checkbox checked:true label:"Success" scheme:"success"
          Checkbox checked:true label:"Danger" scheme:"danger"
        """
  Section id:"checkbox-states" p:{ xs:5 md:7 }
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "STATES"
        Title size:"3xl" weight:"black"
          "Checked, unchecked, and unavailable"
        Text size:"sm" color:"muted"
          "Use checked for a fixed initial state. disabled preserves the state visibly while preventing interaction."
      Grid columns:{ xs:1 md:2 } gap:5
        Checkbox checked:true label:"Enabled and checked" scheme:"success"
        Checkbox checked:false label:"Enabled and unchecked"
        Checkbox checked:true disabled:true label:"Disabled and checked" scheme:"muted"
        Checkbox checked:false disabled:true label:"Disabled and unchecked" scheme:"muted"
      Code:
        language:"dowe"
        variant:"soft"
        scheme:"surface"
        copyLabel:"Copy Dowe"
        copiedLabel:"Copied"
        content:"""
          Checkbox checked:true label:"Enabled and checked" scheme:"success"
          Checkbox checked:false label:"Enabled and unchecked"
          Checkbox checked:true disabled:true label:"Disabled and checked" scheme:"muted"
          Checkbox checked:false disabled:true label:"Disabled and unchecked" scheme:"muted"
        """
  Section id:"checkbox-contract" py:{ xs:7 md:10 }
    Grid columns:1 gap:5
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "BEHAVIOR"
        Title size:"3xl" weight:"black"
          "One boolean contract"
        Text size:"sm" color:"muted"
          "Dowe lowers the same boolean field model to a square, softly rounded checkbox on web, iOS, and Android."
      Grid columns:{ xs:1 md:3 } gap:4
        Card variant:"soft" p:5
          Grid columns:1 gap:2
            Text size:"xs" weight:"bold" color:"muted"
              "BINDING"
            Title size:"lg" weight:"bold"
              "Boolean only"
            Text size:"sm" color:"muted"
              "bind accepts a bool Signal path and writes true or false when the user changes the control."
        Card variant:"soft" p:5
          Grid columns:1 gap:2
            Text size:"xs" weight:"bold" color:"muted"
              "ACCESSIBILITY"
            Title size:"lg" weight:"bold"
              "Label the choice"
            Text size:"sm" color:"muted"
              "Provide label text so the visible choice and its control stay understandable together."
        Card variant:"soft" p:5
          Grid columns:1 gap:2
            Text size:"xs" weight:"bold" color:"muted"
              "TARGETS"
            Title size:"lg" weight:"bold"
              "Portable state"
            Text size:"sm" color:"muted"
              "Web, SwiftUI, and Compose render the same checked, unchecked, and disabled states."
  Section id:"checkbox-props" py:{ xs:7 md:10 }
    Grid columns:1 gap:5
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "API"
        Title size:"3xl" weight:"black"
          "Props"
        Text size:"sm" color:"muted"
          "Checkbox also accepts the applicable common spacing, sizing, font, visibility, accessibility, and shadow props."
      Table:
        data:checkboxProps
        variant:"soft"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"prop" label:"Prop" width:"1fr"
        column field:"type" label:"Type" width:"3fr"
        column field:"defaultValue" label:"Default" width:"1fr"
