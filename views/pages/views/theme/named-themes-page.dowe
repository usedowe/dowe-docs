page NamedThemesPage
  const colorGroups:
    value:[
      {
        group:"Base"
        tokens:"primary, secondary, tertiary, muted, background, surface, success, info, warning, danger"
      },
      {
        group:"Content"
        tokens:"onPrimary, onSecondary, onTertiary, onMuted, onBackground, onSurface, onSuccess, onInfo, onWarning, onDanger"
      },
      {
        group:"Soft"
        tokens:"softPrimary, softSecondary, softTertiary, softMuted, softSuccess, softInfo, softWarning, softDanger"
      },
      {
        group:"Soft content"
        tokens:"onSoftPrimary, onSoftSecondary, onSoftTertiary, onSoftMuted, onSoftSuccess, onSoftInfo, onSoftWarning, onSoftDanger"
      },
    ]
  Section id:"named-themes-introduction" py:{ xs:6 md:10 }
    Grid columns:{ xs:1 md:"1fr auto" } gap:5 align:"end"
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "THEME.DOWE"
        Title size:{ xs:"3xl" md:"6xl" } weight:"black"
          "Named themes"
        Text size:"lg" color:"muted"
          "Define semantic color systems once, inherit complete palettes safely, and generate the same active theme model for every target."
      ToggleTheme variant:"soft" scheme:"secondary" size:"md"
  Section id:"named-themes-structure" p:{ xs:5 md:7 }
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "ROOT STRUCTURE"
        Title size:"3xl" weight:"black"
          "Select one default and declare every name"
        Text size:"sm" color:"muted"
          "design.defaultTheme must match a declared theme. light and dark can reuse Dowe's integrated palettes, while project themes can extend either base and override only the roles that differ."
      Code:
        language:"dowe"
        variant:"soft"
        scheme:"surface"
        copyLabel:"Copy named themes"
        copiedLabel:"Copied"
        content:"""
          theme
            fonts default:"inter" install:["inter"]
            design defaultTheme:"light"
              theme name:"light"
                colors primary:"#1F3A5F" onPrimary:"#FFFFFF"
                colors background:"#FFFFFF" onBackground:"#17263A"
                colors surface:"#F7F9FC" onSurface:"#17263A"
              theme name:"dark"
                colors primary:"#6BC670" onPrimary:"#0E2513"
                colors background:"#0F1721" onBackground:"#F4F7FB"
                colors surface:"#182331" onSurface:"#F4F7FB"
              theme name:"brand" extends:"light"
                colors primary:"#007565" onPrimary:"#FFFFFF"
                colors softPrimary:"#CCFBF3" onSoftPrimary:"#073B35"
        """
      Grid columns:{ xs:1 md:3 } gap:4
        Card variant:"soft" scheme:"surface" p:5 rounded:"md"
          Grid columns:1 gap:2
            Text size:"xs" weight:"bold" color:"muted"
              "DEFAULT THEME"
            Title size:"lg" weight:"bold"
              "Controls the first render"
            Text size:"sm" color:"muted"
              "The normalized default is active in initial HTML and native output before a stored theme preference is applied."
        Card variant:"soft" scheme:"surface" p:5 rounded:"md"
          Grid columns:1 gap:2
            Text size:"xs" weight:"bold" color:"muted"
              "NAMED CATALOG"
            Title size:"lg" weight:"bold"
              "Available to every target"
            Text size:"sm" color:"muted"
              "Every resolved name is emitted deterministically and becomes an option for SelectTheme."
        Card variant:"soft" scheme:"surface" p:5 rounded:"md"
          Grid columns:1 gap:2
            Text size:"xs" weight:"bold" color:"muted"
              "INHERITANCE"
            Title size:"lg" weight:"bold"
              "Override a focused subset"
            Text size:"sm" color:"muted"
              "extends resolves the parent first. Missing roles come from the parent instead of target-specific fallbacks."
  Section id:"named-themes-colors" py:{ xs:7 md:10 }
    Grid columns:1 gap:5
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "SEMANTIC COLORS"
        Title size:"3xl" weight:"black"
          "Thirty-six required color roles"
        Text size:"sm" color:"muted"
          "A resolved theme is complete before generation. Use hexadecimal #RGB, #RRGGBB, or #RRGGBBAA values in theme.dowe and semantic families in views."
      Table:
        data:colorGroups
        variant:"soft"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"group" label:"Group" width:"1fr"
        column field:"tokens" label:"Tokens" width:"4fr"
      Grid columns:{ xs:1 md:2 } gap:4
        Card variant:"solid" scheme:"primary" p:5 rounded:"md"
          Grid columns:1 gap:2
            Text size:"xs" weight:"bold" spacing:"widest"
              "BASE + ON"
            Title size:"xl" weight:"black"
              "Strong semantic surfaces"
            Text size:"sm"
              "solid uses a base family such as primary with its matching content role such as onPrimary."
        Card variant:"soft" scheme:"primary" p:5 rounded:"md"
          Grid columns:1 gap:2
            Text size:"xs" weight:"bold" spacing:"widest"
              "SOFT + ON SOFT"
            Title size:"xl" weight:"black"
              "Lower visual emphasis"
            Text size:"sm"
              "soft uses softPrimary with onSoftPrimary while preserving the same semantic family."
  Section id:"named-themes-resolution" p:{ xs:5 md:7 }
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "RESOLUTION"
        Title size:"3xl" weight:"black"
          "Themes change color, not component geometry"
        Text size:"sm" color:"muted"
          "Named themes own semantic colors. Radius, border, shadow, size, and variant defaults belong to component slots directly under design."
      Grid columns:{ xs:1 md:3 } gap:4
        Card variant:"soft" scheme:"surface" p:5 rounded:"md"
          Grid columns:1 gap:2
            Title size:"lg" weight:"bold"
              "Views stay semantic"
            Text size:"sm" color:"muted"
              "Use scheme:\"primary\", bg:\"surface\", or color:\"muted\" instead of copying hexadecimal values into pages."
        Card variant:"soft" scheme:"surface" p:5 rounded:"md"
          Grid columns:1 gap:2
            Title size:"lg" weight:"bold"
              "Parents resolve first"
            Text size:"sm" color:"muted"
              "Dowe rejects missing parents and inheritance cycles before any target artifacts are generated."
        Card variant:"soft" scheme:"surface" p:5 rounded:"md"
          Grid columns:1 gap:2
            Title size:"lg" weight:"bold"
              "Every result is complete"
            Text size:"sm" color:"muted"
              "A custom base without extends must provide every required role; inherited themes may remain focused."
  Section id:"named-themes-controls" py:{ xs:7 md:10 }
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "RUNTIME CONTROLS"
        Title size:"3xl" weight:"black"
          "Expose the normalized catalog"
        Text size:"sm" color:"muted"
          "SelectTheme lists every resolved name. ToggleTheme is intentionally limited to light and dark. Both persist one shared theme preference."
      Flex direction:{ xs:"column" md:"row" } gap:3 align:{ xs:"stretch" md:"end" }
        SelectTheme label:"Documentation theme" placeholder:"Choose a theme" variant:"outlined" scheme:"surface"
        ToggleTheme variant:"soft" scheme:"secondary" size:"md"
      Flex gap:3 wrap:true
        Button variant:"soft" scheme:"primary" href:"/docs/views/multi-theme/select-theme"
          "SelectTheme docs"
        Button variant:"soft" scheme:"secondary" href:"/docs/views/multi-theme/toggle-theme"
          "ToggleTheme docs"
  Section id:"named-themes-validation" p:{ xs:5 md:7 }
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "VALIDATION"
        Title size:"3xl" weight:"black"
          "Invalid theme graphs stop compilation"
      Grid columns:{ xs:1 md:3 } gap:4
        Card variant:"soft" scheme:"danger" p:5 rounded:"md"
          Grid columns:1 gap:2
            Title size:"lg" weight:"bold"
              "Names and defaults"
            Text size:"sm"
              "Names start with a lowercase letter and use lowercase letters, numbers, and hyphens. Names must be unique, and defaultTheme must resolve."
        Card variant:"soft" scheme:"warning" p:5 rounded:"md"
          Grid columns:1 gap:2
            Title size:"lg" weight:"bold"
              "Colors"
            Text size:"sm"
              "Unknown roles, non-hex values, and incomplete resolved themes are rejected with source locations."
        Card variant:"soft" scheme:"info" p:5 rounded:"md"
          Grid columns:1 gap:2
            Title size:"lg" weight:"bold"
              "Inheritance"
            Text size:"sm"
              "A missing parent or an inheritance cycle is reported before web, desktop, Android, or iOS generation."
