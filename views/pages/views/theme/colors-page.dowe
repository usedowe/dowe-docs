            Text size:"xs" weight:"bold" spacing:"widest"
              "SOFT SUCCESS"
            Title size:"lg" weight:"black"
              "Soft success"
            Text size:"sm"
              "fill: #E0F2E4"
            Text size:"xs"
              "text: #245D33 · title: #245D33"
