page ColorsPage
  const darkOverrides:
    value:[
      {
        token:"primary"
        text:"#0E2513"
        titleHex:"#0E2513"
      }
      {
        token:"secondary"
        text:"#13243A"
        titleHex:"#13243A"
      }
      {
        token:"accent"
        text:"#0E251D"
        titleHex:"#0E251D"
      }
      {
        token:"muted"
        text:"#152131"
        titleHex:"#152131"
      }
      {
        token:"background"
        text:"#F4F7FB"
        titleHex:"#F4F7FB"
      }
      {
        token:"surface"
        text:"#F4F7FB"
        titleHex:"#F4F7FB"
      }
      {
        token:"muted"
        text:"#B7E8BA"
        titleHex:"#B7E8BA"
      }
      {
        token:"muted"
        text:"#DDEAF7"
        titleHex:"#DDEAF7"
      }
      {
        token:"muted"
        text:"#A9E4CB"
        titleHex:"#A9E4CB"
      }
      {
        token:"muted"
        text:"#DCE4EC"
        titleHex:"#DCE4EC"
      }
      {
        token:"success"
        text:"#052E16"
        titleHex:"#052E16"
      }
      {
        token:"info"
        text:"#082F49"
        titleHex:"#082F49"
      }
      {
        token:"warning"
        text:"#422006"
        titleHex:"#422006"
      }
      {
        token:"danger"
        text:"#450A0A"
        titleHex:"#450A0A"
      }
      {
        token:"muted"
        text:"#C9F7D8"
        titleHex:"#C9F7D8"
      }
      {
        token:"muted"
        text:"#D3EFFF"
        titleHex:"#D3EFFF"
      }
      {
        token:"muted"
        text:"#FFF0B8"
        titleHex:"#FFF0B8"
      }
      {
        token:"muted"
        text:"#FFDCE2"
        titleHex:"#FFDCE2"
      }
    ]
  Section id:"colors-introduction" py:{ xs:6 md:10 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest"
          "THEME.DOWE"
        Title size:{ xs:"3xl" md:"6xl" } weight:"black"
          "Colors"
        Text size:"lg"
          "Inspect the semantic color system behind Dowe views. Every entry defines ordinary text and title text for a semantic color role."
        SelectTheme:
          label:"Documentation theme"
          placeholder:"Choose a theme"
          variant:"outlined"
          scheme:"surface"
        ToggleTheme variant:"solid" scheme:"secondary" size:"md"
  Section id:"colors-palette" p:{ xs:5 md:7 }
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest"
          "SEMANTIC PALETTE"
        Title size:"3xl" weight:"black"
          "One card for every color"
        Text size:"sm"
          "Cards use semantic schemes and follow the active theme. The hex labels document the light theme values in theme.dowe; solid cards preview the base families."
      const colors:
        value:[
          {
            token:"primary"
            title:"Primary"
            color:"#1F3A5F"
            text:"#EBF2FA"
            titleHex:"#FFFFFF"
          }
          {
            token:"secondary"
            title:"Secondary"
            color:"#6BC670"
            text:"#0F291E"
            titleHex:"#040D05"
          }
          {
            token:"accent"
            title:"Accent"
            color:"#3F7A8A"
            text:"#F0F7F9"
            titleHex:"#FFFFFF"
          }
          {
            token:"muted"
            title:"Muted"
            color:"#E2E8F0"
            text:"#334155"
            titleHex:"#1F3A5F"
          }
          {
            token:"background"
            title:"Background"
            color:"#F3F1EE"
            text:"#334155"
            titleHex:"#1F3A5F"
          }
          {
            token:"surface"
            title:"Surface"
            color:"#FFFFFF"
            text:"#334155"
            titleHex:"#1F3A5F"
          }
          {
            token:"success"
            title:"Success"
            color:"#16A34A"
            text:"#E8F5E9"
            titleHex:"#FFFFFF"
          }
          {
            token:"info"
            title:"Info"
            color:"#0084D1"
            text:"#E1F5FE"
            titleHex:"#FFFFFF"
          }
          {
            token:"warning"
            title:"Warning"
            color:"#D08700"
            text:"#1F1400"
            titleHex:"#0D0900"
          }
          {
            token:"danger"
            title:"Danger"
            color:"#E7000B"
            text:"#FFEBEE"
            titleHex:"#FFFFFF"
          }
        ]
      each in:colors as:color key:color.token
        Card scheme:color.token p:5 rounded:"lg" border:1 borderColor:"muted"
          Grid columns:1 gap:2
            Title size:"lg" weight:"black"
              "{color.title}"
            Text size:"sm"
              """
              color: {color.color}
              text: {color.text}
              title: {color.titleHex}
              """
  Section id:"colors-dark" py:{ xs:7 md:10 }
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest"
          "DARK THEME OVERRIDES"
        Title size:"3xl" weight:"black"
          "The same roles, a different contrast relationship"
        Text size:"sm"
          "dark extends light and overrides only the values that need a darker canvas or stronger contrast."
      Table:
        data:darkOverrides
        variant:"solid"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"token" label:"Token" width:"1fr"
        column field:"text" label:"Text" width:"2fr"
        column field:"titleHex" label:"Title" width:"2fr"
  Section id:"colors-contract" p:{ xs:5 md:7 }
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest"
          "AUTHORING CONTRACT"
        Title size:"3xl" weight:"black"
          "Declare semantic color roles"
        Text size:"sm"
          "The color property paints the surface, text styles ordinary content, and title styles Title descendants. Views consume semantic names instead of embedding hexadecimal values."
      Code:
        language:"dowe"
        variant:"solid"
        scheme:"surface"
        copyLabel:"Copy color theme"
        copiedLabel:"Copied"
        content:"""
          theme
            design defaultTheme:"light"
              theme name:"light"
                colors:
                  primary color:"#1F3A5F" text:"#EBF2FA" title:"#FFFFFF"
                  secondary color:"#6BC670" text:"#0F291E" title:"#040D05"
                  accent color:"#3F7A8A" text:"#F0F7F9" title:"#FFFFFF"
                  muted color:"#E2E8F0" text:"#334155" title:"#1F3A5F"
                  background color:"#F3F1EE" text:"#334155" title:"#1F3A5F"
                  surface color:"#FFFFFF" text:"#334155" title:"#1F3A5F"
                  success color:"#16A34A" text:"#E8F5E9" title:"#FFFFFF"
                  info color:"#0084D1" text:"#E1F5FE" title:"#FFFFFF"
                  warning color:"#D08700" text:"#1F1400" title:"#0D0900"
                  danger color:"#E7000B" text:"#FFEBEE" title:"#FFFFFF"

          Card scheme:"primary"
            Title
              "A title uses the title role."
            Text
              "Body copy uses the text role."
        """
      Grid columns:1 gap:4
        Card variant:"solid" scheme:"primary" p:5
          Grid columns:1 gap:2
            Text size:"xs" weight:"bold" spacing:"widest"
              "SOLID"
            Title size:"lg" weight:"bold"
              "Base family"
            Text size:"sm"
              "scheme primary uses primary as its fill, primaryText for ordinary content, and primaryTitle for titles."
        Card variant:"solid" scheme:"info" p:5
          Grid columns:1 gap:2
            Text size:"xs" weight:"bold" spacing:"widest"
              "CUSTOM"
            Title size:"lg" weight:"bold"
              "Semantic families"
            Text size:"sm"
              "Add complete color, text, and title values when defining a custom semantic family under colors."
      Flex gap:3 wrap:true
        Button variant:"solid" href:"/docs/views/theme/named-themes"
          "Named themes docs"
        Button variant:"solid" scheme:"secondary" href:"/docs/views/theme/component-defaults"
          "Component defaults docs"
