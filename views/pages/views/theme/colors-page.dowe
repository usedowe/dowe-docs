  Section id:"colors-introduction" py:{ xs:6 md:10 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest"
          "THEME.DOWE"
        Title size:{ xs:"3xl" md:"6xl" } weight:"black"
          "Colors"
        Text size:"lg"
          "Inspect the semantic color system behind Dowe views. Every entry is a complete hexadecimal trio: fill color, ordinary text, and title text."
      Flex direction:{ xs:"column" md:"row" } gap:3 align:{ xs:"stretch" md:"end" }
        SelectTheme label:"Documentation theme" placeholder:"Choose a theme" variant:"outlined" scheme:"surface"
        ToggleTheme variant:"solid" scheme:"secondary" size:"md"
  Section id:"colors-palette" p:{ xs:5 md:7 }
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest"
          "SEMANTIC PALETTE"
        Title size:"3xl" weight:"black"
          "One card for every color"
        Text size:"sm"
          "Cards use semantic schemes and follow the active theme. The hex labels document the light theme values in theme.dowe; solid cards preview the base families."
      Grid columns:{ xs:1 sm:2 lg:4 } gap:4
        Card scheme:"primary" p:5 rounded:"lg"
          Grid columns:1 gap:2
            Text size:"xs" weight:"bold" spacing:"widest"
              "PRIMARY"
            Title size:"lg" weight:"black"
              "Primary"
            Text size:"sm"
              "fill: #1F3A5F"
            Text size:"xs"
              "text: #FFFFFF · title: #FFFFFE"
        Card scheme:"secondary" p:5 rounded:"lg"
          Grid columns:1 gap:2
            Text size:"xs" weight:"bold" spacing:"widest"
              "SECONDARY"
            Title size:"lg" weight:"black"
              "Secondary"
            Text size:"sm"
              "fill: #6BC670"
            Text size:"xs"
              "text: #102A15 · title: #102A15"
        Card scheme:"accent" p:5 rounded:"lg"
          Grid columns:1 gap:2
            Text size:"xs" weight:"bold" spacing:"widest"
              "ACCENT"
            Title size:"lg" weight:"black"
              "Accent"
            Text size:"sm"
              "fill: #3F7A8A"
            Text size:"xs"
              "text: #FFFFFF · title: #FFFFFF"
        Card scheme:"muted" p:5 rounded:"lg"
          Grid columns:1 gap:2
            Text size:"xs" weight:"bold" spacing:"widest"
              "MUTED"
            Title size:"lg" weight:"black"
              "Muted"
            Text size:"sm"
              "fill: #526274"
            Text size:"xs"
              "text: #FFFFFF · title: #FFFFFF"
        Card scheme:"background" p:5 rounded:"lg" border:1 borderColor:"muted"
          Grid columns:1 gap:2
            Text size:"xs" weight:"bold" spacing:"widest"
              "BACKGROUND"
            Title size:"lg" weight:"black"
              "Background"
            Text size:"sm"
              "fill: #FFFFFF"
            Text size:"xs"
              "text: #17263A · title: #17263E"
        Card scheme:"surface" p:5 rounded:"lg" border:1 borderColor:"muted"
          Grid columns:1 gap:2
            Text size:"xs" weight:"bold" spacing:"widest"
              "SURFACE"
            Title size:"lg" weight:"black"
              "Surface"
            Text size:"sm"
              "fill: #F7F9FC"
            Text size:"xs"
              "text: #17263A · title: #17263E"
        Card scheme:"success" p:5 rounded:"lg"
          Grid columns:1 gap:2
            Text size:"xs" weight:"bold" spacing:"widest"
              "SUCCESS"
            Title size:"lg" weight:"black"
              "Success"
            Text size:"sm"
              "fill: #2F7D43"
            Text size:"xs"
              "text: #FFFFFF · title: #FFFFFF"
        Card scheme:"info" p:5 rounded:"lg"
          Grid columns:1 gap:2
            Text size:"xs" weight:"bold" spacing:"widest"
              "INFO"
            Title size:"lg" weight:"black"
              "Info"
            Text size:"sm"
              "fill: #2F6FA3"
            Text size:"xs"
              "text: #FFFFFF · title: #FFFFFF"
        Card scheme:"warning" p:5 rounded:"lg"
          Grid columns:1 gap:2
            Text size:"xs" weight:"bold" spacing:"widest"
              "WARNING"
            Title size:"lg" weight:"black"
              "Warning"
            Text size:"sm"
              "fill: #8A6300"
            Text size:"xs"
              "text: #FFFFFF · title: #FFFFFF"
        Card scheme:"danger" p:5 rounded:"lg"
          Grid columns:1 gap:2
            Text size:"xs" weight:"bold" spacing:"widest"
              "DANGER"
            Title size:"lg" weight:"black"
              "Danger"
            Text size:"sm"
              "fill: #A33A46"
            Text size:"xs"
              "text: #FFFFFF · title: #FFFFFF"
  Section id:"colors-dark" py:{ xs:7 md:10 }
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest"
          "DARK THEME OVERRIDES"
        Title size:"3xl" weight:"black"
          "The same roles, a different contrast relationship"
        Text size:"sm"
          "dark extends light and overrides only the values that need a darker canvas or stronger contrast."
      Table:
        data:darkOverrides
        variant:"solid"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"token" label:"Token" width:"1fr"
        column field:"fill" label:"Color / fill" width:"2fr"
        column field:"text" label:"Text" width:"2fr"
        column field:"titleHex" label:"Title" width:"2fr"
  Section id:"colors-contract" p:{ xs:5 md:7 }
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest"
          "AUTHORING CONTRACT"
        Title size:"3xl" weight:"black"
          "Declare complete color triples"
        Text size:"sm"
          "The color property paints the surface, text styles ordinary content, and title styles Title descendants. Views consume semantic names instead of embedding hexadecimal values."
      Code:
        language:"dowe"
        variant:"solid"
        scheme:"surface"
        copyLabel:"Copy color theme"
        copiedLabel:"Copied"
        content:"""
          theme
            design defaultTheme:"light"
              theme name:"light"
                colors:
                  primary color:"#1F3A5F" text:"#EAF2F8" title:"#FFFFFF"

          Card scheme:"primary"
            Title
              "A title uses the title role."
            Text
              "Body copy uses the text role."
        """
      Grid columns:1 gap:4
        Card variant:"solid" scheme:"primary" p:5
          Grid columns:1 gap:2
            Text size:"xs" weight:"bold" spacing:"widest"
              "SOLID"
            Title size:"lg" weight:"bold"
              "Base family"
            Text size:"sm"
              "scheme primary uses primary as its fill, primaryText for ordinary content, and primaryTitle for titles."
        Card variant:"solid" scheme:"info" p:5
          Grid columns:1 gap:2
            Text size:"xs" weight:"bold" spacing:"widest"
              "CUSTOM"
            Title size:"lg" weight:"bold"
              "Semantic families"
            Text size:"sm"
              "Add complete color, text, and title values when defining a custom semantic family under colors."
      Flex gap:3 wrap:true
        Button variant:"solid" href:"/docs/views/theme/named-themes"
          "Named themes docs"
        Button variant:"solid" scheme:"secondary" href:"/docs/views/theme/component-defaults"
          "Component defaults docs"
