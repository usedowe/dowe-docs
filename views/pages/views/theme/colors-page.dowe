  Section id:"colors-introduction" py:{ xs:6 md:10 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "THEME.DOWE"
        Title size:{ xs:"3xl" md:"6xl" } weight:"black"
          "Colors"
        Text size:"lg" color:"muted"
          "Inspect the semantic color system behind Dowe views. Every entry is a complete hexadecimal trio: fill color, ordinary text, and title text."
      Flex direction:{ xs:"column" md:"row" } gap:3 align:{ xs:"stretch" md:"end" }
        SelectTheme label:"Documentation theme" placeholder:"Choose a theme" variant:"outlined" scheme:"surface"
        ToggleTheme variant:"soft" scheme:"secondary" size:"md"
  Section id:"colors-palette" p:{ xs:5 md:7 }
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "SEMANTIC PALETTE"
        Title size:"3xl" weight:"black"
          "One card for every color"
        Text size:"sm" color:"muted"
          "Cards use semantic schemes and follow the active theme. The hex labels document the light theme values in theme.dowe; solid cards preview base families and soft cards preview lower-emphasis counterparts."
      Grid columns:{ xs:1 sm:2 lg:4 } gap:4
        Card scheme:"primary" p:5 rounded:"lg"
          Grid columns:1 gap:2
            Text size:"xs" weight:"bold" spacing:"widest"
              "PRIMARY"
            Title size:"lg" weight:"black"
              "Primary"
            Text size:"sm"
              "fill: #1F3A5F"
            Text size:"xs"
              "text: #FFFFFF · title: #FFFFFE"
        Card variant:"soft" scheme:"primary" p:5 rounded:"lg"
          Grid columns:1 gap:2
            Text size:"xs" weight:"bold" spacing:"widest"
              "SOFT PRIMARY"
            Title size:"lg" weight:"black"
              "Soft primary"
            Text size:"sm"
              "fill: #CCFBF3"
            Text size:"xs"
              "text: #073B35 · title: #073B35"
        Card scheme:"secondary" p:5 rounded:"lg"
          Grid columns:1 gap:2
            Text size:"xs" weight:"bold" spacing:"widest"
              "SECONDARY"
            Title size:"lg" weight:"black"
              "Secondary"
            Text size:"sm"
              "fill: #6BC670"
            Text size:"xs"
              "text: #102A15 · title: #102A15"
        Card variant:"soft" scheme:"secondary" p:5 rounded:"lg"
          Grid columns:1 gap:2
            Text size:"xs" weight:"bold" spacing:"widest"
              "SOFT SECONDARY"
            Title size:"lg" weight:"black"
              "Soft secondary"
            Text size:"sm"
              "fill: #E3F5E5"
            Text size:"xs"
              "text: #234B2A · title: #234B2A"
        Card scheme:"tertiary" p:5 rounded:"lg"
          Grid columns:1 gap:2
            Text size:"xs" weight:"bold" spacing:"widest"
              "TERTIARY"
            Title size:"lg" weight:"black"
              "Tertiary"
            Text size:"sm"
              "fill: #3F7A8A"
            Text size:"xs"
              "text: #FFFFFF · title: #FFFFFF"
        Card variant:"soft" scheme:"tertiary" p:5 rounded:"lg"
          Grid columns:1 gap:2
            Text size:"xs" weight:"bold" spacing:"widest"
              "SOFT TERTIARY"
            Title size:"lg" weight:"black"
              "Soft tertiary"
            Text size:"sm"
              "fill: #E5F1F3"
            Text size:"xs"
              "text: #244C57 · title: #244C57"
        Card scheme:"happy" p:5 rounded:"lg"
          Grid columns:1 gap:2
            Text size:"xs" weight:"bold" spacing:"widest"
              "CUSTOM FAMILY"
            Title size:"lg" weight:"black"
              "Happy"
            Text size:"sm"
              "fill: #176C75"
            Text size:"xs"
              "text: #FFFFFE · title: #FFFFFE"
        Card variant:"soft" scheme:"happy" p:5 rounded:"lg"
          Grid columns:1 gap:2
            Text size:"xs" weight:"bold" spacing:"widest"
              "CUSTOM SOFT FAMILY"
            Title size:"lg" weight:"black"
              "Soft happy"
            Text size:"sm"
              "fill: #D9F3F1"
            Text size:"xs"
              "text: #124D53 · title: #124D53"
        Card scheme:"muted" p:5 rounded:"lg"
          Grid columns:1 gap:2
            Text size:"xs" weight:"bold" spacing:"widest"
              "MUTED"
            Title size:"lg" weight:"black"
              "Muted"
            Text size:"sm"
              "fill: #526274"
            Text size:"xs"
              "text: #FFFFFF · title: #FFFFFF"
        Card variant:"soft" scheme:"muted" p:5 rounded:"lg"
          Grid columns:1 gap:2
            Text size:"xs" weight:"bold" spacing:"widest"
              "SOFT MUTED"
            Title size:"lg" weight:"black"
              "Soft muted"
            Text size:"sm"
              "fill: #E6EBF0"
            Text size:"xs"
              "text: #33465B · title: #33465B"
        Card scheme:"background" p:5 rounded:"lg" border:1 borderColor:"muted"
          Grid columns:1 gap:2
            Text size:"xs" weight:"bold" spacing:"widest"
              "BACKGROUND"
            Title size:"lg" weight:"black"
              "Background"
            Text size:"sm"
              "fill: #FFFFFF"
            Text size:"xs"
              "text: #17263A · title: #17263E"
        Card scheme:"surface" p:5 rounded:"lg" border:1 borderColor:"muted"
          Grid columns:1 gap:2
            Text size:"xs" weight:"bold" spacing:"widest"
              "SURFACE"
            Title size:"lg" weight:"black"
              "Surface"
            Text size:"sm"
              "fill: #F7F9FC"
            Text size:"xs"
              "text: #17263A · title: #17263E"
        Card scheme:"success" p:5 rounded:"lg"
          Grid columns:1 gap:2
            Text size:"xs" weight:"bold" spacing:"widest"
