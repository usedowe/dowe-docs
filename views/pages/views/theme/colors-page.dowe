            Text size:"xs"
              "text: #FFFFFF · title: #FFFFFF"
        Card variant:"soft" scheme:"info" p:5 rounded:"lg"
          Grid columns:1 gap:2
            Text size:"xs" weight:"bold" spacing:"widest"
              "SOFT INFO"
            Title size:"lg" weight:"black"
              "Soft info"
            Text size:"sm"
              "fill: #E2EEF8"
            Text size:"xs"
              "text: #234F73 · title: #234F73"
        Card scheme:"warning" p:5 rounded:"lg"
          Grid columns:1 gap:2
            Text size:"xs" weight:"bold" spacing:"widest"
              "WARNING"
            Title size:"lg" weight:"black"
              "Warning"
            Text size:"sm"
              "fill: #8A6300"
            Text size:"xs"
              "text: #FFFFFF · title: #FFFFFF"
        Card variant:"soft" scheme:"warning" p:5 rounded:"lg"
          Grid columns:1 gap:2
            Text size:"xs" weight:"bold" spacing:"widest"
              "SOFT WARNING"
            Title size:"lg" weight:"black"
              "Soft warning"
            Text size:"sm"
              "fill: #F8EDCF"
            Text size:"xs"
              "text: #604600 · title: #604600"
        Card scheme:"danger" p:5 rounded:"lg"
          Grid columns:1 gap:2
            Text size:"xs" weight:"bold" spacing:"widest"
              "DANGER"
            Title size:"lg" weight:"black"
              "Danger"
            Text size:"sm"
              "fill: #A33A46"
            Text size:"xs"
              "text: #FFFFFF · title: #FFFFFF"
        Card variant:"soft" scheme:"danger" p:5 rounded:"lg"
          Grid columns:1 gap:2
            Text size:"xs" weight:"bold" spacing:"widest"
              "SOFT DANGER"
            Title size:"lg" weight:"black"
              "Soft danger"
            Text size:"sm"
              "fill: #F7E3E6"
            Text size:"xs"
              "text: #7B2C36 · title: #7B2C36"
  Section id:"colors-dark" py:{ xs:7 md:10 }
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "DARK THEME OVERRIDES"
        Title size:"3xl" weight:"black"
          "The same roles, a different contrast relationship"
        Text size:"sm" color:"muted"
          "dark extends light and overrides only the values that need a darker canvas or stronger contrast. The custom happy family remains inherited from light."
      Table:
        data:darkOverrides
        variant:"soft"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"token" label:"Token" width:"1fr"
        column field:"fill" label:"Color / fill" width:"2fr"
        column field:"text" label:"Text" width:"2fr"
        column field:"titleHex" label:"Title" width:"2fr"
  Section id:"colors-contract" p:{ xs:5 md:7 }
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "AUTHORING CONTRACT"
        Title size:"3xl" weight:"black"
          "Declare complete color triples"
        Text size:"sm" color:"muted"
          "The color property paints the surface, text styles ordinary content, and title styles Title descendants. Views consume semantic names instead of embedding hexadecimal values."
      Code:
        language:"dowe"
        variant:"soft"
        scheme:"surface"
        copyLabel:"Copy color theme"
        copiedLabel:"Copied"
        content:"""
          theme
            design defaultTheme:"light"
              theme name:"light"
                colors:
                  primary color:"#1F3A5F" text:"#FFFFFF" title:"#FFFFFE"
                  softPrimary color:"#CCFBF3" text:"#073B35" title:"#073B35"
                  happy color:"#176C75" text:"#FFFFFE" title:"#FFFFFE"

          Card scheme:"primary"
            Title
              "A title uses the title role."
            Text
              "Body copy uses the text role."
        """
      Grid columns:1 gap:4
        Card variant:"soft" scheme:"primary" p:5
          Grid columns:1 gap:2
            Text size:"xs" weight:"bold" spacing:"widest"
              "SOLID"
            Title size:"lg" weight:"bold"
              "Base family"
            Text size:"sm"
              "scheme primary uses primary as its fill, primaryText for ordinary content, and primaryTitle for titles."
        Card variant:"soft" scheme:"secondary" p:5
          Grid columns:1 gap:2
            Text size:"xs" weight:"bold" spacing:"widest"
              "SOFT"
            Title size:"lg" weight:"bold"
              "Lower emphasis"
            Text size:"sm"
              "variant soft scheme primary resolves the separate softPrimary, softPrimaryText, and softPrimaryTitle trio."
        Card variant:"soft" scheme:"info" p:5
          Grid columns:1 gap:2
            Text size:"xs" weight:"bold" spacing:"widest"
              "CUSTOM"
            Title size:"lg" weight:"bold"
              "Project families"
            Text size:"sm"
              "happy is a custom semantic family. Add its complete color, text, and title values under colors."
      Flex gap:3 wrap:true
        Button variant:"soft" href:"/docs/views/theme/named-themes"
          "Named themes docs"
        Button variant:"soft" scheme:"secondary" href:"/docs/views/theme/component-defaults"
          "Component defaults docs"
