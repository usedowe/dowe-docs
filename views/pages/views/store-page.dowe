import docsPreferences from "@/views/store/docs-preferences"

page StorePage
  const storeGuidanceRows:
    value:[
      { rule:"One declaration" guidance:"A Store module owns its initial value, type, persistence policy, and storage identity. Consumers import it; they never redeclare it." },
      { rule:"Persistence" guidance:"Malformed or outdated persisted data restores the declared initial shape instead of hydrating incomplete state." },
      { rule:"Shared scope" guidance:"Imported pages and layouts read the same Store value across routes." },
      { rule:"Security" guidance:"Persistent Stores use device-local convenience storage. Keep server secrets and credentials in server modules." },
    ]
  Section id:"store-introduction" py:{ xs:6 md:10 }
    Grid columns:1 gap:3
      Text size:"xs" weight:"bold" spacing:"widest"
        "STATE"
      Title size:{ xs:"3xl" md:"6xl" } weight:"black"
        "Store"
      Text size:"lg"
        "A Store is shared application state declared once in an imported module and available to every importing page or layout."
  Section id:"store-example" p:{ xs:5 md:7 }
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest"
          "INTERACTIVE EXAMPLE"
        Title size:"3xl" weight:"black"
          "Shared preference"
        Text size:"sm"
          "This page imports a persistent Store. Its value is shared across routes and restored by target-local storage after restart."
      Card variant:"outlined" p:{ xs:5 md:7 } border:1
        Grid columns:1 gap:4
          Text size:"lg" weight:"bold"
            "Application preference"
          Button onClick:{ set:docsPreferences.compactExamples value:!docsPreferences.compactExamples }
            "Toggle preference"
          Text show:docsPreferences.compactExamples size:"sm"
            "Compact mode is enabled. Another page that imports this Store reads the same value."
      Code:
        language:"dowe"
        variant:"solid"
        scheme:"surface"
        copyLabel:"Copy Dowe"
        copiedLabel:"Copied"
        content:"""
          store preferences persistent:true value:{ compactExamples:false }

          import preferences from "@/views/store/preferences"

          page SettingsPage
            Button onClick:{ set:preferences.compactExamples value:!preferences.compactExamples }
              "Toggle preference"
        """
  Section id:"store-guidance" py:{ xs:7 md:10 }
    Grid columns:1 gap:4
      Table:
        data:storeGuidanceRows
        variant:"solid"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"rule" label:"Rule" width:"2fr"
        column field:"guidance" label:"How to apply it" width:"5fr"
