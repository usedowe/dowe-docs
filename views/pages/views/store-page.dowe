import docsPreferences from "@/views/store/docs-preferences"

page StorePage
  Section id:"store-introduction" py:{ xs:6 md:10 }
    Grid columns:1 gap:3
      Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
        "STATE"
      Title size:{ xs:"3xl" md:"6xl" } weight:"black"
        "Store"
      Text size:"lg" color:"muted"
        "A Store is shared application state declared once in an imported module and available to every importing page or layout."
  Section id:"store-example" p:{ xs:5 md:7 }
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "INTERACTIVE EXAMPLE"
        Title size:"3xl" weight:"black"
          "Shared preference"
        Text size:"sm" color:"muted"
          "This page imports a persistent Store. Its value is shared across routes and restored by target-local storage after restart."
      Card variant:"outlined" scheme:"surface" p:{ xs:5 md:7 } rounded:"md" border:1
        Grid columns:1 gap:4
          Text size:"lg" weight:"bold"
            "Application preference"
          Button onClick:{ set:docsPreferences.compactExamples value:!docsPreferences.compactExamples } scheme:"primary"
            "Toggle preference"
          Text show:docsPreferences.compactExamples size:"sm" color:"muted"
            "Compact mode is enabled. Another page that imports this Store reads the same value."
      Code:
        language:"dowe"
        variant:"soft"
        scheme:"surface"
        copyLabel:"Copy Dowe"
        copiedLabel:"Copied"
        content:"""
          store preferences persistent:true value:{ compactExamples:false }

          import preferences from "@/views/store/preferences"

          page SettingsPage
            Button onClick:{ set:preferences.compactExamples value:!preferences.compactExamples }
              "Toggle preference"
        """
  Section id:"store-guidance" py:{ xs:7 md:10 }
    Grid columns:{ xs:1 md:2 } gap:4
      Card variant:"soft" scheme:"surface" p:5 rounded:"md"
        Grid columns:1 gap:2
          Title size:"lg" weight:"bold"
            "One declaration"
          Text size:"sm" color:"muted"
            "A Store module owns its initial value, type, persistence policy, and storage identity. Consumers import it; they never redeclare it."
          Text size:"sm" color:"muted"
            "When persisted data is malformed or no longer matches the declared initial shape, Dowe restores the initial value instead of hydrating incomplete state."
      Card variant:"soft" scheme:"warning" p:5 rounded:"md"
        Grid columns:1 gap:2
          Title size:"lg" weight:"bold"
            "Keep secrets server-side"
          Text size:"sm" color:"muted"
            "Persistent Stores use device-local convenience storage. Do not place server secrets or credentials in a View Store."
