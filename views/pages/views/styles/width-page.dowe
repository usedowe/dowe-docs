page WidthPage
  const widthProps:
    value:[
      {
        prop:"w"
        type:"Dowe scale | full | responsive"
        defaultValue:"—"
      },
      {
        prop:"minW"
        type:"Dowe scale | full | responsive"
        defaultValue:"—"
      },
      {
        prop:"maxW"
        type:"Dowe scale | full | responsive"
        defaultValue:"—"
      },
    ]
  Section id:"width-introduction" py:{ xs:6 md:10 }
    Grid columns:1 gap:5
      Flex direction:"column" gap:3
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "STYLES"
        Title size:{ xs:"3xl" md:"6xl" } weight:"black"
          "Width"
        Text size:"lg" color:"muted"
          "Set an explicit width or protect a component with minimum and maximum bounds across every target."
  Section id:"width-values" p:{ xs:5 md:7 }
    Flex direction:"column" gap:6
      Flex direction:"column" gap:2
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "WIDTH VALUES"
        Title size:"3xl" weight:"black"
          "Scale values and full width"
        Text size:"sm" color:"muted"
          "Numeric values use the Dowe scale. The full token occupies the available parent width."
      Grid columns:{ xs:1 md:3 } gap:4
        Flex direction:"column" gap:2
          Box bg:"softPrimary" rounded:"md" w:24 h:12
          Text size:"sm" color:"muted"
            "w:24"
        Flex direction:"column" gap:2
          Box bg:"softSecondary" rounded:"md" w:48 h:12
          Text size:"sm" color:"muted"
            "w:48"
        Flex direction:"column" gap:2
          Box bg:"softTertiary" rounded:"md" w:"full" h:12
          Text size:"sm" color:"muted"
            "w:\"full\""
  Section id:"width-minimum" py:{ xs:7 md:10 }
    Grid columns:{ xs:1 md:2 } gap:6 align:"center"
      Flex direction:"column" gap:3
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "MINIMUM WIDTH"
        Title size:"3xl" weight:"black"
          "Keep controls usable"
        Text size:"sm" color:"muted"
          "minW establishes a lower bound while the surrounding layout still decides available space."
        Code:
          language:"dowe"
          variant:"soft"
          scheme:"surface"
          copyLabel:"Copy Dowe"
          copiedLabel:"Copied"
          content:"""
            Button minW:40
              "Continue"
          """
      Flex direction:"column" gap:4 align:"start"
        Button minW:40
          "Continue"
        Button minW:64 variant:"soft" scheme:"secondary"
          "Create workspace"
  Section id:"width-responsive" p:{ xs:5 md:7 }
    Grid columns:{ xs:1 md:2 } gap:6 align:"center"
      Flex direction:"column" gap:3
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "RESPONSIVE"
        Title size:"3xl" weight:"black"
          "Fill available space up to a cap"
        Text size:"sm" color:"muted"
          "Combine w:\"full\" with responsive maxW when a surface should use available mobile space without becoming too wide on larger screens."
        Code:
          language:"dowe"
          variant:"soft"
          scheme:"surface"
          copyLabel:"Copy Dowe"
          copiedLabel:"Copied"
          content:"""
            Box w:"full" maxW:{ xs:"full" md:64 } p:6 rounded:"lg"
              Text "Responsive maximum width"
          """
      Flex direction:"column" align:"center" w:"full"
        Box bg:"softPrimary" w:"full" maxW:{ xs:"full" md:64 } p:6 rounded:"lg"
          Text weight:"bold"
            "Full up to scale 64 from md."
  Section id:"width-maximum" py:{ xs:7 md:10 }
    Flex direction:"column" gap:5
      Flex direction:"column" gap:2
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "MAXIMUM WIDTH"
        Title size:"3xl" weight:"black"
          "Cap width without forcing it"
        Text size:"sm" color:"muted"
          "maxW sets an upper bound. Content may remain narrower, while w:\"full\" grows only until it reaches the limit."
      Grid columns:{ xs:1 md:2 } gap:6 align:"center"
        Code:
          language:"dowe"
          variant:"soft"
          scheme:"surface"
          copyLabel:"Copy Dowe"
          copiedLabel:"Copied"
          content:"""
            Card w:"full" maxW:64 p:6
              Title "Bounded card"
          """
        Flex direction:"column" align:"center" w:"full"
          Card w:"full" maxW:64 variant:"soft" scheme:"success" rounded:"lg" p:6
            Title size:"lg" weight:"bold"
              "Bounded card"
            Text size:"sm" color:"muted"
              "This card fills its parent until scale 64."
  Section id:"width-props" py:{ xs:7 md:10 }
    Flex direction:"column" gap:5
      Flex direction:"column" gap:2
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "API"
        Title size:"3xl" weight:"black"
          "Supported props"
      Table:
        data:widthProps
        variant:"soft"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"prop" label:"Prop" width:"1fr"
        column field:"type" label:"Type" width:"4fr"
        column field:"defaultValue" label:"Default" width:"1fr"
  Section id:"width-compatibility" py:{ xs:7 md:10 }
    Flex direction:"column" gap:3
      Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
        "COMPATIBILITY"
      Title size:"3xl" weight:"black"
        "Available on styled components"
      Text weight:"bold"
        "Layout and shell"
      Text color:"muted"
        "Box, Section, Flex, Grid, AppBar, Footer, BottomBar, Sidebar, Scaffold, and Drawer."
      Text weight:"bold"
        "Navigation"
      Text color:"muted"
        "NavMenu, SideNav, RailNav, Tabs, and Stepper."
      Text weight:"bold"
        "Content and display"
      Text color:"muted"
        "Text, Title, Code, Video, Iframe, Device, Canvas, Table, Divider, Brand, Banner, Alert, Icon, Avatar, AvatarGroup, Badge, Chip, Skeleton, Card, Empty, Marquee, TypeWriter, RichText, Collapsible, Countdown, Map, Audio, Image, Accordion, Carousel, and ChatBox."
      Text weight:"bold"
        "Charts"
      Text color:"muted"
        "Candlestick, ArcChart, AreaChart, BarChart, LineChart, and PieChart."
      Text weight:"bold"
        "Controls and forms"
      Text color:"muted"
        "Input, Select, Button, IconButton, ToggleTheme, SelectTheme, Fab, Slider, Dropzone, ComboBox, CsvField, DragDrop, Editor, ImageCropper, Password, Phone, Pin, Textarea, Record, ToggleGroup, Checkbox, Color, Date, DateRange, RadioGroup, and Toggle."
      Text weight:"bold"
        "Overlays"
      Text color:"muted"
        "Modal, AlertDialog, Tooltip, Toast, Dropdown, and Command."
      Alert type:"info" variant:"soft" scheme:"info" message:"Svg supports w, but not minW or maxW. Splash, Path, and context-only entries such as Option, fabAction, comboOption, csvColumn, dragGroup, dragItem, tab, step, and region entries do not accept these width props."
