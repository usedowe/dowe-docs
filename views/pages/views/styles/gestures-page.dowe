page GesturesPage
  const gesturePresets:
    value:[
      { value:"none" pointer:"No feedback" touch:"No feedback" },
      { value:"lift" pointer:"Raise with shadow; settle while active" touch:"Raise and slightly compress while pressed" },
      { value:"press" pointer:"Compress while active" touch:"Compress while pressed" },
      { value:"grow" pointer:"Enlarge on hover or active" touch:"Enlarge while pressed" },
      { value:"tilt" pointer:"Rotate slightly on hover or active" touch:"Rotate slightly while pressed" },
    ]
  Section id:"gestures-introduction" py:{ xs:6 md:10 }
    Flex direction:"column" gap:3
      Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
        "STYLES"
      Title size:{ xs:"3xl" md:"6xl" } weight:"black"
        "Gestures"
      Text size:"lg" color:"muted"
        "Add portable hover and press feedback without writing target-specific interaction code."
  Section id:"gestures-presets" p:{ xs:5 md:8 }
    Flex direction:"column" gap:6
      Title size:"3xl" weight:"black"
        "Lift, press, grow, or tilt"
      Card variant:"outlined" rounded:"xl" p:{ xs:7 md:10 }
        Flex wrap:true justify:"center" align:"center" gap:5
          Chip variant:"solid" scheme:"warning" gesture:"lift" transition:"spring" rotate:-5
            "Lift"
          Chip variant:"soft" scheme:"muted" gesture:"press" transition:"quick" rotate:3
            "Press"
          Chip variant:"solid" scheme:"success" gesture:"grow" transition:"smooth" rotate:-3
            "Grow"
          Chip variant:"solid" scheme:"muted" gesture:"tilt" transition:"spring" rotate:6
            "Tilt"
      Code:
        language:"dowe"
        variant:"soft"
        scheme:"surface"
        copyLabel:"Copy Dowe"
        copiedLabel:"Copied"
        content:"""
          Chip gesture:"lift" transition:"spring" rotate:-5
            "Interactive chip"
        """
  Section id:"gestures-targets" py:{ xs:7 md:10 }
    Flex direction:"column" gap:3
      Title size:"3xl" weight:"black"
        "One intent, native feedback"
      Text color:"muted"
        "Pointer targets respond to hover and active state. Touch targets respond while pressed, and reduced-motion preferences are respected automatically."
  Section id:"gestures-api" py:{ xs:7 md:10 }
    Flex direction:"column" gap:5
      Flex direction:"column" gap:2
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "API"
        Title size:"3xl" weight:"black"
          "Preset values by input type"
        Text size:"sm" color:"muted"
          "gesture is a static quoted preset. Its default is none. When transition is omitted, each target uses its baseline gesture timing; author a transition preset when named timing matters."
      Table:
        data:gesturePresets
        variant:"soft"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"value" label:"Value" width:"1fr"
        column field:"pointer" label:"Pointer" width:"3fr"
        column field:"touch" label:"Android and iOS" width:"3fr"
  Section id:"gestures-compatibility" py:{ xs:7 md:10 }
    Flex direction:"column" gap:3
      Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
        "COMPATIBILITY"
      Title size:"3xl" weight:"black"
        "Visual feedback on styled components"
      Text color:"muted"
        "Every styled layout, navigation root, content component, chart, control, form, and overlay accepts gesture, including Box, Card, Chip, Image, Text, Button, Input, Tabs, Stepper, and Modal."
      Alert type:"warning" variant:"soft" scheme:"warning" message:"Feedback is not an event. A gesture does not dispatch a function or add navigation semantics. Use onClick on a compatible action surface. Drag, swipe, pinch, long-press callbacks, context entries, Svg, and Path are outside this contract."
