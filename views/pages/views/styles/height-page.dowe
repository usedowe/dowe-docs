page HeightPage
  const heightProps:
    value:[
      {
        prop:"h"
        type:"Dowe scale | full | vh-<scale> | responsive"
        defaultValue:"—"
      },
      {
        prop:"minH"
        type:"Dowe scale | full | vh-<scale> | responsive"
        defaultValue:"—"
      },
      {
        prop:"maxH"
        type:"Dowe scale | full | vh-<scale> | responsive"
        defaultValue:"—"
      },
    ]
  Section id:"height-introduction" py:{ xs:6 md:10 }
    Grid columns:1 gap:5
      Flex direction:"column" gap:3
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "STYLES"
        Title size:{ xs:"3xl" md:"6xl" } weight:"black"
          "Height"
        Text size:"lg" color:"muted"
          "Control fixed, minimum, maximum, full, and viewport-aware heights with portable Dowe values."
  Section id:"height-values" p:{ xs:5 md:7 }
    Flex direction:"column" gap:6
      Flex direction:"column" gap:2
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "HEIGHT VALUES"
        Title size:"3xl" weight:"black"
          "Fixed heights from the scale"
        Text size:"sm" color:"muted"
          "Numeric values use the same logical scale on web, Android, and iOS."
      Grid columns:1 gap:4
        Flex direction:"column" gap:3
          Box bg:"softPrimary" rounded:"md" w:"full" h:16
          Text size:"sm" weight:"bold"
            "h:16"
        Flex direction:"column" gap:3
          Box bg:"softSecondary" rounded:"md" w:"full" h:24
          Text size:"sm" weight:"bold"
            "h:24"
        Flex direction:"column" gap:3
          Box bg:"softTertiary" rounded:"md" w:"full" h:32
          Text size:"sm" weight:"bold"
            "h:32"
  Section id:"height-full" py:{ xs:7 md:10 }
    Grid columns:1 gap:6 align:"center"
      Flex direction:"column" gap:3
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "FULL HEIGHT"
        Title size:"3xl" weight:"black"
          "Fill the available parent height"
        Text size:"sm" color:"muted"
          "The full token follows the height made available by the containing layout."
        Code:
          language:"dowe"
          variant:"soft"
          scheme:"surface"
          copyLabel:"Copy Dowe"
          copiedLabel:"Copied"
          content:"""
            Box h:40
              Box h:"full" bg:"softPrimary"
          """
      Box h:40 border:1 borderColor:"muted" rounded:"lg" p:3
        Box h:"full" bg:"softPrimary" rounded:"md"
          Flex h:"full" align:"center" justify:"center"
            Text weight:"bold"
              "h:\"full\""
  Section id:"height-minimum" p:{ xs:5 md:7 }
    Grid columns:1 gap:6 align:"center"
      Flex direction:"column" gap:3
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "MINIMUM HEIGHT"
        Title size:"3xl" weight:"black"
          "Reserve space without clipping content"
        Text size:"sm" color:"muted"
          "minH sets a lower bound and still allows the component to grow with its children."
      Card minH:32 variant:"soft" scheme:"secondary" rounded:"lg" p:6
        Flex direction:"column" gap:2 justify:"center" minH:20
          Title size:"lg" weight:"bold"
            "Flexible content"
          Text size:"sm" color:"muted"
            "This card is at least scale 32 high and can grow when more content is added."
  Section id:"height-viewport" py:{ xs:7 md:10 }
    Flex direction:"column" gap:5
      Flex direction:"column" gap:2
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "VIEWPORT HEIGHT"
        Title size:"3xl" weight:"black"
          "Subtract a known scale value"
        Text size:"sm" color:"muted"
          "h, minH, and maxH accept vh-<scale> when a manual surface must reserve viewport space. Scaffold already handles its fixed AppBar inset."
      Code:
        language:"dowe"
        variant:"soft"
        scheme:"surface"
        copyLabel:"Copy Dowe"
        copiedLabel:"Copied"
        content:"""
          Box minH:"vh-16"
            Text "Viewport height minus scale 16"
        """
  Section id:"height-maximum" p:{ xs:5 md:7 }
    Flex direction:"column" gap:5
      Flex direction:"column" gap:2
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "MAXIMUM HEIGHT"
        Title size:"3xl" weight:"black"
          "Bound a surface without choosing overflow"
        Text size:"sm" color:"muted"
          "maxH sets an upper bound on the component. It does not add scrolling or clipping, so use a component that explicitly owns overflow when content may exceed the limit."
      Grid columns:1 gap:6 align:"center"
        Code:
          language:"dowe"
          variant:"soft"
          scheme:"surface"
          copyLabel:"Copy Dowe"
          copiedLabel:"Copied"
          content:"""
            Card maxH:{ xs:"vh-16" md:48 } p:6
              Text "Height-limited content"
          """
        Card maxH:48 variant:"soft" scheme:"success" rounded:"lg" p:6
          Flex direction:"column" gap:2
            Title size:"lg" weight:"bold"
              "Maximum height"
            Text size:"sm" color:"muted"
              "The card can stay shorter, but it cannot grow past scale 48."
  Section id:"height-props" py:{ xs:7 md:10 }
    Flex direction:"column" gap:5
      Flex direction:"column" gap:2
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "API"
        Title size:"3xl" weight:"black"
          "Supported props"
      Table:
        data:heightProps
        variant:"soft"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"prop" label:"Prop" width:"1fr"
        column field:"type" label:"Type" width:"4fr"
        column field:"defaultValue" label:"Default" width:"1fr"
  Section id:"height-compatibility" py:{ xs:7 md:10 }
    Flex direction:"column" gap:3
      Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
        "COMPATIBILITY"
      Title size:"3xl" weight:"black"
        "Available on styled components"
      Text weight:"bold"
        "Layout and shell"
      Text color:"muted"
        "Box, Section, Flex, Grid, AppBar, Footer, BottomBar, Sidebar, Scaffold, and Drawer."
      Text weight:"bold"
        "Navigation"
      Text color:"muted"
        "NavMenu, SideNav, RailNav, Tabs, and Stepper."
      Text weight:"bold"
        "Content and display"
      Text color:"muted"
        "Text, Title, Code, Video, Iframe, Device, Canvas, Table, Divider, Brand, Banner, Alert, Icon, Avatar, AvatarGroup, Badge, Chip, Skeleton, Card, Empty, Marquee, TypeWriter, RichText, Collapsible, Countdown, Map, Audio, Image, Accordion, Carousel, and ChatBox."
      Text weight:"bold"
        "Charts"
      Text color:"muted"
        "Candlestick, ArcChart, AreaChart, BarChart, LineChart, and PieChart."
      Text weight:"bold"
        "Controls and forms"
      Text color:"muted"
        "Input, Select, Button, IconButton, ToggleTheme, SelectTheme, Fab, Slider, Dropzone, ComboBox, CsvField, DragDrop, Editor, ImageCropper, Password, Phone, Pin, Textarea, Record, ToggleGroup, Checkbox, Color, Date, DateRange, RadioGroup, and Toggle."
      Text weight:"bold"
        "Overlays"
      Text color:"muted"
        "Modal, AlertDialog, Tooltip, Toast, Dropdown, and Command."
      Alert type:"info" variant:"soft" scheme:"info" message:"Svg supports h, but not minH or maxH. Splash, Path, and context-only entries such as Option, fabAction, comboOption, csvColumn, dragGroup, dragItem, tab, step, and region entries do not accept these height props."
