page CanvasOverviewPage
  signal overviewScene:
    value:[
      {
        type:"rect"
        x:0
        y:0
        width:640
        height:360
        fill:"surface"
      },
      {
        type:"line"
        x1:0
        y1:72
        x2:640
        y2:72
        stroke:"surfaceText"
        strokeWidth:1
        opacity:0.12
      },
      {
        type:"line"
        x1:0
        y1:144
        x2:640
        y2:144
        stroke:"surfaceText"
        strokeWidth:1
        opacity:0.12
      },
      {
        type:"line"
        x1:0
        y1:216
        x2:640
        y2:216
        stroke:"surfaceText"
        strokeWidth:1
        opacity:0.12
      },
      {
        type:"line"
        x1:0
        y1:288
        x2:640
        y2:288
        stroke:"surfaceText"
        strokeWidth:1
        opacity:0.12
      },
      {
        type:"polyline"
        points:[
          { x:50 y:270 },
          { x:150 y:215 },
          { x:245 y:238 },
          { x:355 y:125 },
          { x:465 y:160 },
          { x:590 y:72 },
        ]
        closed:false
        stroke:"primary"
        strokeWidth:8
      },
      {
        type:"circle"
        x:150
        y:215
        radius:13
        fill:"secondary"
        stroke:"secondaryText"
        strokeWidth:4
      },
      {
        type:"circle"
        x:355
        y:125
        radius:18
        fill:"tertiary"
        stroke:"tertiaryText"
        strokeWidth:4
        motion:{ pulse:0.7 }
      },
      {
        type:"rect"
        x:468
        y:220
        width:122
        height:70
        radius:16
        fill:"muted"
        stroke:"primary"
        strokeWidth:3
        rotation:-5
      },
      {
        type:"text"
        x:36
        y:48
        text:"RETAINED SCENE"
        fill:"surfaceText"
        size:24
      },
      {
        type:"text"
        x:529
        y:262
        text:"6 commands"
        fill:"mutedText"
        size:16
        align:"center"
      },
      {
        type:"text"
        x:36
        y:334
        text:"One logical viewport · deterministic target output"
        fill:"muted"
        size:14
      },
    ]
  const canvasProps:
    value:[
      {
        prop:"scene"
        type:"Signal array path"
        defaultValue:"required"
      },
      {
        prop:"label"
        type:"non-empty static string"
        defaultValue:"required"
      },
      {
        prop:"viewWidth, viewHeight"
        type:"positive integers"
        defaultValue:"320, 180"
      },
      {
        prop:"fit"
        type:"contain | cover | stretch"
        defaultValue:"contain"
      },
      {
        prop:"fps"
        type:"1 through 120"
        defaultValue:"60"
      },
      {
        prop:"autoplay"
        type:"boolean"
        defaultValue:"true"
      },
      {
        prop:"background"
        type:"Dowe color token | transparent"
        defaultValue:"transparent"
      },
      {
        prop:"pixelated"
        type:"boolean"
        defaultValue:"false"
      },
      {
        prop:"onPointer, onKey, onMotion"
        type:"function reference"
        defaultValue:"—"
      },
      {
        prop:"motionRate"
        type:"1 through 60"
        defaultValue:"30"
      },
    ]
  const commandTypes:
    value:[
      {
        command:"rect"
        required:"x, y, width, height"
        purpose:"Panels, backgrounds, bars, and tiles"
      },
      {
        command:"circle"
        required:"x, y, radius"
        purpose:"Markers, particles, nodes, and lights"
      },
      {
        command:"line"
        required:"x1, y1, x2, y2"
        purpose:"Rules, axes, links, and guides"
      },
      {
        command:"polyline"
        required:"points"
        purpose:"Paths, polygons, ships, and trends"
      },
      {
        command:"text"
        required:"x, y, text"
        purpose:"Labels and scene annotations"
      },
      {
        command:"image"
        required:"src, x, y, width, height"
        purpose:"Asset placement and composition"
      },
    ]
  Section id:"canvas-overview-introduction" py:{ xs:6 md:10 }
    Grid columns:{ xs:1 md:2 } gap:5 align:"center"
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest"
          "CANVAS"
        Title size:{ xs:"3xl" md:"6xl" } weight:"black"
          "Canvas"
        Text size:"lg"
          "Describe a retained 2D scene once and render it through native drawing systems on web, desktop, Android, and iOS."
      Card variant:"solid" scheme:"primary" p:5 rounded:"lg" minW:56
        Grid columns:1 gap:1
          Text size:"xs" weight:"bold" spacing:"widest"
            "TARGET-NEUTRAL"
          Title size:"xl" weight:"black"
            "Commands, not drawing APIs"
          Text size:"sm"
            "Dowe owns transforms, frame timing, color resolution, clipping, input, and target generation."
  Section id:"canvas-overview-scene" p:{ xs:5 md:7 }
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest"
          "ADVANCED OVERVIEW"
        Title size:"3xl" weight:"black"
          "Layer a complete scene in source order"
        Text size:"sm"
          "Every command is retained in a Signal array. Later commands draw above earlier commands, while the logical viewport stays independent from the displayed size."
      Canvas:
        scene:overviewScene
        viewWidth:640
        viewHeight:360
        fit:"contain"
        fps:60
        autoplay:true
        background:"surface"
        label:"Layered Canvas scene with a rising path, markers, grid, and annotation"
        w:"full"
        h:96
        rounded:"lg"
        border:1
        shadow:"md"
      Code:
        language:"dowe"
        variant:"solid"
        scheme:"surface"
        copyLabel:"Copy Dowe"
        copiedLabel:"Copied"
        content:"""
          page ScenePage
            signal scene value:[
              { type:"rect" x:0 y:0 width:640 height:360 fill:"surface" },
              { type:"polyline" points:[{ x:50 y:270 } { x:355 y:125 } { x:590 y:72 }] stroke:"primary" strokeWidth:8 }
              { type:"circle" x:355 y:125 radius:18 fill:"tertiary" motion:{ pulse:0.7 } },
              { type:"text" x:36 y:48 text:"RETAINED SCENE" fill:"surfaceText" size:24 },
            ]

            Canvas scene:scene viewWidth:640 viewHeight:360 fit:"contain" label:"Layered retained scene" w:"full" h:96
        """
  Section id:"canvas-overview-model" py:{ xs:7 md:10 }
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest"
          "MENTAL MODEL"
        Title size:"3xl" weight:"black"
          "Separate scene coordinates from layout"
      Grid columns:{ xs:1 md:3 } gap:4
        Card variant:"solid" scheme:"primary" p:5 rounded:"lg"
          Grid columns:1 gap:2
            Title size:"xl" weight:"black"
              "Logical viewport"
            Text size:"sm"
              "viewWidth and viewHeight establish portable coordinates. Layout props such as w and h only size the component."
        Card variant:"solid" scheme:"secondary" p:5 rounded:"lg"
          Grid columns:1 gap:2
            Title size:"xl" weight:"black"
              "Fit transform"
            Text size:"sm"
              "contain preserves the full scene, cover fills and clips, and stretch maps both axes independently."
        Card variant:"solid" scheme:"tertiary" p:5 rounded:"lg"
          Grid columns:1 gap:2
            Title size:"xl" weight:"black"
              "Accessible equivalent"
            Text size:"sm"
              "label describes the image role. Essential data and controls must also exist as normal Dowe content."
  Section id:"canvas-overview-commands" p:{ xs:5 md:7 }
    Grid columns:1 gap:5
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest"
          "SCENE COMMANDS"
        Title size:"3xl" weight:"black"
          "Six portable primitives"
      Table:
        data:commandTypes
        variant:"solid"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"command" label:"Command" width:"1fr"
        column field:"required" label:"Required fields" width:"2fr"
        column field:"purpose" label:"Best for" width:"3fr"
  Section id:"canvas-overview-props" py:{ xs:7 md:10 }
    Grid columns:1 gap:5
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest"
          "API"
        Title size:"3xl" weight:"black"
          "Canvas props"
        Text size:"sm"
          "Canvas also accepts applicable common identity, spacing, sizing, visibility, radius, border, and shadow props."
      Table:
        data:canvasProps
        variant:"solid"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"prop" label:"Prop" width:"1.4fr"
        column field:"type" label:"Type" width:"3fr"
        column field:"defaultValue" label:"Default" width:"1.2fr"
      Flex justify:"end"
        Button href:"/docs/views/canvas/arcade" iconEnd:"alt-arrow-right"
          "Build an arcade scene"
