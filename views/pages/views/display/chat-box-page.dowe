type ChatMessage
  id:string
  role:string
  userId:string
  text:string
  status:string

page ChatBoxPage
  signal conversationMessages type:ChatMessage[] value:[
    { id:"1" role:"assistant" userId:"assistant" text:"Welcome to the Dowe workspace." status:"09:41" },
    { id:"2" role:"user" userId:"ada" text:"Show me the component contract." status:"09:42" },
    { id:"3" role:"assistant" userId:"assistant" text:"Use one messages Signal and bind the actions you need." status:"09:42" },
  ]
  signal promptMessages type:ChatMessage[] value:[
    { id:"1" role:"system" userId:"system" text:"You are reviewing a generated interface." status:"ready" },
    { id:"2" role:"user" userId:"ada" text:"Summarize the next implementation step." status:"sent" },
    { id:"3" role:"assistant" userId:"assistant" text:"Keep the source contract explicit and portable." status:"streaming" },
  ]
  signal loading value:false
  signal sending value:false
  signal streaming value:true
  signal hasMore value:true
  const chatProps:
    value:[
      { prop:"messages" type:"Signal array path" defaultValue:"required" },
      { prop:"mode" type:"conversation | prompt" defaultValue:"conversation" },
      { prop:"currentUserId" type:"string" defaultValue:"—" },
      { prop:"variant" type:"solid | soft | outlined" defaultValue:"solid" },
      { prop:"scheme" type:"Dowe design family" defaultValue:"primary" },
      { prop:"userName, userAvatar, userStatus" type:"user header values" defaultValue:"—, —, Online" },
      { prop:"assistantName, assistantAvatar" type:"assistant header values" defaultValue:"Assistant, —" },
      { prop:"showHeader, showAttachments, showVoiceNote, showCamera" type:"boolean" defaultValue:"true, true, true, false" },
      { prop:"placeholder" type:"string" defaultValue:"Type a message..." },
      { prop:"loading, sending, streaming, hasMore" type:"bool Signal paths" defaultValue:"—" },
      { prop:"onSend ... onCameraCapture" type:"Action names" defaultValue:"—" },
    ]
  fn loadOlderMessages
    reset hasMore
  fn sendMessage
    reset sending
    reset loading
  fn stopStreaming
    reset streaming
  fn handleChatTool
    reset loading
  Section id:"chat-box-introduction" py:{ xs:6 md:10 }
    Grid columns:{ xs:1 md:"1fr auto" } gap:5 align:"end"
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "DISPLAY"
        Title size:{ xs:"3xl" md:"6xl" } weight:"black"
          "ChatBox"
        Text size:"lg" color:"muted"
          "ChatBox turns a typed Signal array into a portable conversation surface with native input, status, streaming, and action states."
      Card variant:"soft" scheme:"info" p:5 rounded:"lg" minW:56
        Grid columns:1 gap:1
          Text size:"xs" weight:"bold" spacing:"widest"
            "ONE MESSAGE MODEL"
          Title size:"xl" weight:"black"
            "Conversation or prompt"
          Text size:"sm"
            "Switch alignment and labels with mode while keeping the same source data shape."
  Section id:"chat-box-playground" p:{ xs:5 md:7 }
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "PLAYGROUND"
        Title size:"3xl" weight:"black"
          "Wire a complete chat workflow"
        Text size:"sm" color:"muted"
          "The preview binds every reactive state and exposes the optional attachment, voice, camera, load-more, send, and stop actions."
      ChatBox:
        messages:conversationMessages
        mode:"conversation"
        currentUserId:"ada"
        variant:"soft"
        scheme:"primary"
        userName:"Ada"
        userAvatar:"/assets/icon.svg"
        userStatus:"Online"
        assistantName:"Dowe"
        assistantAvatar:"/assets/logo.svg"
        showHeader:true
        placeholder:"Ask about the component contract"
        showAttachments:true
        showVoiceNote:true
        showCamera:true
        loading:loading
        sending:sending
        streaming:streaming
        hasMore:hasMore
        onSend:sendMessage
        onLoadMore:loadOlderMessages
        onStop:stopStreaming
        onVoiceNote:handleChatTool
        onFileAttach:handleChatTool
        onCameraCapture:handleChatTool
      Code language:"dowe" variant:"soft" scheme:"surface" copyLabel:"Copy Dowe" copiedLabel:"Copied" content:"""
        type ChatMessage
          id:string
          role:string
          userId:string
          text:string
          status:string

        signal messages type:ChatMessage[] value:[{ id:"1" role:"assistant" userId:"assistant" text:"Welcome" status:"sent" }]
        signal loading value:false
        signal sending value:false
        signal streaming value:false
        signal hasMore value:true

        ChatBox messages:messages mode:"conversation" currentUserId:"ada" userName:"Ada" assistantName:"Dowe" loading:loading sending:sending streaming:streaming hasMore:hasMore onSend:sendMessage
      """
  Section id:"chat-box-modes" py:{ xs:7 md:10 }
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "MODES"
        Title size:"3xl" weight:"black"
          "Reuse the message contract"
        Text size:"sm" color:"muted"
          "Conversation mode aligns messages around currentUserId. Prompt mode treats user, assistant, and system roles as an assistant-oriented prompt timeline."
      Grid columns:{ xs:1 md:2 } gap:4
        Card variant:"outlined" scheme:"surface" p:{ xs:5 md:7 } rounded:"md" border:1
          Grid columns:1 gap:4
            Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
              "CONVERSATION"
            ChatBox messages:conversationMessages mode:"conversation" currentUserId:"ada" userName:"Ada" assistantName:"Dowe" variant:"outlined" scheme:"primary" showCamera:false placeholder:"Reply to the thread" onSend:sendMessage
            Text size:"sm" color:"muted"
              "Use sender identity when the screen reads like a person-to-person thread."
        Card variant:"outlined" scheme:"surface" p:{ xs:5 md:7 } rounded:"md" border:1
          Grid columns:1 gap:4
            Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
              "PROMPT"
            ChatBox messages:promptMessages mode:"prompt" currentUserId:"ada" assistantName:"Dowe" variant:"soft" scheme:"secondary" showHeader:false showAttachments:false showVoiceNote:false placeholder:"Refine the prompt" streaming:streaming onSend:sendMessage onStop:stopStreaming
            Text size:"sm" color:"muted"
              "Use role values to present an assistant workflow or generation prompt."
      Code language:"dowe" variant:"soft" scheme:"surface" copyLabel:"Copy Dowe" copiedLabel:"Copied" content:"""
        ChatBox messages:messages mode:"conversation" currentUserId:"ada" userName:"Ada" assistantName:"Dowe" onSend:sendMessage
        ChatBox messages:messages mode:"prompt" showHeader:false showAttachments:false showVoiceNote:false placeholder:"Refine the prompt"
      """
  Section id:"chat-box-actions" p:{ xs:5 md:7 }
    Grid columns:{ xs:1 md:3 } gap:4
      Card variant:"soft" scheme:"surface" p:5 rounded:"md"
        Grid columns:1 gap:2
          Text size:"xs" weight:"bold" color:"muted"
            "LOAD MORE"
          Title size:"lg" weight:"black"
            "Paginate history"
          Text size:"sm" color:"muted"
            "Bind hasMore and onLoadMore to a function that appends older rows to the messages Signal."
      Card variant:"soft" scheme:"surface" p:5 rounded:"md"
        Grid columns:1 gap:2
          Text size:"xs" weight:"bold" color:"muted"
            "STREAMING"
          Title size:"lg" weight:"black"
            "Stop deliberately"
          Text size:"sm" color:"muted"
            "When streaming is true, onStop gives the user a target-neutral escape hatch for an in-flight response."
      Card variant:"soft" scheme:"surface" p:5 rounded:"md"
        Grid columns:1 gap:2
          Text size:"xs" weight:"bold" color:"muted"
            "TOOLS"
          Title size:"lg" weight:"black"
            "Keep host actions explicit"
          Text size:"sm" color:"muted"
            "Voice, file, and camera actions are named Dowe functions; ChatBox does not assume a remote AI provider."
  Section id:"chat-box-props" py:{ xs:7 md:10 }
    Grid columns:1 gap:5
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "API"
        Title size:"3xl" weight:"black"
          "Props"
        Text size:"sm" color:"muted"
          "ChatBox also accepts common spacing, sizing, border, visibility, and accessibility props."
      Table data:chatProps variant:"soft" scheme:"surface" size:"sm" striped:true dividers:true rounded:"md"
        column field:"prop" label:"Prop" width:"1.2fr"
        column field:"type" label:"Type" width:"3fr"
        column field:"defaultValue" label:"Default" width:"1.2fr"
