page IconPage
  signal icons value:[]
  signal categories value:[]
  signal category value:"arrows"
  signal style value:"linear"
  const selectedIcon value:"route-bold-duotone"
  signal search value:""
  signal page value:1
  signal total value:0
  signal totalLabel value:"0"
  signal loading value:true
  signal hasError value:false
  const styleOptions:
    value:[
      {
        id:"broken"
        value:"broken"
        label:"Broken"
      }
      {
        id:"outline"
        value:"outline"
        label:"Outline"
      }
      {
        id:"linear"
        value:"linear"
        label:"Linear"
      }
      {
        id:"bold"
        value:"bold"
        label:"Bold"
      }
      {
        id:"line-duotone"
        value:"line-duotone"
        label:"Line duotone"
      }
      {
        id:"bold-duotone"
        value:"bold-duotone"
        label:"Bold duotone"
      }
    ]
  const iconProps:
    value:[
      {
        prop:"name"
        type:"quoted catalog name | string Signal, constant, or each-item path"
        defaultValue:"required"
      }
      {
        prop:"fill"
        type:"currentColor | Dowe color token"
        defaultValue:"currentColor"
      }
      {
        prop:"stroke"
        type:"currentColor | Dowe color token"
        defaultValue:"currentColor"
      }
      {
        prop:"w, h"
        type:"common size props"
        defaultValue:"6"
      }
    ]
  const catalogSources:
    value:[
      {
        id:"solar"
        name:"layers-line-duotone"
        fill:"primary"
        title:"Solar"
        description:"Use the base name for linear or append a canonical suffix for another Solar variant."
      }
      {
        id:"country-flags"
        name:"country-flags:US"
        fill:"currentColor"
        title:"Country flags"
        description:"Prefix the ISO country code with country-flags:. No variant prop is needed."
      }
      {
        id:"spinners"
        name:"svg-spinners:270-ring"
        fill:"accent"
        title:"SVG Spinners"
        description:"Prefix one of 46 bundled spinner names with svg-spinners:. No variant prop is needed."
      }
      {
        id:"logos"
        name:"svg-logos:github-icon"
        fill:"currentColor"
        title:"SVG Logos"
        description:"Prefix one of 1,863 bundled logo names with svg-logos: and keep its authored brand colors."
      }
    ]
  const logoNames:
    value:[
      {
        id:"github-icon"
        name:"svg-logos:github-icon"
        label:"github-icon"
      }
      {
        id:"openai"
        name:"svg-logos:openai"
        label:"openai"
      }
      {
        id:"anthropic-icon"
        name:"svg-logos:anthropic-icon"
        label:"anthropic-icon"
      }
      {
        id:"cloudflare-workers"
        name:"svg-logos:cloudflare-workers"
        label:"cloudflare-workers"
      }
      {
        id:"rust"
        name:"svg-logos:rust"
        label:"rust"
      }
      {
        id:"apple"
        name:"svg-logos:apple"
        label:"apple"
      }
      {
        id:"google"
        name:"svg-logos:google"
        label:"google"
      }
      {
        id:"docker"
        name:"svg-logos:docker"
        label:"docker"
      }
      {
        id:"figma"
        name:"svg-logos:figma"
        label:"figma"
      }
      {
        id:"model-context-protocol-icon"
        name:"svg-logos:model-context-protocol-icon"
        label:"model-context-protocol-icon"
      }
      {
        id:"vercel-icon"
        name:"svg-logos:vercel-icon"
        label:"vercel-icon"
      }
      {
        id:"vite-icon"
        name:"svg-logos:vite-icon"
        label:"vite-icon"
      }
    ]
  const spinnerOptions:
    value:[
      {
        id:"90-ring"
        name:"svg-spinners:90-ring"
        label:"90-ring"
        fill:"primary"
      }
      {
        id:"3-dots-bounce"
        name:"svg-spinners:3-dots-bounce"
        label:"3-dots-bounce"
        fill:"secondary"
      }
      {
        id:"bars-scale-middle"
        name:"svg-spinners:bars-scale-middle"
        label:"bars-scale-middle"
        fill:"accent"
      }
      {
        id:"blocks-wave"
        name:"svg-spinners:blocks-wave"
        label:"blocks-wave"
        fill:"success"
      }
      {
        id:"pulse-rings-3"
        name:"svg-spinners:pulse-rings-3"
        label:"pulse-rings-3"
        fill:"warning"
      }
      {
        id:"bouncing-ball"
        name:"svg-spinners:bouncing-ball"
        label:"bouncing-ball"
        fill:"danger"
      }
      {
        id:"wifi-fade"
        name:"svg-spinners:wifi-fade"
        label:"wifi-fade"
        fill:"info"
      }
      {
        id:"wind-toy"
        name:"svg-spinners:wind-toy"
        label:"wind-toy"
        fill:"primary"
      }
    ]
  const styleVariants:
    value:[
      {
        id:"broken"
        name:"alt-arrow-right-broken"
        fill:"primary"
        label:"broken"
      }
      {
        id:"outline"
        name:"alt-arrow-right-outline"
        fill:"primary"
        label:"outline"
      }
      {
        id:"linear"
        name:"alt-arrow-right"
        fill:"primary"
        label:"linear"
      }
      {
        id:"bold"
        name:"alt-arrow-right-bold"
        fill:"primary"
        label:"bold"
      }
      {
        id:"line-duotone"
        name:"alt-arrow-right-line-duotone"
        fill:"accent"
        label:"line-duotone"
      }
      {
        id:"bold-duotone"
        name:"alt-arrow-right-bold-duotone"
        fill:"primary"
        label:"bold-duotone"
      }
    ]
  init
    request categoriesResult method:"GET" route:"/api/icons/categories"
    if categoriesResult.ok
      set categories value:categoriesResult.data
      request result method:"GET" route:"/api/icons/:category/:style/q-:search/:page"
      if result.ok
        set icons value:result.data.data
        set total value:result.data.total
        set totalLabel source:parse.string value:result.data.total
        set loading value:false
        set hasError value:false
      else
        set loading value:false
        set hasError value:true
    else
      set loading value:false
      set hasError value:true
  fn loadIcons
    set loading value:true
    request result method:"GET" route:"/api/icons/:category/:style/q-:search/:page"
    if result.ok
      set icons value:result.data.data
      set total value:result.data.total
      set totalLabel source:parse.string value:result.data.total
      set loading value:false
      set hasError value:false
    else
      set loading value:false
      set hasError value:true
  fn applyFilters
    set page value:1
    set loading value:true
    request result method:"GET" route:"/api/icons/:category/:style/q-:search/:page"
    if result.ok
      set icons value:result.data.data
      set total value:result.data.total
      set totalLabel source:parse.string value:result.data.total
      set loading value:false
      set hasError value:false
    else
      set loading value:false
      set hasError value:true
  Section id:"icon-introduction" py:{ xs:6 md:10 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest"
          "DISPLAY"
        Title size:{ xs:"3xl" md:"6xl" } weight:"black"
          "Icon"
        Text size:"lg"
          "Icon resolves bundled Solar, country flag, animated SVG Spinner, and SVG Logos vectors before target generation."
      Flex gap:4 align:"center"
        Icon name:"alt-arrow-right-bold-duotone" fill:"primary" w:10 h:10
        Icon name:"country-flags:CO" w:10 h:10
        Icon name:"svg-spinners:3-dots-bounce" fill:"secondary" w:10 h:10
        Icon name:"svg-logos:github-icon" w:10 h:10
  Section id:"icon-catalogs" p:{ xs:5 md:7 }
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest"
          "FOUR CATALOGS"
        Title size:"3xl" weight:"black"
          "One component, namespaced sources"
        Text size:"sm"
          "Plain names resolve Solar. Country flags, SVG Spinners, and SVG Logos use explicit namespaces so completions and diagnostics stay deterministic."
      Grid columns:{ xs:1 md:2 lg:4 } gap:{ xs:3 md:4 }
        each in:catalogSources as:catalog key:catalog.id
          Card variant:"solid" p:5 border:1
            Grid columns:1 gap:3
              Icon name:catalog.name fill:catalog.fill w:9 h:9
              Title size:"lg" weight:"black"
                "{catalog.title}"
              Text size:"sm"
                "{catalog.description}"
      Code:
        language:"dowe"
        variant:"solid"
        scheme:"surface"
        copyLabel:"Copy Dowe"
        copiedLabel:"Copied"
        content:"""
          Icon name:"alt-arrow-right-bold-duotone" fill:"primary"
          Icon name:"country-flags:CO" w:8 h:8
          Icon name:"svg-spinners:3-dots-bounce" fill:"secondary" w:8 h:8
          Icon name:"svg-logos:github-icon" w:8 h:8
        """
  Section id:"icon-logos" py:{ xs:7 md:10 }
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest"
          "SVG LOGOS"
        Title size:"3xl" weight:"black"
          "Brand vectors without runtime downloads"
        Text size:"sm"
          "Choose a lower-case SVG Logos file stem with the svg-logos: namespace. Only referenced logos enter generated output."
        Text size:"sm"
          "Web and desktop preserve the validated original SVG. Native targets draw shared normalized paths with deterministic solid fallbacks for complex paints."
      Grid columns:{ xs:2 sm:3 md:4 lg:6 } gap:{ xs:3 md:4 }
        each in:logoNames as:logoName key:logoName.id
          Card variant:"solid" p:{ xs:3 md:4 }
            Flex direction:"column" gap:3 align:"center"
              Icon name:logoName.name w:10 h:10
              Text size:"xs" weight:"bold"
                "{logoName.label}"
      Code:
        language:"dowe"
        variant:"solid"
        scheme:"surface"
        copyLabel:"Copy Dowe"
        copiedLabel:"Copied"
        content:"""
          Icon name:"svg-logos:github-icon" w:10 h:10
          Icon name:"svg-logos:cloudflare-workers" w:10 h:10
        """
      Alert:
        type:"info"
        message:"SVG Logos is CC0, but logos and trademarks remain the property of their respective owners. Icon is decorative, so label the containing control or link."
        variant:"solid"
        scheme:"info"
  Section id:"icon-browser" py:{ xs:7 md:10 }
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest"
          "DOWE DATABASE CATALOG"
        Title size:"3xl" weight:"black"
          "Browse every Solar icon without bundling the catalog"
        Text size:"sm"
          "Categories and counts come from Dowe Database. The server filters and paginates normalized SVG records; this view receives at most 60 geometries and renders each one with Svg data."
        Text size:"sm"
          "The catalog is loaded by a server-only Dowe seeder. The dowe icons namespace remains dedicated to application icon assets."
      Code:
        language:"dowe"
        variant:"solid"
        scheme:"surface"
        copyLabel:"Copy command"
        copiedLabel:"Copied"
        content:"database IconDb provider:\"dowe\" host:env.DOWE_HOST port:env.DOWE_PORT account:env.DOWE_ACCOUNT secret:env.DOWE_SECRET name:\"dowe-docs-icons\" entities:[IconCategories Icons] seeders:[IconCatalog]"
      Card variant:"solid" p:{ xs:4 md:6 } border:1
        Grid columns:1 gap:6
          Grid columns:{ xs:1 sm:2 md:4 } gap:{ xs:3 md:4 } align:"end"
            Select bind:category label:"Category" placeholder:"Choose a category"
              each in:categories as:categoryOption key:categoryOption.slug
                Option value:categoryOption.slug label:categoryOption.label
            Input bind:search label:"Search" placeholder:"Icon name"
            Select bind:style label:"Style" placeholder:"Choose a style"
              each in:styleOptions as:option key:option.id
                Option value:option.value label:option.label
            Button w:"full" onClick:applyFilters iconStart:"magnifier"
              "Apply"
          Flex wrap:true justify:"between" align:"center" gap:4
            Flex direction:"column" gap:1
              Text size:"xs" weight:"bold" spacing:"widest"
                "{category}"
              Flex gap:1 align:"center"
                Text size:"xs"
                  "{totalLabel}"
                Text size:"xs"
                  "matching icons"
            Button onClick:loadIcons variant:"solid" size:"sm" iconStart:"restart"
              "Refresh"
          Text show:loading size:"sm"
            "Loading SVG geometry from Dowe Database…"
          Alert:
            type:"error"
            message:"The icon catalog could not be loaded."
            visible:hasError
            variant:"solid"
            scheme:"danger"
          Grid columns:{ xs:2 sm:3 md:4 lg:6 } gap:{ xs:3 md:4 }
            each in:icons as:icon key:icon.key
              Card variant:"solid" p:4
                Flex direction:"column" gap:3 align:"center"
                  Svg data:icon.svg color:"primary" w:12 h:12
                  Text size:"xs"
                    "{icon.name}"
          Text show:{ when:total lte:0 } size:"sm"
            "No icons match the current filters."
          Pagination:
            bind:page
            total:total
            pageSize:60
            onChange:loadIcons
            variant:"solid"
            scheme:"primary"
            size:"sm"
            ariaLabel:"Icon catalog pages"
      Alert:
        type:"info"
        message:"Runtime Svg accepts normalized Dowe vector data only. The renderer validates every viewBox, path, paint, opacity, stroke, and transform before drawing it."
        variant:"solid"
        scheme:"info"
  Section id:"icon-styles" p:{ xs:5 md:7 }
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest"
          "SOLAR VARIANTS"
        Title size:"3xl" weight:"black"
          "Six variants, canonical names"
        Text size:"sm"
          "The base name selects linear; other variants append a suffix. Duotone geometry preserves its authored secondary opacity."
      Grid columns:{ xs:2 sm:3 md:6 } gap:{ xs:3 md:4 }
        each in:styleVariants as:styleVariant key:styleVariant.id
          Flex direction:"column" gap:3 align:"center"
            Icon name:styleVariant.name fill:styleVariant.fill stroke:"primary" w:10 h:10
            Text size:"xs" weight:"bold"
              "{styleVariant.label}"
      Code:
        language:"dowe"
        variant:"solid"
        scheme:"surface"
        copyLabel:"Copy Dowe"
        copiedLabel:"Copied"
        content:"""
          Icon name:"alt-arrow-right-bold-duotone"
          Icon name:"alt-arrow-right-bold"
          Icon name:"alt-arrow-right-broken"
        """
  Section id:"icon-spinners" py:{ xs:7 md:10 }
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest"
          "LOADING MOTION"
        Title size:"3xl" weight:"black"
          "Choose a spinner by visual rhythm"
        Text size:"sm"
          "Web and desktop preserve validated upstream CSS. Android and iOS draw the same portable fallback paths with native continuous motion."
      Grid columns:{ xs:2 sm:3 md:4 } gap:{ xs:3 md:4 }
        each in:spinnerOptions as:spinner key:spinner.id
          Card variant:"solid" p:{ xs:3 md:4 }
            Flex direction:"column" gap:3 align:"center"
              Icon name:spinner.name fill:spinner.fill w:9 h:9
              Text size:"xs" weight:"bold"
                "{spinner.label}"
  Section id:"icon-contract" p:{ xs:5 md:7 }
    Grid columns:1 gap:5
      Text size:"xs" weight:"bold" spacing:"widest"
        "AUTHORING CONTRACT"
      Title size:"3xl" weight:"black"
        "Catalog selection, decorative semantics"
      Table data:iconProps variant:"solid" scheme:"surface" size:"sm"
        column field:"prop" label:"Prop"
        column field:"type" label:"Accepted value"
        column field:"defaultValue" label:"Default"
      Flex gap:4 align:"center"
        Icon name:selectedIcon fill:"primary" w:10 h:10
        Text size:"sm"
          "A string Signal or each-item path can switch among the shared catalog; immutable const collections preload only their literal names, unrelated mutable lists do not expand the catalog, and invalid runtime values use the validated initial icon."
      Alert:
        type:"info"
        message:"Icon is decorative. Pair a loading spinner with visible status text or an accessible labeled control. Reduced-motion preferences stop or suppress continuous motion."
        variant:"solid"
        scheme:"info"
