page IconPage
  signal icons value:[]
  signal category value:"arrows"
  signal style value:"linear"
  signal search value:""
  signal page value:1
  signal total value:0
  signal loading value:true
  signal hasError value:false
  const styleOptions:
    value:[
      { id:"broken" value:"broken" label:"Broken" },
      { id:"outline" value:"outline" label:"Outline" },
      { id:"linear" value:"linear" label:"Linear" },
      { id:"bold" value:"bold" label:"Bold" },
      { id:"line-duotone" value:"line-duotone" label:"Line duotone" },
      { id:"bold-duotone" value:"bold-duotone" label:"Bold duotone" },
    ]
  const iconProps:
    value:[
      { prop:"name" type:"Solar variant | country-flags:* | svg-spinners:* | svg-logos:*" defaultValue:"required" },
      { prop:"fill" type:"currentColor | Dowe color token" defaultValue:"currentColor" },
      { prop:"stroke" type:"currentColor | Dowe color token" defaultValue:"currentColor" },
      { prop:"w, h" type:"common size props" defaultValue:"6" },
    ]
  init
    request result method:"GET" route:"/api/icons/:category/:style/q-:search/:page"
    if result.ok
      set icons value:result.data.data
      set total value:result.data.total
      set loading value:false
      set hasError value:false
    else
      set loading value:false
      set hasError value:true
  fn loadIcons
    set loading value:true
    request result method:"GET" route:"/api/icons/:category/:style/q-:search/:page"
    if result.ok
      set icons value:result.data.data
      set total value:result.data.total
      set loading value:false
      set hasError value:false
    else
      set loading value:false
      set hasError value:true
  fn applyFilters
    set page value:1
    set loading value:true
    request result method:"GET" route:"/api/icons/:category/:style/q-:search/:page"
    if result.ok
      set icons value:result.data.data
      set total value:result.data.total
      set loading value:false
      set hasError value:false
    else
      set loading value:false
      set hasError value:true
  fn selectArrows
    set category value:"arrows"
    set page value:1
    request result method:"GET" route:"/api/icons/:category/:style/q-:search/:page"
    if result.ok
      set icons value:result.data.data
      set total value:result.data.total
    else
      set hasError value:true
