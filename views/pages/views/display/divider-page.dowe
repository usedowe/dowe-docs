        Flex direction:{ xs:"column" md:"row" } align:"center" gap:4
          Flex direction:"column" gap:1
            Text size:"xs" weight:"bold"
              "FILTER"
            Text weight:"bold"
              "All records"
          Divider orientation:"vertical" scheme:"muted" h:12
          Flex direction:"column" gap:1
            Text size:"xs" weight:"bold"
              "SORT"
            Text weight:"bold"
              "Recently updated"
          Divider orientation:"vertical" scheme:"secondary" h:12
          Flex direction:"column" gap:1
            Text size:"xs" weight:"bold"
              "STATUS"
            Text weight:"bold"
              "Synchronized"
      Grid columns:{ xs:1 md:2 } gap:4
        Card variant:"outlined" p:5 border:1
          Grid columns:1 gap:3
            Text size:"xs" weight:"bold"
              "SECTION RHYTHM"
            Title size:"lg" weight:"black"
              "Explicit boundaries"
            Divider scheme:"muted"
            Text size:"sm"
              "Use the page Section and Grid gap for rhythm, then place Divider only where the line itself carries meaning."
        Card variant:"outlined" p:5 border:1
          Grid columns:1 gap:3
            Text size:"xs" weight:"bold"
              "TOKEN COLORS"
            Title size:"lg" weight:"black"
              "Semantic emphasis"
