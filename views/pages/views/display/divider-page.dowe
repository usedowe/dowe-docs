  Section id:"divider-contract" p:{ xs:5 md:7 }
    Grid columns:{ xs:1 md:3 } gap:4
      Flex direction:"column" gap:2
        Text size:"xs" weight:"bold"
          "HORIZONTAL"
        Title size:"lg" weight:"black"
          "Width follows the parent"
        Text size:"sm"
          "Use the parent layout to define horizontal padding and gap."
      Flex direction:"column" gap:2
        Text size:"xs" weight:"bold"
          "VERTICAL"
        Title size:"lg" weight:"black"
          "Height is intentional"
        Text size:"sm"
          "Set h when a vertical line sits beside content with no shared intrinsic height."
      Flex direction:"column" gap:2
        Text size:"xs" weight:"bold"
          "PORTABLE"
        Title size:"lg" weight:"black"
          "No children"
        Text size:"sm"
          "Divider is a leaf component; it never owns content or an implicit spacer."
