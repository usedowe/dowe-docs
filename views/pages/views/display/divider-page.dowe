page DividerPage
  const dividerProps:
    value:[
      { prop:"orientation" type:"horizontal | vertical" defaultValue:"horizontal" },
      { prop:"scheme" type:"primary | secondary | tertiary | muted | background | surface | success | info | warning | danger" defaultValue:"muted" },
      { prop:"show" type:"bool Signal or responsive visibility" defaultValue:"true" },
      { prop:"spacing, sizing, rounded, border" type:"common style props" defaultValue:"—" },
    ]
  Section id:"divider-introduction" py:{ xs:6 md:10 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest"
          "DISPLAY"
        Title size:{ xs:"3xl" md:"6xl" } weight:"black"
          "Divider"
        Text size:"lg"
          "Divider creates an intentional visual boundary without adding hidden layout or spacing assumptions."
      Card variant:"solid" scheme:"muted" p:5 rounded:"lg" minW:56
        Grid columns:1 gap:1
          Text size:"xs" weight:"bold" spacing:"widest"
            "ONE LINE, TWO AXES"
          Title size:"xl" weight:"black"
            "Keep structure visible"
          Text size:"sm"
            "Choose horizontal for sections and vertical for compact toolbars or split panels."
  Section id:"divider-playground" p:{ xs:5 md:7 }
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest"
          "PLAYGROUND"
        Title size:"3xl" weight:"black"
          "Compare orientation and scheme"
        Text size:"sm"
          "Horizontal lines fill the available width. Vertical lines fill the authored height, so pair them with an explicit h when the surrounding content has no intrinsic height."
      Card variant:"outlined" p:{ xs:6 md:9 } border:1
        Grid columns:1 gap:5
          Text weight:"bold"
            "Horizontal content boundary"
          Text size:"sm"
            "The divider separates two semantic bands while the Grid owns the gap around them."
          Divider orientation:"horizontal" scheme:"primary"
          Text size:"sm"
            "Continue with the next section of the workflow."
      Code language:"dowe" variant:"solid" scheme:"surface" copyLabel:"Copy Dowe" copiedLabel:"Copied" content:"""
        Divider orientation:"horizontal" scheme:"primary"
        Divider orientation:"vertical" scheme:"secondary" h:12
      """
  Section id:"divider-layouts" py:{ xs:7 md:10 }
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest"
          "ADVANCED LAYOUTS"
        Title size:"3xl" weight:"black"
          "Compose a split toolbar"
        Text size:"sm"
          "Divider is deliberately neutral: parent Flex or Grid owns alignment, spacing, and responsive behavior."
