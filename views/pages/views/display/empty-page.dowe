page EmptyPage
  signal recoveryReady value:true
  fn retrySearch
    reset recoveryReady
  fn openTemplate
    reset recoveryReady
  const emptyProps:
    value:[
      { prop:"type" type:"playlist | result | data | template" defaultValue:"template" },
      { prop:"title" type:"static string" defaultValue:"—" },
      { prop:"description" type:"static string" defaultValue:"—" },
      { prop:"actionLabel" type:"static string" defaultValue:"View more" },
      { prop:"href, target, externalMode" type:"navigation props" defaultValue:"—" },
      { prop:"onClick" type:"Action name" defaultValue:"—" },
      { prop:"variant, scheme" type:"solid | soft | outlined | ghost, Dowe family" defaultValue:"soft, primary" },
    ]
  Section id:"empty-introduction" py:{ xs:6 md:10 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "DISPLAY"
        Title size:{ xs:"3xl" md:"6xl" } weight:"black"
          "Empty"
        Text size:"lg" color:"muted"
          "Empty gives a missing-data workflow a clear illustration, useful copy, and one explicit next action."
      Empty type:"result" title:"No saved views" description:"Create a view to keep this workspace close at hand." actionLabel:"Create a view" variant:"soft" scheme:"primary" onClick:openTemplate
  Section id:"empty-playground" p:{ xs:5 md:7 }
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "PLAYGROUND"
        Title size:"3xl" weight:"black"
          "Match the illustration to the job"
        Text size:"sm" color:"muted"
          "The type selects a portable illustration family. Keep the title and description specific, then choose either navigation or an action for the recovery path."
      Grid columns:1 gap:4
        Card variant:"outlined" p:{ xs:5 md:7 } border:1
          Grid columns:1 gap:4
            Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
              "SEARCH"
            Empty type:"result" title:"No matching projects" description:"Try a broader query or reset the filters." actionLabel:"Reset filters" variant:"soft" scheme:"info" onClick:retrySearch
        Card variant:"outlined" p:{ xs:5 md:7 } border:1
          Grid columns:1 gap:4
            Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
              "TEMPLATE"
            Empty type:"template" title:"Start from a template" description:"Choose a starter surface before adding your own content." actionLabel:"Browse templates" href:"/docs/views" variant:"outlined" scheme:"secondary"
      Code language:"dowe" variant:"soft" scheme:"surface" copyLabel:"Copy Dowe" copiedLabel:"Copied" content:"""
        Empty type:"result" title:"No matching projects" description:"Try a broader query or reset the filters." actionLabel:"Reset filters" onClick:retrySearch
        Empty type:"template" title:"Start from a template" description:"Choose a starter surface before adding your own content." actionLabel:"Browse templates" href:"/docs/views"
      """
  Section id:"empty-types" py:{ xs:7 md:10 }
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "ILLUSTRATION TYPES"
        Title size:"3xl" weight:"black"
          "Four states, one recovery pattern"
        Text size:"sm" color:"muted"
          "Use the type as a semantic hint rather than a visual hack. The same action contract works for lists, search, datasets, and starter surfaces."
      Grid columns:1 gap:4
        Empty type:"playlist" title:"No playlist yet" description:"Save content to build a queue." actionLabel:"Add content" scheme:"primary" variant:"soft" onClick:openTemplate
        Empty type:"result" title:"No results" description:"Change the query and search again." actionLabel:"Search again" scheme:"info" variant:"soft" onClick:retrySearch
        Empty type:"data" title:"No data" description:"Connect a source to populate this view." actionLabel:"Connect source" scheme:"success" variant:"outlined" onClick:openTemplate
        Empty type:"template" title:"No template selected" description:"Pick a starting point for this page." actionLabel:"Choose template" scheme:"secondary" variant:"ghost" href:"/docs/views"
      Code language:"dowe" variant:"soft" scheme:"surface" copyLabel:"Copy Dowe" copiedLabel:"Copied" content:"""
        Empty type:"playlist" title:"No playlist yet" description:"Save content to build a queue." actionLabel:"Add content"
        Empty type:"result" title:"No results" description:"Change the query and search again." actionLabel:"Search again"
        Empty type:"data" title:"No data" description:"Connect a source to populate this view." actionLabel:"Connect source"
        Empty type:"template" title:"No template selected" description:"Pick a starting point for this page." actionLabel:"Choose template"
      """
  Section id:"empty-workflows" p:{ xs:5 md:7 }
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "ADVANCED WORKFLOWS"
        Title size:"3xl" weight:"black"
          "Make the next step obvious"
      Grid columns:1 gap:4
        Card variant:"soft" p:5
          Grid columns:1 gap:2
            Text size:"xs" weight:"bold" color:"muted"
              "FILTERED COLLECTION"
            Title size:"lg" weight:"black"
              "Reset, do not dead-end"
            Text size:"sm" color:"muted"
              "Use onClick when the parent page owns a local reset or query mutation."
        Card variant:"soft" p:5
          Grid columns:1 gap:2
            Text size:"xs" weight:"bold" color:"muted"
              "NEW SURFACE"
            Title size:"lg" weight:"black"
              "Navigate to a builder"
            Text size:"sm" color:"muted"
              "Use href when the recovery step is a route and does not need local state."
        Card variant:"soft" p:5
          Grid columns:1 gap:2
            Text size:"xs" weight:"bold" color:"muted"
              "COPY"
            Title size:"lg" weight:"black"
              "Name the absence"
            Text size:"sm" color:"muted"
              "A specific title and description help people understand whether to wait, search, create, or connect."
  Section id:"empty-props" py:{ xs:7 md:10 }
    Grid columns:1 gap:5
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "API"
        Title size:"3xl" weight:"black"
          "Props"
        Text size:"sm" color:"muted"
          "Empty also accepts common spacing, sizing, visibility, border, radius, and accessibility props."
      Table data:emptyProps variant:"soft" scheme:"surface" size:"sm" striped:true dividers:true rounded:"md"
        column field:"prop" label:"Prop" width:"1.2fr"
        column field:"type" label:"Type" width:"3fr"
        column field:"defaultValue" label:"Default" width:"1.2fr"
