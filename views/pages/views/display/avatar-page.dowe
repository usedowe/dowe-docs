page AvatarPage
  const avatarProps:
    value:[
      { prop:"src" type:"asset path | https URL" defaultValue:"—" },
      { prop:"name" type:"string" defaultValue:"—" },
      { prop:"alt" type:"string" defaultValue:"Avatar" },
      { prop:"variant" type:"solid | soft" defaultValue:"solid" },
      { prop:"scheme" type:"primary | secondary | tertiary | muted | background | surface | success | info | warning | danger" defaultValue:"primary" },
      { prop:"size" type:"xs | sm | md | lg | xl" defaultValue:"md" },
      { prop:"status" type:"online | offline | busy | away" defaultValue:"—" },
      { prop:"bordered" type:"boolean" defaultValue:"false" },
      { prop:"href" type:"string" defaultValue:"—" },
      { prop:"onClick" type:"Action name" defaultValue:"—" },
    ]
  Section id:"avatar-introduction" py:{ xs:6 md:10 }
    Grid columns:{ xs:1 md:"1fr auto" } gap:5 align:"end"
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "DISPLAY"
        Title size:{ xs:"3xl" md:"6xl" } weight:"black"
          "Avatar"
        Text size:"lg" color:"muted"
          "Avatars identify people and entities with an image, initials, or a portable icon."
      Avatar src:"https://images.unsplash.com/photo-1494790108377-be9c29b29330?auto=format&fit=crop&w=160&q=80" name:"Maya Chen" alt:"Portrait of Maya Chen" size:"xl" status:"online" bordered:true
  Section id:"avatar-images" p:{ xs:5 md:7 }
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "IMAGES"
        Title size:"3xl" weight:"black"
          "Profiles with clear fallbacks"
        Text size:"sm" color:"muted"
          "Use a packaged asset or an HTTPS image. Android loads both through its cached native image pipeline; when loading fails, Dowe falls back to initials resolved from name and then alt."
      Card variant:"outlined" scheme:"surface" p:{ xs:6 md:8 } rounded:"md" border:1
        Flex wrap:true justify:"center" align:"center" gap:6
          Avatar src:"https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=160&q=80" name:"Nora Kim" alt:"Portrait of Nora Kim" size:"xl" status:"online"
          Avatar src:"https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&w=160&q=80" name:"Leo Martin" alt:"Portrait of Leo Martin" size:"lg" status:"busy" bordered:true
          Avatar src:"https://images.unsplash.com/photo-1531123897727-8f129e1688ce?auto=format&fit=crop&w=160&q=80" name:"Amara Okafor" alt:"Portrait of Amara Okafor" size:"md" status:"away"
      Code:
        language:"dowe"
        variant:"soft"
        scheme:"surface"
        copyLabel:"Copy Dowe"
        copiedLabel:"Copied"
        content:"""
          Avatar src:"assets/people/maya.webp" name:"Maya Chen" alt:"Portrait of Maya Chen" size:"xl" status:"online" bordered:true
        """
  Section id:"avatar-fallbacks" py:{ xs:7 md:10 }
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "FALLBACKS"
        Title size:"3xl" weight:"black"
          "Initials stay recognizable"
        Text size:"sm" color:"muted"
          "Without src, Avatar renders initials from name. Variant and scheme keep the fallback aligned with the design system."
      Flex wrap:true justify:"center" align:"center" gap:4
        Avatar name:"Ada Lovelace" alt:"Ada Lovelace" variant:"solid" scheme:"primary" size:"xl"
        Avatar name:"Grace Hopper" alt:"Grace Hopper" variant:"soft" scheme:"secondary" size:"lg"
        Avatar name:"Linus Torvalds" alt:"Linus Torvalds" variant:"soft" scheme:"success" size:"md"
        Avatar name:"Margaret Hamilton" alt:"Margaret Hamilton" variant:"solid" scheme:"tertiary" size:"sm"
        Avatar name:"Alan Turing" alt:"Alan Turing" variant:"soft" scheme:"muted" size:"xs"
  Section id:"avatar-priority" p:{ xs:5 md:7 }
    Grid columns:1 gap:5
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "CONTENT PRIORITY"
        Title size:"3xl" weight:"black"
          "Image, icon, then initials"
        Text size:"sm" color:"muted"
          "A valid src has priority over the icon region. Without either, Dowe derives initials from name and alt."
      Code:
        language:"dowe"
        variant:"soft"
        scheme:"surface"
        copyLabel:"Copy Dowe"
        copiedLabel:"Copied"
        content:"""
          Avatar name:"Dowe Agent" alt:"Dowe Agent" variant:"soft" scheme:"info" size:"lg"
            icon
              Svg viewBox:"0 0 24 24" w:6 h:6
                Path d:"M12 2a5 5 0 0 0-5 5v3H5v12h14V10h-2V7a5 5 0 0 0-5-5Z" fill:"currentColor"
        """
  Section id:"avatar-props" py:{ xs:7 md:10 }
    Grid columns:1 gap:5
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "API"
        Title size:"3xl" weight:"black"
          "Props"
        Text size:"sm" color:"muted"
          "Avatar also accepts navigation, visibility, sizing, spacing, grid placement, and applicable common style props."
      Table:
        data:avatarProps
        variant:"soft"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"prop" label:"Prop" width:"1fr"
        column field:"type" label:"Type" width:"3fr"
        column field:"defaultValue" label:"Default" width:"1fr"
