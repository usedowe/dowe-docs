page BadgePage
  const badgeProps:
    value:[
      { prop:"text" type:"static string" defaultValue:"required" },
      { prop:"position" type:"top-left | top-right | bottom-left | bottom-right" defaultValue:"top-right" },
      { prop:"variant" type:"solid | soft" defaultValue:"solid" },
      { prop:"scheme" type:"primary | secondary | tertiary | muted | background | surface | success | info | warning | danger" defaultValue:"primary" },
      { prop:"children" type:"one or more view children" defaultValue:"required" },
    ]
  Section id:"badge-introduction" py:{ xs:6 md:10 }
    Grid columns:{ xs:1 md:"1fr auto" } gap:6 align:"end"
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "DISPLAY"
        Title size:{ xs:"3xl" md:"6xl" } weight:"black"
          "Badge"
        Text size:"lg" color:"muted"
          "Badge adds a compact count or status to a child without changing the child’s measured size or interaction."
      Flex direction:"column" align:"center" justify:"center" p:6 minW:32 minH:24
        Badge text:"Live" scheme:"success" variant:"soft" position:"top-right"
          Avatar name:"Dowe" size:"xl" scheme:"primary" bordered:true
  Section id:"badge-playground" p:{ xs:5 md:7 }
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "PLAYGROUND"
        Title size:"3xl" weight:"black"
          "Add context without covering the control"
        Text size:"sm" color:"muted"
          "Each example gets enough breathing room for the label to sit across the child’s corner on web, Android, and iOS."
      Grid columns:{ xs:1 md:3 } gap:4
        Card variant:"outlined" rounded:"lg" border:1 p:7 minH:36
          Flex direction:"column" align:"center" justify:"between" gap:6 minH:24
            Badge text:"3" scheme:"danger" position:"top-right"
              Avatar name:"Ada" size:"xl" scheme:"secondary" bordered:true
            Grid columns:1 gap:1
              Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
                "COUNT"
              Text size:"sm" color:"muted"
                "Keep numeric alerts short."
        Card variant:"outlined" rounded:"lg" border:1 p:7 minH:36
          Flex direction:"column" align:"center" justify:"between" gap:6 minH:24
            Badge text:"New" scheme:"success" variant:"soft" position:"bottom-right"
              Button variant:"soft" iconStart:"inbox"
                "Inbox"
            Grid columns:1 gap:1
              Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
                "STATUS"
              Text size:"sm" color:"muted"
                "Use soft for quiet metadata."
        Card variant:"outlined" rounded:"lg" border:1 p:7 minH:36
          Flex direction:"column" align:"center" justify:"between" gap:6 minH:24
            Badge text:"Beta" scheme:"info" variant:"soft" position:"top-left"
              Button scheme:"muted" size:"lg"
                "Command"
            Grid columns:1 gap:1
              Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
                "LABEL"
              Text size:"sm" color:"muted"
                "Prefer one short word."
      Code:
        language:"dowe"
        variant:"soft"
        scheme:"surface"
        copyLabel:"Copy Dowe"
        copiedLabel:"Copied"
        content:"""
          Badge text:"3" scheme:"danger" position:"top-right"
            Avatar name:"Ada" size:"xl" scheme:"secondary" bordered:true

          Badge text:"New" scheme:"success" variant:"soft" position:"bottom-right"
            Button variant:"soft" iconStart:"inbox"
              "Inbox"

          Badge text:"Beta" scheme:"info" variant:"soft" position:"top-left"
            Button scheme:"muted" size:"lg"
              "Command"
        """
  Section id:"badge-positions" py:{ xs:7 md:10 }
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "POSITION"
        Title size:"3xl" weight:"black"
          "Choose one of four corners"
        Text size:"sm" color:"muted"
          "The center of the capsule anchors to the selected corner, so the label remains legible without shifting the wrapped view."
      Grid columns:{ xs:1 sm:2 md:4 } gap:4
        Card variant:"soft" scheme:"muted" p:7 rounded:"lg" minH:32
          Flex direction:"column" align:"center" justify:"center" gap:5 minH:20
            Badge text:"TL" scheme:"primary" position:"top-left"
              Button variant:"soft" scheme:"muted"
                "Target"
            Text size:"xs" weight:"bold"
              "TOP LEFT"
        Card variant:"soft" scheme:"muted" p:7 rounded:"lg" minH:32
          Flex direction:"column" align:"center" justify:"center" gap:5 minH:20
            Badge text:"TR" scheme:"secondary" position:"top-right"
              Button variant:"soft" scheme:"muted"
                "Target"
            Text size:"xs" weight:"bold"
              "TOP RIGHT"
        Card variant:"soft" scheme:"muted" p:7 rounded:"lg" minH:32
          Flex direction:"column" align:"center" justify:"center" gap:5 minH:20
            Badge text:"BL" scheme:"tertiary" position:"bottom-left"
              Button variant:"soft" scheme:"muted"
                "Target"
            Text size:"xs" weight:"bold"
              "BOTTOM LEFT"
        Card variant:"soft" scheme:"muted" p:7 rounded:"lg" minH:32
          Flex direction:"column" align:"center" justify:"center" gap:5 minH:20
            Badge text:"BR" scheme:"danger" position:"bottom-right"
              Button variant:"soft" scheme:"muted"
                "Target"
            Text size:"xs" weight:"bold"
              "BOTTOM RIGHT"
  Section id:"badge-guidance" p:{ xs:5 md:7 }
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "USAGE"
        Title size:"3xl" weight:"black"
          "Keep the child primary"
        Text size:"sm" color:"muted"
          "A Badge should clarify an existing view, not become a second control or a paragraph of content."
      Grid columns:{ xs:1 md:3 } gap:4
        Card variant:"soft" scheme:"success" p:5 rounded:"lg"
          Grid columns:1 gap:2
            Text size:"xs" weight:"bold" spacing:"widest"
              "DO"
            Title size:"lg" weight:"black"
              "Use semantic schemes"
            Text size:"sm"
              "Choose danger for attention, success for completion, and info for contextual labels."
        Card variant:"soft" scheme:"info" p:5 rounded:"lg"
          Grid columns:1 gap:2
            Text size:"xs" weight:"bold" spacing:"widest"
              "DO"
            Title size:"lg" weight:"black"
              "Keep text compact"
            Text size:"sm"
              "Use a count, symbol, or short status word that can remain on one line."
        Card variant:"soft" scheme:"warning" p:5 rounded:"lg"
          Grid columns:1 gap:2
            Text size:"xs" weight:"bold" spacing:"widest"
              "AVOID"
            Title size:"lg" weight:"black"
              "Do not hide the target"
            Text size:"sm"
              "Leave enough surrounding space for the capsule and keep essential content away from the chosen corner."
  Section id:"badge-parity" py:{ xs:7 md:10 }
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "TARGET PARITY"
        Title size:"3xl" weight:"black"
          "One source, the same overlay"
        Text size:"sm" color:"muted"
          "Dowe lowers the same Badge tree into target-owned layout primitives while preserving label metrics, scheme, variant, and corner."
      Grid columns:{ xs:1 md:3 } gap:4
        Card variant:"outlined" rounded:"lg" border:1 p:5
          Grid columns:1 gap:2
            Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
              "WEB"
            Title size:"lg" weight:"black"
              "Positioned overlay"
            Text size:"sm" color:"muted"
              "The wrapper keeps the child’s intrinsic size and paints the capsule above its selected corner."
        Card variant:"outlined" rounded:"lg" border:1 p:5
          Grid columns:1 gap:2
            Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
              "ANDROID"
            Title size:"lg" weight:"black"
              "Compose Box overlay"
            Text size:"sm" color:"muted"
              "Jetpack Compose measures the child first, then offsets the capsule by half of its own size."
        Card variant:"outlined" rounded:"lg" border:1 p:5
          Grid columns:1 gap:2
            Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
              "IOS"
            Title size:"lg" weight:"black"
              "SwiftUI aligned overlay"
            Text size:"sm" color:"muted"
              "SwiftUI aligns the capsule center to the same corner without changing the content frame."
  Section id:"badge-props" py:{ xs:7 md:10 }
    Grid columns:1 gap:5
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "API"
        Title size:"3xl" weight:"black"
          "Props"
        Text size:"sm" color:"muted"
          "Badge also accepts the applicable common spacing, sizing, visibility, and accessibility props on its wrapper."
      Table:
        data:badgeProps
        variant:"soft"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"prop" label:"Prop" width:"1fr"
        column field:"type" label:"Type" width:"3fr"
        column field:"defaultValue" label:"Default" width:"1fr"
  Section id:"badge-next" p:{ xs:5 md:7 }
    Flex wrap:true justify:"between" gap:4
      Button href:"/docs/views/display/avatar-group" variant:"outlined" rounded:"full"
        "Previous AvatarGroup"
      Button href:"/docs/views/display/collapsible" rounded:"full"
        "Next Collapsible"
