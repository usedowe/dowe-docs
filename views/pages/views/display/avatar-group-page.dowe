page AvatarGroupPage
  signal team value:[
    { src:"https://images.unsplash.com/photo-1494790108377-be9c29b29330?auto=format&fit=crop&w=96&q=80" name:"Maya" alt:"Maya Chen" },
    { src:"https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&w=96&q=80" name:"Leo" alt:"Leo Martin" },
    { name:"Amara" alt:"Amara Okafor" },
    { name:"Lin" alt:"Lin Park" },
    { name:"Dowe" alt:"Dowe Agent" },
  ]
  const avatarGroupProps:
    value:[
      { prop:"items" type:"Signal array path" defaultValue:"—" },
      { prop:"item" type:"src, name, alt, navigation or action" defaultValue:"optional" },
      { prop:"size" type:"xs | sm | md | lg | xl" defaultValue:"md" },
      { prop:"max" type:"positive integer" defaultValue:"—" },
      { prop:"autoFit" type:"boolean" defaultValue:"false" },
      { prop:"inline" type:"boolean" defaultValue:"false" },
      { prop:"bordered" type:"boolean" defaultValue:"false" },
      { prop:"variant, scheme" type:"solid; design family" defaultValue:"solid; primary" },
    ]
  Section id:"avatar-group-introduction" py:{ xs:6 md:10 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest"
          "DISPLAY"
        Title size:{ xs:"3xl" md:"6xl" } weight:"black"
          "AvatarGroup"
        Text size:"lg"
          "AvatarGroup renders a stack or inline collection of identities from static item entries or a Signal-backed array, with a deterministic overflow counter."
      AvatarGroup items:team size:"lg" max:4 bordered:true variant:"solid" scheme:"primary"
  Section id:"avatar-group-playground" p:{ xs:5 md:7 }
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest"
          "PLAYGROUND"
        Title size:"3xl" weight:"black"
          "Show a live project roster"
        Text size:"sm"
          "Use items when the collection already lives in page state. max keeps the header compact without throwing away the complete source array."
      Card variant:"solid" border:1 p:{ xs:5 md:7 }
        Grid columns:1 gap:5
          Grid columns:1 gap:2
            Text size:"xs" weight:"bold" spacing:"widest"
              "SIGNAL ARRAY"
            Title size:"xl" weight:"black"
              "Design systems guild"
            Text size:"sm"
              "The fifth person becomes an overflow counter when max is four on web, Android, and iOS."
          AvatarGroup items:team size:"xl" max:4 bordered:true variant:"solid" scheme:"primary"
          Code:
            language:"dowe"
            variant:"solid"
            scheme:"surface"
            copyLabel:"Copy Dowe"
            copiedLabel:"Copied"
            content:"""
              signal team value:[
                { name:"Maya" alt:"Maya Chen" },
                { name:"Leo" alt:"Leo Martin" },
                { name:"Amara" alt:"Amara Okafor" },
                { name:"Lin" alt:"Lin Park" },
              ]
              AvatarGroup items:team size:"xl" max:4 bordered:true variant:"solid" scheme:"primary"
            """
  Section id:"avatar-group-patterns" py:{ xs:7 md:10 }
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest"
          "ADVANCED PATTERNS"
        Title size:"3xl" weight:"black"
          "Choose the right density"
        Text size:"sm"
          "Stacked groups communicate membership; inline groups work better inside metadata rows and compact headers."
      Grid columns:{ xs:1 md:3 } gap:4
        Card variant:"solid" p:5
          Grid columns:1 gap:3
            Text size:"xs" weight:"bold"
              "STACKED"
            Title size:"lg" weight:"black"
              "Project collaborators"
            AvatarGroup size:"lg" max:3 bordered:true variant:"solid" scheme:"secondary"
              item name:"Ada" alt:"Ada Lovelace"
              item name:"Grace" alt:"Grace Hopper"
              item name:"Linus" alt:"Linus Torvalds"
              item name:"Margaret" alt:"Margaret Hamilton"
        Card variant:"solid" p:5
          Grid columns:1 gap:3
            Text size:"xs" weight:"bold"
              "INLINE"
            Title size:"lg" weight:"black"
              "Review participants"
            AvatarGroup size:"sm" inline:true variant:"solid" scheme:"success"
              item name:"Maya" alt:"Maya Chen"
              item name:"Leo" alt:"Leo Martin"
              item name:"Dowe" alt:"Dowe Agent"
        Card variant:"solid" p:5
          Grid columns:1 gap:3
            Text size:"xs" weight:"bold"
              "AUTO FIT"
            Title size:"lg" weight:"black"
              "Responsive header"
            AvatarGroup items:team size:"md" autoFit:true bordered:true variant:"solid" scheme:"info"
      Code:
        language:"dowe"
        variant:"solid"
        scheme:"surface"
        copyLabel:"Copy Dowe"
        copiedLabel:"Copied"
        content:"""
          AvatarGroup size:"lg" max:3 bordered:true variant:"solid" scheme:"secondary"
            item name:"Ada" alt:"Ada Lovelace"
            item name:"Grace" alt:"Grace Hopper"
            item name:"Linus" alt:"Linus Torvalds"
            item name:"Margaret" alt:"Margaret Hamilton"

          AvatarGroup size:"sm" inline:true variant:"solid" scheme:"success"
            item name:"Maya" alt:"Maya Chen"
            item name:"Leo" alt:"Leo Martin"
            item name:"Dowe" alt:"Dowe Agent"
        """
  Section id:"avatar-group-contract" p:{ xs:5 md:7 }
    Grid columns:{ xs:1 md:2 } gap:4
      Flex direction:"column" gap:2
        Text size:"xs" weight:"bold" spacing:"widest"
          "FALLBACKS"
        Title size:"xl" weight:"black"
          "Image, then initials"
        Text size:"sm"
          "A valid HTTPS or packaged local src wins first; without it, name and alt keep the identity recognizable on every target."
      Flex direction:"column" gap:2
        Text size:"xs" weight:"bold" spacing:"widest"
          "INTERACTION"
        Title size:"xl" weight:"black"
          "Items can navigate"
        Text size:"sm"
          "Static item entries also accept href, target, externalMode, and onClick when an identity should act as a link or action."
  Section id:"avatar-group-props" py:{ xs:7 md:10 }
    Grid columns:1 gap:5
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest"
          "API"
        Title size:"3xl" weight:"black"
          "Props"
        Text size:"sm"
          "AvatarGroup also accepts the applicable common spacing, sizing, border, visibility, and accessibility props."
      Table:
        data:avatarGroupProps
        variant:"solid"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"prop" label:"Prop" width:"1fr"
        column field:"type" label:"Type" width:"3fr"
        column field:"defaultValue" label:"Default" width:"1fr"
  Section id:"avatar-group-next" p:{ xs:5 md:7 }
    Flex wrap:true justify:"between" gap:4
      Button href:"/docs/views/display/avatar" variant:"solid" rounded:"full"
        "Previous Avatar"
      Button href:"/docs/views/display/badge" rounded:"full"
        "Next Badge"
