              Title size:"2xl"
                "Featured area"
            Section background:"slate"
              Text
                "Supporting area"
        """
  Section id:"section-props" py:{ xs:7 md:10 }
    Grid columns:1 gap:5
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest"
          "API"
        Title size:"3xl" weight:"black"
          "Props"
        Text size:"sm"
          "Section also accepts font, foreground and background colors, sizing, radius, border, and applicable common container props."
      Table:
