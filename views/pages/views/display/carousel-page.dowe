page CarouselPage
  const carouselProps:
    value:[
      {
        prop:"variant"
        type:"simple | snapping | masonry | rtl | sticky | controls | dots | thumbnails | coverFlow | slideshow | stories | smartStack | cardStack | flipbook"
        defaultValue:"simple"
      },
      {
        prop:"scheme"
        type:"primary | secondary | tertiary | muted | success | info | warning | danger"
        defaultValue:"primary"
      },
      {
        prop:"orientation"
        type:"horizontal | vertical"
        defaultValue:"horizontal"
      },
      {
        prop:"autoplay, autoplayInterval"
        type:"boolean, milliseconds"
        defaultValue:"false, 3000"
      },
      {
        prop:"disableLoop"
        type:"boolean"
        defaultValue:"false"
      },
      {
        prop:"hideControls, hideIndicators"
        type:"boolean"
        defaultValue:"false"
      },
      {
        prop:"showNavigation, showCounter"
        type:"boolean"
        defaultValue:"false"
      },
      {
        prop:"indicatorType"
        type:"bar | dot"
        defaultValue:"bar"
      },
      {
        prop:"slideWidth, slideHeight, slidesPerView, gap"
        type:"positive numbers"
        defaultValue:"—, —, 1, 0"
      },
    ]
  Section id:"carousel-introduction" py:{ xs:6 md:10 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "DISPLAY"
        Title size:{ xs:"3xl" md:"6xl" } weight:"black"
          "Carousel"
        Text size:"lg" color:"muted"
          "Native-first carousels for web, Android, and iOS with touch, drag, snapping, navigation, and portable 3D presets."
      Card variant:"soft" scheme:"success" p:5 rounded:"lg" minW:56
        Grid columns:1 gap:1
          Text size:"xs" weight:"bold" spacing:"widest"
            "THREE NATIVE TARGETS"
          Title size:"xl" weight:"black"
            "One Carousel contract"
          Text size:"sm"
            "Web scrolls natively, Android uses Compose gestures, and iOS uses SwiftUI scrolling."
  Section id:"carousel-basic" p:{ xs:5 md:7 }
    Grid columns:1 gap:8
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "BASIC VARIANTS"
        Title size:"3xl" weight:"black"
          "Scroll, snap, compose, and change direction"
        Text size:"sm" color:"muted"
          "Touch works on every target. Web also adds fine-pointer dragging while preserving native scrolling and accessibility."
      Grid columns:1 gap:4
        Title size:"xl" weight:"black"
          "1. Simple scrollable and draggable"
        Carousel variant:"simple" scheme:"primary" slideWidth:320 gap:16 hideControls:true hideIndicators:true
          slide id:"simple-one"
            Card variant:"soft" scheme:"primary" minH:44 rounded:"lg"
              Flex direction:"column" justify:"between" gap:3 minH:36
                Text size:"xs" weight:"bold" spacing:"widest"
                  "01"
                Title size:"2xl" weight:"black"
                  "Native scroll"
          slide id:"simple-two"
            Card variant:"soft" scheme:"secondary" minH:44 rounded:"lg"
              Flex direction:"column" justify:"between" gap:3 minH:36
                Text size:"xs" weight:"bold" spacing:"widest"
                  "02"
                Title size:"2xl" weight:"black"
                  "Touch and drag"
          slide id:"simple-three"
            Card variant:"soft" scheme:"tertiary" minH:44 rounded:"lg"
              Flex direction:"column" justify:"between" gap:3 minH:36
                Text size:"xs" weight:"bold" spacing:"widest"
                  "03"
                Title size:"2xl" weight:"black"
                  "No forced snap"
          slide id:"simple-four"
            Card variant:"soft" scheme:"success" minH:44 rounded:"lg"
              Flex direction:"column" justify:"between" gap:3 minH:36
                Text size:"xs" weight:"bold" spacing:"widest"
                  "04"
                Title size:"2xl" weight:"black"
                  "Momentum preserved"
        Code language:"dowe" variant:"soft" scheme:"surface" copyLabel:"Copy Dowe" copiedLabel:"Copied" content:"""
          Carousel variant:"simple" scheme:"primary" slideWidth:220 gap:16 hideControls:true hideIndicators:true
            slide id:"one"
              Card variant:"soft" scheme:"primary"
                Text
                  "Native scrolling"
        """
      Grid columns:1 gap:4
        Title size:"xl" weight:"black"
          "2. Snapping"
        Carousel variant:"snapping" scheme:"secondary" gap:16 hideControls:true indicatorType:"dot"
          slide id:"snap-one"
            Card variant:"soft" scheme:"secondary" minH:48 rounded:"lg"
              Title size:"2xl" weight:"black"
                "Centered snap"
          slide id:"snap-two"
            Card variant:"soft" scheme:"info" minH:48 rounded:"lg"
              Title size:"2xl" weight:"black"
                "One gesture"
          slide id:"snap-three"
            Card variant:"soft" scheme:"success" minH:48 rounded:"lg"
              Title size:"2xl" weight:"black"
                "Stable landing"
        Code language:"dowe" variant:"soft" scheme:"surface" copyLabel:"Copy Dowe" copiedLabel:"Copied" content:"""
          Carousel variant:"snapping" scheme:"secondary" gap:16 indicatorType:"dot"
            slide id:"one"
