page CarouselPage
  const carouselProps:
    value:[
      { prop:"variant" type:"simple | snapping | masonry | rtl | sticky | controls | dots | thumbnails | coverFlow | slideshow | stories | smartStack | cardStack | flipbook" defaultValue:"simple" },
      { prop:"scheme" type:"primary | secondary | accent | muted | success | info | warning | danger" defaultValue:"primary" },
      { prop:"orientation" type:"horizontal | vertical" defaultValue:"horizontal" },
      { prop:"autoplay, autoplayInterval" type:"boolean, milliseconds" defaultValue:"false, 3000" },
      { prop:"disableLoop" type:"boolean" defaultValue:"false" },
      { prop:"hideControls, hideIndicators" type:"boolean" defaultValue:"false" },
      { prop:"showNavigation, showCounter" type:"boolean" defaultValue:"false" },
      { prop:"indicatorType" type:"bar | dot" defaultValue:"bar" },
      { prop:"slideWidth, slideHeight, slidesPerView, gap" type:"positive numbers" defaultValue:"—, —, 1, 0" },
    ]
  Section id:"carousel-introduction" py:{ xs:6 md:10 }
    Grid columns:1 gap:6
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest"
          "DISPLAY"
        Title size:{ xs:"3xl" md:"6xl" } weight:"black"
          "Carousel"
        Text size:"lg"
          "One ordered slide track with native scrolling, predictable controls, and responsive layouts on web, Android, and iOS."
      Grid columns:{ xs:1 md:3 } gap:4
        Card variant:"solid" scheme:"success" p:5 rounded:"lg"
          Grid columns:1 gap:2
            Text size:"xs" weight:"bold" spacing:"widest"
              "ONE CONTRACT"
            Title size:"xl" weight:"black"
              "The same slide model"
            Text size:"sm"
              "Web uses overflow scrolling, Android uses Compose lazy scrolling, and iOS uses SwiftUI scrolling."
        Card variant:"solid" scheme:"info" p:5 rounded:"lg"
          Grid columns:1 gap:2
            Text size:"xs" weight:"bold" spacing:"widest"
              "RESPONSIVE BY DEFAULT"
            Title size:"xl" weight:"black"
              "Full-width slides"
            Text size:"sm"
              "Examples without slideWidth fill the viewport, so the same source works on desktop and narrow screens."
        Card variant:"solid" scheme:"warning" p:5 rounded:"lg"
          Grid columns:1 gap:2
            Text size:"xs" weight:"bold" spacing:"widest"
              "INTERACTION"
            Title size:"xl" weight:"black"
              "Scroll or control"
            Text size:"sm"
              "Drag, touch, wheel, keyboard, dots, thumbnails, and arrows update one active slide."
  Section id:"carousel-basic" p:{ xs:5 md:7 }
    Grid columns:1 gap:8
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest"
          "BASIC VARIANTS"
        Title size:"3xl" weight:"black"
          "Scroll, snap, compose, and change direction"
        Text size:"sm"
          "Each example has several slides so the track can be tested with touch, mouse drag, wheel input, and responsive widths."
      Grid columns:1 gap:4
        Title size:"xl" weight:"black"
          "1. Simple scrollable and draggable"
        Carousel variant:"simple" scheme:"primary" gap:16 hideControls:true hideIndicators:true
          slide id:"simple-one"
            Card variant:"solid" scheme:"primary" minH:44 rounded:"lg" p:5
              Text size:"xs" weight:"bold" spacing:"widest"
                "01 / NATIVE SCROLL"
              Title size:"2xl" weight:"black"
                "Free momentum"
              Text size:"sm"
                "The track follows the platform gesture."
          slide id:"simple-two"
            Card variant:"solid" scheme:"secondary" minH:44 rounded:"lg" p:5
              Text size:"xs" weight:"bold" spacing:"widest"
                "02 / POINTER"
              Title size:"2xl" weight:"black"
                "Touch and drag"
              Text size:"sm"
                "Fine pointers get a drag enhancement."
          slide id:"simple-three"
            Card variant:"solid" scheme:"accent" minH:44 rounded:"lg" p:5
              Text size:"xs" weight:"bold" spacing:"widest"
                "03 / RESPONSIVE"
              Title size:"2xl" weight:"black"
                "Full-width layout"
              Text size:"sm"
                "No second mobile tree is required."
          slide id:"simple-four"
            Card variant:"solid" scheme:"success" minH:44 rounded:"lg" p:5
              Text size:"xs" weight:"bold" spacing:"widest"
                "04 / ACCESSIBLE"
              Title size:"2xl" weight:"black"
                "Keyboard friendly"
              Text size:"sm"
                "The native track remains reachable."
        Code language:"dowe" variant:"solid" scheme:"surface" copyLabel:"Copy Dowe" copiedLabel:"Copied" content:"""
          Carousel variant:"simple" scheme:"primary" gap:16 hideControls:true hideIndicators:true
            slide id:"one"
              Card variant:"solid" scheme:"primary"
                Text
                  "Native scrolling"
            slide id:"two"
              Card variant:"solid" scheme:"secondary"
                Text
                  "Another slide"
        """
      Grid columns:1 gap:4
        Title size:"xl" weight:"black"
          "2. Snapping"
        Carousel variant:"snapping" scheme:"secondary" gap:16 hideControls:true indicatorType:"dot"
          slide id:"snap-one"
