page IconButtonPage
  signal schemeChoice value:"primary"
  signal variantChoice value:"solid"
  signal sizeChoice value:"md"
  const schemeOptions:
    value:[
      {
        id:"primary"
        value:"primary"
        label:"Primary"
      },
      {
        id:"secondary"
        value:"secondary"
        label:"Secondary"
      },
      {
        id:"accent"
        value:"accent"
        label:"Accent"
      },
      {
        id:"muted"
        value:"muted"
        label:"Muted"
      },
      {
        id:"success"
        value:"success"
        label:"Success"
      },
      {
        id:"info"
        value:"info"
        label:"Info"
      },
      {
        id:"warning"
        value:"warning"
        label:"Warning"
      },
      {
        id:"danger"
        value:"danger"
        label:"Danger"
      },
    ]
  const variantOptions:
    value:[
      {
        id:"solid"
        value:"solid"
        label:"Solid"
      },
      {
        id:"outlined"
        value:"outlined"
        label:"Outlined"
      },
      {
        id:"ghost"
        value:"ghost"
        label:"Ghost"
      },
    ]
  const sizeOptions:
    value:[
      {
        id:"xs"
        value:"xs"
        label:"xs"
      },
      {
        id:"sm"
        value:"sm"
        label:"sm"
      },
      {
        id:"md"
        value:"md"
        label:"md"
      },
      {
        id:"lg"
        value:"lg"
        label:"lg"
      },
      {
        id:"xl"
        value:"xl"
        label:"xl"
      },
    ]
  const iconButtonProps:
    value:[
      {
        prop:"icon"
        type:"Solar icon name"
        defaultValue:"required"
      },
      {
        prop:"label"
        type:"non-empty string"
        defaultValue:"required"
      },
      {
        prop:"onClick"
        type:"Action name"
        defaultValue:"—"
      },
      {
        prop:"href"
        type:"string"
        defaultValue:"—"
      },
      {
        prop:"navigate"
        type:"push | replace"
        defaultValue:"push"
      },
      {
        prop:"history"
        type:"back | forward"
        defaultValue:"—"
      },
      {
        prop:"target"
        type:"_self | _blank | _parent | _top"
        defaultValue:"_self"
      },
      {
        prop:"externalMode"
        type:"browser | system"
        defaultValue:"browser"
      },
      {
        prop:"variant"
        type:"solid | outlined | ghost"
        defaultValue:"solid"
      },
      {
        prop:"scheme"
        type:"primary | secondary | accent | muted | success | info | warning | danger"
        defaultValue:"primary"
      },
      {
        prop:"size"
        type:"xs | sm | md | lg | xl"
        defaultValue:"md"
      },
      {
        prop:"w"
        type:"Dowe size value"
        defaultValue:"size"
      },
      {
        prop:"h"
        type:"Dowe size value"
        defaultValue:"size"
      },
      {
        prop:"gesture"
        type:"none"
        defaultValue:"press feedback"
      },
      {
        prop:"rounded"
        type:"xs | sm | md | lg | xl | full"
        defaultValue:"radius"
      },
      {
        prop:"show"
        type:"boolean"
        defaultValue:"true"
      },
    ]
  Section id:"icon-button-introduction"
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest"
          "CONTROL / ACTIONS"
        Title as:"h1"
          "IconButton"
        Text size:"lg"
          "Compact, accessible actions for toolbars, navigation, and focused workflows."
        Text size:"sm"
          "IconButton keeps the square interaction target while the required label gives the action a clear name on every supported platform."
  Section id:"icon-button-playground"
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest"
          "PLAYGROUND"
        Title size:"3xl"
          "Configure an icon button"
        Text size:"sm"
          "Visual props update the preview. The icon name and accessible label remain static."
      Grid columns:{ xs:1 md:3 } gap:4
        Select:
          bind:schemeChoice
          label:"Scheme"
          placeholder:"Choose a scheme"
          each in:schemeOptions as:option key:option.id
            Option value:option.value label:option.label
        Select:
          bind:variantChoice
          label:"Variant"
          placeholder:"Choose a variant"
          each in:variantOptions as:option key:option.id
            Option value:option.value label:option.label
        Select:
          bind:sizeChoice
          label:"Size"
          placeholder:"Choose a size"
          each in:sizeOptions as:option key:option.id
            Option value:option.value label:option.label
      Card variant:"solid" p:{ xs:6 md:10 } border:1
        Flex justify:"center" align:"center" gap:3
          IconButton:
            icon:"settings"
            label:"Open settings"
            variant:variantChoice
            scheme:schemeChoice
            size:sizeChoice
      Code:
        language:"dowe"
        variant:"solid"
        scheme:"surface"
        copyLabel:"Copy Dowe"
        copiedLabel:"Copied"
        content:"""
          IconButton:
            icon:"settings"
            label:"Open settings"
            variant:variantChoice
            scheme:schemeChoice
            size:sizeChoice
        """
  Section id:"icon-button-contract"
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest"
          "CONTRACT"
        Title size:"3xl"
          "Icon-only by design"
        Text size:"sm"
          "IconButton has no children. Its hidden label describes the action. The full square is interactive on web, iOS, and Android. The icon is visual content inside the button, not a smaller tap target. Use a quoted Solar name and keep the icon focused on one action."
      Grid columns:{ xs:1 md:2 } gap:4
        Flex direction:"column" gap:2
          IconButton icon:"settings" label:"Open settings"
          Title size:"lg"
            "Required icon"
          Text size:"sm"
            "Use a quoted Solar name. The icon inherits the control foreground and stays visual content inside the target."
        Flex direction:"column" gap:2
          IconButton icon:"info-circle" label:"Read accessibility guidance"
          Title size:"lg"
            "Accessible label"
          Text size:"sm"
            "Use a short, non-empty action label, such as Open settings or Delete item. The label is announced even though it is not visible."
        Flex direction:"column" gap:2
          IconButton icon:"alt-arrow-right" label:"Open next page"
          Title size:"lg"
            "Actions and navigation"
          Text size:"sm"
            "Use onClick for an action, or combine href with navigate, history, target, or externalMode for navigation."
  Section id:"icon-button-schemes"
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest"
          "SCHEMES AND VARIANTS"
        Title size:"3xl"
          "Compare the visual hierarchy"
        Text size:"sm"
          "Compare all semantic schemes across the three variants. Solid emphasizes the action, outlined preserves structure, and ghost keeps the quietest footprint."
      Grid columns:{ xs:1 md:3 } gap:5
        Grid columns:1 gap:3
          Text size:"sm" weight:"bold"
            "Solid"
          Grid columns:{ xs:4 md:2 } gap:3
            each in:schemeOptions as:scheme key:scheme.id
              IconButton icon:"settings" label:"Open settings" variant:"solid" scheme:scheme.value
        Grid columns:1 gap:3
          Text size:"sm" weight:"bold"
            "Outlined"
          Grid columns:{ xs:4 md:2 } gap:3
            each in:schemeOptions as:scheme key:scheme.id
              IconButton icon:"settings" label:"Open settings" variant:"outlined" scheme:scheme.value
        Grid columns:1 gap:3
          Text size:"sm" weight:"bold"
            "Ghost"
          Grid columns:{ xs:4 md:2 } gap:3
            each in:schemeOptions as:scheme key:scheme.id
              IconButton icon:"settings" label:"Open settings" variant:"ghost" scheme:scheme.value
  Section id:"icon-button-sizes"
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest"
          "SIZES"
        Title size:"3xl"
          "Five square densities"
        Text size:"sm"
          "Sizes xs through xl create square controls from 24 to 56 target units. Inside Grid, the track may grow while IconButton keeps its fixed square dimensions."
      Grid columns:{ xs:2 md:5 } gap:3
        each in:sizeOptions as:size key:size.id
          IconButton icon:"settings" label:"Open settings" size:size.value
  Section id:"icon-button-props"
    Grid columns:1 gap:5
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest"
          "API"
        Title size:"3xl"
          "Props"
        Text size:"sm"
          "IconButton also accepts common spacing, sizing, visibility, and accessibility props. Width and height always use the same fixed dimension derived from size. It gives visible press feedback by scaling its full square surface to 0.94 while active on web, iOS, and Android; use gesture:\"none\" to disable it."
      Table:
        data:iconButtonProps
        variant:"solid"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"prop" label:"Prop" width:"1fr"
        column field:"type" label:"Type" width:"3fr"
        column field:"defaultValue" label:"Default" width:"1fr"
