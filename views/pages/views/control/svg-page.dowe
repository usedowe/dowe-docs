  const svgProps:
    value:[
      {
        prop:"viewBox"
        type:"four-number string"
        defaultValue:"required"
      },
      {
        prop:"color"
        type:"design color token"
        defaultValue:"inherited"
      },
      {
        prop:"w"
        type:"size scale | full"
        defaultValue:"6"
      },
      {
        prop:"h"
        type:"size scale | full"
        defaultValue:"6"
      },
      {
        prop:"show"
        type:"boolean | responsive | Signal"
        defaultValue:"true"
      },
    ]
  const pathProps:
    value:[
      {
        prop:"d"
        type:"portable SVG path data"
        defaultValue:"required"
      },
      {
        prop:"fill"
        type:"currentColor | none | hex | color token"
        defaultValue:"currentColor"
      },
      {
        prop:"fillRule"
        type:"nonzero | evenodd"
        defaultValue:"nonzero"
      },
      {
        prop:"transform"
        type:"matrix(a b c d e f)"
        defaultValue:"identity"
      },
    ]
  fn convertSvg
    set doweSvg source:parse.svg value:svgSource fallback:"" colors:"original" format:"source"
    set svgPreview source:parse.svg value:svgSource fallback:"" colors:"original" format:"data"
  Section id:"svg-introduction" py:{ xs:6 md:10 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "CONTROL"
        Title size:{ xs:"3xl" md:"6xl" } weight:"black"
          "Svg"
        Text size:"lg" color:"muted"
          "Svg renders portable inline vector paths from one target-neutral Dowe source tree."
  Section id:"svg-converter" p:{ xs:5 md:7 }
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "SVG TO DOWE"
        Title size:"3xl" weight:"black"
          "Convert vector source in the view"
        Text size:"sm" color:"muted"
          "Paste SVG XML, run the view function, and copy the generated Svg and Path declarations."
      Grid columns:1 gap:5
        Grid columns:1 gap:3
          Textarea:
            bind:svgSource
            label:"SVG source"
            placeholder:"Paste an <svg> document"
            rows:16
            maxLength:60000
            variant:"outlined"
            scheme:"primary"
            w:"full"
          Button onClick:convertSvg iconStart:"code"
            "Convert to Dowe"
        Grid columns:1 gap:3
          Grid columns:1 gap:2
            Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
              "PREVIEW"
            Box p:4 border:1 rounded:"lg" w:"full"
              Svg data:svgPreview w:"full" h:48
          Code:
            language:"dowe"
            template:true
            variant:"soft"
            scheme:"surface"
            copyLabel:"Copy Dowe"
            copiedLabel:"Copied"
            content:"{doweSvg}"
          Text size:"xs" color:"muted"
            "The preview and generated Path declarations preserve original colors and inherited evenodd fill rules, so compound-path holes remain visible."
      Code:
        language:"dowe"
        variant:"soft"
        scheme:"surface"
        copyLabel:"Copy function"
        copiedLabel:"Copied"
        content:"""
          signal svgSource value:"<svg viewBox='0 0 24 24' style='fill-rule:evenodd'><path d='M2 2H22V22H2ZM7 7H17V17H7Z'/></svg>"
          signal doweSvg value:""
          signal svgPreview value:""

          fn convertSvg
            set doweSvg source:parse.svg value:svgSource fallback:"" colors:"original" format:"source"
            set svgPreview source:parse.svg value:svgSource fallback:"" colors:"original" format:"data"

          Textarea bind:svgSource label:"SVG source" rows:12
          Button onClick:convertSvg
            "Convert to Dowe"
          Code language:"dowe" template:true content:"{doweSvg}"
          Svg data:svgPreview w:"full" h:48
        """
  Section id:"svg-contract" py:{ xs:7 md:10 }
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "AUTHORING CONTRACT"
        Title size:"3xl" weight:"black"
          "One surface, direct Path children"
        Text size:"sm" color:"muted"
          "Svg requires a viewBox and one or more direct Path children. Path is structural and cannot be used outside Svg."
      Grid columns:1 gap:5
        Table data:svgProps variant:"outlined" scheme:"surface" size:"sm"
          column field:"prop" label:"Svg prop"
          column field:"type" label:"Accepted value"
          column field:"defaultValue" label:"Default"
        Table data:pathProps variant:"outlined" scheme:"surface" size:"sm"
          column field:"prop" label:"Path prop"
          column field:"type" label:"Accepted value"
          column field:"defaultValue" label:"Default"
      Code:
        language:"dowe"
        variant:"soft"
        scheme:"surface"
        copyLabel:"Copy Dowe"
        copiedLabel:"Copied"
        content:"""
          Svg viewBox:"0 0 120 72" w:32 h:20
            Path d:"M42 24H60C70 24 78 29 82 36L72 48L62 34L52 48L42 36Z" fill:"#1f3a60"
            Path d:"M60 4A32 32 0 1 1 60 68A32 32 0 1 1 60 4ZM60 10A26 26 0 1 0 60 62A26 26 0 1 0 60 10Z" fill:"#6bc66e" fillRule:"evenodd"
        """
  Section id:"svg-support" p:{ xs:5 md:7 }
    Grid columns:1 gap:4
      Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
        "PORTABLE SUBSET"
      Title size:"3xl" weight:"black"
        "Paths, fill rules, and affine matrices"
      Alert:
        type:"info"
        message:"parse.svg imports svg, g, path, and non-rounded rect elements; inherits nonzero or evenodd fill-rule; and flattens matrix(...) transforms. It ignores unsupported drawing elements and never executes scripts, DTD, external entities, or user JavaScript."
        variant:"soft"
        scheme:"info"
      Text size:"sm" color:"muted"
        "Generated source writes inherited evenodd as Path fillRule, while preview data uses evenOdd. Web, Android Canvas, and iOS SwiftUI consume the same normalized rule and geometry."
