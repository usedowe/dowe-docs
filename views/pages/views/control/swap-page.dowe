page SwapPage
  signal menuOpen value:false
  const swapProps:
    value:[
      {
        prop:"bind"
        type:"boolean Signal path"
        defaultValue:"required"
      },
      {
        prop:"iconOn"
        type:"Solar icon name"
        defaultValue:"required"
      },
      {
        prop:"iconOff"
        type:"Solar icon name"
        defaultValue:"required"
      },
      {
        prop:"label"
        type:"non-empty string"
        defaultValue:"required"
      },
      {
        prop:"scheme"
        type:"semantic scheme"
        defaultValue:"primary"
      },
      {
        prop:"variant"
        type:"solid | soft | outlined | ghost"
        defaultValue:"solid"
      },
      {
        prop:"size"
        type:"xs | sm | md | lg | xl"
        defaultValue:"md"
      },
    ]
  Section id:"swap-introduction" py:{ xs:6 md:10 }
    Grid columns:1 gap:4
      Text size:"xs" weight:"bold" spacing:"widest"
        "CONTROL"
      Title size:{ xs:"3xl" md:"6xl" } weight:"black"
        "Swap"
      Text size:"lg"
        "Swap is an accessible icon control that changes between two icons while updating one boolean Signal."
      Text size:"sm"
        "Use it for menu triggers, audio states, visibility, and other binary actions."
  Section id:"swap-playground" p:{ xs:5 md:7 }
    Grid columns:1 gap:5
      Title size:"3xl" weight:"black"
        "One binding, two icons"
      Text size:"sm"
        "The iconOn state is shown when the bound value is true. iconOff is shown when it is false. The transition is shared by web, iOS, and Android."
      Card variant:"outlined" border:1 p:{ xs:6 md:8 }
        Flex direction:"column" align:"center" gap:3
          Swap bind:menuOpen iconOn:"close-circle" iconOff:"menu-dots" label:"Toggle menu"
          Text size:"sm"
            "Tap the control to update menuOpen."
      Code language:"dowe" variant:"solid" scheme:"surface" copyLabel:"Copy Dowe" copiedLabel:"Copied" content:"""
        signal menuOpen value:false

        Swap bind:menuOpen iconOn:"close-circle" iconOff:"menu-dots" label:"Toggle menu"
      """
  Section id:"swap-contract" py:{ xs:7 md:10 }
    Grid columns:1 gap:4
      Title size:"3xl" weight:"black"
        "Portable binary control"
      Text size:"sm"
        "bind is required and must point to a boolean Signal or View Store value. Both iconOn and iconOff are quoted Solar icon names, and label is the accessible action description."
      Text size:"sm"
        "Swap keeps the square IconButton proportions, press feedback, semantic styling, and animated icon exchange consistent across every target."
      Table:
        data:swapProps
        variant:"solid"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        column field:"prop" label:"Prop"
        column field:"type" label:"Type"
        column field:"defaultValue" label:"Default"
