page GridPage
  const gridProps:
    value:[
      {
        prop:"columns"
        type:"positive integer from 1 to 12 | fr track list | responsive object"
        defaultValue:"1"
      },
      {
        prop:"rows"
        type:"auto | positive integer | responsive object"
        defaultValue:"auto"
      },
      {
        prop:"gap"
        type:"spacing value | responsive object"
        defaultValue:"0"
      },
      {
        prop:"flex"
        type:"initial | auto | none | 1 | responsive object"
        defaultValue:"initial"
      },
      {
        prop:"justify"
        type:"start | center | end | stretch"
        defaultValue:"stretch"
      },
      {
        prop:"align"
        type:"start | center | end | stretch"
        defaultValue:"stretch"
      },
    ]
  const gridItemProps:
    value:[
      {
        prop:"colSpan"
        type:"positive integer | responsive object"
        defaultValue:"1"
      },
      {
        prop:"rowSpan"
        type:"positive integer | responsive object"
        defaultValue:"1"
      },
    ]
  Section id:"grid-introduction" py:{ xs:6 md:10 }
    Grid columns:1 gap:3
      Text size:"xs" weight:"bold" spacing:"widest"
        "LAYOUT"
      Title size:{ xs:"3xl" md:"6xl" } weight:"black"
        "Grid"
      Text size:"lg"
        "Grid creates explicit rows and columns for catalogs, dashboards, galleries, and page structure. It fills the available width by default and keeps an automatic height based on its content across web, iOS, and Android."
      Text size:"sm"
        "Grid can be a flex item of Section, Box, Flex, or Card. Its own children remain grid items, so their flex prop has no effect."
  Section id:"grid-columns" p:{ xs:5 md:7 }
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest"
          "COLUMNS"
        Title size:"3xl" weight:"black"
          "Create equal tracks"
        Text size:"sm"
          "A positive integer creates that many equal columns. Gap separates rows and columns."
      Card variant:"solid" p:{ xs:5 md:7 } border:1
        Grid columns:3 gap:4
          Box bg:"success" color:"successText" p:4 rounded:"sm"
            Text
              "Item 1"
          Box bg:"primary" color:"primaryText" p:4 rounded:"sm"
            Text
              "Item 2"
          Box bg:"muted" p:4 rounded:"sm"
            Text
              "Item 3"
      Code:
        language:"dowe"
        variant:"solid"
        scheme:"surface"
        copyLabel:"Copy Dowe"
        copiedLabel:"Copied"
        content:"""
          Grid columns:3 gap:4
            Box bg:"success" color:"surface" p:4 rounded:"sm"
              Text
                "Item 1"
            Box bg:"primary" color:"surface" p:4 rounded:"sm"
              Text
                "Item 2"
            Box bg:"muted" p:4 rounded:"sm"
              Text
                "Item 3"
        """
  Section id:"grid-responsive" py:{ xs:7 md:10 }
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest"
          "RESPONSIVE COLUMNS"
        Title size:"3xl" weight:"black"
          "Adapt the structure by width"
        Text size:"sm"
          "Responsive columns select the highest matching breakpoint while the viewport narrows or widens, without requiring a reload."
      Card variant:"solid" p:{ xs:5 md:7 } border:1
        Grid columns:{ xs:1 sm:2 md:3 } gap:4
          Box bg:"success" color:"successText" p:4 rounded:"sm"
            Text
              "Item 1"
          Box bg:"primary" color:"primaryText" p:4 rounded:"sm"
            Text
              "Item 2"
          Box bg:"muted" p:4 rounded:"sm"
            Text
              "Item 3"
          Box bg:"warning" p:4 rounded:"sm"
            Text
              "Item 4"
          Box bg:"info" color:"surface" p:4 rounded:"sm"
            Text
              "Item 5"
          Box bg:"danger" color:"surface" p:4 rounded:"sm"
            Text
              "Item 6"
      Code:
        language:"dowe"
        variant:"solid"
        scheme:"surface"
        copyLabel:"Copy Dowe"
        copiedLabel:"Copied"
        content:"""
          Grid columns:{ xs:1 sm:2 md:3 } gap:4
            Card variant:"solid"
              Text
                "First card"
            Card variant:"solid"
              Text
                "Second card"
            Card variant:"solid"
              Text
                "Third card"
        """
  Section id:"grid-track-counts" py:{ xs:7 md:10 }
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest"
          "RESPONSIVE TRACK COUNTS"
        Title size:"3xl" weight:"black"
          "Keep the structure portable"
        Text size:"sm"
          "Grid columns use an integer from 1 to 12. Responsive values change the number of equal columns at each breakpoint, so the same declaration behaves consistently on web, iOS, and Android."
      Card variant:"solid" p:{ xs:5 md:7 } border:1
        Grid columns:1 gap:4
          Text size:"sm"
            "This responsive example is one column below md and two equal columns from md upward. The gap changes from scale 10 to 16, align:center centers each cell's content, and minH:vh-0 gives the grid a minimum viewport height."
          Code:
            language:"dowe"
            variant:"solid"
            scheme:"surface"
            copyLabel:"Copy Dowe"
            copiedLabel:"Copied"
            content:"""
              Grid columns:{ xs:1 md:2 } gap:{ xs:10 md:16 } align:"center" minH:"vh-0"
                Box p:4
                  Text
                    "First column"
                Box p:4
                  Text
                    "Second column"
            """
          Text size:"sm"
            "Rows continue to use auto or positive integer counts. Grid columns also support homogeneous positive fr tracks; px, percentages, mixed units, zero-weight tracks, and fr rows remain invalid."
  Section id:"grid-fraction-tracks" py:{ xs:7 md:10 }
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest"
          "FRACTION TRACKS"
        Title size:"3xl" weight:"black"
          "Build weighted layouts"
        Text size:"sm"
          "Use positive fr weights when equal columns are not enough. The same 1:2:1 proportions are generated for web CSS, iOS SwiftUI, Android Compose, and the Android development launcher."
      Card variant:"solid" p:{ xs:5 md:7 } border:1
        Grid columns:{ xs:"1fr" md:"1fr 2fr 1fr" } gap:4 align:"center"
          Box bg:"success" color:"successText" p:4 rounded:"sm"
            Text
              "1fr"
          Box bg:"primary" color:"primaryText" p:4 rounded:"sm"
            Text
              "2fr"
          Box bg:"info" color:"surface" p:4 rounded:"sm"
            Text
              "1fr"
      Code:
        language:"dowe"
        variant:"solid"
        scheme:"surface"
        copyLabel:"Copy Dowe"
        copiedLabel:"Copied"
        content:"""
          Grid columns:"1fr 2fr 1fr" gap:4 align:"center"
            Box p:4
              Text
                "Narrow track"
            Box p:4
              Text
                "Wide track"
            Box p:4
              Text
                "Narrow track"
        """
  Section id:"grid-spans" p:{ xs:5 md:7 }
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest"
          "GRID ITEMS"
        Title size:"3xl" weight:"black"
          "Span multiple tracks"
        Text size:"sm"
          "Direct Box and Card children can span columns or rows while the parent Grid keeps ownership of the structure."
      Card variant:"solid" p:{ xs:5 md:7 } border:1
        Grid columns:3 gap:4
          Box colSpan:2 bg:"primary" color:"surface" p:4 rounded:"sm"
            Text
              "Two columns"
          Box bg:"muted" p:4 rounded:"sm"
            Text
              "One column"
          Box bg:"success" color:"surface" p:4 rounded:"sm"
            Text
              "One column"
          Box colSpan:2 bg:"info" color:"surface" p:4 rounded:"sm"
            Text
              "Two columns"
      Code:
        language:"dowe"
        variant:"solid"
        scheme:"surface"
        copyLabel:"Copy Dowe"
        copiedLabel:"Copied"
        content:"""
          Grid columns:3 gap:4
            Box colSpan:2 p:4
              Text
                "Two columns"
            Box p:4
              Text
                "One column"
        """
  Section id:"grid-props" py:{ xs:7 md:10 }
    Grid columns:1 gap:7
      Grid columns:1 gap:5
        Grid columns:1 gap:2
          Text size:"xs" weight:"bold" spacing:"widest"
            "API"
          Title size:"3xl" weight:"black"
            "Grid props"
          Text size:"sm"
            "Grid also accepts the applicable common spacing, sizing, visibility, and accessibility props."
        Table:
          data:gridProps
          variant:"solid"
          scheme:"surface"
          size:"sm"
          striped:true
          dividers:true
          rounded:"md"
          column field:"prop" label:"Prop" width:"1fr"
          column field:"type" label:"Type" width:"3fr"
          column field:"defaultValue" label:"Default" width:"1fr"
      Grid columns:1 gap:5
        Grid columns:1 gap:2
          Title size:"2xl" weight:"black"
            "Grid item props"
          Text size:"sm"
            "colSpan and rowSpan are valid only on a direct Box or Card child of Grid."
        Table:
          data:gridItemProps
          variant:"solid"
          scheme:"surface"
          size:"sm"
          striped:true
          dividers:true
          rounded:"md"
          column field:"prop" label:"Prop" width:"1fr"
          column field:"type" label:"Type" width:"3fr"
          column field:"defaultValue" label:"Default" width:"1fr"
