page RailNavPage
  const railNavProps:
    value:[
      {
        prop:"variant"
        type:"solid | soft | outlined | ghost"
        defaultValue:"ghost"
      },
      {
        prop:"scheme"
        type:"primary | secondary | tertiary | muted | success | info | warning | danger"
        defaultValue:"muted"
      },
      {
        prop:"size"
        type:"sm | md | lg"
        defaultValue:"md"
      },
      {
        prop:"showLabels"
        type:"boolean"
        defaultValue:"false"
      },
    ]
  const entryProps:
    value:[
      {
        prop:"label"
        type:"string"
        behavior:"Required accessible name"
      },
      {
        prop:"i18n"
        type:"translation key"
        behavior:"Optional translated label"
      },
      {
        prop:"icon"
        type:"Solar icon name"
        behavior:"Required portable Icon"
      },
      {
        prop:"href"
        type:"path | fragment | HTTPS URL"
        behavior:"Portable navigation"
      },
      {
        prop:"navigate"
        type:"push | replace"
        behavior:"History behavior for href"
      },
      {
        prop:"target"
        type:"self | blank"
        behavior:"Web destination for href"
      },
      {
        prop:"externalMode"
        type:"system | webview"
        behavior:"Native external navigation"
      },
      {
        prop:"onClick"
        type:"function name"
        behavior:"Runs a declared view function"
      },
    ]
  Section id:"railnav-introduction" py:{ xs:6 md:10 }
    Grid columns:{ xs:1 md:"1fr auto" } gap:5 align:"end"
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "NAVIGATION"
        Title size:{ xs:"3xl" md:"6xl" } weight:"black"
          "RailNav"
        Text size:"lg" color:"muted"
          "RailNav creates a narrow vertical menu with portable icons, accessible tooltips, and optional labels below each icon."
      Button variant:"soft" scheme:"success" size:"sm" rounded:"full" iconStart:"copy"
        "Copy LLM"
  Section id:"railnav-default" p:{ xs:5 md:7 }
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "ICON-ONLY"
        Title size:"3xl" weight:"black"
          "A compact rail by default"
        Text size:"sm" color:"muted"
          "Each item requires a label and a Solar icon. On web and desktop, hover or keyboard focus reveals the label in a Tooltip positioned after the rail. Native targets expose the same label to accessibility services."
      Grid columns:{ xs:1 md:2 } gap:6 align:"start"
        Card variant:"outlined" scheme:"surface" p:{ xs:6 md:10 } rounded:"md" border:1
          Flex justify:"center"
            RailNav variant:"ghost" scheme:"primary" size:"md"
              item label:"RailNav" href:"/docs/views/navigation/railnav" icon:"route"
              divider
              item label:"Overview" href:"/docs/views" icon:"home"
              item label:"Explore" href:"/docs/views/navigation/sidenav" icon:"compass"
              item label:"Saved" href:"/docs/views" icon:"bookmark"
              item label:"Settings" href:"/docs/views" icon:"settings"
        Code:
          language:"dowe"
          variant:"soft"
          scheme:"surface"
          copyLabel:"Copy Dowe"
          copiedLabel:"Copied"
          content:"""
            RailNav variant:"ghost" scheme:"primary" size:"md"
              item label:"RailNav" href:"/docs/views/navigation/railnav" icon:"route"
              divider
              item label:"Overview" href:"/docs/views" icon:"home"
              item label:"Explore" href:"/explore" icon:"compass"
              item label:"Saved" href:"/saved" icon:"bookmark"
              item label:"Settings" href:"/settings" icon:"settings"
          """
  Section id:"railnav-labels" py:{ xs:7 md:10 }
    Grid columns:{ xs:1 md:2 } gap:7 align:"center"
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "OPTIONAL LABELS"
        Title size:"3xl" weight:"black"
          "Text below the icon"
        Text size:"sm" color:"muted"
          "Set showLabels:true when every destination should remain visible. RailNav centers the label below its icon, keeps it to one line, and preserves the narrow width selected by size. Because the label is visible, no duplicate tooltip is generated."
        Code:
          language:"dowe"
          variant:"soft"
          scheme:"surface"
          content:"""
            RailNav showLabels:true size:"sm" variant:"soft" scheme:"muted"
              item label:"Home" href:"/" icon:"home"
              item label:"Map" href:"/map" icon:"map"
              item label:"Saved" href:"/saved" icon:"bookmark"
          """
      Card variant:"soft" scheme:"surface" p:{ xs:6 md:9 } rounded:"md"
        Flex justify:"center"
          RailNav showLabels:true size:"sm" variant:"soft" scheme:"muted"
            item label:"Home" href:"/docs/views" icon:"home"
            item label:"Map" href:"/docs/views" icon:"map"
            item label:"Saved" href:"/docs/views" icon:"bookmark"
  Section id:"railnav-variations" py:{ xs:7 md:10 }
    Grid columns:1 gap:8
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "VISUAL OPTIONS"
        Title size:"3xl" weight:"black"
          "Variants, schemes, and sizes"
        Text size:"sm" color:"muted"
          "Visual props apply to hover, focus, press, and active destination states without changing the rail structure."
      Grid columns:1 gap:4
        Title size:"xl" weight:"bold"
          "Variants"
        Flex wrap:true align:"start" gap:5
          RailNav variant:"solid" scheme:"primary" size:"sm"
            item label:"Solid" href:"/docs/views/navigation/railnav" icon:"home"
            item label:"Settings" href:"/docs/views" icon:"settings"
          RailNav variant:"soft" scheme:"primary" size:"sm"
            item label:"Soft" href:"/docs/views/navigation/railnav" icon:"home"
            item label:"Settings" href:"/docs/views" icon:"settings"
          RailNav variant:"outlined" scheme:"primary" size:"sm"
            item label:"Outlined" href:"/docs/views/navigation/railnav" icon:"home"
            item label:"Settings" href:"/docs/views" icon:"settings"
          RailNav variant:"ghost" scheme:"primary" size:"sm"
            item label:"Ghost" href:"/docs/views/navigation/railnav" icon:"home"
            item label:"Settings" href:"/docs/views" icon:"settings"
      Grid columns:1 gap:4
        Title size:"xl" weight:"bold"
          "Schemes"
        Flex wrap:true align:"start" gap:5
          RailNav variant:"soft" scheme:"primary" size:"sm"
            item label:"Primary" href:"/docs/views/navigation/railnav" icon:"route"
          RailNav variant:"soft" scheme:"secondary" size:"sm"
            item label:"Secondary" href:"/docs/views/navigation/railnav" icon:"route"
          RailNav variant:"soft" scheme:"success" size:"sm"
            item label:"Success" href:"/docs/views/navigation/railnav" icon:"route"
          RailNav variant:"soft" scheme:"warning" size:"sm"
            item label:"Warning" href:"/docs/views/navigation/railnav" icon:"route"
          RailNav variant:"soft" scheme:"danger" size:"sm"
            item label:"Danger" href:"/docs/views/navigation/railnav" icon:"route"
      Grid columns:1 gap:4
        Title size:"xl" weight:"bold"
          "Sizes"
        Flex wrap:true align:"start" gap:5
          RailNav variant:"outlined" scheme:"muted" size:"sm"
            item label:"Small" href:"/docs/views/navigation/railnav" icon:"route"
          RailNav variant:"outlined" scheme:"muted" size:"md"
            item label:"Medium" href:"/docs/views/navigation/railnav" icon:"route"
          RailNav variant:"outlined" scheme:"muted" size:"lg"
            item label:"Large" href:"/docs/views/navigation/railnav" icon:"route"
  Section id:"railnav-contract" p:{ xs:5 md:7 }
    Grid columns:{ xs:1 md:2 } gap:6
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "PORTABLE CONTRACT"
        Title size:"3xl" weight:"black"
          "Icon and Tooltip are built in"
        Text size:"sm" color:"muted"
          "The icon prop resolves through the same Solar catalog and vector model as Icon. In icon-only web and desktop output, RailNav reuses Tooltip styling, positioning, hover, and focus behavior automatically."
        Text size:"sm" color:"muted"
          "Items accept navigation or an onClick function, never both. divider is the only other direct child; headers, descriptions, statuses, submenus, and custom SVG icons belong in SideNav."
      Code:
        language:"dowe"
        variant:"soft"
        scheme:"surface"
        content:"""
          RailNav variant:"soft" scheme:"primary"
            item label:"Home" href:"/" icon:"home"
            item label:"Explore" href:"/explore" navigate:"replace" icon:"compass"
            divider
            item label:"Settings" onClick:openSettings icon:"settings"
        """
  Section id:"railnav-props" py:{ xs:7 md:10 }
    Grid columns:1 gap:8
      Grid columns:1 gap:5
        Grid columns:1 gap:2
          Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
            "API"
          Title size:"3xl" weight:"black"
            "RailNav props"
          Text size:"sm" color:"muted"
            "RailNav also accepts applicable common identity, spacing, sizing, visibility, radius, and border props."
        Table:
          data:railNavProps
          variant:"soft"
          scheme:"surface"
          size:"sm"
          striped:true
          dividers:true
          rounded:"md"
          column field:"prop" label:"Prop" width:"1fr"
          column field:"type" label:"Type" width:"3fr"
          column field:"defaultValue" label:"Default" width:"1fr"
      Grid columns:1 gap:5
        Grid columns:1 gap:2
          Title size:"2xl" weight:"black"
            "Item props"
          Text size:"sm" color:"muted"
            "label and icon are required static values. i18n can translate the accessible or visible label while preserving its deterministic fallback."
        Table:
          data:entryProps
          variant:"soft"
          scheme:"surface"
          size:"sm"
          striped:true
          dividers:true
          rounded:"md"
          column field:"prop" label:"Prop" width:"1fr"
          column field:"type" label:"Type" width:"2fr"
          column field:"behavior" label:"Behavior" width:"3fr"
