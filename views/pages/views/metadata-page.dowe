page MetadataPage
  meta name:"title" content:"Web Metadata and SEO — Dowe Views"
  meta name:"description" content:"Define inherited titles, descriptions, canonical URLs, Open Graph images, and Twitter Cards in Dowe layouts and pages."
  meta name:"canonical" content:"https://dowe.dev/docs/views/web/metadata"
  meta name:"og:title" content:"Web Metadata and SEO — Dowe Views"
  meta name:"og:description" content:"Add SEO and social-sharing metadata directly to Dowe layouts and pages."
  meta name:"og:url" content:"https://dowe.dev/docs/views/web/metadata"
  meta name:"twitter:title" content:"Web Metadata and SEO — Dowe Views"
  meta name:"twitter:description" content:"Add SEO and social-sharing metadata directly to Dowe layouts and pages."
  const metadataModelRows:
    value:[
      {
        layer:"Layout"
        responsibility:"Shared defaults"
        guidance:"Define site-wide title, description, social image, card type, and site name values."
      },
      {
        layer:"Page"
        responsibility:"Route-specific overrides"
        guidance:"Replace only the names this route needs; undeclared names remain inherited from the active layout."
      },
      {
        layer:"Web document"
        responsibility:"Rendered head"
        guidance:"Web SSR emits the effective metadata and browser navigation keeps it synchronized."
      },
    ]
  const metadataResolutionRows:
    value:[
      {
        step:"1 / Active layout"
        source:"Layout"
        behavior:"Establishes defaults shared by the route group."
      },
      {
        step:"2 / Page"
        source:"Page"
        behavior:"Replaces matching names and inherits every other layout value."
      },
      {
        step:"3 / Browser head"
        source:"Effective result"
        behavior:"title, canonical, description, Open Graph, and Twitter values become document metadata."
      },
    ]
  const metadataNameRows:
    value:[
      {
        group:"Document and search"
        names:"title, description, keywords, robots, canonical"
      },
      {
        group:"Open Graph"
        names:"og:title, og:description, og:image, og:image:alt, og:type, og:url, og:site_name"
      },
      {
        group:"Twitter Card"
        names:"twitter:card, twitter:title, twitter:description, twitter:image, twitter:image:alt, twitter:site, twitter:creator"
      },
      {
        group:"Image ownership"
        names:"Dowe emits authored URLs. It does not fetch, resize, inspect, or generate social images."
      },
    ]
  Section id:"metadata-overview" py:{ xs:6 md:10 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "WEB / DOCUMENT HEAD"
        Title size:{ xs:"3xl" md:"6xl" } weight:"black"
          "Metadata follows the active route"
        Text size:"lg" color:"muted"
          "Layouts define shared SEO defaults. Pages override only the names they need. Dowe emits the effective head during SSR and keeps it synchronized during browser navigation."
        Alert type:"info" message:"Start with the layout for values shared by many routes. Add meta to a page only when that route needs a different value."
      Table:
        data:metadataModelRows
        variant:"soft"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"layer" label:"Layer" width:"1fr"
        column field:"responsibility" label:"Owns" width:"2fr"
        column field:"guidance" label:"How to use it" width:"4fr"
  Section id:"metadata-syntax" p:{ xs:5 md:7 }
    Grid columns:1 gap:6
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "1 / AUTHOR THE DEFAULTS"
        Title size:"3xl" weight:"black"
          "Declare metadata in the layout"
        Text size:"sm" color:"muted"
          "meta is a direct child of layout or page. It is not a visual component and does not count toward the layout root. Both props are required quoted strings."
        Text size:"xs" weight:"bold" color:"muted"
          "views/layouts/site-layout.dowe"
      Code:
        language:"dowe"
        variant:"soft"
        scheme:"surface"
        copyLabel:"Copy layout metadata"
        copiedLabel:"Copied"
        content:"""
          layout SiteLayout
            meta name:"title" content:"Acme"
            meta name:"description" content:"Tools for focused teams."
            meta name:"og:image" content:"https://acme.dev/og.png"
            meta name:"twitter:card" content:"summary_large_image"
            Scaffold
              main
                children
        """
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" color:"primary"
          "2 / OVERRIDE ONE ROUTE"
        Title size:"2xl" weight:"black"
          "Replace only what this page needs"
        Text size:"sm" color:"muted"
          "The page inherits every layout value it does not declare. This keeps shared defaults in one place while allowing a route to provide its own title, description, or canonical URL."
        Text size:"xs" weight:"bold" color:"primary"
          "views/pages/pricing-page.dowe"
      Code:
        language:"dowe"
        variant:"soft"
        scheme:"surface"
        copyLabel:"Copy page metadata"
        copiedLabel:"Copied"
        content:"""
          page PricingPage
            meta name:"title" content:"Pricing — Acme"
            meta name:"description" content:"Plans for every team."
            meta name:"canonical" content:"https://acme.dev/pricing"
            meta name:"og:title" content:"Pricing — Acme"
            Section
              Title
                "Simple pricing"
        """
  Section id:"metadata-resolution" py:{ xs:7 md:10 }
    Grid columns:1 gap:5
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "RESOLUTION"
        Title size:{ xs:"2xl" md:"4xl" } weight:"black"
          "Nearest declaration wins by name"
        Text color:"muted"
          "Dowe starts with the active layout and applies the page last. Ordering is deterministic, and only a declaration with the same name replaces an inherited value."
      Table:
        data:metadataResolutionRows
        variant:"soft"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"step" label:"Order" width:"1fr"
        column field:"source" label:"Source" width:"2fr"
        column field:"behavior" label:"Result" width:"4fr"
      Alert type:"info" message:"The first HTTP response already contains the effective values. Internal links, back and forward navigation, layout changes, and development hot updates replace stale Dowe-authored metadata without reloading the page."
  Section id:"metadata-names" p:{ xs:5 md:7 }
    Grid columns:1 gap:5
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "SUPPORTED NAMES"
        Title size:{ xs:"2xl" md:"4xl" } weight:"black"
          "A bounded SEO contract"
        Text color:"muted"
          "Dowe rejects unknown, duplicated, empty, dynamic, nested, or child-bearing metadata before generation."
      Table:
        data:metadataNameRows
        variant:"soft"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"group" label:"Group" width:"2fr"
        column field:"names" label:"Supported names and behavior" width:"5fr"
  Section id:"metadata-targets" py:{ xs:7 md:10 }
    Grid columns:1 gap:4
      Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
        "TARGET SUPPORT"
      Title size:{ xs:"2xl" md:"4xl" } weight:"black"
        "Browser documents only"
      Text color:"muted"
        "Web emits metadata in SSR HTML and updates it in the SPA router. Desktop accepts the syntax but emits no document metadata. Android and iOS accept the syntax but generate no native metadata."
      Alert type:"info" variant:"soft" scheme:"info" message:"Use platform-specific app configuration for future window, activity, view, or store-listing metadata. The meta declaration currently owns only the web document head."
