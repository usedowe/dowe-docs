page ParsePage
  signal svgInput value:"<svg viewBox='0 0 24 24'><path d='M4 4L20 4L12 20Z' fill='#2563eb'/></svg>"
  signal parsedSvg value:""
  const parseFunctions:
    value:[
      {
        name:"parse.int"
        input:"string"
        result:"number | fallback | null"
      },
      {
        name:"parse.float"
        input:"string | number"
        result:"number | fallback | null"
      },
      {
        name:"parse.bool"
        input:"string | bool"
        result:"bool | fallback | null"
      },
      {
        name:"parse.json"
        input:"JSON string"
        result:"JSON | fallback | null"
      },
      {
        name:"parse.string"
        input:"JSON-compatible value"
        result:"string"
      },
      {
        name:"parse.svg"
        input:"SVG XML string"
        result:"Dowe source | fallback | null"
      },
    ]
  fn parseSvgInput
    set parsedSvg source:parse.svg value:svgInput fallback:""
  Section id:"parse-introduction" py:{ xs:6 md:10 }
    Grid columns:1 gap:3
      Text size:"xs" weight:"bold" spacing:"widest"
        "UTILITY"
      Title size:{ xs:"3xl" md:"6xl" } weight:"black"
        "parse"
      Text size:"lg"
        "parse converts user-provided strings into safe portable values without throwing a view runtime exception."
  Section id:"parse-syntax" p:{ xs:5 md:7 }
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest"
          "VIEW SYNTAX"
        Title size:"3xl" weight:"black"
          "Assign utility results inside fn"
        Text size:"sm"
          "View utilities are normalized calls. source names the function, named props provide its arguments, and set writes the result to a Signal."
      Code:
        language:"dowe"
        variant:"solid"
        scheme:"surface"
        copyLabel:"Copy syntax"
        copiedLabel:"Copied"
        content:"""
          fn convert
            set output source:parse.svg value:input fallback:""
        """
      Alert type:"info" message:"parser svg data=svg and string svg data=... are not Dowe declarations. The implemented syntax is set <Signal> source:parse.svg value:<string Signal>." variant:"solid" scheme:"info"
  Section id:"parse-playground" py:{ xs:7 md:10 }
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest"
          "PLAYGROUND"
        Title size:"3xl" weight:"black"
          "Convert SVG text"
      Grid columns:1 gap:5
        Grid columns:1 gap:3
          Textarea bind:svgInput label:"SVG source" rows:10 maxLength:60000 variant:"outlined" scheme:"primary" w:"full"
          Button onClick:parseSvgInput iconStart:"code"
            "Run parse.svg"
        Code:
          language:"dowe"
          template:true
          variant:"solid"
          scheme:"surface"
          copyLabel:"Copy result"
          copiedLabel:"Copied"
          content:"{parsedSvg}"
  Section id:"parse-functions" p:{ xs:5 md:7 }
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest"
          "FUNCTIONS"
        Title size:"3xl" weight:"black"
          "Implemented parse catalog"
      Table data:parseFunctions variant:"outlined" scheme:"surface" size:"sm"
        column field:"name" label:"Function"
        column field:"input" label:"Input"
        column field:"result" label:"Result"
  Section id:"parse-limits" py:{ xs:7 md:10 }
    Grid columns:1 gap:4
      Text size:"xs" weight:"bold" spacing:"widest"
        "CURRENT SUPPORT"
      Title size:"3xl" weight:"black"
        "Bounded and deterministic"
      Text size:"sm"
        "parse.svg accepts at most 262144 UTF-8 bytes and 1024 paths. It imports viewBox or numeric width and height, svg, g, path, inline fill styles, and matrix transforms."
      Text size:"sm"
        "Unsupported vector elements are skipped. Invalid XML, dimensions, path data, or transforms return fallback when supplied and null otherwise."
