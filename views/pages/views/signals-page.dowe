page SignalsPage
  const signalGuidanceRows:
    value:[
      { rule:"Local ownership" guidance:"Declare a Signal in the page or layout that owns the interaction. Its lifetime follows that view instance." },
      { rule:"Direct bindings" guidance:"Read compatible paths directly in props such as show:ready or bind:form.name." },
      { rule:"Updates" guidance:"Use set in an event function or event expression. Every compatible binding refreshes from the same Signal." },
      { rule:"Reset behavior" guidance:"A page Signal resets when its page instance is recreated; use a Store when state must cross routes." },
    ]
  signal count value:0
  signal detailsVisible value:false
  Section id:"signals-introduction" py:{ xs:6 md:10 }
    Grid columns:1 gap:3
      Text size:"xs" weight:"bold" spacing:"widest"
        "STATE"
      Title size:{ xs:"3xl" md:"6xl" } weight:"black"
        "Signals"
      Text size:"lg"
        "A Signal is reactive state owned by one page or layout instance. Update it and every compatible binding refreshes."
  Section id:"signals-example" p:{ xs:5 md:7 }
    Grid columns:1 gap:6
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest"
          "INTERACTIVE EXAMPLE"
        Title size:"3xl" weight:"black"
          "Local counter and visibility"
        Text size:"sm"
          "This counter and its details panel reset when this page instance is recreated."
      Card variant:"solid" p:{ xs:5 md:7 } border:1
        Grid columns:1 gap:4
          Title size:"2xl" weight:"black"
            "Local reactive counter"
          Flex wrap:true gap:3
            Button onClick:{ set:count add:1 }
              "Add one"
            Button onClick:{ set:detailsVisible value:!detailsVisible } variant:"solid"
              "Toggle details"
          Text show:detailsVisible size:"sm"
            "The show prop reads the same boolean Signal and removes this text from layout while false."
          Text show:{ when:count gt:0 } size:"sm" color:"success"
            "The counter is greater than zero."
      Code:
        language:"dowe"
        variant:"solid"
        scheme:"surface"
        copyLabel:"Copy Dowe"
        copiedLabel:"Copied"
        content:"""
          page CounterPage
            signal count value:0
            signal detailsVisible value:false

            Button onClick:{ set:count add:1 }
              "Add one"
            Text show:{ when:count gt:0 }
              "The counter is greater than zero."
            Text show:detailsVisible
              "More details"
        """
  Section id:"signals-guidance" py:{ xs:7 md:10 }
    Grid columns:1 gap:4
      Table:
        data:signalGuidanceRows
        variant:"solid"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"rule" label:"Rule" width:"2fr"
        column field:"guidance" label:"How to apply it" width:"5fr"
