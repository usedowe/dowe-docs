page RouterHttpPage
  const httpRouteRows:
    value:[
      {
        form:"Inline or multiline"
        guidance:"A property-suite header such as post: accepts path and handler one per line. It lowers exactly like the compact form."
      },
      {
        form:"Dynamic segments"
        guidance:"Use :id in a path and read req.params.id inside the server handler. Route matching stays owned by the Dowe runtime."
      },
    ]
  Section id:"router-http" py:{ xs:6 md:10 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "HTTP ROUTES"
        Title size:{ xs:"3xl" md:"5xl" } weight:"black"
          "Use a verb as the route declaration"
        Text size:"lg" color:"muted"
          "Imported endpoint modules use lowercase get, post, put, patch, and delete declarations. Each route declares its path and handler directly."
      Code:
        language:"dowe"
        variant:"soft"
        scheme:"surface"
        copyLabel:"Copy Dowe"
        copiedLabel:"Copied"
        content:"""
          endpoints apiRoutes
            group path:"/api/auth"
              post path:"/register" handler:registerUser
              post:
                path:"/login"
                handler:loginUser
        """
      Table:
        data:httpRouteRows
        variant:"soft"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"form" label:"Form" width:"2fr"
        column field:"guidance" label:"Guidance" width:"5fr"
