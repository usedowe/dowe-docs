page RouterWebSocketsPage
  const websocketRows:
    value:[
      {
        concern:"Query values are credentials"
        guidance:"Use short-lived tokens, serve only over TLS, and avoid logging complete WebSocket URLs. Dowe validates middleware before the upgrade is accepted."
      },
      {
        concern:"Lifecycle remains explicit"
        guidance:"open, message, close, and drain remain optional Dowe-backed lifecycle handlers after authentication succeeds."
      },
    ]
  Section id:"router-websockets" py:{ xs:6 md:10 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest"
          "WEBSOCKETS"
        Title size:{ xs:"3xl" md:"5xl" } weight:"black"
          "Protect the upgrade before opening a socket"
        Text size:"lg"
          "WebSockets can live in endpoint groups, inherit their path and middleware, and add route-specific middleware. Browser clients authenticate the upgrade with a search parameter because they cannot set arbitrary upgrade headers."
      Code:
        language:"dowe"
        variant:"solid"
        scheme:"surface"
        copyLabel:"Copy Dowe"
        copiedLabel:"Copied"
        content:"""
          middleware requireSocketToken
            jwt verified secret:env.JWT_SECRET algorithm:"HS256" token:req.query.token
            if verified.valid
              next
            return status:401 json:{ ok:false error:"Unauthorized" }

          endpoints controlRoutes
            group path:"/api/v1/sip"
              websocket path:"/control" middleware:[requireSocketToken]
                open ws
                  log "sip control websocket open"
                message ws
                  ws event source:"json"
                  send ws json:{ ok:true channel:"sip-control" }
                close ws
                  log "sip control websocket close"
        """
      Table:
        data:websocketRows
        variant:"solid"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"concern" label:"Concern" width:"2fr"
        column field:"guidance" label:"Rule" width:"5fr"
