page RouterEndpointsPage
  const endpointRows:
    value:[
      {
        rule:"Path composition"
        guidance:"The group /api/blogs plus get path:\"/:id\" registers GET /api/blogs/:id. An empty method path targets the group root."
      },
      {
        rule:"Ordered protection"
        guidance:"Group middleware runs first. Method middleware runs after it and before its handler. Put protection on either surface without nesting groups."
      },
      {
        rule:"One normalized router"
        guidance:"The compiler resolves groups once; the shared Dowe runtime receives final HTTP routes and does not reparse source."
      },
    ]
  Section id:"router-endpoints" py:{ xs:6 md:10 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "SERVER ROUTER"
        Title size:{ xs:"3xl" md:"5xl" } weight:"black"
          "Endpoint groups are one level"
        Text size:"lg" color:"muted"
          "Each group adds a path prefix and optional middleware to direct methods and WebSockets before Dowe compiles the final routes into the Dowe server. Groups never contain groups."
      Code:
        language:"dowe"
        variant:"soft"
        scheme:"surface"
        copyLabel:"Copy Dowe"
        copiedLabel:"Copied"
        content:"""
          endpoints apiRoutes
            group path:"/api/blogs"
              get path:"" handler:listBlogs
              get path:"/:id" handler:readBlog
              post path:"/create" handler:createBlog middleware:[requireBearer]
              patch path:"/:id/edit" handler:updateBlog middleware:[requireBearer]
        """
      Table:
        data:endpointRows
        variant:"soft"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"rule" label:"Rule" width:"2fr"
        column field:"guidance" label:"What it means" width:"5fr"
