page HttpPage
  const httpModelRows:
    value:[
      {
        part:"Binding"
        rule:"upstream is the inspected response result for a JSON response, proxy, byte response, or following server statement."
      },
      {
        part:"Method"
        rule:"method accepts get, post, put, patch, or delete. The lowercase value becomes the direct Dowe HTTP request method."
      },
      {
        part:"Boundary"
        rule:"http is server-only. Views and client targets do not receive outbound network authority or server environment values."
      },
    ]
  const httpProxyRows:
    value:[
      {
        concern:"Response modes"
        guidance:"json is the default for inspectable status and data. bytes preserves an upstream byte binding, and proxy forwards a controlled upstream response."
      },
      {
        concern:"Migration"
        guidance:"Replace let upstream = http.get, http.post, or http.request with http upstream method:\"...\". Legacy expression forms are rejected."
      },
    ]
  Section id:"http-introduction" py:{ xs:6 md:10 }
    Grid columns:1 gap:3
      Text size:"xs" weight:"bold" spacing:"widest"
        "SERVER / HTTP"
      Title size:{ xs:"3xl" md:"6xl" } weight:"black"
        "Make a controlled outbound request"
      Text size:"lg"
        "http is a server-only declaration for outbound Dowe runtime requests. It gives the response a named binding while keeping URLs, credentials, and response handling inside the server boundary."
  Section id:"http-mental-model" p:{ xs:5 md:7 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest"
          "1 / MENTAL MODEL"
        Title size:"3xl" weight:"black"
          "Declare the response binding first"
        Text size:"sm"
          "The name after http is the response variable for later statements. Use one lowercase method value and keep base, path, headers, timeout, and response mode explicit."
      Code:
        language:"dowe"
        variant:"solid"
        scheme:"surface"
        copyLabel:"Copy Dowe"
        copiedLabel:"Copied"
        content:"""
          handler fetchStatus
            http upstream method:"get" base:env.MEDIA_BASE_URL path:"/api/status" mode:"bytes" headers:[{ name:"Accept" value:"application/json" }]
            return json:{ ok:upstream.ok status:upstream.status }
        """
      Table:
        data:httpModelRows
        variant:"solid"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"part" label:"Part" width:"2fr"
        column field:"rule" label:"Contract" width:"5fr"
  Section id:"http-proxy" py:{ xs:7 md:10 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest"
          "2 / PROXY AND SAFETY"
        Title size:"3xl" weight:"black"
          "Keep authority explicit"
        Text size:"sm"
          "Declare base and bearer names in .env.example, supply values through .env or the process environment, and reference them only from server source. Headers are validated, Authorization belongs in bearer, and redirect plus timeout policy remain visible in source."
      Code:
        language:"dowe"
        variant:"solid"
        scheme:"surface"
        copyLabel:"Copy Dowe"
        copiedLabel:"Copied"
        content:"""
          handler chatCompletions
            const body value:req.json
            http upstream method:"post" base:env.OPENROUTER_BASE_URL path:"/api/v1/chat/completions" bearer:env.OPENROUTER_API_KEY json:body mode:"proxy" timeoutMs:10000
            return proxy:upstream
        """
      Table:
        data:httpProxyRows
        variant:"solid"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"concern" label:"Concern" width:"2fr"
        column field:"guidance" label:"Guidance" width:"5fr"
