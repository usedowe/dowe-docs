page SessionPage
  const sessionModelRows:
    value:[
      { part:"Token" meaning:"ULID is random, opaque, sortable, and without readable claims." },
      { part:"Cache" meaning:"session:<ulid> stores only the server-owned session projection for a fast hit." },
      { part:"Database" meaning:"A Cache miss reads sessions and rehydrates the projection." },
    ]
  const sessionValidationRows:
    value:[
      { step:"1. Cache hit" guidance:"The session projection is validated and the request continues without reading the persistent database." },
      { step:"2. Cache miss" guidance:"The database record is checked. A valid record is copied back to Cache for the next request." },
      { step:"3. Reject" guidance:"Missing, malformed, expired, or revoked sessions receive HTTP 401 and never populate request context." },
    ]
  const sessionLifecycleRows:
    value:[
      { concern:"Cache is acceleration" guidance:"Cache improves latency but is not the only authority. Database fallback keeps sessions recoverable after Cache restarts." },
      { concern:"Revocation is explicit" guidance:"Delete the Cache key and persistent row when logging out, banning a user, or rotating all sessions." },
    ]
  const sessionChoiceRows:
    value:[
      { choice:"Opaque sessions" guidance:"Use them when shared state enables immediate logout, permission changes, or per-device session control. The CRUD template recommends this model." },
      { choice:"JWT" guidance:"Use it when independent services must verify a signed assertion without calling a shared session store, paired with short expiry or a revocation strategy. Bearer is the transport scheme, not the token format." },
    ]
  Section id:"session-introduction" py:{ xs:6 md:10 }
    Grid columns:1 gap:3
      Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
        "SERVER / SESSIONS"
      Title size:{ xs:"3xl" md:"6xl" } weight:"black"
        "Opaque sessions"
      Text size:"lg" color:"muted"
        "Bearer describes how a credential travels. It does not require JWT. Dowe's CRUD template uses a server-owned ULID session backed by Cache and Database."
  Section id:"session-mental-model" p:{ xs:5 md:7 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "1 / MENTAL MODEL"
        Title size:"3xl" weight:"black"
          "Use an opaque ULID as the session id"
        Text size:"sm" color:"muted"
          "id session source:\"ulid\" generates a canonical 26-character ULID on the server. The client receives only the opaque id and sends it as Authorization: Bearer <ulid>. Claims and database credentials never enter the token."
      Code:
        language:"dowe"
        variant:"soft"
        scheme:"surface"
        copyLabel:"Copy Dowe"
        copiedLabel:"Copied"
        content:"""
          fn createSessionRepository params:{ userId:string }
            id session source:"ulid"
            query created db:appDb.insert table:"sessions" value:{ id:session userId:args.userId createdAt:now } required:["id", "userId"]
            str sessionKey source:"join" values:["session", session] delimiter:":"
            kv cached conn:appCache.set key:sessionKey value:{ id:session userId:args.userId }
            return value:{ id:session userId:args.userId }
        """
      Table:
        data:sessionModelRows
        variant:"soft"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"part" label:"Layer" width:"2fr"
        column field:"meaning" label:"Responsibility" width:"5fr"
  Section id:"session-validation" py:{ xs:7 md:10 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "2 / MIDDLEWARE"
        Title size:"3xl" weight:"black"
          "Validate Cache first, then Database"
        Text size:"sm" color:"muted"
          "session.verify rejects malformed or expired ULIDs, checks Cache, falls back to the sessions table, and returns valid:false when the session is absent. Only verified data should reach next context."
      Code:
        language:"dowe"
        variant:"soft"
        scheme:"surface"
        copyLabel:"Copy Dowe"
        copiedLabel:"Copied"
        content:"""
          import { appDb, appCache } from "@/server/config/database"

          middleware requireBearer
            bearer token value:req.header.Authorization
            session verified cache:appCache database:appDb token:token maxAge:2592000
            if verified.valid
              next context:{ auth:{ subject:verified.userId session:verified.id authorization:req.header.Authorization token:token } }
            return status:401 json:{ ok:false error:"Unauthorized" }
        """
      Table:
        data:sessionValidationRows
        variant:"soft"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"step" label:"Step" width:"2fr"
        column field:"guidance" label:"Result" width:"5fr"
  Section id:"session-lifecycle" p:{ xs:5 md:7 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "3 / LIFECYCLE"
        Title size:"3xl" weight:"black"
          "Expiration and logout are stateful"
        Text size:"sm" color:"muted"
          "The default CRUD maxAge is 30 days. Runtime checks the ULID timestamp on every validation. Logout deletes both session:<ulid> from Cache and the matching sessions record, so revocation is immediate."
      Code:
        language:"dowe"
        variant:"soft"
        scheme:"surface"
        copyLabel:"Copy Dowe"
        copiedLabel:"Copied"
        content:"""
          fn logoutUserService params:{ session:string }
            deleteSessionRepository deleted args:{ id:args.session }
            return value:{ authenticated:false guest:true authorization:"" token:"" }
        """
      Table:
        data:sessionLifecycleRows
        variant:"soft"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"concern" label:"Concern" width:"2fr"
        column field:"guidance" label:"Rule" width:"5fr"
  Section id:"session-jwt-choice" py:{ xs:7 md:10 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "4 / DESIGN CHOICE"
        Title size:"3xl" weight:"black"
          "When should you use JWT?"
        Text size:"sm" color:"muted"
          "Choose the credential model from the authority your application needs: shared state favors immediate revocation, while signed assertions favor independent verification."
      Table:
        data:sessionChoiceRows
        variant:"soft"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"choice" label:"Model" width:"2fr"
        column field:"guidance" label:"Choose it when" width:"5fr"
