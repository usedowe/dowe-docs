page KvPage
  const cacheModelRows:
    value:[
      { part:"Connection" meaning:"cache appCache keeps provider, endpoint, account, secret, and Cache name server-only." },
      { part:"Operation" meaning:"kv saved conn binds get, set, delete, keys, or clear output for later statements." },
      { part:"Boundary" meaning:"Responses may include values, never Cache handles or credentials." },
    ]
  const cacheProviderRows:
    value:[
      { provider:"kv" guidance:"Connects to Cloudflare KV over HTTPS. account is the account ID and name is the namespace ID." },
      { provider:"redis" guidance:"Uses native Redis with ACL credentials and isolates keys under the logical name." },
      { provider:"dowe" guidance:"Uses one authenticated shared WebSocket connection to Dowe Cache." },
    ]
  const cacheOperationRows:
    value:[
      { operation:"get" guidance:"Returns JSON data or null." },
      { operation:"set" guidance:"Stores JSON and returns ok plus the key." },
      { operation:"delete" guidance:"Returns whether a value was deleted." },
      { operation:"keys" guidance:"Lists sorted keys with an optional prefix." },
      { operation:"clear" guidance:"Clears the selected Cache name." },
    ]
  Section id:"cache-introduction" py:{ xs:6 md:10 }
    Grid columns:1 gap:3
      Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
        "SERVER / CACHE"
      Title size:{ xs:"3xl" md:"6xl" } weight:"black"
        "Cache"
      Text size:"lg" color:"muted"
        "One server-only key-value contract for Cloudflare KV, Redis, and Dowe Cache, with a fast persistent local engine during dowe dev."
  Section id:"cache-mental-model" p:{ xs:5 md:7 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "1 / MENTAL MODEL"
        Title size:"3xl" weight:"black"
          "Declare Cache, operate with kv"
        Text size:"sm" color:"muted"
          "cache creates the provider connection. kv owns key-value operations and their result bindings, independently from Database query."
      Code:
        language:"dowe"
        variant:"soft"
        scheme:"surface"
        copyLabel:"Copy Dowe"
        copiedLabel:"Copied"
        content:"""
          handler cacheAppointment
            cache appCache provider:"dowe" host:env.CACHE_HOST port:env.CACHE_PORT account:env.CACHE_USER secret:env.CACHE_PASSWORD name:env.CACHE_DATABASE
            kv saved conn:appCache.set key:"appointment:1" value:{ patientName:"Ana" }
            kv value conn:appCache.get key:"appointment:1" required:true
            return json:{ ok:saved.ok data:value }
        """
      Table:
        data:cacheModelRows
        variant:"soft"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"part" label:"Part" width:"2fr"
        column field:"meaning" label:"Contract" width:"5fr"
  Section id:"cache-providers" py:{ xs:7 md:10 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "2 / PROVIDERS"
        Title size:"3xl" weight:"black"
          "Choose the production adapter"
        Text size:"sm" color:"muted"
          "Every provider uses the same required props. Store credential names in .env.example and values in .env or the process environment."
      Table:
        data:cacheProviderRows
        variant:"soft"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"provider" label:"Provider" width:"2fr"
        column field:"guidance" label:"Connection" width:"5fr"
  Section id:"cache-operations" p:{ xs:5 md:7 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "3 / OPERATIONS"
        Title size:"3xl" weight:"black"
          "Read, write, list, and clear"
        Text size:"sm" color:"muted"
          "required:true turns a missing get into a controlled NotFound result."
      Code:
        language:"dowe"
        variant:"soft"
        scheme:"surface"
        copyLabel:"Copy Dowe"
        copiedLabel:"Copied"
        content:"""
          kv value conn:appCache.get key:"appointment:1"
          kv saved conn:appCache.set key:"appointment:1" value:{ status:"scheduled" }
          kv deleted conn:appCache.delete key:"appointment:1"
          kv keys conn:appCache.keys prefix:"appointment:"
          kv cleared conn:appCache.clear
        """
      Table:
        data:cacheOperationRows
        variant:"soft"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"operation" label:"Operation" width:"2fr"
        column field:"guidance" label:"Result" width:"5fr"
  Section id:"cache-development" py:{ xs:7 md:10 }
    Grid columns:1 gap:4
      Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
        "4 / DOWE DEV"
      Title size:"3xl" weight:"black"
        "Local without Wrangler"
      Text size:"sm" color:"muted"
        "During dowe dev, all providers resolve only name and use the persistent Dowe engine at .dowe/kv. Host and credentials are not resolved, no remote provider starts, and no auxiliary port is opened."
      Code:
        language:"dowe"
        variant:"soft"
        scheme:"surface"
        copyLabel:"Copy path"
        copiedLabel:"Copied"
        content:".dowe/kv/<resolved-name>"
  Section id:"cache-service" p:{ xs:5 md:7 }
    Grid columns:1 gap:4
      Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
        "5 / DOWE CACHE"
      Title size:"3xl" weight:"black"
        "Run the authenticated service"
      Text size:"sm" color:"muted"
        "The Dowe provider authenticates before the WebSocket upgrade. Administrators create Cache names and accounts through dowe cache create-account."
      Code:
        language:"dowe"
        variant:"soft"
        scheme:"surface"
        copyLabel:"Copy Dowe"
        copiedLabel:"Copied"
        content:"""
          main
            server port:4148
              cache service
        """
