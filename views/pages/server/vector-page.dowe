page VectorPage
  const vectorConnectionRows:
    value:[
      { field:"provider" meaning:"Only dowe is supported initially." },
      { field:"name" meaning:"Selects the persistent Vector database." },
      { field:"credentials" meaning:"Account and secret authenticate only remote production connections." },
    ]
  const vectorOperationRows:
    value:[
      { operation:"upsert" result:"Stores id, vector, and optional metadata. The first upsert fixes the vector dimension." },
      { operation:"search" result:"Uses cosine similarity and supports limit, minScore, and exact metadata filters. Results are highest score first." },
      { operation:"read" result:"Returns an embedding or a controlled NotFound result." },
      { operation:"delete" result:"Removes an embedding and reports whether it existed." },
      { operation:"list" result:"Returns embeddings ordered by ID and can filter exact metadata." },
    ]
  const vectorModeRows:
    value:[
      { mode:"dowe dev" behavior:"Resolves only name and persists under .dowe/vector without opening another port." },
      { mode:"Production local" behavior:"Set host to local to keep the embedded Dowe engine." },
      { mode:"Production remote" behavior:"Any other host uses one authenticated persistent WebSocket." },
    ]
  Section id:"vector-introduction" py:{ xs:6 md:10 }
    Grid columns:1 gap:3
      Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
        "SERVER / VECTOR"
      Title size:{ xs:"3xl" md:"6xl" } weight:"black"
        "Find related records"
      Text size:"lg" color:"muted"
        "Store embeddings, attach JSON metadata, and find related records with the same server-only contract in local and remote environments."
      Button href:"/docs/server/kv" variant:"ghost" scheme:"muted" size:"sm"
        "Cache documentation"
  Section id:"vector-connection" p:{ xs:5 md:7 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "1 / CONNECTION"
        Title size:"3xl" weight:"black"
          "Declare Vector, operate with emb"
        Text size:"sm" color:"muted"
          "The initial provider is dowe. Connection values stay server-only and may come from the server environment."
      Code:
        language:"dowe"
        variant:"soft"
        scheme:"surface"
        copyLabel:"Copy Dowe"
        copiedLabel:"Copied"
        content:"vector appVector provider:\"dowe\" host:env.VECTOR_HOST port:env.VECTOR_PORT account:env.VECTOR_USER secret:env.VECTOR_PASSWORD name:env.VECTOR_DATABASE"
      Table:
        data:vectorConnectionRows
        variant:"soft"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"field" label:"Field" width:"2fr"
        column field:"meaning" label:"Meaning" width:"5fr"
  Section id:"vector-operations" py:{ xs:7 md:10 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "2 / OPERATIONS"
        Title size:"3xl" weight:"black"
          "Upsert, search, read, delete, and list"
        Text size:"sm" color:"muted"
          "The first upsert fixes the dimension. Search uses cosine similarity and returns the highest scores first."
      Code:
        language:"dowe"
        variant:"soft"
        scheme:"surface"
        copyLabel:"Copy operations"
        copiedLabel:"Copied"
        content:"""
          emb saved conn:appVector.upsert id:"article-1" vector:[0.12, 0.48, -0.2] metadata:{ kind:"article" }
          emb matches conn:appVector.search vector:req.body.vector limit:10 minScore:0.7 where:{ kind:"article" }
          emb article conn:appVector.read id:req.params.id required:true
          emb removed conn:appVector.delete id:req.params.id
          emb articles conn:appVector.list limit:100 where:{ kind:"article" }
        """
      Table:
        data:vectorOperationRows
        variant:"soft"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"operation" label:"Operation" width:"2fr"
        column field:"result" label:"Contract" width:"5fr"
  Section id:"vector-modes" p:{ xs:5 md:7 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "3 / LOCAL AND REMOTE"
        Title size:"3xl" weight:"black"
          "One contract, explicit production mode"
        Text size:"sm" color:"muted"
          "The same declarations work during development and production. The host value decides whether the connection stays embedded or crosses an authenticated WebSocket."
      Table:
        data:vectorModeRows
        variant:"soft"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"mode" label:"Mode" width:"2fr"
        column field:"behavior" label:"Behavior" width:"5fr"
  Section id:"vector-service" py:{ xs:7 md:10 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "4 / DOWE VECTOR"
        Title size:"3xl" weight:"black"
          "Run the remote provider"
        Text size:"sm" color:"muted"
          "The maintained dowe-vector project authenticates an account and bearer secret before the WebSocket upgrade."
      Code:
        language:"dowe"
        variant:"soft"
        scheme:"surface"
        copyLabel:"Copy Dowe"
        copiedLabel:"Copied"
        content:"""
          main
            server port:4149
              vector service
        """
      Code:
        language:"dowe"
        variant:"soft"
        scheme:"surface"
        copyLabel:"Copy command"
        copiedLabel:"Copied"
        content:"dowe vector create-account semantic-search search-api"
