page FileStoragePage
  const fileOperationRows:
    value:[
      {
        operation:"write and read"
        behavior:"write returns size and SHA-256 metadata. read produces a byte binding that can be returned or passed to another server declaration."
      },
      {
        operation:"exists and delete"
        behavior:"exists reports availability without reading content. delete is idempotent and reports whether a file was removed."
      },
    ]
  const fileSafetyRows:
    value:[
      {
        rule:"Atomic writes"
        guidance:"Dowe creates parent directories, writes and synchronizes a temporary file, then renames it into place."
      },
      {
        rule:"Optional integrity"
        guidance:"sha256 rejects mismatched bytes before the destination is published."
      },
      {
        rule:"Native runtime"
        guidance:"File Storage is available in native Dowe Server and is rejected for edge targets without host storage."
      },
    ]
  Section id:"file-storage-introduction" py:{ xs:6 md:10 }
    Grid columns:1 gap:3
      Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
        "SERVER / FILE STORAGE"
      Title size:{ xs:"3xl" md:"6xl" } weight:"black"
        "Persist bounded server files"
      Text size:"lg" color:"muted"
        "file is Dowe's server-only storage declaration for immutable artifacts, exports, and generated media. The shared Rust runtime owns paths, integrity checks, and asynchronous host I/O."
  Section id:"file-storage-operations" p:{ xs:5 md:7 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "1 / OPERATIONS"
        Title size:"3xl" weight:"black"
          "Write, read, inspect, and delete"
        Text size:"sm" color:"muted"
          "Every declaration names its result first. root selects the operator-configured storage directory and path must resolve below that root."
      Code:
        language:"dowe"
        variant:"soft"
        scheme:"surface"
        copyLabel:"Copy Dowe"
        copiedLabel:"Copied"
        content:"""
          handler manageArtifact
            request payload source:"bytes"
            file stored source:"write" root:env.STORAGE_ROOT path:req.params.hash data:payload sha256:req.params.hash
            file available source:"exists" root:env.STORAGE_ROOT path:req.params.hash
            file artifact source:"read" root:env.STORAGE_ROOT path:req.params.hash
            file removed source:"delete" root:env.STORAGE_ROOT path:req.params.hash
            return json:{ stored:stored available:available removed:removed }
        """
      Table:
        data:fileOperationRows
        variant:"soft"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"operation" label:"Operation" width:"2fr"
        column field:"behavior" label:"Result" width:"5fr"
  Section id:"file-storage-safety" py:{ xs:7 md:10 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "2 / STORAGE BOUNDARY"
        Title size:"3xl" weight:"black"
          "Keep every path confined"
        Text size:"sm" color:"muted"
          "Paths must be non-empty and relative. Dowe rejects absolute paths, dot traversal, and symlinks below the configured root."
      Table:
        data:fileSafetyRows
        variant:"soft"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"rule" label:"Rule" width:"2fr"
        column field:"guidance" label:"Behavior" width:"5fr"
