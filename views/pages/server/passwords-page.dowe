page PasswordsPage
  const passwordSecurityRows:
    value:[
      {
        rule:"Argon2id"
        guidance:"Each hash receives a random salt and stores its parameters in the standard PHC string."
      },
      {
        rule:"Required verification"
        guidance:"required true returns Unauthorized when credentials do not match."
      },
      {
        rule:"Async boundary"
        guidance:"Memory-hard work runs outside the asynchronous request executor."
      },
    ]
  Section id:"passwords-introduction" py:{ xs:6 md:10 }
    Grid columns:1 gap:3
      Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
        "SERVER / PASSWORDS"
      Title size:{ xs:"3xl" md:"6xl" } weight:"black"
        "Protect account credentials"
      Text size:"lg" color:"muted"
        "password is Dowe's server-only capability for salted Argon2id hashing and constant-interface verification. Password values and hashes never enter Views."
  Section id:"passwords-flow" p:{ xs:5 md:7 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "1 / ACCOUNT FLOW"
        Title size:"3xl" weight:"black"
          "Hash on registration, verify on login"
        Text size:"sm" color:"muted"
          "Store only the PHC result. Login reads the account by a public identifier and verifies the submitted password against that hash."
      Code:
        language:"dowe"
        variant:"soft"
        scheme:"surface"
        copyLabel:"Copy Dowe"
        copiedLabel:"Copied"
        content:"""
          handler registerAccount
            const body:RegisterInput value:req.json
            password passwordHash source:"hash" value:body.password
            query user db:CloudDb.insert table:"users" value:{ email:body.email passwordHash:passwordHash }
            return status:201 json:{ ok:true }

          handler loginAccount
            const body:LoginInput value:req.json
            query user db:CloudDb.read table:"users" where:{ email:body.email } required:true
            password verified source:"verify" value:body.password hash:user.passwordHash required:true
            return json:{ ok:true }
        """
      Table:
        data:passwordSecurityRows
        variant:"soft"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"rule" label:"Rule" width:"2fr"
        column field:"guidance" label:"Behavior" width:"5fr"
  Section id:"passwords-safety" py:{ xs:7 md:10 }
    Grid columns:1 gap:4
      Text size:"xs" weight:"bold" spacing:"widest" color:"danger"
        "2 / SECURITY BOUNDARY"
      Title size:"3xl" weight:"black"
        "Never return or log credentials"
      Text size:"sm" color:"muted"
        "Dowe rejects empty and non-string password inputs. Keep submitted values, PHC hashes, Database fields, and verification bindings inside Server handlers and functions."
      Alert type:"warning" message:"A password hash is still credential material. Store it only in the server data layer and never serialize it into a view response."
