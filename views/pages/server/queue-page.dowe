page QueuePage
  const queueTopologyRows:
    value:[
      { rule:"Competing consumers" meaning:"Subscriptions on one queue share deliveries. One active delivery is not duplicated to another consumer on that queue." },
      { rule:"Pub/sub copies" meaning:"Two queues bound to the same pattern each receive an independent copy of the published message." },
      { rule:"Durable topology" meaning:"Declared queues, bindings, and ready messages persist in the provider namespace, protected by an exclusive .lock." },
    ]
  const queueDeliveryRows:
    value:[
      { decision:"ACK" meaning:"Removes the delivery permanently after the consumer has processed the message." },
      { decision:"NACK with requeue" meaning:"Puts the message at the front and marks it redelivered:true." },
      { decision:"NACK without requeue" meaning:"Discards the delivery instead of making it available again." },
      { decision:"Close or restart" meaning:"Requeues every persisted delivery still waiting for a decision." },
    ]
  const queueProviderRows:
    value:[
      { provider:"Dowe" contract:"Authenticated WebSocket, durable storage below .dowe/queue, and authoritative declare, bind, publish, and topology operations." },
      { provider:"RabbitMQ" contract:"Durable namespaced topic exchange, publisher confirms, and streaming consumers whose ACK/NACK stays on the same AMQP channel." },
      { provider:"Cloudflare" contract:"Cloudflare Worker Queue producer binding emitted by deploy. The Worker sends JSON through DOWE_QUEUE_<QUEUE_NAME>." },
      { provider:"Vercel" contract:"Vercel Queues regional REST publication using the server deployment token and optional Vqs-Deployment-Id." },
    ]
  const queueApplicationRows:
    value:[
      { environment:"Local development" guidance:"dowe dev uses persistent local storage below .dowe/queue/<vhost> and resolves only vhost. It does not contact the authored provider." },
      { environment:"Deploy environments" guidance:"Deploy resolves the selected .env.live, .env.stage, or .env.uat values. Secrets remain deployment secrets and are not embedded in generated source." },
      { environment:"Cloudflare" guidance:"The Worker deploy emits a DOWE_QUEUE_<QUEUE_NAME> producer binding. Cloudflare confirms acceptance without a provider message ID, so sent.id is a Dowe correlation ID." },
      { environment:"Vercel" guidance:"The deploy calls the regional Queue API with the secret as a bearer token. A provider message ID is returned for 201; deferred 202 responses use a Dowe correlation ID." },
      { environment:"Publish boundary" guidance:"msg publish targets a queue already declared by the CLI or provider API. It does not declare, bind, reinterpret, or retry after an ambiguous response." },
    ]
  const queueCliRows:
    value:[
      { area:"Lifecycle" commands:"start, create-account, init, and list set up the service and namespace." },
      { area:"Topology" commands:"inspect, declare, and bind review and change durable topology." },
      { area:"Messages" commands:"publish sends JSON and purge removes only ready messages from one queue." },
      { area:"Retry rule" commands:"Only inspect may retry automatically. Mutating commands and receipt decisions are not retried after an ambiguous response." },
    ]
  Section id:"queue-introduction" py:{ xs:6 md:10 }
    Grid columns:1 gap:3
      Text size:"xs" weight:"bold" spacing:"widest"
        "SERVER / QUEUE"
      Title size:{ xs:"3xl" md:"6xl" } weight:"black"
        "Deliver durable work"
      Text size:"lg"
        "Queue provides durable work queues and topic pub/sub with explicit delivery decisions. The same server contract serves local Dowe storage, RabbitMQ, Cloudflare Worker bindings, and Vercel Queues."
  Section id:"queue-topology" p:{ xs:5 md:7 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest"
          "1 / TOPOLOGY"
        Title size:"3xl" weight:"black"
          "Bindings decide where a message goes"
        Text size:"sm"
          "Topics use dot-separated words. A star matches one word and a hash matches zero or more words. Publishing copies a message to every matching queue."
      Code:
        language:"dowe"
        variant:"solid"
        scheme:"surface"
        copyLabel:"Copy commands"
        copiedLabel:"Copied"
        content:"""
          dowe queue init jobs
          dowe queue declare jobs email-workers
          dowe queue declare jobs email-notifications
          dowe queue bind jobs email-workers orders.*
          dowe queue bind jobs email-notifications orders.*
          dowe queue publish jobs orders.created '{"id":"order-42"}'
        """
      Table:
        data:queueTopologyRows
        variant:"solid"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"rule" label:"Rule" width:"2fr"
        column field:"meaning" label:"What happens" width:"5fr"
      Text size:"sm"
        "A live service, second server, and local CLI cannot directly own the same namespace concurrently. Lock acquisition fails closed; use the authenticated service protocol for a namespace owned by a running service."
  Section id:"queue-delivery" py:{ xs:7 md:10 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest"
          "2 / DELIVERY"
        Title size:"3xl" weight:"black"
          "At-least-once, session-bound decisions"
        Text size:"sm"
          "Each subscription keeps its own streaming session. An opaque receipt can be acknowledged or rejected only once and only on that session."
      Table:
        data:queueDeliveryRows
        variant:"solid"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"decision" label:"Decision" width:"2fr"
        column field:"meaning" label:"Effect" width:"5fr"
      Alert type:"warning" message:"Delivery is at-least-once. Exactly-once delivery and visibility timeouts are not part of this release."
  Section id:"queue-providers" p:{ xs:5 md:7 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest"
          "3 / PROVIDERS"
        Title size:"3xl" weight:"black"
          "One contract, four provider boundaries"
        Text size:"sm"
          "The provider API and CLI share local and native publication semantics while deploy adapters connect edge handlers to the selected provider."
      Table:
        data:queueProviderRows
        variant:"solid"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"provider" label:"Provider" width:"2fr"
        column field:"contract" label:"What it owns" width:"5fr"
      Text size:"sm"
        "Remote Dowe Queue and RabbitMQ connections require TLS. Cloudflare uses the generated Worker binding; Vercel uses its regional HTTPS API."
  Section id:"queue-service" py:{ xs:7 md:10 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest"
          "4 / DOWE QUEUE"
        Title size:"3xl" weight:"black"
          "Run the maintained service"
        Text size:"sm"
          "The host reserves one authenticated WebSocket path, takes exclusive ownership of each opened namespace, and leaves Queue operations to the shared Rust crate."
      Code:
        language:"dowe"
        variant:"solid"
        scheme:"surface"
        copyLabel:"Copy Dowe"
        copiedLabel:"Copied"
        content:"""
          main
            server port:4150
              queue service
        """
      Text size:"sm"
        "Account writers use .dowe/queue/_auth/.lock for exclusive read-modify-write and atomic replacement. A second writer fails closed instead of losing an account record."
      Code:
        language:"dowe"
        variant:"solid"
        scheme:"surface"
        copyLabel:"Copy commands"
        copiedLabel:"Copied"
        content:"""
          dowe queue create-account jobs jobs-api
          dowe dev --target server
          dowe queue inspect jobs
        """
  Section id:"queue-application" py:{ xs:7 md:10 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest"
          "5 / SERVER-ONLY APPLICATION API"
        Title size:"3xl" weight:"black"
          "Publish to an existing queue"
        Text size:"sm"
          "Server actions can select Dowe, RabbitMQ, Cloudflare, or Vercel and publish JSON directly to a named queue. The connection, credentials, and payload stay on the server."
      Code:
        language:"dowe"
        variant:"solid"
        scheme:"surface"
        copyLabel:"Copy Dowe"
        copiedLabel:"Copied"
        content:"""
          handler enqueueNotification
            queue appQueue provider:"dowe" host:env.QUEUE_HOST port:env.QUEUE_PORT account:env.QUEUE_USER secret:env.QUEUE_PASSWORD vhost:env.QUEUE_VHOST
            msg sent conn:appQueue.publish queue:"notifications" payload:{ userId:"123" event:"user_created" }
            return json:{ ok:sent.ok messageId:sent.id }
        """
      Text size:"sm"
        "Declare QUEUE_HOST, QUEUE_PORT, QUEUE_USER, QUEUE_PASSWORD, and QUEUE_VHOST in the root .env.example with empty or placeholder values. During dowe dev every provider uses local Dowe; deploys resolve the selected .env.live, .env.stage, or .env.uat values. Never expose secrets to Views."
      Table:
        data:queueApplicationRows
        variant:"solid"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"environment" label:"Boundary" width:"2fr"
        column field:"guidance" label:"Rule" width:"5fr"
  Section id:"queue-cli" p:{ xs:5 md:7 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest"
          "6 / CLI"
        Title size:"3xl" weight:"black"
          "Inspect and administer local namespaces"
        Text size:"sm"
          "The root command calls the same Rust implementation used by runtime and IPC. Direct local commands fail closed when a live service owns the namespace lock."
      Table:
        data:queueCliRows
        variant:"solid"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"area" label:"Area" width:"2fr"
        column field:"commands" label:"Use" width:"5fr"
  Section id:"queue-boundary" py:{ xs:7 md:10 }
    Grid columns:1 gap:4
      Text size:"xs" weight:"bold" spacing:"widest"
        "7 / CURRENT SUPPORT"
      Title size:"3xl" weight:"black"
        "Finite publication, streaming consumption"
      Text size:"sm"
        "Dowe Source Format supports queue service, server-only Queue connections, and direct msg publish. Cloudflare and Vercel edge handlers support one static publication per handler; dynamic actions and source-level consume, subscribe, ACK, and NACK remain native Rust provider APIs. Secrets, receipts, and payloads remain server-only."
      Alert type:"info" message:"Provision remote queues through the provider control plane before deployment. The contract excludes arbitrary AMQP exchange types, priorities, TTL, dead-lettering, exactly-once delivery, visibility timeouts, and transparent subscription reconnection."
