page BackgroundJobsPage
  const jobDefinitionRows:
    value:[
      {
        concern:"Reusable work"
        guidance:"The same function contract can be tested and reused like any other server function."
      },
      {
        concern:"Server-only access"
        guidance:"Database, Cache, environment, and provider handles stay inside the worker function."
      },
      {
        concern:"Explicit input"
        guidance:"The params contract makes every value required by the job visible before it runs."
      },
    ]
  const cronRows:
    value:[
      { field:"Minute" values:"0-59" },
      { field:"Hour" values:"0-23" },
      { field:"Day" values:"1-31" },
      { field:"Month" values:"1-12" },
      { field:"Weekday" values:"0-7, Sunday is 0 or 7" },
    ]
  const jobRuntimeRows:
    value:[
      { behavior:"Isolated execution" guidance:"Every run starts in a child process. A worker failure is logged without terminating the server." },
      { behavior:"No local overlap" guidance:"If the previous run is still active, Dowe skips the next due run for that registration." },
      { behavior:"No catch-up" guidance:"Runs missed while the server is offline are not replayed after startup." },
    ]
  Section id:"background-jobs-introduction" py:{ xs:6 md:10 }
    Grid columns:1 gap:3
      Text size:"xs" weight:"bold" spacing:"widest"
        "SERVER / BACKGROUND JOBS"
      Title size:{ xs:"3xl" md:"6xl" } weight:"black"
        "Run scheduled server work"
      Text size:"lg"
        "A background job is an imported server function registered with cron. Dowe runs each scheduled execution in an isolated worker without blocking the server."
  Section id:"background-jobs-definition" p:{ xs:5 md:7 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest"
          "1 / DEFINE THE WORK"
        Title size:"3xl" weight:"black"
          "Use an ordinary server function"
        Text size:"sm"
          "Jobs do not need a special declaration. Put the reusable work in a server fn, declare its input with params, and keep provider access inside that function."
      Code:
        language:"dowe"
        variant:"solid"
        scheme:"surface"
        copyLabel:"Copy Dowe"
        copiedLabel:"Copied"
        content:"""
          import appDb from "@/server/config/database"

          fn compactAudit params:{ retentionDays:number }
            query removed conn:appDb.delete table:"audit_events" where:{ olderThanDays:args.retentionDays }
            return value:{ removed:removed }
        """
      Table:
        data:jobDefinitionRows
        variant:"solid"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"concern" label:"Concern" width:"2fr"
        column field:"guidance" label:"Rule" width:"5fr"
  Section id:"background-jobs-registration" py:{ xs:7 md:10 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest"
          "2 / REGISTER THE SCHEDULE"
        Title size:"3xl" weight:"black"
          "Attach cron directly to server.init"
        Text size:"sm"
          "Import the function in main.dowe and register it under server.init with the explicit fn prop. Cron creates no result binding, the schedule uses five UTC fields, and args must be static JSON because init has no request-local scope."
      Code:
        language:"dowe"
        variant:"solid"
        scheme:"surface"
        copyLabel:"Copy Dowe"
        copiedLabel:"Copied"
        content:"""
          import compactAudit from "@/server/tasks/compact-audit"

          main
            server port:8080
              init
                cron fn:compactAudit schedule:"0 3 * * *" args:{ retentionDays:30 }
        """
      Table:
        data:cronRows
        variant:"solid"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"field" label:"Field" width:"2fr"
        column field:"values" label:"Accepted values" width:"5fr"
      Text size:"sm"
        "Cron fields accept *, numeric values, lists, ranges, and steps such as */15. Each server replica owns its own scheduler."
  Section id:"background-jobs-runtime" pb:{ xs:7 md:10 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest"
          "3 / RUNTIME BEHAVIOR"
        Title size:"3xl" weight:"black"
          "Know what happens when a job runs"
      Table:
        data:jobRuntimeRows
        variant:"solid"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"behavior" label:"Behavior" width:"2fr"
        column field:"guidance" label:"Result" width:"5fr"
      Alert type:"info" message:"Current support does not include source-level cancellation, result inspection, durable delivery, or distributed singleton scheduling."
