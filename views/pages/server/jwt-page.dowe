page JwtPage
  const jwtModelRows:
    value:[
      { part:"JWT variable" meaning:"jwt token binds the compact token or validation result inside the current action." },
      { part:"Result" meaning:"claims creates a token; token validates or decrypts an existing token." },
      { part:"Boundary" meaning:"Views receive only deliberate response data, never JWT secrets, keys, or utility state." },
    ]
  const jwtVerifyRows:
    value:[
      { operation:"Sign" guidance:"Uses secret plus HS256 and returns a compact signed JWS token." },
      { operation:"Verify" guidance:"Returns valid and trusted claims only after signature and configured claim checks pass." },
    ]
  const jwtSecurityRows:
    value:[
      { rule:"No Node.js" guidance:"JWT behavior is executed by shared Dowe crates, not user JavaScript or an external crypto CLI." },
      { rule:"No client secrets" guidance:"secret and key values must be referenced only from server source and never enter client artifacts." },
      { rule:"Explicit migration" guidance:"Replace let result = jwt operations and const bindings with one jwt result declaration." },
    ]
  Section id:"jwt-introduction" py:{ xs:6 md:10 }
    Grid columns:1 gap:3
      Text size:"xs" weight:"bold" spacing:"widest"
        "SERVER / JWT"
      Title size:{ xs:"3xl" md:"6xl" } weight:"black"
        "JWT"
      Text size:"lg"
        "JWT is Dowe's Dowe-owned server utility for signing, verifying, encrypting, and decrypting tokens without Node.js, npm packages, or client-side secrets."
  Section id:"jwt-mental-model" p:{ xs:5 md:7 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest"
          "1 / MENTAL MODEL"
        Title size:"3xl" weight:"black"
          "Bind each JWT result directly"
        Text size:"sm"
          "jwt binds a token or verification result directly. Its secret or key stays server-only for the current handler or middleware, and the old let value = jwt form is rejected."
      Code:
        language:"dowe"
        variant:"solid"
        scheme:"surface"
        copyLabel:"Copy Dowe"
        copiedLabel:"Copied"
        content:"""
          handler createSession
            jwt token secret:env.JWT_SECRET algorithm:"HS256" claims:{ sub:"user-1" }
            return json:{ ok:true token:token }
        """
      Table:
        data:jwtModelRows
        variant:"solid"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"part" label:"Part" width:"2fr"
        column field:"meaning" label:"Contract" width:"5fr"
  Section id:"jwt-verify" py:{ xs:7 md:10 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest"
          "2 / SIGNED TOKENS"
        Title size:"3xl" weight:"black"
          "Verify bearer tokens before trusting claims"
        Text size:"sm"
          "bearer only extracts the token. jwt verified validates the HS256 signature and standard time claims before middleware explicitly calls next."
      Code:
        language:"dowe"
        variant:"solid"
        scheme:"surface"
        copyLabel:"Copy Dowe"
        copiedLabel:"Copied"
        content:"""
          middleware requireBearer params:{}
            bearer token value:req.header.Authorization
            jwt verified secret:env.JWT_SECRET algorithm:"HS256" token:token
            if verified.valid
              next
            return status:401 json:{ ok:false error:"Unauthorized" }
        """
      Table:
        data:jwtVerifyRows
        variant:"solid"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"operation" label:"Operation" width:"2fr"
        column field:"guidance" label:"Result" width:"5fr"
  Section id:"jwt-encryption" p:{ xs:5 md:7 }
    Grid columns:1 gap:4
      Text size:"xs" weight:"bold" spacing:"widest"
        "3 / ENCRYPTED TOKENS"
      Title size:"3xl" weight:"black"
        "Use a separate JWE variable for encrypted claims"
      Text size:"sm"
        "JWE uses direct key management with A256GCM. jwt infers encryption from key plus claims, and decryption from key plus token."
      Code:
        language:"dowe"
        variant:"solid"
        scheme:"surface"
        copyLabel:"Copy Dowe"
        copiedLabel:"Copied"
        content:"""
          handler createEncryptedSession
            jwt token key:env.JWT_KEY algorithm:"dir" encryption:"A256GCM" claims:{ sub:"user-1" }
            return json:{ token:token }
        """
  Section id:"jwt-security" py:{ xs:7 md:10 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest"
          "4 / SECURITY"
        Title size:"3xl" weight:"black"
          "Fail closed and keep authority on the server"
        Text size:"sm"
          "Dowe rejects alg:none, unsupported algorithms, missing server environment values, invalid signatures, expired tokens, and tokens that are not yet valid. Declare secret names in .env.example and supply values through .env or the process environment. Runtime errors do not log tokens, headers, keys, or secrets."
      Table:
        data:jwtSecurityRows
        variant:"solid"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"rule" label:"Rule" width:"2fr"
        column field:"guidance" label:"Why it matters" width:"5fr"
