page TlsPage
  const tlsAcmeRows:
    value:[
      { concern:"Multiple domains" guidance:"One declared set becomes the certificate SAN set. Duplicate names are removed before issuance." },
      { concern:"Automatic renewal" guidance:"ACME state loads cached material and renews the certificate while the server stays active." },
      { concern:"Server only" guidance:"Views never receive account state, cache contents, private keys, or managed domain sources." },
    ]
  const tlsManagedRows:
    value:[
      { concern:"Authenticated catalog" guidance:"The endpoint and bearer remain server-only. Responses may contain domain strings or records with host or hostname." },
      { concern:"Ports 80 and 443" guidance:"HTTPS stays on 443. Port 80 issues permanent redirects while preserving the request path and query." },
      { concern:"Closed host policy" guidance:"Only hosts in the effective TLS catalog redirect. Unknown or malformed Host values receive 421." },
    ]
  const tlsPolicyRows:
    value:[
      { owner:"Dowe runtime" responsibility:"Certificate issuance, ACME state, renewal, cached private material, and effective domain matching." },
      { owner:"Authored server" responsibility:"Administrator authorization, upstream routing, DNS integration, application deployment, and tenant policy." },
    ]
  Section id:"tls-introduction" py:{ xs:6 md:10 }
    Grid columns:1 gap:3
      Text size:"xs" weight:"bold" spacing:"widest"
        "SERVER / TLS"
      Title size:{ xs:"3xl" md:"6xl" } weight:"black"
        "Own HTTPS in the Dowe runtime"
      Text size:"lg"
        "Dowe issues, caches, and renews multi-domain Let's Encrypt certificates without Certbot, Node.js, or an external reverse proxy."
  Section id:"tls-acme" p:{ xs:5 md:7 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest"
          "1 / ACME"
        Title size:"3xl" weight:"black"
          "Declare every public hostname"
        Text size:"sm"
          "TLS-ALPN-01 runs on the HTTPS listener. The cache lives below .dowe, staging is safe by default, and certificate state is polled for automatic renewal."
      Code:
        language:"dowe"
        variant:"solid"
        scheme:"surface"
        copyLabel:"Copy Dowe"
        copiedLabel:"Copied"
        content:"""
          main
            server port:443
              tls:
                mode:"acme"
                domains:["example.com" "www.example.com"]
                email:"admin@example.com"
                staging:false
        """
      Table:
        data:tlsAcmeRows
        variant:"solid"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"concern" label:"Concern" width:"2fr"
        column field:"guidance" label:"What Dowe does" width:"5fr"
  Section id:"tls-managed-domains" py:{ xs:7 md:10 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest"
          "2 / MANAGED DOMAINS"
        Title size:"3xl" weight:"black"
          "Feed domains from Dowe data"
        Text size:"sm"
          "A reverse proxy or application platform can load domains from local Dowe data or an authenticated HTTPS control plane. Dowe validates and reloads the effective set when it changes."
      Code:
        language:"dowe"
        variant:"solid"
        scheme:"surface"
        copyLabel:"Copy Dowe"
        copiedLabel:"Copied"
        content:"""
          tls:
            mode:"acme"
            domains:["platform.example.com"]
            email:"ops@example.com"
            staging:false
            domainsFrom:{
              endpoint:env.CONTROL_PLANE_URL
              path:"/v1/domains"
              bearer:env.CONTROL_PLANE_TOKEN
              timeoutMs:5000
            }
            refreshSeconds:30
            httpPort:80
        """
      Table:
        data:tlsManagedRows
        variant:"solid"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"concern" label:"Concern" width:"2fr"
        column field:"guidance" label:"What happens" width:"5fr"
      Table:
        data:tlsPolicyRows
        variant:"solid"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"owner" label:"Owner" width:"2fr"
        column field:"responsibility" label:"Responsibility" width:"5fr"
  Section id:"tls-local" py:{ xs:7 md:10 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest"
          "3 / LOCAL DEVELOPMENT"
        Title size:"3xl" weight:"black"
          "Use a self-signed localhost certificate"
        Text size:"sm"
          "Let's Encrypt does not issue localhost certificates. Local mode creates an ephemeral self-signed certificate without modifying the system trust store."
      Code:
        language:"dowe"
        variant:"solid"
        scheme:"surface"
        copyLabel:"Copy Dowe"
        copiedLabel:"Copied"
        content:"""
          main
            server port:8443
              tls:
                mode:"local"
                domains:["localhost" "app.localhost"]
        """
