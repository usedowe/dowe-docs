page RequestBytesPage
  const requestBytesRows:
    value:[
      {
        rule:"Exact body"
        guidance:"payload preserves the bytes received over HTTP instead of producing a parsed JSON value."
      },
      {
        rule:"Server only"
        guidance:"Views and client targets cannot receive a host byte binding or gain filesystem authority."
      },
      {
        rule:"Bound input"
        guidance:"The general request limit still applies, so accepting raw bytes does not create an unbounded upload path."
      },
    ]
  Section id:"request-bytes-introduction" py:{ xs:6 md:10 }
    Grid columns:1 gap:3
      Text size:"xs" weight:"bold" spacing:"widest"
        "SERVER / REQUEST BYTES"
      Title size:{ xs:"3xl" md:"6xl" } weight:"black"
        "Receive the exact HTTP body"
      Text size:"lg"
        "request source bytes binds the incoming body without JSON decoding or text conversion. The Rust runtime preserves its byte sequence for storage, hashing, functions, and byte responses."
  Section id:"request-bytes-mental-model" p:{ xs:5 md:7 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest"
          "1 / MENTAL MODEL"
        Title size:"3xl" weight:"black"
          "Bind bytes before using them"
        Text size:"sm"
          "The name after request is the byte binding available to following server declarations. It belongs inside an HTTP handler and remains subject to the runtime request-size limit."
      Code:
        language:"dowe"
        variant:"solid"
        scheme:"surface"
        copyLabel:"Copy Dowe"
        copiedLabel:"Copied"
        content:"""
          handler uploadArtifact
            request payload source:"bytes"
            file stored source:"write" root:env.STORAGE_ROOT path:req.params.hash data:payload sha256:req.params.hash
            return status:201 json:stored
        """
      Table:
        data:requestBytesRows
        variant:"solid"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"rule" label:"Rule" width:"2fr"
        column field:"guidance" label:"What it means" width:"5fr"
  Section id:"request-bytes-response" py:{ xs:7 md:10 }
    Grid columns:1 gap:4
      Text size:"xs" weight:"bold" spacing:"widest"
        "2 / BYTE FLOW"
      Title size:"3xl" weight:"black"
        "Return a byte binding directly"
      Text size:"sm"
        "A byte binding read from storage can be returned with an explicit content type. Dowe avoids a JSON or UTF-8 round trip across the complete handler."
      Code:
        language:"dowe"
        variant:"solid"
        scheme:"surface"
        copyLabel:"Copy Dowe"
        copiedLabel:"Copied"
        content:"""
          handler downloadArtifact
            file artifact source:"read" root:env.STORAGE_ROOT path:req.params.hash
            return bytes:artifact contentType:"application/vnd.dowe.application"
        """
      Alert type:"info" message:"Current support covers HTTP handlers in the native Dowe server runtime. Cloudflare edge targets do not receive this server-only host capability."
