page CloudControlPlanePage
  const controlPlaneRows:
    value:[
      {
        resource:"Registry"
        responsibility:"Physical immutable artifact storage endpoints."
      },
      {
        resource:"Runtime"
        responsibility:"Execution upstreams with explicit ready, loading, or offline state."
      },
      {
        resource:"Pool"
        responsibility:"Validated ready Runtime membership with roundRobin strategy."
      },
      {
        resource:"Route"
        responsibility:"Host, project, state, fallbacks, and eligible upstreams published to Cache."
      },
    ]
  const fallbackRows:
    value:[
      {
        state:"Loading page"
        behavior:"A loading route redirects temporarily while the Runtime loads and verifies the binary."
      },
      {
        state:"Error page"
        behavior:"An error state or empty ready pool redirects to the configured failure surface."
      },
    ]
  Section id:"cloud-control-plane-introduction" py:{ xs:6 md:10 }
    Grid columns:1 gap:3
      Text size:"xs" weight:"bold" spacing:"widest"
        "SERVER / DOWE CLOUD"
      Title size:{ xs:"3xl" md:"6xl" } weight:"black"
        "Publish a balanced control plane"
      Text size:"lg"
        "The /dash administrator owns Registry and Runtime inventory, active round-robin pools, and host routes sent to Dowe Proxy."
  Section id:"cloud-control-plane-model" p:{ xs:5 md:7 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest"
          "1 / INVENTORY MODEL"
        Title size:"3xl" weight:"black"
          "Separate artifacts, runtimes, pools, and routes"
        Text size:"sm"
          "Each resource has one responsibility. The dashboard validates inventory and publishes the route; Proxy reads only its local Dowe Cache while serving a request."
      Table:
        data:controlPlaneRows
        variant:"solid"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"resource" label:"Resource" width:"2fr"
        column field:"responsibility" label:"Owns" width:"5fr"
  Section id:"cloud-control-plane-request" py:{ xs:7 md:10 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest"
          "2 / REQUEST PATH"
        Title size:"3xl" weight:"black"
          "Cloud configures; Proxy serves"
        Text size:"sm"
          "Dowe Cloud validates inventory and publishes through the protected Proxy API. Dowe Proxy reads only its local Dowe Cache for each request and never waits for the dashboard or Database."
      Code:
        language:"dowe"
        variant:"solid"
        scheme:"surface"
        copyLabel:"Copy Dowe"
        copiedLabel:"Copied"
        content:"""
          handler forwardRequest
            request host source:"header" name:"Host"
            kv route conn:RouteCache.get key:host required:true
            return reverse:route.upstreams strategy:"roundRobin" state:route.state loadingUrl:route.loadingUrl errorUrl:route.errorUrl
        """
      Table:
        data:fallbackRows
        variant:"solid"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"state" label:"State" width:"2fr"
        column field:"behavior" label:"Fallback" width:"5fr"
