page DatabaseEntitiesPage
  const entityTypeRows:
    value:[
      { type:"string" mapping:"TEXT on PostgreSQL and D1." },
      { type:"bool" mapping:"BOOLEAN on PostgreSQL and INTEGER on D1." },
      { type:"int" mapping:"BIGINT on PostgreSQL and INTEGER on D1." },
      { type:"number" mapping:"DOUBLE PRECISION on PostgreSQL and REAL on D1." },
      { type:"decimal" mapping:"DOUBLE PRECISION on PostgreSQL and NUMERIC on D1 in the current generator." },
      { type:"timestamp" mapping:"TEXT on both providers." },
      { type:"json" mapping:"JSONB on PostgreSQL and TEXT on D1." },
    ]
  const entityConstraintRows:
    value:[
      {
        constraint:"primary"
        guidance:"Creates the single PRIMARY KEY and also makes the field NOT NULL."
      },
      {
        constraint:"required"
        guidance:"Emits NOT NULL for PostgreSQL and D1 migrations."
      },
      {
        constraint:"unique"
        guidance:"Emits a UNIQUE constraint for the field."
      },
      {
        constraint:"index"
        guidance:"Emits a deterministic secondary index named from the table and field."
      },
    ]
  const entityProviderRows:
    value:[
      {
        provider:"PostgreSQL"
        guidance:"dowe database migrate appends deterministic CREATE TABLE, ALTER TABLE, and CREATE INDEX SQL; production applies pending nodes before listening."
      },
      {
        provider:"Cloudflare D1"
        guidance:"The same command appends SQLite-compatible SQL, and production applies each node through one atomic D1 batch before seeders."
      },
      {
        provider:"Dowe Database"
        guidance:"The graph records a dynamic no-SQL head. Local and remote Dowe engines stay schema-less and do not reject undeclared record fields at runtime."
      },
    ]
  Section id:"database-entities-introduction" py:{ xs:6 md:10 }
    Grid columns:1 gap:3
      Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
        "SERVER / DATABASE / ENTITIES"
      Title size:{ xs:"3xl" md:"6xl" } weight:"black"
        "Entities"
      Text size:"lg" color:"muted"
        "An entity is an importable server contract that names a table, its fields, and the constraints Dowe can lower into deterministic PostgreSQL or D1 migrations. Dowe Database remains schema-less and does not create a local SQL schema from entities."
  Section id:"database-entities-declaration" p:{ xs:5 md:7 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "1 / DECLARATION"
        Title size:"3xl" weight:"black"
          "Describe one table with explicit fields"
        Text size:"sm" color:"muted"
          "The declaration name is a server binding. Dowe converts it to a lower-snake-case table name, so SmsDeliveries targets sms_deliveries. Every entity must declare at least one field and may declare at most one primary field."
      Code:
        language:"dowe"
        variant:"soft"
        scheme:"surface"
        copyLabel:"Copy entity"
        copiedLabel:"Copied"
        content:"""
          entity SmsDeliveries
            id:string primary:true
            recipient:string required:true index:true
            providerMessageId:string unique:true
            status:string required:true index:true
            attempts:int required:true
            cost:decimal
            createdAt:timestamp required:true index:true
            metadata:json
        """
      Alert type:"info" message:"When no field is marked primary and an id field exists, Dowe promotes that id field to required primary. It does not add a missing id field to an entity."
  Section id:"database-entities-types" py:{ xs:7 md:10 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "2 / FIELD TYPES"
        Title size:"3xl" weight:"black"
          "Use the implemented portable type set"
        Text size:"sm" color:"muted"
          "Entity field types are fixed and validated during compilation. The provider migration maps each type to its current SQL representation."
      Table:
        data:entityTypeRows
        variant:"soft"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"type" label:"Dowe type" width:"2fr"
        column field:"mapping" label:"Provider mapping" width:"5fr"
  Section id:"database-entities-constraints" p:{ xs:5 md:7 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "3 / CONSTRAINTS"
        Title size:"3xl" weight:"black"
          "Make storage requirements visible"
        Text size:"sm" color:"muted"
          "Constraint props are boolean and belong after the field type. Unknown props, duplicate fields, unsupported types, and multiple primary fields fail compilation."
      Table:
        data:entityConstraintRows
        variant:"soft"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"constraint" label:"Constraint" width:"2fr"
        column field:"guidance" label:"Generated behavior" width:"5fr"
      Text size:"sm" color:"muted"
        "Entities do not currently declare foreign keys, relations, defaults, compound indexes, or provider-specific column types."
  Section id:"database-entities-modules" py:{ xs:7 md:10 }
    Grid columns:1 gap:6
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "4 / MODULES AND DATABASE CONFIG"
        Title size:"3xl" weight:"black"
          "Group a bounded domain behind one module"
        Text size:"sm" color:"muted"
          "Keep related declarations together under server/entities and import their named bindings into a shared Database config module. Prefer one focused plural file per bounded domain instead of one file per table. Keep isolated schemas separate and split modules when ownership, lifecycle, authorization, or size demands it."
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" color:"primary"
          "server/entities/sms-entities.dowe"
        Code:
          language:"dowe"
          variant:"soft"
          scheme:"surface"
          copyLabel:"Copy entity module"
          copiedLabel:"Copied"
          content:"""
            entity SmsDeliveries
              id:string primary:true
              recipient:string required:true index:true
              status:string required:true index:true
              createdAt:timestamp required:true

            entity SmsDeliveryEvents
              id:string primary:true
              deliveryId:string required:true index:true
              status:string required:true index:true
              createdAt:timestamp required:true
          """
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" color:"muted"
          "server/config/database.dowe"
        Code:
          language:"dowe"
          variant:"soft"
          scheme:"surface"
          copyLabel:"Copy Database config"
          copiedLabel:"Copied"
          content:"""
            import SmsDeliveries, SmsDeliveryEvents from "@/server/entities/sms-entities"

            database appDb provider:"postgres"
              host:env.POSTGRES_HOST
              port:env.POSTGRES_PORT
              account:env.POSTGRES_USER
              secret:env.POSTGRES_PASSWORD
              name:env.POSTGRES_DATABASE
              entities:[SmsDeliveries, SmsDeliveryEvents]
              seeders:[]
          """
  Section id:"database-entities-provider-behavior" p:{ xs:5 md:7 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "5 / PROVIDER BEHAVIOR"
        Title size:"3xl" weight:"black"
          "Know what the entity controls"
      Table:
        data:entityProviderRows
        variant:"soft"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"provider" label:"Provider" width:"2fr"
        column field:"guidance" label:"Entity effect" width:"5fr"
      Text size:"sm" color:"muted"
        "A query still uses conn:<handle>.<operation> and a table string. An entity is compile-time schema and migration authority for SQL providers, not a runtime Database handle and not a value exposed to Views."
      Button href:"/docs/server/db/migrations" variant:"soft" scheme:"muted" size:"sm" iconStart:"document-add"
        "Migration graph"
