page DatabasePage
  const databaseModelRows:
    value:[
      {
        part:"Handle"
        example:"database db1"
        guidance:"In dowe dev, opens or reuses .dowe/db/<name>; in production, selects the declared provider adapter."
      },
      {
        part:"Result"
        example:"query blog"
        guidance:"Keeps the result variable explicit and inferable for later response data."
      },
      {
        part:"Boundary"
        example:"Server only"
        guidance:"Views receive response data, never a Database handle or its credentials."
      },
      {
        part:"CLI"
        example:"dowe database"
        guidance:"In an interactive terminal, shows every Database command, including migrate and seeders, then asks for required arguments."
      },
    ]
  const databaseOperationRows:
    value:[
      {
        operation:"list / read"
        purpose:"Select and read"
        href:"/docs/server/db/select"
      },
      {
        operation:"insert"
        purpose:"Create a record"
        href:"/docs/server/db/insert"
      },
      {
        operation:"update"
        purpose:"Patch a record"
        href:"/docs/server/db/update"
      },
      {
        operation:"delete"
        purpose:"Remove a record"
        href:"/docs/server/db/delete"
      },
      {
        operation:"transactions"
        purpose:"Stage inserts atomically on every provider"
        href:"/docs/server/db/transactions"
      },
      {
        operation:"migrations"
        purpose:"Maintain append-only entity schema history"
        href:"/docs/server/db/migrations"
      },
      {
        operation:"entities"
        purpose:"Define SQL provider schema contracts"
        href:"/docs/server/db/entities"
      },
      {
        operation:"relations"
        purpose:"Connect records with IDs and joins"
        href:"/docs/server/db/relations"
      },
      {
        operation:"seeders"
        purpose:"Load static records deterministically"
        href:"/docs/server/db/seeders"
      },
    ]
  const databaseProviderRows:
    value:[
      {
        provider:"PostgreSQL"
        guidance:"host and port locate the PostgreSQL server. account is the database user, secret is its password, and name is the PostgreSQL database name."
      },
      {
        provider:"D1"
        guidance:"account is the Cloudflare account ID, secret is the API token, and name is the D1 database ID. D1 does not use host or port; the runtime builds the official HTTP endpoint."
      },
      {
        provider:"Dowe Database"
        guidance:"host and port locate the Dowe WebSocket service. account and secret are database-scoped credentials, and name selects the Dowe NoSQL database."
      },
    ]
  const databaseSchemaRows:
    value:[
      {
        part:"entities"
        guidance:"List the entity bindings included by this database. Their fields and constraints become the Postgres or D1 schema contract."
      },
      {
        part:"seeders"
        guidance:"List static seeder bindings in execution order. A changed fingerprint is a new seeder run; use dowe database seeders to populate local development data explicitly."
      },
      {
        part:"server-only"
        guidance:"Entities, seeders, providers, and credentials stay in server modules. Return only the records or fields your endpoint needs."
      },
    ]
  Section id:"database-introduction" py:{ xs:6 md:10 }
    Grid columns:1 gap:3
      Text size:"xs" weight:"bold" spacing:"widest"
        "SERVER / DATABASE"
      Title size:{ xs:"3xl" md:"6xl" } weight:"black"
        "Database"
      Text size:"lg"
        "Database is Dowe's Dowe-owned server data contract. One query syntax can target PostgreSQL, Cloudflare D1, or Dowe Database, while handles and credentials stay server-only."
  Section id:"database-mental-model" p:{ xs:5 md:7 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest"
          "1 / MENTAL MODEL"
        Title size:"3xl" weight:"black"
          "Declare a handle, then bind results"
        Text size:"sm"
          "database declares the provider connection and query executes one operation. The HTTP request is already available as req inside the handler, just like env references; the binding returned by query is available to later server statements and can be projected into a response."
      Code:
        language:"dowe"
        variant:"solid"
        scheme:"surface"
        copyLabel:"Copy Dowe"
        copiedLabel:"Copied"
        content:"""
          handler getBlog
            database db1 provider:"dowe" host:env.DOWE_HOST port:env.DOWE_PORT account:env.DOWE_USER secret:env.DOWE_PASSWORD name:"content"
            query blog conn:db1.read table:"blogs" where:{ id:req.params.id } required:true
            return json:{ ok:true data:blog }
        """
      Table:
        data:databaseModelRows
        variant:"solid"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"part" label:"Part" width:"2fr"
        column field:"example" label:"Example" width:"2fr"
        column field:"guidance" label:"Meaning" width:"5fr"
  Section id:"database-operations" py:{ xs:7 md:10 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest"
          "2 / OPERATIONS"
        Title size:"3xl" weight:"black"
          "Choose the data flow"
        Text size:"sm"
          "Use list, read, insert, update, and delete for predictable record access. Use query for the supported SQL-like read grammar. The operation syntax stays the same when the provider changes."
      Table:
        data:databaseOperationRows
        variant:"solid"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"operation" label:"Operation" width:"2fr"
        column field:"purpose" label:"Use it for" width:"4fr"
        column field:"href" label:"Documentation route" width:"2fr"
  Section id:"database-providers" p:{ xs:5 md:7 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest"
          "3 / PROVIDERS"
        Title size:"3xl" weight:"black"
          "Three adapters, one server contract"
        Text size:"sm"
          "The provider selects the Dowe adapter used in production. host, port, account, secret, and name are server-only props; Dowe never sends them to a View."
      Table:
        data:databaseProviderRows
        variant:"solid"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"provider" label:"Provider" width:"2fr"
        column field:"guidance" label:"Connection contract" width:"5fr"
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold"
          "The same query against each provider"
        Code:
          language:"dowe"
          variant:"solid"
          scheme:"surface"
          copyLabel:"Copy PostgreSQL"
          copiedLabel:"Copied"
          content:"""
            database appDb provider:"postgres"
              host:env.POSTGRES_HOST
              port:env.POSTGRES_PORT
              account:env.POSTGRES_USER
              secret:env.POSTGRES_PASSWORD
              name:env.POSTGRES_DATABASE
              entities:[Users Blogs]
              seeders:[Bootstrap]
            query blogs conn:appDb.list table:"blogs"
          """
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold"
          "Cloudflare D1"
        Code:
          language:"dowe"
          variant:"solid"
          scheme:"surface"
          copyLabel:"Copy D1"
          copiedLabel:"Copied"
          content:"""
            database appDb provider:"d1"
              account:env.ACCOUNT_ID
              secret:env.CLOUDFLARE_API_TOKEN
              name:env.DATABASE_ID
              entities:[Users Blogs]
              seeders:[Bootstrap]
            query blogs conn:appDb.list table:"blogs"
          """
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold"
          "Dowe Database"
        Code:
          language:"dowe"
          variant:"solid"
          scheme:"surface"
          copyLabel:"Copy Dowe"
          copiedLabel:"Copied"
          content:"""
            database appDb provider:"dowe"
              host:env.DOWE_HOST
              port:env.DOWE_PORT
              account:env.DOWE_USER
              secret:env.DOWE_PASSWORD
              name:env.DOWE_DATABASE
              entities:[Users Blogs]
              seeders:[Bootstrap]
            query blogs conn:appDb.list table:"blogs"
          """
  Section id:"database-registration" p:{ xs:5 md:7 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest"
          "3 / PROJECT REGISTRY"
        Title size:"3xl" weight:"black"
          "Register handles in main.dowe"
        Text size:"sm"
          "A Database declaration can live in any server configuration module. Import the handle into main.dowe and list it under server.databases so migrate and seeders receive one deterministic project catalog, even before a route uses that handle."
      Code:
        language:"dowe"
        variant:"solid"
        scheme:"surface"
        copyLabel:"Copy registration"
        copiedLabel:"Copied"
        content:"""
          import IconDb from "@/server/config/database"

          main
            server port:8081
              databases:[IconDb]
        """
      Text size:"sm"
        "The registry accepts only imported Database handles. It does not copy provider credentials, open connections, or expose server-only values to Views."
  Section id:"database-schema" py:{ xs:7 md:10 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest"
          "4 / ENTITIES AND SEEDERS"
        Title size:"3xl" weight:"black"
          "Describe shape once, seed it deterministically"
        Text size:"sm"
          "entity and seeder are importable server bindings. Run dowe database migrate after entity changes: Postgres and D1 append provider SQL, while Dowe records a dynamic no-SQL head. Production applies pending migrations and seeders automatically; local development applies seeders with dowe database seeders."
      Code:
        language:"dowe"
        variant:"solid"
        scheme:"surface"
        copyLabel:"Copy schema"
        copiedLabel:"Copied"
        content:"""
          entity Users
            id:string primary:true
            name:string required:true
            email:string required:true unique:true

          entity Blogs
            id:string primary:true
            title:string required:true
            ownerId:string required:true index:true

          seeder Bootstrap
            insert entity:Users value:{ id:"01H00000000000000000000000" name:"Admin" email:"admin@example.com" }
        """
      Table:
        data:databaseSchemaRows
        variant:"solid"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"part" label:"Part" width:"2fr"
        column field:"guidance" label:"Responsibility" width:"5fr"
  Section id:"database-environments" p:{ xs:5 md:7 }
    Grid columns:1 gap:4
      Text size:"xs" weight:"bold" spacing:"widest"
        "5 / DEVELOPMENT AND PRODUCTION"
      Title size:"3xl" weight:"black"
        "The same source behaves predictably in both environments"
      Text size:"sm"
        "During dowe dev, all three providers use the embedded local Database under .dowe/db/<name> and resolve only name. Seeders are not loaded or executed automatically; run dowe database seeders when local records are needed. No account, secret, external network, Wrangler process, or second D1 port is used."
      Text size:"sm"
        "During production, Dowe validates the maintained migration graph, applies pending Postgres or D1 nodes atomically, runs pending seeders atomically, and only then starts accepting traffic. Dowe Database uses authenticated WebSocket operations and does not require SQL migrations."
      Code:
        language:"dowe"
        variant:"solid"
        scheme:"surface"
        copyLabel:"Copy query"
        copiedLabel:"Copied"
        content:"""
          query appointments conn:appDb.list table:"appointments"
          query appointment conn:appDb.read table:"appointments" where:{ id:req.params.id } required:true
        """
