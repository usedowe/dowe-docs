page DatabaseSelectPage
  const selectRows:
    value:[
      {
        operation:"list"
        guidance:"Returns JSON-compatible records from one declared table."
      },
      {
        operation:"read"
        guidance:"Returns one record or null, with required:true available for controlled absence."
      },
      {
        operation:"query"
        guidance:"Uses a static, validated SQL-like read expression. Never interpolate request values into sql."
      },
    ]
  Section id:"database-select-introduction" py:{ xs:6 md:10 }
    Grid columns:1 gap:3
      Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
        "SERVER / DATABASE / READ"
      Title size:{ xs:"3xl" md:"6xl" } weight:"black"
        "Select and read"
      Text size:"lg" color:"muted"
        "Use list for a table collection, read for one equality-filtered record, and query when the supported SQL-like grammar expresses a read more clearly. The query syntax is shared by postgres, d1, and dowe."
  Section id:"database-orm-read" p:{ xs:5 md:7 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "1 / ORM"
        Title size:"3xl" weight:"black"
          "List a table or require one record"
        Text size:"sm" color:"muted"
          "required:true turns an empty read into a controlled 404 for a JSON endpoint. The filter remains equality-based and database-owned."
      Code:
        language:"dowe"
        variant:"soft"
        scheme:"surface"
        copyLabel:"Copy Dowe"
        copiedLabel:"Copied"
        content:"""
          handler blogDetail
            database db provider:"dowe" host:env.DOWE_HOST port:env.DOWE_PORT account:env.DOWE_USER secret:env.DOWE_PASSWORD name:"content"
            query blogs db:db.list table:"blogs"
            query blog db:db.read table:"blogs" where:{ id:req.params.id } required:true
            return json:{ list:blogs selected:blog }
        """
      Table:
        data:selectRows
        variant:"soft"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"operation" label:"Operation" width:"2fr"
        column field:"guidance" label:"Use it for" width:"5fr"
  Section id:"database-native-query" py:{ xs:7 md:10 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "2 / SQL-LIKE"
        Title size:"3xl" weight:"black"
          "Use query for a supported read expression"
        Text size:"sm" color:"muted"
          "SQL-like input is a static, validated string. Do not interpolate values from body, params, query strings, or headers into SQL."
      Code:
        language:"dowe"
        variant:"soft"
        scheme:"surface"
        copyLabel:"Copy Dowe"
        copiedLabel:"Copied"
        content:"""
          handler scheduledAppointments
            database db provider:"dowe" host:env.DOWE_HOST port:env.DOWE_PORT account:env.DOWE_USER secret:env.DOWE_PASSWORD name:"clinic"
            query rows db:db.query sql:"select appointments.patientName, appointments.startsAt from appointments where status = \"scheduled\" order by startsAt"
            return json:{ ok:true data:rows }
        """
