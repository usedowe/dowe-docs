page TasksPage
  const taskNamedRows:
    value:[
      { rule:"Explicit data" guidance:"Pass JSON-compatible values through args so the worker receives only the data it needs." },
      { rule:"Independent worker" guidance:"The function resolves Database, Cache, and provider access inside its own server process." },
      { rule:"No result binding" guidance:"Task results are intentionally discarded. Worker failures are logged without failing the caller." },
    ]
  const taskTelemetryRows:
    value:[
      { rule:"Headers, not fallbacks" guidance:"The task starts after real upstream headers. Upstream 4xx and 5xx responses count; local loading, error, or connection failures do not." },
      { rule:"Measured event" guidance:"Dowe overwrites status, method, path, latency, input bytes, and output bytes while preserving custom event fields. Missing Content-Length becomes zero." },
      { rule:"Tight scope" guidance:"after headers is rejected in init, reusable functions, middleware, WebSockets, protocol handlers, non-reverse handlers, and cron." },
    ]
  const taskInlineRows:
    value:[
      { rule:"Pass values through args" guidance:"Inline bodies can use args and imported server configuration, but cannot capture handler locals, req, environment values, or runtime handles." },
      { rule:"Keep control at the caller" guidance:"Inline tasks cannot return a value, launch another task or cron registration, or send an HTTP or WebSocket response." },
    ]
  Section id:"tasks-introduction" py:{ xs:6 md:10 }
    Grid columns:1 gap:3
      Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
        "SERVER / TASKS"
      Title size:{ xs:"3xl" md:"6xl" } weight:"black"
        "Start isolated work now"
      Text size:"lg" color:"muted"
        "Tasks start detached server work immediately. The caller continues without a result while Dowe runs the work in an isolated worker."
      Button href:"/docs/server/background-jobs" variant:"ghost" scheme:"muted" size:"sm" iconStart:"chart-2"
        "Scheduled cron jobs"
  Section id:"tasks-named" p:{ xs:5 md:7 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "1 / NAMED TASKS"
        Title size:"3xl" weight:"black"
          "Reuse an imported server function"
        Text size:"sm" color:"muted"
          "Use a named task when the detached work belongs in a reusable server module. The caller evaluates args before the worker starts, then returns immediately."
      Code:
        language:"dowe"
        variant:"soft"
        scheme:"surface"
        copyLabel:"Copy Dowe"
        copiedLabel:"Copied"
        content:"""
          import writeAudit from "@/server/tasks/write-audit"

          handler createOrder
            const order value:req.json
            task fn:writeAudit args:{ orderId:order.id event:"order.created" }
            return status:202 json:{ accepted:true }
        """
      Table:
        data:taskNamedRows
        variant:"soft"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"rule" label:"Rule" width:"2fr"
        column field:"guidance" label:"What it means" width:"5fr"
  Section id:"tasks-reverse-proxy" py:{ xs:7 md:10 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "2 / REVERSE-PROXY TELEMETRY"
        Title size:"3xl" weight:"black"
          "Measure a real upstream response"
        Text size:"sm" color:"muted"
          "Tasks are immediate by default. Only a direct handler that finishes with return reverse can opt into after headers timing."
      Code:
        language:"dowe"
        variant:"soft"
        scheme:"surface"
        copyLabel:"Copy Dowe"
        copiedLabel:"Copied"
        content:"""
          import RouteCache from "@/server/config/cache"
          import emitTelemetry from "@/server/tasks/telemetry"

          handler forwardRequest
            request host source:"header" name:"Host"
            kv route conn:RouteCache.get key:host required:true
            task fn:emitTelemetry args:{ event:{ projectId:route.projectId status:0 method:"" path:"" latencyMs:0 bytesIn:0 bytesOut:0 custom:"edge" } } after:"headers"
            return reverse:route.url
        """
      Table:
        data:taskTelemetryRows
        variant:"soft"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"rule" label:"Rule" width:"2fr"
        column field:"guidance" label:"What it means" width:"5fr"
  Section id:"tasks-inline" py:{ xs:7 md:10 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "3 / INLINE TASKS"
        Title size:"3xl" weight:"black"
          "Keep small detached work local"
        Text size:"sm" color:"muted"
          "An inline task is useful when the work is short and does not deserve a reusable module. Its body has its own worker scope."
      Code:
        language:"dowe"
        variant:"soft"
        scheme:"surface"
        copyLabel:"Copy Dowe"
        copiedLabel:"Copied"
        content:"""
          handler createOrder
            const order value:req.json
            task args:{ orderId:order.id }
              str auditKey source:"join" values:["order", args.orderId] delimiter:":"
              log "queued audit" auditKey
            return status:202 json:{ accepted:true }
        """
      Table:
        data:taskInlineRows
        variant:"soft"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"rule" label:"Rule" width:"2fr"
        column field:"guidance" label:"What it means" width:"5fr"
  Section id:"tasks-limits" pb:{ xs:7 md:10 }
    Grid columns:1 gap:4
      Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
        "4 / PROCESS BOUNDARY"
      Title size:"3xl" weight:"black"
        "Choose tasks for non-critical work"
      Text size:"sm" color:"muted"
        "Tasks do not expose cancellation, inspection, retry, or durable delivery. Use cron for UTC schedules, and keep a request synchronous when its response depends on the result."
      Alert type:"warning" message:"A task is detached execution, not durable delivery. Use Queue when the work must survive process failure, be inspected, or be acknowledged by a consumer."
