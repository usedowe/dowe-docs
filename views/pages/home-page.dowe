page HomePage
  Section id:"workflow-platform-hero" boxed:true minH:"vh-0" py:{ xs:8 md:12 }
    Flex direction:"column" align:"center" justify:"center" gap:0 minH:"vh-32"
      Flex direction:"column" align:"center" gap:0 show:{ xs:false md:true }
        Title size:"7xl" weight:"black"
          "Full-stack development,"
        Title size:"7xl" weight:"black"
          "from one codebase"
      Flex direction:"column" align:"center" gap:0 show:{ xs:true md:false }
        Title size:"4xl" weight:"black"
          "Full-stack development, from one codebase"
      Box h:12
      Grid columns:{ xs:1 md:"720px" } gap:3
        Tabs variant:"line" scheme:"primary"
          tab id:"hero-unix" label:"macOS / Linux"
            Code:
              language:"dowe"
              variant:"solid"
              scheme:"surface"
              copyLabel:"Copy install command"
              copiedLabel:"Copied"
              content:"curl -fsSL https://get.dowe.dev/install | bash"
          tab id:"hero-windows" label:"Windows"
            Code:
              language:"dowe"
              variant:"solid"
              scheme:"surface"
              copyLabel:"Copy PowerShell command"
              copiedLabel:"Copied"
              content:"powershell -c \"irm https://get.dowe.dev/install.ps1 | iex\""
      Box h:20
      Flex wrap:true justify:"center" align:"center" gap:{ xs:8 md:24 }
        Flex direction:"column" align:"center" gap:3
          Flex align:"center" gap:3
            Icon name:"route" style:"bold-duotone" fill:"muted" w:10 h:10
            Text size:"3xl" weight:"black" color:"muted"
              "Server"
          Text size:"xs"
            "Native routing and host capabilities."
        Flex direction:"column" align:"center" gap:3
          Flex align:"center" gap:3
            Icon name:"global" style:"bold-duotone" fill:"muted" w:10 h:10
            Text size:"3xl" weight:"black" color:"muted"
              "Web"
          Text size:"xs"
            "Initial SSR plus route assets."
        Flex direction:"column" align:"center" gap:3
          Flex align:"center" gap:3
            Icon name:"laptop" style:"bold-duotone" fill:"muted" w:10 h:10
            Text size:"3xl" weight:"black" color:"muted"
              "Desktop"
          Text size:"xs"
            "Local web output in native windows."
        Flex direction:"column" align:"center" gap:3
          Flex align:"center" gap:3
            Icon name:"svg-logos:apple" w:10 h:10
            Text size:"3xl" weight:"black" color:"muted"
              "Ios"
          Text size:"xs"
            "Generated native SwiftUI."
        Flex direction:"column" align:"center" gap:3
          Flex align:"center" gap:3
            Icon name:"svg-logos:android-icon" w:10 h:10
            Text size:"3xl" weight:"black" color:"muted"
              "Android"
          Text size:"xs"
            "Generated native Jetpack Compose."
  Section boxed:true py:0
    Divider scheme:"muted"
  Section boxed:true px:{ xs:5 md:12 } py:{ xs:10 md:14 }
    Grid columns:{ xs:1 md:"2fr 3fr" } gap:{ xs:8 md:14 } align:"start"
      Grid columns:1 gap:5
        Text size:"xs" weight:"bold" spacing:"widest" color:"primary"
          "STRAIGHT ANSWERS"
        Title size:{ xs:"3xl" md:"5xl" } weight:"black"
          "The tradeoffs are explicit."
      Grid columns:1 gap:0
        Grid columns:1 gap:3 py:5
          Title size:"xl" weight:"black"
            "Do I need a separate codebase for every target?"
          Text size:"sm" color:"muted"
            "No. One Dowe source graph can drive server, web, desktop, Android, and iOS outputs."
        Divider scheme:"muted"
        Grid columns:1 gap:3 py:5
          Title size:"xl" weight:"black"
            "Are Android and iOS apps WebViews?"
          Text size:"sm" color:"muted"
            "No. Dowe generates native Jetpack Compose and SwiftUI components with UI/UX parity across web, Android, and iOS."
        Divider scheme:"muted"
        Grid columns:1 gap:3 py:5
          Title size:"xl" weight:"black"
            "Can I add arbitrary JavaScript packages?"
          Text size:"sm" color:"muted"
            "No. Dowe capabilities come through checked contracts instead of a node_modules application layer."
        Divider scheme:"muted"
        Grid columns:1 gap:3 py:5
          Title size:"xl" weight:"black"
            "Am I limited to predefined layouts?"
          Text size:"sm" color:"muted"
            "No. Compose routes, layouts, pages, sections, grids, state, and handlers within Dowe's checked contracts."
