page HomePage
  Section id:"workflow-platform-hero" boxed:true center:true gap:10
    Title size:"7xl" align:"center" maxW:"6xl"
      """
      Full-stack development,
      from one codebase
      """
    Tabs variant:"line" w:"full" maxW:"4xl"
      tab id:"hero-unix" label:"macOS / Linux"
        Code:
          language:"dowe"
          variant:"solid"
          scheme:"surface"
          copyLabel:"Copy install command"
          copiedLabel:"Copied"
          content:"curl -fsSL https://get.dowe.dev/install | bash"
      tab id:"hero-windows" label:"Windows"
        Code:
          language:"dowe"
          variant:"solid"
          scheme:"surface"
          copyLabel:"Copy PowerShell command"
          copiedLabel:"Copied"
          content:"powershell -c \"irm https://get.dowe.dev/install.ps1 | iex\""
    Grid columns:{ xs:2 md:3 lg:5 } gap:4
      const platforms value:[
        { icon:"route-bold-duotone" title:"server" text:"Routing and host capabilities" }
        { icon:"global-bold-duotone" title:"web" text:"SSR plus route assets" }
        { icon:"laptop-bold-duotone" title:"desktop" text:"Native Windows/Macos/Linux apps" }
        { icon:"svg-logos:android-icon" title:"Android" text:"Native Jetpack Compose" }
        { icon:"svg-logos:apple" title:"Ios" text:"Native SwiftUI" }
      ]
      each in:platforms as:platform key:platform.title
        Flex gap:3 align:"center"
          Icon name:platform.icon fill:"muted" w:12 h:12
          Flex direction:"column"
            Text size:"3xl" weight:"black" color:"muted"
              "{platform.title}"
            Text size:"xs"
              "{platform.text}"

  Section boxed:true py:0
    Divider scheme:"muted"
  Section boxed:true px:{ xs:5 md:12 } py:{ xs:10 md:14 }
    Grid columns:{ xs:1 md:2 } gap:{ xs:8 md:14 } align:"start"
      Grid columns:1 gap:5
        Text size:"xs" weight:"bold" spacing:"widest" color:"primary"
          "STRAIGHT ANSWERS"
        Title size:{ xs:"3xl" md:"5xl" } weight:"black"
          "The tradeoffs are explicit."
      Grid columns:1 gap:0
        Grid columns:1 gap:3 py:5
          Title size:"xl" weight:"black"
            "Do I need a separate codebase for every target?"
          Text size:"sm" color:"muted"
            "No. One Dowe source graph can drive server, web, desktop, Android, and iOS outputs."
        Divider scheme:"muted"
        Grid columns:1 gap:3 py:5
          Title size:"xl" weight:"black"
            "Are Android and iOS apps WebViews?"
          Text size:"sm" color:"muted"
            "No. Dowe generates native Jetpack Compose and SwiftUI components with UI/UX parity across web, Android, and iOS."
        Divider scheme:"muted"
        Grid columns:1 gap:3 py:5
          Title size:"xl" weight:"black"
            "Can I add arbitrary JavaScript packages?"
          Text size:"sm" color:"muted"
            "No. Dowe capabilities come through checked contracts instead of a node_modules application layer."
        Divider scheme:"muted"
        Grid columns:1 gap:3 py:5
          Title size:"xl" weight:"black"
            "Am I limited to predefined layouts?"
          Text size:"sm" color:"muted"
            "No. Compose routes, layouts, pages, sections, grids, state, and handlers within Dowe's checked contracts."
