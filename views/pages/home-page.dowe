page HomePage
  Section id:"workflow-platform-hero" boxed:true centerX:true gap:10
    Flex direction:"column" align:"center" gap:5
      Chip scheme:"muted"
        "ONE SOURCE · EVERY SURFACE"
      Title size:"5xl" weight:"black" align:"center" maxW:"6xl" spacing:"tighter"
        """
        Full-stack development,
        from one codebase.
        """
      Text size:{ xs:"md" md:"lg" } align:"center" maxW:"2xl"
        "Build the product once. Dowe turns one source graph into a complete, native experience everywhere your users are."
    Card:
      w:"full"
      maxW:"4xl"
      p:{ xs:3 md:5 }
      variant:"solid"
      scheme:"surface"
      rounded:"xl"
      shadowColor:"primary"
      Tabs variant:"line" scheme:"primary" w:"full"
        tab id:"hero-unix" label:"macOS / Linux"
          Code:
            language:"dowe"
            copyLabel:"Copy install command"
            copiedLabel:"Copied"
            content:"curl -fsSL https://get.dowe.dev/install | bash"
        tab id:"hero-windows" label:"Windows"
          Code:
            language:"dowe"
            copyLabel:"Copy PowerShell command"
            copiedLabel:"Copied"
            content:"powershell -c \"irm https://get.dowe.dev/install.ps1 | iex\""
  Section id:"platforms-support" scheme:"muted" boxed:true centerX:true gap:8
    Grid columns:{ xs:1 md:2 } gap:{ xs:3 md:5 } align:"center"
      Flex direction:"column" gap:2
        Chip scheme:"primary"
          "ONE SOURCE GRAPH"
        Title size:{ xs:"3xl" md:"4xl" } weight:"black"
          "One source. Native everywhere."
        Text size:"sm" maxW:"xl"
          "Dowe does not wrap your product in a web view. The compiler carries the same source graph into purpose-built output for every surface."
      Card variant:"outlined" scheme:"surface" rounded:"xl" shadow:"sm"
        Flex align:"center" justify:"between" gap:3
          Text size:"xs" weight:"bold" spacing:"widest" color:"primary"
            "COMPILE PIPELINE"
          Chip scheme:"secondary"
            "5 NATIVE TARGETS"
        Text size:"sm"
          "One contract, resolved into platform-native UI, routing, and runtime capabilities."
        Code:
          language:"dowe"
          copyLabel:"Copy source graph"
          copiedLabel:"Copied"
          content:"source graph -> server | web | desktop | android | ios"
    Grid columns:{ xs:1 md:3 } gap:4
      const platforms:
        value:[
          {
            id:"server"
            number:"01"
            icon:"server-minimalistic-bold-duotone"
            title:"Server"
            text:"Routing, host capabilities, and secure runtime"
            output:"Rust runtime"
            detail:"One source of truth for routes, auth, and execution."
          }
          {
            id:"web"
            number:"02"
            icon:"window-frame-bold-duotone"
            title:"Web"
            text:"SSR, route assets, and fast delivery"
            output:"HTML + CSS"
            detail:"Ships a responsive experience from the same view tree."
          }
          {
            id:"desktop"
            number:"03"
            icon:"monitor-bold-duotone"
            title:"Desktop"
            text:"Native apps for Windows, macOS, and Linux"
            output:"Native desktop"
            detail:"A full desktop runtime without rebuilding the product."
          }
          {
            id:"android"
            number:"04"
            icon:"svg-logos:android-icon"
            title:"Android"
            text:"Native screens with Jetpack Compose"
            output:"Jetpack Compose"
            detail:"Native Android UI with shared behavior and parity."
          }
          {
            id:"ios"
            number:"05"
            icon:"svg-logos:apple"
            title:"iOS"
            text:"Native screens with SwiftUI"
            output:"SwiftUI"
            detail:"Native iOS surfaces powered by the same source graph."
          }
        ]
      each in:platforms as:platform key:platform.id
        Card variant:"outlined" scheme:"surface" rounded:"xl" shadow:"md"
          Flex direction:"column" align:"center" gap:3
            Avatar:
              name:"Dowe Agent"
              alt:"Dowe Agent"
              variant:"solid"
              scheme:"info"
              size:"xl"
              icon:platform.icon
            Flex direction:"column" align:"center" gap:1
              Text size:"xs" weight:"black" spacing:"widest" color:"mutedText"
                "{platform.number} · NATIVE TARGET"
              Title size:"xl" weight:"black" align:"center"
                "{platform.title}"
              Text size:"xs" weight:"bold" align:"center"
                "{platform.output}"
            Text size:"sm" align:"center" maxW:"sm"
              "{platform.text}"
            Text size:"xs" align:"center" maxW:"sm"
              "{platform.detail}"
  Section boxed:true py:0
    Divider scheme:"muted"
  Section boxed:true px:{ xs:5 md:12 } py:{ xs:10 md:14 }
    Grid columns:{ xs:1 md:2 } gap:{ xs:8 md:14 } align:"start"
      Grid columns:1 gap:5
        Text size:"xs" weight:"bold" spacing:"widest" color:"primary"
          "STRAIGHT ANSWERS"
        Title size:{ xs:"3xl" md:"5xl" } weight:"black"
          "The tradeoffs are explicit."
      Grid columns:1 gap:0
        const questions:
          value:[
            {
              title:"Do I need a separate codebase for every target?"
              text:"No. One Dowe source graph can drive server, web, desktop, Android, and iOS outputs."
            }
            {
              title:"Are Android and iOS apps WebViews?"
              text:"No. Dowe generates native Jetpack Compose and SwiftUI components with UI/UX parity across web, Android, and iOS."
            }
            {
              title:"Can I add arbitrary JavaScript packages?"
              text:"Yes. Dowe supports npm packages and can be extended to support other package managers."
            }
            {
              title:"Can I add arbitrary Android libraries?"
              text:"Yes. Dowe supports Gradle dependencies and can be extended to support other package managers."
            }
          ]
        each in:questions as:question key:question.title
          Grid columns:1 gap:3 py:5
            Title size:"xl"
              "{question.title}"
            Text size:"sm"
              "{question.text}"
          Divider scheme:"muted"
