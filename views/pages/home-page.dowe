page HomePage
  Section boxed:true px:{ xs:5 md:12 } py:{ xs:8 md:10 }
    Grid columns:1 gap:8
      Grid columns:{ xs:1 md:"3fr 1fr" } gap:8 align:"end"
        Grid columns:1 gap:4
          Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
            "// FULLSTACK FOR THE AI ERA"
          Title size:{ xs:"4xl" md:"6xl" } weight:"black"
            "AI GENERATES CODE. DOWE GENERATES THE SYSTEM."
        Grid columns:1 gap:4
          Text size:"sm" color:"muted"
            "One declarative source becomes checked software for server, web, desktop, Android, and iOS."
          Button href:"/docs/views" variant:"solid" scheme:"muted"
            "Explore Dowe"
      Card variant:"solid" scheme:"surface" p:0 rounded:"md" shadow:"xl" shadowColor:"muted"
        Grid columns:{ xs:1 md:"2fr 1fr" } gap:0
          Box p:{ xs:5 md:7 }
            Grid columns:1 gap:5
              Flex justify:"between" align:"center" gap:3
                Text size:"xs" weight:"bold" spacing:"widest"
                  "DOWE / INSTALL"
                Chip variant:"outlined" scheme:"primary" size:"sm"
                  "DOWE-NATIVE"
              Title size:{ xs:"2xl" md:"4xl" } weight:"black"
                "Install Dowe in seconds."
              Tabs variant:"line" scheme:"primary" position:"top"
                tab id:"unix" label:"macOS / Linux"
                  Code:
                    language:"dowe"
                    variant:"soft"
                    scheme:"surface"
                    copyLabel:"Copy install command"
                    copiedLabel:"Copied"
                    content:"curl -fsSL https://get.dowe.dev/install | bash"
                tab id:"windows" label:"Windows"
                  Code:
                    language:"dowe"
                    variant:"soft"
                    scheme:"surface"
                    copyLabel:"Copy install command"
                    copiedLabel:"Copied"
                    content:"powershell -c \"irm https://get.dowe.dev/install.ps1 | iex\""
          Box bg:"primary" color:"onPrimary" p:{ xs:5 md:7 }
            Grid columns:1 gap:4
              Text size:"xs" weight:"bold" spacing:"widest"
                "THE DOWE LOOP"
              Title size:"2xl" weight:"black"
                "SOURCE IN. SYSTEM OUT."
              Grid columns:"auto 1fr" gap:3 align:"center"
                Text size:"xs" weight:"bold"
                  "01"
                Grid columns:1 gap:1
                  Title size:"md" weight:"black"
                    "Describe"
                  Text size:"xs"
                    "Views, data, and server intent."
              Divider scheme:"background"
              Grid columns:"auto 1fr" gap:3 align:"center"
                Text size:"xs" weight:"bold"
                  "02"
                Grid columns:1 gap:1
                  Title size:"md" weight:"black"
                    "Check"
                  Text size:"xs"
                    "Contracts and boundaries."
              Divider scheme:"background"
              Grid columns:"auto 1fr" gap:3 align:"center"
                Text size:"xs" weight:"bold"
                  "03"
                Grid columns:1 gap:1
                  Title size:"md" weight:"black"
                    "Generate"
                  Text size:"xs"
                    "Native outputs for every target."
  Section boxed:true px:{ xs:5 md:12 } py:{ xs:10 md:14 }
    Grid columns:{ xs:1 md:2 } gap:10 align:"center"
      Grid columns:1 gap:5
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "// ABOUT DOWE"
        Title size:{ xs:"3xl" md:"5xl" } weight:"black"
          "ONE SOURCE. EVERY SURFACE. PURPOSEFULLY UNIFIED."
        Text size:"sm" color:"muted"
          "Architecture lives in the source and generation lives in the Dowe compiler. Agents edit intent; Dowe keeps the system coherent."
        Button href:"/docs/dev/agent" variant:"outlined" scheme:"muted"
          "Meet Dowe Agent"
      Card variant:"soft" scheme:"primary" p:{ xs:5 md:7 } rounded:"md"
        Grid columns:1 gap:6
          Text size:"xs" weight:"bold" spacing:"widest"
            "SYSTEM METRICS"
          Grid columns:3 gap:4
            Grid columns:1 gap:1
              Title size:{ xs:"2xl" md:"4xl" } weight:"black"
                "01"
              Text size:"xs" weight:"bold"
                "SOURCE MODEL"
            Grid columns:1 gap:1
              Title size:{ xs:"2xl" md:"4xl" } weight:"black"
                "05"
              Text size:"xs" weight:"bold"
                "TARGET FAMILIES"
            Grid columns:1 gap:1
              Title size:{ xs:"2xl" md:"4xl" } weight:"black"
                "00"
              Text size:"xs" weight:"bold"
                "NODE.JS RUNTIME"
          Divider scheme:"primary"
          Text size:"sm"
            "One compiler authority owns parsing, analysis, lowering, routing, runtime behavior, and target generation."
  Section boxed:true bg:"softMuted" color:"onSoftMuted" px:{ xs:5 md:12 } py:{ xs:10 md:14 }
    Grid columns:1 gap:8
      Grid columns:1 gap:2
        Text size:"xs" weight:"bold" spacing:"widest"
          "// THE SYSTEM"
        Title size:{ xs:"3xl" md:"5xl" } weight:"black"
          "FULLSTACK CAPABILITIES, ONE COMPILER"
      Grid columns:1 gap:0
        Grid columns:{ xs:1 md:"auto 1fr 2fr auto" } gap:5 align:"center" py:5
          Text size:"xs" weight:"bold"
            "01"
          Title size:"xl" weight:"black"
            "VIEWS & UI"
          Text size:"sm"
            "Declarative pages, layouts, components, design tokens, and portable interaction contracts."
          Text size:"xl" weight:"black"
            "↗"
        Divider scheme:"muted"
        Grid columns:{ xs:1 md:"auto 1fr 2fr auto" } gap:5 align:"center" py:5
          Text size:"xs" weight:"bold"
            "02"
          Title size:"xl" weight:"black"
            "SERVER & RUNTIME"
          Text size:"sm"
            "Server binaries, routing, SSR, data access, and explicit runtime boundaries."
          Text size:"xl" weight:"black"
            "↗"
        Divider scheme:"muted"
        Grid columns:{ xs:1 md:"auto 1fr 2fr auto" } gap:5 align:"center" py:5
          Text size:"xs" weight:"bold"
            "03"
          Title size:"xl" weight:"black"
            "NATIVE TARGETS"
          Text size:"sm"
            "Web, desktop windows, Jetpack Compose, and SwiftUI generated from one product model."
          Text size:"xl" weight:"black"
            "↗"
        Divider scheme:"muted"
        Grid columns:{ xs:1 md:"auto 1fr 2fr auto" } gap:5 align:"center" py:5
          Text size:"xs" weight:"bold"
            "04"
          Title size:"xl" weight:"black"
            "AGENT WORKFLOWS"
          Text size:"sm"
            "Machine-readable constraints, early diagnostics, and deterministic artifacts agents can repair."
          Text size:"xl" weight:"black"
            "↗"
  Section boxed:true bg:"muted" color:"onMuted" px:{ xs:5 md:12 } py:{ xs:10 md:14 }
    Grid columns:1 gap:8
      Grid columns:{ xs:1 md:"1fr auto" } gap:5 align:"end"
        Grid columns:1 gap:2
          Text size:"xs" weight:"bold" spacing:"widest"
            "// GENERATED TARGETS"
          Title size:{ xs:"3xl" md:"5xl" } weight:"black"
            "ONE PRODUCT. NATIVE OUTPUTS."
        Button href:"/docs/views" variant:"soft" scheme:"primary"
          "View the contracts"
      Grid columns:{ xs:1 md:2 } gap:4
        Card variant:"solid" scheme:"background" p:{ xs:5 md:7 } rounded:"md"
          Grid columns:1 gap:4
            Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
              "01 / WEB"
            Title size:"3xl" weight:"black"
              "SSR, routing, JavaScript, and CSS."
            Text size:"sm" color:"muted"
              "The browser gets only the assets it needs; the server router keeps server authority."
        Card variant:"solid" scheme:"background" p:{ xs:5 md:7 } rounded:"md"
          Grid columns:1 gap:4
            Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
              "02 / SERVER"
            Title size:"3xl" weight:"black"
              "Server binaries without ambient Node.js."
            Text size:"sm" color:"muted"
              "Dependencies, execution, and deployment stay explicit from source to runtime."
        Card variant:"solid" scheme:"background" p:{ xs:5 md:7 } rounded:"md" colSpan:{ xs:1 md:2 }
          Grid columns:{ xs:1 md:"1fr 2fr" } gap:6 align:"center"
            Grid columns:1 gap:3
              Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
                "03 / NATIVE"
              Title size:"3xl" weight:"black"
                "Desktop and mobile stay in the same system."
              Text size:"sm" color:"muted"
                "Native windows, SwiftUI, and Jetpack Compose share the same source architecture."
            Code:
              language:"dowe"
              variant:"soft"
              scheme:"surface"
              copyLabel:"Copy Dowe"
              copiedLabel:"Copied"
              content:"""
                dowe dev --target web
                dowe dev --target desktop
                dowe dev --target android
                dowe dev --target ios
              """
  Section boxed:true px:{ xs:5 md:12 } py:{ xs:10 md:14 }
    Grid columns:1 gap:8
      Grid columns:{ xs:1 md:2 } gap:10 align:"end"
        Grid columns:1 gap:2
          Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
            "// THE COMPILER LOOP"
          Title size:{ xs:"3xl" md:"5xl" } weight:"black"
            "INTENT IN. CHECKED OUTPUTS OUT."
        Text size:"sm" color:"muted"
          "Dowe makes the path from an agent edit to a platform artifact visible, deterministic, and reviewable."
      Grid columns:{ xs:1 md:4 } gap:3
        Card variant:"soft" scheme:"muted" p:5 rounded:"sm"
          Grid columns:1 gap:4
            Text size:"xs" weight:"bold"
              "01"
            Title size:"lg" weight:"black"
              "DESCRIBE"
            Text size:"sm"
              "Write the complete product intent."
        Card variant:"soft" scheme:"muted" p:5 rounded:"sm"
          Grid columns:1 gap:4
            Text size:"xs" weight:"bold"
              "02"
            Title size:"lg" weight:"black"
              "CHECK"
            Text size:"sm"
              "Validate contracts and boundaries."
        Card variant:"soft" scheme:"muted" p:5 rounded:"sm"
          Grid columns:1 gap:4
            Text size:"xs" weight:"bold"
              "03"
            Title size:"lg" weight:"black"
              "GENERATE"
            Text size:"sm"
              "Produce every selected target."
        Card variant:"soft" scheme:"muted" p:5 rounded:"sm"
          Grid columns:1 gap:4
            Text size:"xs" weight:"bold"
              "04"
            Title size:"lg" weight:"black"
              "REVIEW"
            Text size:"sm"
              "Inspect artifacts and diagnostics."
  Section boxed:true bg:"muted" color:"onMuted" px:{ xs:5 md:12 } py:{ xs:10 md:14 }
    Grid columns:{ xs:1 md:"1fr auto" } gap:8 align:"center"
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest"
          "// BUILD WITH DOWE"
        Title font:"syne" size:{ xs:"3xl" md:"6xl" } weight:"black"
          "BUILD THE SYSTEM, NOT THE STACK."
      Flex direction:{ xs:"column" sm:"row" } gap:3
        Button href:"/docs/views" variant:"soft" scheme:"primary" size:"lg"
          "Start with Views"
        Button href:"/docs/dev/agent" variant:"soft" scheme:"secondary" size:"lg"
          "Use Dowe Agent"
