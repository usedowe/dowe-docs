page DeployEnvironmentsPage
  const environmentRows:
    value:[
      {
        environment:"Live"
        purpose:"Production"
        behavior:"Uses production names and URLs for real users. No preview access gate is generated."
      },
      {
        environment:"Stage"
        purpose:"Team testing"
        behavior:"Uses a stable Stage URL for remote team testing and isolated output under .dowe/dist/stage."
      },
      {
        environment:"UAT"
        purpose:"Tester acceptance"
        behavior:"Uses a stable UAT URL for tester acceptance and isolated output under .dowe/dist/uat."
      },
    ]
  const accessRows:
    value:[
      {
        area:"Password handling"
        guidance:"Dowe packages only a SHA-256 hash. The raw password, selected dotenv file, and other server secrets stay outside the package and deployment report."
      },
      {
        area:"Provider isolation"
        guidance:"Cloudflare Pages uses stage.<project>.pages.dev and uat.<project>.pages.dev aliases, Workers use name suffixes, Vercel uses the custom deployment targets stage and uat, and Docker uses stage or uat default tags. Live keeps existing production destinations."
      },
      {
        area:"Variable propagation"
        guidance:"Docker declares server-only names for runtime injection, SSH installs selected server values in a root-only EnvironmentFile, Cloudflare uses vars and secrets.required, and Vercel maps Live, Stage, and UAT to production, stage, and uat."
      },
    ]
  Section id:"deploy-environments-introduction" py:{ xs:6 md:10 }
    Grid columns:1 gap:3
      Text size:"xs" weight:"bold" spacing:"widest"
        "DEVELOPMENT / DEPLOY ENVIRONMENTS"
      Title size:{ xs:"3xl" md:"6xl" } weight:"black"
        "Live, Stage, and UAT"
      Text size:"lg"
        "Publish isolated remote versions without editing the .env file used by dowe dev."
  Section id:"deploy-environments-profiles" p:{ xs:5 md:7 }
    Grid columns:1 gap:4
      Text size:"xs" weight:"bold" spacing:"widest"
        "1 / LOCAL PROFILES"
      Title size:"3xl" weight:"black"
        "One local profile per environment"
      Text size:"sm"
        "Declare shared variable names in .env.example. Process environment values take precedence over the selected local file, and Dowe never falls back to another profile. Keep all four value files in .gitignore; they are compiler inputs and are never copied into deployment packages."
      Code:
        language:"dowe"
        variant:"solid"
        scheme:"surface"
        copyLabel:"Copy profile names"
        copiedLabel:"Copied"
        content:"""
          .env
          .env.live
          .env.stage
          .env.uat
        """
  Section id:"deploy-environments-selection" py:{ xs:7 md:10 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest"
          "2 / DEPLOY FLOW"
        Title size:"3xl" weight:"black"
          "Select the environment first"
        Text size:"sm"
          "Interactive deploy asks for Live, Stage, or UAT before it asks for the Server or Web surface. Scripts use --environment; Live is the default."
      Code:
        language:"dowe"
        variant:"solid"
        scheme:"surface"
        copyLabel:"Copy deploy commands"
        copiedLabel:"Copied"
        content:"""
          dowe deploy
          dowe deploy web --environment stage --publish
          dowe deploy web --environment uat --publish
          dowe deploy server --environment live --target cloudflare --publish
          dowe deploy web --environment stage --target vercel --name clinic-web --publish
        """
      Table:
        data:environmentRows
        variant:"solid"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"environment" label:"Environment" width:"1fr"
        column field:"purpose" label:"Purpose" width:"2fr"
        column field:"behavior" label:"Behavior" width:"5fr"
  Section id:"deploy-environments-access" p:{ xs:5 md:7 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest"
          "3 / PREVIEW ACCESS"
        Title size:"3xl" weight:"black"
          "Protect previews without changing Live"
        Text size:"sm"
          "Stage and UAT require a server-only DOWE_DEPLOY_ACCESS_PASSWORD with at least 12 characters. Browsers receive an HTTP Basic Auth challenge before any app route or static asset runs."
      Table:
        data:accessRows
        variant:"solid"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"area" label:"Concern" width:"2fr"
        column field:"guidance" label:"Rule" width:"5fr"
      Code:
        language:"dowe"
        variant:"solid"
        scheme:"surface"
        copyLabel:"Copy access variable"
        copiedLabel:"Copied"
        content:"DOWE_DEPLOY_ACCESS_PASSWORD=use-a-long-private-password"
