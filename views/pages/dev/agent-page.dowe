page AgentPage
  const referenceChecks value:[
    {
      id:"structure"
      label:"STRUCTURE"
      title:"Keep chrome in the layout"
      description:"A shared AppBar or Footer belongs to one Scaffold layout even when the route graph currently has one page. Ordered page bands remain sibling Sections."
    },
    {
      id:"blueprint"
      label:"BLUEPRINT"
      title:"Decide before authoring"
      description:"The visual QA blueprint records exact bands and region bounds, semantic components, ownership, data, assets, theme decisions, and reusable candidates before application source changes."
    },
    {
      id:"collections"
      label:"COLLECTIONS"
      title:"Model repeated UI once"
      description:"Repeated cards, metrics, and rows use one collection and one each: const for fixed content, a typed signal for backend updates, and a View Store only across routes."
    },
    {
      id:"responsive"
      label:"RESPONSIVE"
      title:"Separate evidence from inference"
      description:"The supplied viewport is observed. Unshown breakpoints are conservative inferences validated at xs and md without hiding essential content or actions."
    },
    {
      id:"quality"
      label:"UX AND ACCESSIBILITY"
      title:"Review behavior, not only pixels"
      description:"Loading, empty, error, focus, keyboard, touch, overlay, contrast, labels, source order, and reduced motion stay part of completion."
    },
    {
      id:"fidelity"
      label:"VISUAL QA"
      title:"Compare every band"
      description:"The reference remains evidence, never an asset. Deterministic capture writes a rendered image, diff, and machine-readable band report below .dowe."
    },
  ]
  const agentInstallationRows:
    value:[
      {
        command:"dowe agent init"
        behavior:"Preserve project work"
        guidance:"Creates missing agent files and preserves existing files byte for byte. It does not write generated .dowe artifacts."
      },
      {
        command:"dowe agent update"
        behavior:"Refresh managed knowledge"
        guidance:"Rebuilds Dowe-managed instructions and skills, removes obsolete managed resources, and preserves project-owned skills."
      },
    ]
  const agentSkillRows:
    value:[
      {
        area:"Discovery"
        guidance:"The agent discovers skill metadata before loading a focused SKILL.md."
      },
      {
        area:"Detail"
        guidance:"Each SKILL.md routes the current task to one focused reference. MCP can retrieve that declared resource directly without loading the complete skill bundle."
      },
      {
        area:"Ownership"
        guidance:"Dowe-managed dowe-* skills are separate from private compiler-development skills and project-owned guidance."
      },
    ]
  const starterRows:
    value:[
      {
        starter:"CRUD"
        result:"A modern editorial dashboard"
        guidance:"DB and D1 share the same responsive journal, contained story list, session-aware actions, and separate modals for registration, login, publishing, and editing."
      },
      {
        starter:"Blank"
        result:"A minimal portable baseline"
        guidance:"Includes one Hello Dowe page and one Dowe-owned GET endpoint without unused folders or backend modules. Enable i18n to generate English and Spanish catalogs."
      },
    ]
  const agentWorkflowRows:
    value:[
      {
        area:"Harness and CodeGraph"
        guidance:"Contract changes use the Agent Harness. CodeGraph ranks maintained Dowe source from the task when ownership, modularity, dependencies, or duplication matter."
      },
      {
        area:"MCP integration"
        guidance:"Providers can start the local read-only MCP bridge with dowe agent mcp and retrieve compact skills, individual references, unique examples, and project context."
      },
    ]
  Section id:"agent-introduction" py:{ xs:6 md:10 }
    Grid columns:1 gap:3
      Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
        "DEVELOPMENT / EXTERNAL AGENTS"
      Title size:{ xs:"3xl" md:"6xl" } weight:"black"
        "Dowe Agent"
      Text size:"lg" color:"muted"
        "Dowe prepares a project for Codex, Claude Code, OpenCode, or another coding agent without choosing, hosting, or charging for the model."
  Section id:"agent-installation" p:{ xs:5 md:7 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "1 / ONE PROJECT SETUP"
        Title size:"3xl" weight:"black"
          "Install the complete agent"
        Text size:"sm" color:"muted"
          "Initialization writes provider-neutral instructions, the TDD harness, plans, and the public Dowe authoring skills included in the installed Dowe version."
      Code:
        language:"dowe"
        variant:"soft"
        scheme:"surface"
        copyLabel:"Copy commands"
        copiedLabel:"Copied"
        content:"""
          dowe agent init
          dowe agent update
        """
      Table:
        data:agentInstallationRows
        variant:"soft"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"command" label:"Command" width:"2fr"
        column field:"behavior" label:"Purpose" width:"2fr"
        column field:"guidance" label:"Behavior" width:"5fr"
  Section id:"agent-skills" py:{ xs:7 md:10 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "2 / VERSIONED AUTHORING KNOWLEDGE"
        Title size:"3xl" weight:"black"
          "Skills are installed automatically"
        Text size:"sm" color:"muted"
          "Dowe installs authoring skills locally so an external agent can use the syntax and target boundaries that match the current compiler version. The skills keep frontend modules in views, backend modules and migrations in server, and only project wiring at the root."
      Code:
        language:"dowe"
        variant:"soft"
        scheme:"surface"
        copyLabel:"Copy structure"
        copiedLabel:"Copied"
        content:"""
          AGENTS.md
          CLAUDE.md
          .agents/
            manifest.json
            harnesses/tdd.md
            plans/
            skills/
              dowe-core/
              dowe-views/
              dowe-server/
              dowe-theme/
        """
      Table:
        data:agentSkillRows
        variant:"soft"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"area" label:"Step" width:"2fr"
        column field:"guidance" label:"What the agent does" width:"5fr"
  Section id:"agent-visual-fidelity" p:{ xs:5 md:7 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "3 / REFERENCE-DRIVEN UI"
        Title size:"3xl" weight:"black"
          "Treat the image as a visual contract"
        Text size:"sm" color:"muted"
          "When a user asks for an exact reconstruction, dowe-views inventories the complete shell and every visible page band before authoring source."
      each in:referenceChecks as:check key:check.id
        Grid columns:1 gap:1
          Text size:"xs" weight:"bold" color:"muted"
            "{check.label}"
          Title size:"xl" weight:"black"
            "{check.title}"
          Text size:"sm" color:"muted"
            "{check.description}"
      Code:
        language:"dowe"
        variant:"soft"
        scheme:"surface"
        copyLabel:"Copy visual QA command"
        copiedLabel:"Copied"
        content:"python3 .agents/skills/dowe-views/scripts/visual_qa.py self-test"
  Section id:"project-starters" p:{ xs:5 md:7 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "4 / AGENT-READY FROM INIT"
        Title size:"3xl" weight:"black"
          "Start with a designed system"
        Text size:"sm" color:"muted"
          "Choose CRUD or blank first. CRUD continues directly to optional English and Spanish i18n, while the Database provider stays in server configuration and both starters include the same project Agent Harness and four public authoring skills."
      Table:
        data:starterRows
        variant:"soft"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"starter" label:"Starter" width:"1fr"
        column field:"result" label:"Shape" width:"2fr"
        column field:"guidance" label:"Details" width:"5fr"
  Section id:"agent-workflow" p:{ xs:5 md:7 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "5 / AUTOMATIC WORKFLOW"
        Title size:"3xl" weight:"black"
          "The agent owns the workflow"
        Text size:"sm" color:"muted"
          "AGENTS.md gives every external agent one short authoring contract. CLAUDE.md points Claude-compatible tools to the same rules instead of creating a second workflow."
      Table:
        data:agentWorkflowRows
        variant:"soft"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"area" label:"Capability" width:"2fr"
        column field:"guidance" label:"Responsibility" width:"5fr"
  Section id:"agent-tdd" py:{ xs:7 md:10 }
    Grid columns:1 gap:4
      Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
        "6 / SPEC-DRIVEN DEVELOPMENT"
      Title size:"3xl" weight:"black"
        "Harnesses enforce process, not a test language"
      Text size:"sm" color:"muted"
        "The TDD harness requires a spec, contracts, a test plan, validation, and documentation before a behavior change closes. Native literal tests can live in any project folder and run through dowe test."
      Code:
        language:"dowe"
        variant:"soft"
        scheme:"surface"
        copyLabel:"Copy flow"
        copiedLabel:"Copied"
        content:"Spec -> Contract -> Tests -> Implementation -> Validation -> Documentation"
      Text size:"sm" color:"muted"
        "The coding agent writes and runs the concrete project tests appropriate to the selected spec. For literal contracts it can use test and assert declarations anywhere in the project, then records validation evidence under .dowe only when the harness requires it."
      Button:
        href:"/docs/dev/tests"
        variant:"soft"
        size:"sm"
        rounded:"full"
        iconStart:"check-circle"
        "Read native test docs"
