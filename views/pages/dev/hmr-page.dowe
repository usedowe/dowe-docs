page HmrPage
  const hmrProcessRows:
    value:[
      {
        phase:"Watch"
        action:"Detect eligible saves"
        guidance:"Dowe receives native filesystem events and groups one editor save without rescanning the full project on a timer."
      },
      {
        phase:"Build"
        action:"Reuse valid modules"
        guidance:"Page and layout edits reuse unchanged parsed modules, chunks, route documents, and the stable web runtime."
      },
      {
        phase:"Apply"
        action:"Update the running target"
        guidance:"Each selected target applies its own valid module without waiting for a slower sibling target."
      },
    ]
  const hmrTargetRows:
    value:[
      {
        target:"Web"
        behavior:"Replace the smallest safe boundary"
        guidance:"A page edit publishes its changed chunks and manifest, then replaces the page boundary without rebuilding or reloading unrelated routes."
      },
      {
        target:"Desktop"
        behavior:"Reload the shared Views output"
        guidance:"The desktop development window uses the same generated Views server as web and refreshes its WebView when a successful reload is published."
      },
      {
        target:"Android"
        behavior:"Load a new DEX module"
        guidance:"After the development host is installed, later view updates load a new DEX and render with Android Views without running adb install again."
      },
      {
        target:"iOS"
        behavior:"Load a new Swift module"
        guidance:"The simulator host opens before the initial dylib finishes. Without a cached module it shows a preparation indicator, then mounts the valid SwiftUI module; later updates do not run simctl install again."
      },
    ]
  const hmrStateRows:
    value:[
      {
        state:"Route and compatible state"
        guidance:"Targets keep the active route when a compatible module replaces the current one inside the active process. Web also restores compatible Signal values and bound control state after hydration."
      },
      {
        state:"Mobile process relaunch"
        guidance:"Android and iOS mount the cached native module at the generated initial route with a new navigation stack. A valid incoming deep link can select another declared launch route."
      },
      {
        state:"Failed rebuild"
        guidance:"Compiler or native module failures report diagnostics, keep the previous valid module active, and leave watch available for the next save."
      },
      {
        state:"Terminal confirmation"
        guidance:"A valid rebuild prints INFO Hot reload completed (0 errors). A failed rebuild prints ERROR Hot reload failed before its diagnostics."
      },
    ]
  Section id:"hmr-introduction" py:{ xs:6 md:10 }
    Grid columns:1 gap:3
      Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
        "DEVELOPMENT / HOT MODULE RELOAD"
      Title size:{ xs:"3xl" md:"6xl" } weight:"black"
        "Hot reload across targets"
      Text size:"lg" color:"muted"
        "Keep dowe dev running while Dowe rebuilds changed views and publishes the latest valid module to each selected development target."
  Section id:"hmr-start" p:{ xs:5 md:7 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "1 / AUTOMATIC IN DEVELOPMENT"
        Title size:"3xl" weight:"black"
          "Save source and let the active session update"
        Text size:"sm" color:"muted"
          "HMR starts automatically for supported targets selected by dowe dev. There is no application-level HMR import, configuration file, or JavaScript development server to add."
      Code:
        language:"dowe"
        variant:"soft"
        scheme:"surface"
        copyLabel:"Copy HMR commands"
        copiedLabel:"Copied"
        content:"""
          dowe dev --target web
          dowe dev --target desktop
          dowe dev --target android
          dowe dev --target ios
        """
      Table:
        data:hmrProcessRows
        variant:"soft"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"phase" label:"Phase" width:"1fr"
        column field:"action" label:"Responsibility" width:"2fr"
        column field:"guidance" label:"Behavior" width:"5fr"
  Section id:"hmr-targets" py:{ xs:7 md:10 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "2 / TARGET BEHAVIOR"
        Title size:"3xl" weight:"black"
          "Keep the renderer native to each platform"
        Text size:"sm" color:"muted"
          "HMR changes development delivery, not the rendering model. Dowe does not execute authored source in the browser or replace native views with a WebView."
      Table:
        data:hmrTargetRows
        variant:"soft"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"target" label:"Target" width:"1fr"
        column field:"behavior" label:"Update strategy" width:"2fr"
        column field:"guidance" label:"Details" width:"5fr"
  Section id:"hmr-state" p:{ xs:5 md:7 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "3 / STATE AND RECOVERY"
        Title size:"3xl" weight:"black"
          "Keep the last valid experience active"
        Text size:"sm" color:"muted"
          "Dowe preserves useful development context when the new module remains compatible and avoids replacing a working module with incomplete output."
      Table:
        data:hmrStateRows
        variant:"soft"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"state" label:"State" width:"2fr"
        column field:"guidance" label:"What happens" width:"5fr"
      Text size:"sm" color:"muted"
        "Native module updates publish only after all generated target sources compile. If iOS compilation fails, the simulator keeps the last valid module and the next save can retry the build."
      Text size:"sm" color:"muted"
        "Server changes use a successful backend restart rather than view HMR. Production builds do not include the HMR client, module server, or .dowe/dev dependency."
  Section id:"hmr-performance" py:{ xs:7 md:10 }
    Grid columns:1 gap:4
      Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
        "4 / CURRENT PERFORMANCE"
      Title size:"3xl" weight:"black"
        "Rebuild only what the session needs"
      Text size:"sm" color:"muted"
        "The first compile fills a development-session cache. Later page and layout saves reuse unchanged modules, while iOS keeps the complete dynamic Icon catalog in bounded Swift shards outside the shared route index."
      Alert type:"info" message:"A save with identical generated output emits no browser update. Shared components, Stores, types, theme, i18n, environment, icons, deletes, and unknown paths keep a conservative invalidation path."
      Button:
        href:"/docs/dev/dev#dev-watch"
        variant:"soft"
        size:"sm"
        rounded:"full"
        iconStart:"restart"
        "Review watch behavior"
