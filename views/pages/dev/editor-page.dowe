page ExtensionsPage
  const vscodeRows:
    value:[
      {
        area:"Marketplace"
        result:"Published"
        guidance:"Find Dowe Source Format Language Support by the publisher identifier dowe.dowe-language-support."
      },
      {
        area:"Language server"
        result:"Installed automatically"
        guidance:"Without a local server, the first Dowe file downloads a pinned release, verifies its SHA-256, and caches it in VS Code's global extension storage."
      },
      {
        area:"Local setup"
        result:"No Dowe setup"
        guidance:"Users do not need the dowe-lsp repository, Dowe, Cargo, Node.js, or npm in their Dowe project."
      },
    ]
  const zedRows:
    value:[
      {
        area:"Registry"
        result:"Publication pending"
        guidance:"The PR adds Dowe and the separate Dowe icon extension to Zed's official registry."
      },
      {
        area:"Repository"
        result:"usedowe/dowe-zed"
        guidance:"Use the repository for the extension adapter, Tree-sitter grammar, Zed queries, icon theme, and local validation workflow."
      },
    ]
  const languageRows:
    value:[
      {
        area:"Compiler-backed assistance"
        guidance:"Component props, imports, env references, server constructs, and auto-import fixes stay aligned with the compiler APIs."
      },
      {
        area:"Editor-specific adapters"
        guidance:"VS Code uses TextMate highlighting and LSP providers; Zed uses its grammar and queries. Workspace checks keep keywords, components, indentation, and shared language-server semantics aligned."
      },
    ]
  Section id:"extensions-introduction" py:{ xs:6 md:10 }
    Grid columns:1 gap:3
      Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
        "DEVELOPMENT / EXTENSIONS"
      Title size:{ xs:"3xl" md:"6xl" } weight:"black"
        "Dowe editor extensions"
      Text size:"lg" color:"muted"
        "Official editor integrations for Dowe Source Format, backed by one Dowe language service contract."
  Section id:"extensions-vscode" p:{ xs:5 md:7 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "1 / PUBLISHED / VISUAL STUDIO CODE"
        Title size:"3xl" weight:"black"
          "Dowe Source Format Language Support"
        Text size:"sm" color:"muted"
          "Install the VS Code extension from the Marketplace. It uses an explicit or PATH-provided Dowe language server before downloading a verified compatible release."
        Button:
          href:"https://marketplace.visualstudio.com/items?itemName=dowe.dowe-language-support"
          target:"blank"
          variant:"soft"
          size:"sm"
          rounded:"full"
          iconStart:"link"
          "Open VS Code Marketplace"
      Code:
        language:"dowe"
        variant:"soft"
        scheme:"surface"
        copyLabel:"Copy commands"
        copiedLabel:"Copied"
        content:"code --install-extension dowe.dowe-language-support"
      Table:
        data:vscodeRows
        variant:"soft"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"area" label:"Area" width:"2fr"
        column field:"result" label:"Result" width:"2fr"
        column field:"guidance" label:"Details" width:"5fr"
  Section id:"extensions-zed" py:{ xs:7 md:10 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "2 / OPEN / ZED REGISTRY"
        Title size:"3xl" weight:"black"
          "Dowe for Zed"
        Text size:"sm" color:"muted"
          "The Zed extension also installs a managed language-server release automatically. Its official registry PR remains open for review."
        Button:
          href:"https://github.com/zed-industries/extensions/pull/6940"
          target:"blank"
          variant:"soft"
          size:"sm"
          rounded:"full"
          iconStart:"link"
          "View Zed registry PR #6940"
      Table:
        data:zedRows
        variant:"soft"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"area" label:"Area" width:"2fr"
        column field:"result" label:"Status" width:"2fr"
        column field:"guidance" label:"Details" width:"5fr"
  Section id:"extensions-language-server" p:{ xs:5 md:7 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "3 / SHARED LANGUAGE CONTRACT"
        Title size:"3xl" weight:"black"
          "One service, multiple editors"
        Text size:"sm" color:"muted"
          "Diagnostics, completion, hover, definition, symbols, formatting, and code actions come from the Dowe language service instead of separate JavaScript validators."
      Table:
        data:languageRows
        variant:"soft"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"area" label:"Layer" width:"2fr"
        column field:"guidance" label:"Responsibility" width:"5fr"
  Section id:"extensions-source-formatting" py:{ xs:7 md:10 }
    Grid columns:1 gap:4
      Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
        "4 / SOURCE FORMAT"
      Title size:"3xl" weight:"black"
        "Nested property suites"
      Text size:"sm" color:"muted"
        "Props stay at the start of their declaration suite. A following child can open its own suite at the next indentation level."
      Code:
        language:"dowe"
        variant:"soft"
        scheme:"surface"
        copyLabel:"Copy source"
        copiedLabel:"Copied"
        content:"""
          Grid:
            columns:{ xs:1 md:2 }
            gap:4
            Card:
              variant:"soft"
        """
  Section id:"extensions-settings" p:{ xs:5 md:7 }
    Grid columns:1 gap:4
      Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
        "5 / TROUBLESHOOTING"
      Title size:"3xl" weight:"black"
        "Override only when developing the server"
      Text size:"sm" color:"muted"
        "The default installation is automatic. Contributors can set an absolute executable path and restart the service after rebuilding it."
      Code:
        language:"dowe"
        variant:"soft"
        scheme:"surface"
        copyLabel:"Copy settings"
        copiedLabel:"Copied"
        content:"""
          dowe.languageServer.path
          dowe.languageServer.args
          dowe.languageServer.trace.server
        """
      Button:
        href:"/docs/dev/dev"
        variant:"soft"
        size:"sm"
        rounded:"full"
        iconStart:"code"
        "Back to Dowe Dev"
