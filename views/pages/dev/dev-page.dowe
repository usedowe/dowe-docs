page DevPage
  const devCommandRows:
    value:[
      {
        mode:"Interactive"
        action:"Choose targets once"
        guidance:"The checkbox menu filters targets from main.dowe and the current host, then remembers every selected target, including server when available, in .dowe/dev/target-selection.json."
      },
      {
        mode:"Automation"
        action:"Use explicit flags"
        guidance:"Each --target is validated before compilation. Explicit runs do not read or write the interactive preference file."
      },
      {
        mode:"Host filtering"
        action:"Keep unavailable targets out"
        guidance:"Server and web run on supported desktop hosts. iOS is available only on macOS, while mobile and desktop launchers require their native toolchains."
      },
    ]
  const devTargetRows:
    value:[
      {
        targets:"Server + web"
        result:"Fast fullstack feedback"
        guidance:"The server target starts the Dowe-owned backend. The web target serves generated HTML, CSS, JavaScript, route chunks, fonts, and development reload support."
      },
      {
        targets:"Desktop + mobile"
        result:"Native previews from the same views"
        guidance:"Desktop starts or reuses the same Views server origin as web before opening the platform window. Android and iOS use native hosts while preserving the shared Dowe view model."
      },
      {
        targets:"Native startup"
        result:"Fail fast across targets"
        guidance:"Android and iOS start in parallel. If one target fails, Dowe cancels pending native compiler trees, including descendants that create independent process groups, cleans up the session, and reports the first actionable error immediately."
      },
      {
        targets:"Cold native builds"
        result:"Bound work, then reuse units"
        guidance:"Large Android pages are partitioned before javac. iOS opens its simulator host before the first Swift module finishes, uses at most two one-primary Swift frontends, and reuses incremental native caches on later runs."
      },
    ]
  const devWatchRows:
    value:[
      {
        area:"Source of truth"
        guidance:"Edit Dowe Source Format and configuration at the project root. Generated artifacts remain disposable and reproducible."
      },
      {
        area:"Recoverable rebuilds"
        guidance:"A failed rebuild reports the native compiler diagnostic, keeps the last valid module active, and does not repeat the same failed Swift compilation before waiting for the next correction."
      },
      {
        area:"Terminal confirmation"
        guidance:"Every valid rebuild prints INFO Hot reload completed (0 errors), while a failed rebuild prints ERROR Hot reload failed before its diagnostics."
      },
    ]
  Section id:"dev-introduction" py:{ xs:6 md:10 }
    Grid columns:1 gap:3
      Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
        "DEVELOPMENT / CLI"
      Title size:{ xs:"3xl" md:"6xl" } weight:"black"
        "Dowe Dev"
      Text size:"lg" color:"muted"
        "Compile the current project, start the targets you choose, and keep development artifacts inside the disposable .dowe directory."
  Section id:"dev-command" p:{ xs:5 md:7 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "1 / ONE DEVELOPMENT ENTRYPOINT"
        Title size:"3xl" weight:"black"
          "Start the project from its root"
        Text size:"sm" color:"muted"
          "Run Dowe from the directory that contains main.dowe. In a terminal, dowe dev opens the target selector; explicit flags make the same workflow deterministic for scripts and CI."
      Code:
        language:"dowe"
        variant:"soft"
        scheme:"surface"
        copyLabel:"Copy commands"
        copiedLabel:"Copied"
        content:"""
          dowe dev
          dowe dev --target server --target web
          dowe dev --target desktop
          dowe dev --target android
          dowe dev --target ios
        """
      Table:
        data:devCommandRows
        variant:"soft"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"mode" label:"Mode" width:"2fr"
        column field:"action" label:"Choice" width:"2fr"
        column field:"guidance" label:"Behavior" width:"5fr"
  Section id:"dev-targets" py:{ xs:7 md:10 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "2 / TARGET PIPELINE"
        Title size:"3xl" weight:"black"
          "One source model, several targets"
        Text size:"sm" color:"muted"
          "The shared Dowe compiler reads the project model once and prepares the selected target pipelines. A fullstack project commonly starts the server and web targets together."
      Table:
        data:devTargetRows
        variant:"soft"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"targets" label:"Selection" width:"2fr"
        column field:"result" label:"Outcome" width:"2fr"
        column field:"guidance" label:"What happens" width:"5fr"
  Section id:"dev-artifacts" p:{ xs:5 md:7 }
    Grid columns:1 gap:4
      Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
        "3 / DISPOSABLE DEVELOPMENT OUTPUT"
      Title size:"3xl" weight:"black"
        "Inspect generated support without owning it"
      Text size:"sm" color:"muted"
        "Dowe writes generated development output below .dowe, including target manifests, route data, fonts, icon copies, and type-checking support. Keep project source in main.dowe, theme.dowe, views, and server; do not edit generated files."
      Code:
        language:"dowe"
        variant:"soft"
        scheme:"surface"
        copyLabel:"Copy structure"
        copiedLabel:"Copied"
        content:"""
          .dowe/
            dev/
            apps/
            fonts/
            icons/
            types/
            tsconfig.json
        """
      Text size:"sm" color:"muted"
        "Dowe does not require Node.js, node_modules, Tailwind, or a JavaScript application runtime to compile source or run the Dowe-owned development server."
      Text size:"sm" color:"muted"
        "Web output uses a content-addressed router and design core plus route-selected style and runtime capabilities. Navigation loads missing CSS before replacing content, keeps active styles attached, and retires obsolete route chunks without an unstyled frame."
      Text size:"sm" color:"muted"
        "In dowe dev --target web, enable the in-page Dowe inspector to hover or select a Section, AppBar, or component and see its project-relative source path and inclusive lines. Drag the floating inspector control away from the component when needed. Generated text wrappers inherit their parent component identity, keeping Section, Title, and component mappings precise. The inspector manifest and selection state stay under .dowe and are never emitted by dowe deploy."
      Button:
        href:"/docs/dev/inspector"
        variant:"soft"
        size:"sm"
        rounded:"full"
        iconStart:"magnifier"
        "Read View Inspector docs"
  Section id:"dev-watch" py:{ xs:7 md:10 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "4 / WATCH AND RELOAD"
        Title size:"3xl" weight:"black"
          "Keep the session open while source changes"
        Text size:"sm" color:"muted"
          "The development session watches project inputs, runs the shared rebuild pipeline, and reports successful or failed rebuilds. Web changes reload the browser; server changes restart the backend when the new build succeeds."
      Table:
        data:devWatchRows
        variant:"soft"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"area" label:"Rule" width:"2fr"
        column field:"guidance" label:"What to remember" width:"5fr"
      Button:
        href:"/docs/dev/hmr"
        variant:"soft"
        size:"sm"
        rounded:"full"
        iconStart:"restart"
        "Read Hot Reload docs"
