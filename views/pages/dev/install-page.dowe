page InstallPage
  const installChannelRows:
    value:[
      {
        platform:"macOS + Linux"
        method:"One shell installer"
        guidance:"The Bash installer selects the matching macOS or Linux archive and updates the user PATH when the install directory is not already present."
      },
      {
        platform:"Windows"
        method:"PowerShell native flow"
        guidance:"The PowerShell installer downloads the Windows archive, places the binary and Dowe font catalog under the user directory, and updates the user PATH when needed."
      },
    ]
  const installConfigRows:
    value:[
      {
        variable:"DOWE_VERSION"
        behavior:"Pin a release"
        guidance:"Use latest by default or provide a version such as 1.2.3."
      },
      {
        variable:"DOWE_INSTALL_DIR"
        behavior:"Choose a directory"
        guidance:"macOS and Linux default to $HOME/.dowe/bin; Windows defaults to the user .dowe/bin directory."
      },
      {
        variable:"DOWE_BASE_URL"
        behavior:"Use another channel"
        guidance:"Point the installer at a compatible release CDN or private mirror."
      },
    ]
  const installVerifyRows:
    value:[
      {
        command:"dowe version"
        behavior:"Confirm the binary"
        guidance:"Prints the installed CLI version so scripts and support reports can identify the toolchain."
      },
      {
        command:"dowe upgrade"
        behavior:"Compare latest metadata"
        guidance:"Checks latest/version and only installs when the published version is newer. Invalid metadata and unsupported platforms produce a clear error instead of a partial upgrade."
      },
    ]
  const uninstallRows:
    value:[
      {
        concern:"Confirmation"
        behavior:"Review before removal"
        guidance:"dowe uninstall asks for confirmation in a terminal. Use --yes when a script already owns the decision."
      },
      {
        concern:"Three platforms"
        behavior:"macOS, Linux, and Windows"
        guidance:"Unix removes the executable before exit. Windows schedules removal after the current process closes."
      },
      {
        concern:"Safe boundary"
        behavior:"Keep application data"
        guidance:"Dowe does not delete project files, project .dowe directories, application data, credentials, or unrelated install-directory files."
      },
    ]
  const installNextRows:
    value:[
      {
        project:"New project"
        guidance:"Use dowe init --template blank, or choose CRUD from the interactive menu and continue to the optional i18n step. A root main.dowe marks an existing project."
      },
      {
        project:"Existing project"
        guidance:"Run dowe dev --target server --target web to start it. Interactive dowe init asks before replacing managed template files and defaults to keeping the project unchanged."
      },
    ]
  Section id:"install-introduction" py:{ xs:6 md:10 }
    Grid columns:1 gap:3
      Text size:"xs" weight:"bold" spacing:"widest"
        "DEVELOPMENT / CLI DISTRIBUTION"
      Title size:{ xs:"3xl" md:"6xl" } weight:"black"
        "Install Dowe"
      Text size:"lg"
        "Install the versioned Dowe CLI from the official release channel, then use the same binary for development, testing, builds, and deployment."
  Section id:"install-command" p:{ xs:5 md:7 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest"
          "1 / OFFICIAL INSTALLERS"
        Title size:"3xl" weight:"black"
          "Install from get.dowe.dev"
        Text size:"sm"
          "The platform installer downloads the matching archive from the latest channel and places the binary in the user install directory."
      Code:
        language:"dowe"
        variant:"solid"
        scheme:"surface"
        copyLabel:"Copy install commands"
        copiedLabel:"Copied"
        content:"""
          macOS / Linux:
          curl -fsSL https://get.dowe.dev/install | bash

          Windows:
          powershell -c "irm https://get.dowe.dev/install.ps1 | iex"
        """
      Table:
        data:installChannelRows
        variant:"solid"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"platform" label:"Platform" width:"2fr"
        column field:"method" label:"Installer" width:"2fr"
        column field:"guidance" label:"Behavior" width:"5fr"
  Section id:"install-location" py:{ xs:7 md:10 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest"
          "2 / USER-OWNED INSTALLATION"
        Title size:"3xl" weight:"black"
          "Choose the version and location"
        Text size:"sm"
          "Use installer environment variables when a project, workstation image, or CI runner needs a different release channel or destination."
      Code:
        language:"dowe"
        variant:"solid"
        scheme:"surface"
        copyLabel:"Copy configuration"
        copiedLabel:"Copied"
        content:"""
          DOWE_VERSION=1.2.3 curl -fsSL https://get.dowe.dev/install | bash
          DOWE_INSTALL_DIR=/opt/dowe/bin curl -fsSL https://get.dowe.dev/install | bash
          DOWE_BASE_URL=https://releases.example.test curl -fsSL https://releases.example.test/install | bash
        """
      Table:
        data:installConfigRows
        variant:"solid"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"variable" label:"Variable" width:"2fr"
        column field:"behavior" label:"Purpose" width:"2fr"
        column field:"guidance" label:"Default or rule" width:"5fr"
  Section id:"install-troubleshooting" p:{ xs:5 md:7 }
    Grid columns:1 gap:4
      Text size:"xs" weight:"bold" spacing:"widest"
        "3 / WINDOWS TROUBLESHOOTING"
      Title size:"3xl" weight:"black"
        "Expose the installer error"
      Text size:"sm"
        "Empty installer variables are treated as unset. If PowerShell reports a null method error, download the script first to expose whether the response or the installer failed."
      Code:
        language:"dowe"
        variant:"solid"
        scheme:"surface"
        copyLabel:"Copy diagnostic"
        copiedLabel:"Copied"
        content:"""
          $installer = irm https://get.dowe.dev/install.ps1
          if ([string]::IsNullOrWhiteSpace($installer)) { throw "The installer response is empty" }
          iex $installer
        """
  Section id:"install-verify" p:{ xs:5 md:7 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest"
          "4 / VERIFY AND UPGRADE"
        Title size:"3xl" weight:"black"
          "Keep the CLI current"
        Text size:"sm"
          "After installation, verify the binary and let Dowe delegate future upgrades to the same platform installer instead of duplicating installation logic."
      Code:
        language:"dowe"
        variant:"solid"
        scheme:"surface"
        copyLabel:"Copy commands"
        copiedLabel:"Copied"
        content:"""
          dowe version
          dowe upgrade
        """
      Table:
        data:installVerifyRows
        variant:"solid"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"command" label:"Command" width:"2fr"
        column field:"behavior" label:"Purpose" width:"2fr"
        column field:"guidance" label:"Rule" width:"5fr"
  Section id:"install-uninstall" py:{ xs:7 md:10 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest"
          "5 / REMOVE THE CLI"
        Title size:"3xl" weight:"black"
          "Uninstall without touching projects"
        Text size:"sm"
          "Dowe removes the installed binary, its packaged font catalog, the managed PATH entry, and only empty installation directories. Project source, project .dowe data, and unrelated files remain untouched."
      Code:
        language:"dowe"
        variant:"solid"
        scheme:"surface"
        copyLabel:"Copy uninstall commands"
        copiedLabel:"Copied"
        content:"""
          dowe uninstall
          dowe uninstall --yes
        """
      Table:
        data:uninstallRows
        variant:"solid"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"concern" label:"Concern" width:"2fr"
        column field:"behavior" label:"Behavior" width:"2fr"
        column field:"guidance" label:"Boundary" width:"5fr"
  Section id:"install-next" py:{ xs:7 md:10 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest"
          "6 / READY TO BUILD"
        Title size:"3xl" weight:"black"
          "Move from installation to a project"
        Text size:"sm"
          "Once the CLI is available, initialize a project or enter an existing Dowe root and start the shared development workflow."
      Table:
        data:installNextRows
        variant:"solid"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"project" label:"Project" width:"2fr"
        column field:"guidance" label:"Next command or rule" width:"5fr"
      Button:
        href:"/docs/dev"
        variant:"solid"
        size:"sm"
        rounded:"full"
        iconStart:"add-circle"
        "Initialize a project"
