page BuildPage
  const buildCommandRows:
    value:[
      {
        concern:"Project source"
        outcome:"Compile once"
        guidance:"The Rust compiler owns parsing, analysis, lowering, routes, assets, and target generation. Authored .dowe source is not executed by Node.js."
      },
      {
        concern:"Local artifact"
        outcome:"No publication"
        guidance:"Build writes the release output locally. Use dowe deploy only when the artifact should be uploaded to a provider or store."
      },
      {
        concern:"Safe plan"
        outcome:"Dry run"
        guidance:"Add --dry-run to regenerate target assets and build.json without executing the final toolchain or writing the release executable."
      },
    ]
  const buildEnvironmentRows:
    value:[
      {
        rule:"Separate local profiles"
        guidance:"dowe dev resolves .env. dowe build resolves .env.live and does not fall back to .env when a Live value is missing."
      },
      {
        rule:"Process overrides first"
        guidance:"CI and signing variables from the process environment override .env.live. Keep every shared variable name declared in .env.example."
      },
    ]
  const buildTargetRows:
    value:[
      {
        target:"Android"
        artifact:"Signed release APK"
        guidance:"Available on macOS, Windows, and Linux with JDK 17 and the Android SDK. Dowe manages the pinned Gradle Wrapper."
      },
      {
        target:"Apple"
        artifact:"IPA and DMG on macOS"
        guidance:"iOS uses the Xcode toolchain and Apple signing credentials. macOS packages the native app and its custom icon into a DMG."
      },
      {
        target:"Windows"
        artifact:"Dowe-owned EXE"
        guidance:"Available only on Windows. Dowe appends the compiled application bundle to the installed Dowe runtime without requiring Rust or Tauri."
      },
      {
        target:"Linux"
        artifact:"Native executable"
        guidance:"Available only on Linux. The result uses the installed Dowe runtime and resolves the system GTK and WebKitGTK libraries when it starts."
      },
    ]
  const buildSigningRows:
    value:[
      {
        target:"Android keystore"
        guidance:"The first release creates a private upload keystore below .dowe/credentials/android. Later builds reuse the same identity. For CI, provide all four DOWE_ANDROID_KEYSTORE, DOWE_ANDROID_KEY_ALIAS, DOWE_ANDROID_KEYSTORE_PASSWORD, and DOWE_ANDROID_KEY_PASSWORD values together."
      },
      {
        target:"Apple identity and profile"
        guidance:"Dowe matches a valid Keychain identity with a compatible Xcode-managed provisioning profile. Configure an Apple account once in Xcode when no compatible profile exists. CI can provide DOWE_IOS_SIGNING_IDENTITY and DOWE_IOS_PROVISIONING_PROFILE together."
      },
    ]
  const buildVersionRows:
    value:[
      {
        variable:"DOWE_APP_VERSION"
        effect:"Sets Android versionName and the Apple short version presented to users."
      },
      {
        variable:"DOWE_APP_BUILD_NUMBER"
        effect:"Sets the positive Android versionCode and Apple bundle build number used by store validation."
      },
    ]
  Section id:"build-introduction" py:{ xs:6 md:10 }
    Grid columns:1 gap:3
      Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
        "DEVELOPMENT / NATIVE BUILD"
      Title size:{ xs:"3xl" md:"6xl" } weight:"black"
        "Build without publishing"
      Text size:"lg" color:"muted"
        "Compile Dowe Views into mobile and desktop release artifacts while keeping publication as a separate deploy step."
  Section id:"build-command" p:{ xs:5 md:7 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "1 / COMMAND"
        Title size:"3xl" weight:"black"
          "Choose a release target"
        Text size:"sm" color:"muted"
          "Run dowe build from the project root. Without --target, the interactive menu shows only targets available on the current host."
      Code:
        language:"dowe"
        variant:"soft"
        scheme:"surface"
        copyLabel:"Copy build commands"
        copiedLabel:"Copied"
        content:"""
          dowe build
          dowe build --target android
          dowe build --target ios
          dowe build --target macos
          dowe build --target windows
          dowe build --target linux
          dowe build --target android --dry-run
        """
      Table:
        data:buildCommandRows
        variant:"soft"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"concern" label:"Concern" width:"2fr"
        column field:"outcome" label:"Meaning" width:"2fr"
        column field:"guidance" label:"Details" width:"5fr"
  Section id:"build-environment" py:{ xs:7 md:10 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "2 / PRODUCTION ENVIRONMENT"
        Title size:"3xl" weight:"black"
          "Build with .env.live"
        Text size:"sm" color:"muted"
          "Keep development values in .env. Every dowe build reads Live values from the Git-ignored .env.live file, so release compilation never requires editing the development profile."
      Code:
        language:"dowe"
        variant:"soft"
        scheme:"surface"
        copyLabel:"Copy environment files"
        copiedLabel:"Copied"
        content:"""
          .env.example
          .env
          .env.live
        """
      Table:
        data:buildEnvironmentRows
        variant:"soft"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"rule" label:"Rule" width:"2fr"
        column field:"guidance" label:"Behavior" width:"5fr"
  Section id:"build-targets" py:{ xs:7 md:10 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "3 / HOST AVAILABILITY"
        Title size:"3xl" weight:"black"
          "Build on the operating system that owns the target"
        Text size:"sm" color:"muted"
          "Android is portable across supported hosts. Apple targets require macOS, Windows requires Windows, and Linux requires Linux."
      Table:
        data:buildTargetRows
        variant:"soft"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"target" label:"Target" width:"1fr"
        column field:"artifact" label:"Artifact" width:"2fr"
        column field:"guidance" label:"Host and toolchain" width:"5fr"
  Section id:"build-mobile-signing" p:{ xs:5 md:7 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "4 / AUTOMATIC SIGNING"
        Title size:"3xl" weight:"black"
          "Keep release credentials out of source"
        Text size:"sm" color:"muted"
          "Dowe automates the default local signing flow and keeps optional CI overrides in the process environment. Signing values never enter build.json."
      Table:
        data:buildSigningRows
        variant:"soft"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"target" label:"Target" width:"2fr"
        column field:"guidance" label:"Credential behavior" width:"5fr"
  Section id:"build-versioning" py:{ xs:7 md:10 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "5 / RELEASE VERSION"
        Title size:"3xl" weight:"black"
          "Increment the store build number"
        Text size:"sm" color:"muted"
          "The public version defaults to 0.1.0 and the numeric build defaults to 1. Store providers reject a build number that has already been uploaded."
      Code:
        language:"dowe"
        variant:"soft"
        scheme:"surface"
        copyLabel:"Copy versioned build"
        copiedLabel:"Copied"
        content:"""
          DOWE_APP_VERSION=1.2.0 DOWE_APP_BUILD_NUMBER=12 dowe build --target android
          DOWE_APP_VERSION=1.2.0 DOWE_APP_BUILD_NUMBER=12 dowe build --target ios
        """
      Table:
        data:buildVersionRows
        variant:"soft"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"variable" label:"Variable" width:"2fr"
        column field:"effect" label:"Changes" width:"5fr"
  Section id:"build-output" p:{ xs:5 md:7 }
    Grid columns:1 gap:4
      Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
        "6 / OUTPUT CONTRACT"
      Title size:"3xl" weight:"black"
        "Everything stays below .dowe/dist/build"
      Text size:"sm" color:"muted"
        "Each target owns one output folder containing build.json and the expected release artifact. Generated target projects remain disposable below .dowe/apps."
      Code:
        language:"dowe"
        variant:"soft"
        scheme:"surface"
        copyLabel:"Copy output structure"
        copiedLabel:"Copied"
        content:"""
          .dowe/
            apps/
            dist/
              build/
                android/AppName.apk
                ios/AppName.ipa
                macos/AppName.dmg
                windows/AppName.exe
                linux/AppName
                target/build.json
        """
      Alert type:"info" message:"A successful non-dry build verifies that the expected artifact exists. Reports exclude every .env profile, signing passwords, private keys, and authored Dowe source."
