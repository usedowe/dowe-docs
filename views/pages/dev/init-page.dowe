page InitPage
  const initTemplateRows:
    value:[
      {
        template:"CRUD"
        role:"A production-shaped fullstack example"
        guidance:"Creates an editorial blogs application with users, sessions, authentication, public listing, owner-scoped writes, a persistent View Store, and focused modal workflows. Its Database declaration defaults to the local Dowe provider."
      },
      {
        template:"Blank"
        role:"The shortest path to Hello Dowe"
        guidance:"Creates one visible page and one GET /api/hello endpoint. Use it to learn the project boundary before adding routes, views, and server modules. Add --i18n to either template for English and Spanish catalogs."
      },
    ]
  const initProjectRows:
    value:[
      {
        area:"Source at the root"
        guidance:"main.dowe owns application wiring, theme.dowe owns the design system, and imports use the project-root @/ alias."
      },
      {
        area:"Local values stay local"
        guidance:".env.example declares shareable names. The generated .env contains development values; .env.live, .env.stage, and .env.uat contain local deploy values. Every value file is excluded from Git."
      },
      {
        area:"Agents start with context"
        guidance:"Init installs the project Agent Harness and five focused public authoring skills, including domain modeling blueprints for business systems, so coding agents can inspect the same Dowe contracts."
      },
    ]
  const initSafetyRows:
    value:[
      {
        situation:"Existing project"
        behavior:"main.dowe is the marker"
        guidance:"Interactive init asks before reinstalling managed files and defaults to keeping the existing project unchanged."
      },
      {
        situation:"Non-interactive"
        behavior:"Never overwrite"
        guidance:"An explicit --template run against an existing project fails before writing and asks you to use an interactive terminal."
      },
      {
        situation:"Generated output"
        behavior:"Init leaves .dowe absent"
        guidance:"The .dowe directory is ignored and created only by later development, validation, build, or deploy commands."
      },
    ]
  Section id:"init-introduction" py:{ xs:6 md:10 }
    Grid columns:1 gap:3
      Text size:"xs" weight:"bold" spacing:"widest"
        "START HERE / PROJECT SETUP"
      Title size:{ xs:"3xl" md:"6xl" } weight:"black"
        "Dowe Init"
      Text size:"lg"
        "Create a complete Dowe project in the current directory, with source, editor settings, local environment files, and agent-ready guidance."
  Section id:"init-command" p:{ xs:5 md:7 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest"
          "1 / YOUR FIRST PROJECT"
        Title size:"3xl" weight:"black"
          "Initialize the directory you want to own"
        Text size:"sm"
          "Create or enter an empty directory, then run the interactive command. Dowe asks which starter to use and whether to add English and Spanish localization catalogs."
      Code:
        language:"dowe"
        variant:"solid"
        scheme:"surface"
        copyLabel:"Copy first project commands"
        copiedLabel:"Copied"
        content:"""
          mkdir my-dowe-app
          cd my-dowe-app
          dowe init
        """
      Alert type:"info" message:"Select CRUD for a complete fullstack example or blank for the smallest Hello Dowe application. Use --i18n when the first version should include English and Spanish catalogs."
      Code:
        language:"dowe"
        variant:"solid"
        scheme:"surface"
        copyLabel:"Copy template commands"
        copiedLabel:"Copied"
        content:"""
          dowe init --template crud
          dowe init --template crud --i18n
          dowe init --template blank
          dowe init --template blank --i18n
        """
  Section id:"init-templates" py:{ xs:7 md:10 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest"
          "2 / TWO CANONICAL STARTERS"
        Title size:"3xl" weight:"black"
          "Start small or study the full system"
        Text size:"sm"
          "Both templates use the same Dowe Source Format and the same Rust-owned compiler. The difference is how much application structure they create for you."
      Table:
        data:initTemplateRows
        variant:"solid"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"template" label:"Template" width:"1fr"
        column field:"role" label:"Best for" width:"2fr"
        column field:"guidance" label:"What it creates" width:"5fr"
  Section id:"init-project" p:{ xs:5 md:7 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest"
          "3 / PROJECT BOUNDARY"
        Title size:"3xl" weight:"black"
          "Know what Dowe creates"
        Text size:"sm"
          "The root files connect the application. Frontend modules stay under views, backend modules stay under server, and generated development output does not exist until a later command compiles the project."
      Code:
        language:"dowe"
        variant:"solid"
        scheme:"surface"
        copyLabel:"Copy project structure"
        copiedLabel:"Copied"
        content:"""
          main.dowe
          theme.dowe
          .env.example
          .env
          .env.live
          .env.stage
          .env.uat
          .gitignore
          .zed/settings.json
          views/
            routes/
            layouts/
            pages/
          server/
            endpoints.dowe
            handlers/
          .agents/
          AGENTS.md
          CLAUDE.md
        """
      Table:
        data:initProjectRows
        variant:"solid"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"area" label:"Area" width:"2fr"
        column field:"guidance" label:"Ownership" width:"5fr"
  Section id:"init-safety" py:{ xs:7 md:10 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest"
          "4 / SAFE INITIALIZATION"
        Title size:"3xl" weight:"black"
          "No partial project and no silent overwrite"
        Text size:"sm"
          "Dowe validates every destination before it writes. A conflict stops new-project initialization without leaving a partially copied template."
      Table:
        data:initSafetyRows
        variant:"solid"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"situation" label:"Situation" width:"2fr"
        column field:"behavior" label:"Decision" width:"2fr"
        column field:"guidance" label:"What happens" width:"5fr"
      Text size:"sm"
        "Initialization does not run development automatically, initialize Git, install node_modules, add Tailwind, or execute authored source through Node.js."
  Section id:"init-next" p:{ xs:5 md:7 }
    Grid columns:1 gap:4
      Text size:"xs" weight:"bold" spacing:"widest"
        "5 / NEXT STEP"
      Title size:"3xl" weight:"black"
        "Start the generated project"
      Text size:"sm"
        "Run the fullstack development targets from the same directory. Dowe compiles main.dowe and its imports, starts the server and web views, and writes disposable artifacts below .dowe."
      Code:
        language:"dowe"
        variant:"solid"
        scheme:"surface"
        copyLabel:"Copy development command"
        copiedLabel:"Copied"
        content:"dowe dev --target server --target web"
      Button:
        href:"/docs/dev/dev"
        variant:"solid"
        size:"sm"
        rounded:"full"
        iconStart:"code"
        "Continue to Dowe Dev"
