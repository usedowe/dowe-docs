page TestsPage
  const testPlacementRows:
    value:[
      {
        rule:"No reserved directory"
        guidance:"Choose a folder that makes the tested contract easy to find. Dowe does not reserve test or tests."
      },
      {
        rule:"Safe discovery"
        guidance:"Discovery skips .agents, .dowe, .git, target, and node_modules."
      },
      {
        rule:"Deterministic order"
        guidance:"Cases run by relative path and then source order for stable reports."
      },
    ]
  const assertionRows:
    value:[
      {
        assertion:"assert true"
        behavior:"Passes only when value is exactly true."
      },
      {
        assertion:"assert false"
        behavior:"Passes only when value is exactly false."
      },
      {
        assertion:"assert equal"
        behavior:"Compares strings, numbers, booleans, null, arrays, and objects exactly."
      },
    ]
  Section id:"tests-introduction" py:{ xs:6 md:10 }
    Grid columns:1 gap:3
      Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
        "DEVELOPMENT / TESTING"
      Title size:{ xs:"3xl" md:"6xl" } weight:"black"
        "Native project tests"
      Text size:"lg" color:"muted"
        "Place literal Dowe tests wherever they best describe the contract. Dowe discovers them without requiring a test folder or a filename convention."
  Section id:"tests-placement" p:{ xs:5 md:7 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "1 / UNRESTRICTED PLACEMENT"
        Title size:"3xl" weight:"black"
          "Use the folder that fits the project"
        Text size:"sm" color:"muted"
          "A test-only .dowe file can be below verification, checks, test, or any other project directory. The runner scans eligible Dowe files and executes only files that declare tests."
      Code:
        language:"dowe"
        variant:"soft"
        scheme:"surface"
        copyLabel:"Copy layout"
        copiedLabel:"Copied"
        content:"""
          verification/release/metadata.dowe
          checks/theme-contract.dowe
          test/navigation.dowe
        """
      Table:
        data:testPlacementRows
        variant:"soft"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"rule" label:"Rule" width:"2fr"
        column field:"guidance" label:"What it means" width:"5fr"
  Section id:"tests-syntax" py:{ xs:7 md:10 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "2 / LITERAL ASSERTIONS"
        Title size:"3xl" weight:"black"
          "Start with deterministic contracts"
        Text size:"sm" color:"muted"
          "Tests use a quoted name and direct assert declarations. Equal compares Dowe literals structurally without evaluating application code."
      Code:
        language:"dowe"
        variant:"soft"
        scheme:"surface"
        copyLabel:"Copy test"
        copiedLabel:"Copied"
        content:"""
          test "release metadata"
            assert true value:true
            assert false value:false
            assert equal actual:{ name:"dowe" channels:["stable" "canary"] } expected:{ name:"dowe" channels:["stable" "canary"] }
        """
      Table:
        data:assertionRows
        variant:"soft"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"assertion" label:"Assertion" width:"2fr"
        column field:"behavior" label:"Pass condition" width:"5fr"
  Section id:"tests-runner" p:{ xs:5 md:7 }
    Grid columns:1 gap:4
      Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
        "3 / RUNNER"
      Title size:"3xl" weight:"black"
        "Run all tests or select a path"
      Text size:"sm" color:"muted"
        "Use JSON for agents and CI. A failed assertion returns a non-zero status with its source location."
      Code:
        language:"dowe"
        variant:"soft"
        scheme:"surface"
        copyLabel:"Copy commands"
        copiedLabel:"Copied"
        content:"""
          dowe test
          dowe test verification
          dowe test checks/theme-contract.dowe
          dowe test --json
        """
      Alert type:"info" message:"This native runner does not execute views, handlers, HTTP, databases, or target runtime code. Use target-specific validation alongside literal tests when a contract needs runtime behavior."
