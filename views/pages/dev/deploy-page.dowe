page DeployPage
  const deploySurfaceRows:
    value:[
      {
        surface:"Server"
        providers:"Dowe Cloud (coming soon), Docker, SSH, Cloudflare Worker, or Vercel"
        guidance:"Selecting Dowe Cloud currently reports that deployment is coming soon and exits without compiling or publishing. Docker generates one standalone Linux application executable and copies it into Distroless. SSH installs one executable as a Debian or Ubuntu systemd service. Cloudflare Worker and Vercel use the supported Dowe-owned Wasm edge subset."
      },
      {
        surface:"Web"
        providers:"Dowe Cloud (coming soon), Docker, Cloudflare Pages, or Vercel"
        guidance:"Selecting Dowe Cloud currently reports that deployment is coming soon and exits without compiling or publishing. Docker generates a standalone Linux Web application for SSR and web assets, including views-only projects; it ignores Server configuration. Pages and Vercel package the generated HTML, JavaScript, CSS, fonts, icons, and project assets without a Node project."
      },
    ]
  const deployEnvironmentRows:
    value:[
      {
        area:"Client configuration"
        guidance:"Values referenced from Views are compiled from the selected profile into the output. The process environment has higher precedence and Dowe never falls back to another profile."
      },
      {
        area:"Server secrets"
        guidance:"Dotenv profiles are never copied into a package. Stage and UAT require the server-only DOWE_DEPLOY_ACCESS_PASSWORD; Live does not include that access middleware."
      },
    ]
  const nativeBuildRows:
    value:[
      {
        target:"Mobile"
        artifact:"APK and IPA"
        guidance:"Android downloads and verifies its pinned Gradle Wrapper, creates and reuses a private project keystore automatically, and produces a signed release APK. iOS embeds its distribution profile and produces a signed IPA."
      },
      {
        target:"Desktop"
        artifact:"DMG, EXE, and Linux"
        guidance:"Windows builds run on Windows and Linux builds run on Linux. Each appends a verified Dowe app bundle to the installed Dowe executable without Tauri, .NET, C, Cargo, Docker, or project target SDKs."
      },
      {
        target:"Safe plans"
        artifact:"Dry run"
        guidance:"Add --dry-run to materialize manifests and inspect commands without running toolchains or contacting a store."
      },
    ]
  const storeRows:
    value:[
      {
        store:"Google Play"
        guidance:"Set Android signing variables and DOWE_GOOGLE_PLAY_ACCESS_TOKEN. Increment DOWE_APP_BUILD_NUMBER for each upload; the default track is internal."
      },
      {
        store:"App Store Connect"
        guidance:"On macOS, set the iOS signing profile and identity plus the App Store API key and issuer."
      },
    ]
  const dockerRows:
    value:[
      {
        concern:"Registry"
        defaultValue:"docker.io"
        guidance:"Use Docker Hub, ghcr.io, a private host, or a registry with a port."
      },
      {
        concern:"Image"
        defaultValue:"project:latest"
        guidance:"Dowe adds latest when the selected image name does not contain a tag."
      },
      {
        concern:"Interactive preference"
        defaultValue:"server/web: .dowe/dev/docker-deploy-<surface>.json"
        guidance:"After confirmation, Server and Web remember registry and image independently for their next Docker menu. Explicit flags override these values; credentials are never stored."
      },
      {
        concern:"Platform"
        defaultValue:"linux/amd64"
        guidance:"The current native runtime and generated build command target Linux amd64."
      },
    ]
  const runtimeRows:
    value:[
      {
        concern:"Server executable"
        guidance:"Server Docker appends the selected application to Dowe's packaged Linux runtime utility and starts /usr/local/bin/dowe-app without CLI arguments."
      },
      {
        concern:"Web executable"
        guidance:"Web Docker uses the same packaged Linux utility to generate its own /usr/local/bin/dowe-app with surface metadata. Neither target downloads another CLI or requires Cargo, rustc, or a user Rust toolchain."
      },
    ]
  const sshRows:
    value:[
      {
        concern:"Preflight before upload"
        guidance:"Dowe validates the local runtime, then checks the remote OS, amd64 architecture, systemd, user, and root or sudo privileges before starting scp. Failed preflight uploads no executable and changes no service."
      },
      {
        concern:"Password or key"
        guidance:"OpenSSH owns password and key-passphrase prompts. Dowe stores neither and keeps normal host-key verification enabled."
      },
      {
        concern:"Debian or Ubuntu"
        guidance:"The remote installer rejects other distributions, non-amd64 hosts, or missing systemd. Root sessions install directly; non-root accounts require sudo access."
      },
      {
        concern:"Background service"
        guidance:"systemctl enable --now starts the app immediately, enables boot startup, and restarts it after a failure."
      },
    ]
  const deployResultRows:
    value:[
      {
        state:"Daemon available"
        guidance:"Dowe runs docker build for linux/amd64 with the full registry and image tag."
      },
      {
        state:"Daemon unavailable"
        guidance:"Deploy succeeds and reports that no local image was built."
      },
      {
        state:"Dry run"
        guidance:"The context and command are produced without executing Docker."
      },
    ]
  const deployBoundaryRows:
    value:[
      {
        area:"Secrets stay outside"
        guidance:".env, .env.live, .env.stage, and .env.uat are never copied. Declare names in .env.example and provide runtime server values through the platform."
      },
      {
        area:"Push stays explicit"
        guidance:"Dowe tags the local Docker image but does not log in or push it to the registry."
      },
    ]
  Section id:"deploy-introduction" py:{ xs:6 md:10 }
    Grid columns:1 gap:3
      Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
        "DEVELOPMENT / PRODUCTION DEPLOY"
      Title size:{ xs:"3xl" md:"6xl" } weight:"black"
        "Dowe Deploy"
      Text size:"lg" color:"muted"
        "Build native release artifacts, publish mobile apps, or deploy to Docker, SSH, Cloudflare, and Vercel. Dowe Cloud deployment is coming soon."
  Section id:"deploy-command" p:{ xs:5 md:7 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "1 / CAPABILITY-AWARE MENU"
        Title size:"3xl" weight:"black"
          "Choose a configured surface"
        Text size:"sm" color:"muted"
          "Run deploy from the project root. Select Live, Stage, or UAT before the deploy surface; Android and iOS remain Live-only."
      Code:
        language:"dowe"
        variant:"soft"
        scheme:"surface"
        copyLabel:"Copy commands"
        copiedLabel:"Copied"
        content:"""
          dowe deploy
          dowe deploy web --target docker --registry ghcr.io/acme --image clinic-web
          dowe deploy server --target ssh --publish --host server.example.com --user deploy --key-file $HOME/.ssh/id_ed25519
          dowe deploy server --environment stage --target docker --registry ghcr.io/acme --image clinic
          dowe deploy --environment uat --target cloudflare --name clinic-api
          dowe deploy server --target vercel --name clinic-api --publish
          dowe deploy web --target vercel --name clinic-web --publish
          dowe deploy web --environment live --name clinic-web --publish
          dowe deploy --target android --track internal --publish
          dowe deploy --target ios --publish
        """
      Table:
        data:deploySurfaceRows
        variant:"soft"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"surface" label:"Surface" width:"1fr"
        column field:"providers" label:"Providers" width:"2fr"
        column field:"guidance" label:"Behavior" width:"5fr"
  Section id:"deploy-environment" py:{ xs:7 md:10 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "2 / DEPLOY ENVIRONMENTS"
        Title size:"3xl" weight:"black"
          "Deploy without rewriting .env"
        Text size:"sm" color:"muted"
          "dowe dev uses .env. Deploy selects .env.live, .env.stage, or .env.uat, while dowe build always uses .env.live. Ignore every local value file and declare shared names in .env.example."
      Table:
        data:deployEnvironmentRows
        variant:"soft"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
        column field:"area" label:"Area" width:"2fr"
        column field:"guidance" label:"Rule" width:"5fr"
  Section id:"native-builds" py:{ xs:7 md:10 }
    Grid columns:1 gap:5
      Grid columns:1 gap:3
        Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
          "3 / NATIVE RELEASE ARTIFACTS"
        Title size:"3xl" weight:"black"
          "Build without publishing"
        Text size:"sm" color:"muted"
          "dowe build writes release artifacts under .dowe/dist/build. iOS and macOS are available only when Dowe runs on macOS."
      Code:
        language:"dowe"
        variant:"soft"
        scheme:"surface"
        copyLabel:"Copy build commands"
        copiedLabel:"Copied"
        content:"""
          dowe build --target android
          dowe build --target ios
          dowe build --target macos
          dowe build --target windows
          dowe build --target linux
        """
      Table:
        data:nativeBuildRows
        variant:"soft"
        scheme:"surface"
        size:"sm"
        striped:true
        dividers:true
        rounded:"md"
