page FootersPage
  Section id:"footers" py:{ xs:6 md:10 }
    Grid columns:1 gap:4
      Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
        "COPY-READY BLOCKS"
      Title size:{ xs:"3xl" md:"6xl" } weight:"black"
        "Footers"
      Text size:"lg" color:"muted"
        "Six responsive closing patterns. Preview desktop and mobile sizes, then copy the Footer source."
  Section id:"navigation" p:{ xs:5 md:7 }
    Grid columns:1 gap:5
      Flex direction:{ xs:"column" md:"row" } justify:"between" align:"end" gap:3
        Grid columns:1 gap:2
          Text size:"xs" weight:"bold" color:"muted"
            "01 · NAVIGATION"
          Title size:"2xl" weight:"black"
            "Copyright, links, and social destinations"
        Button:
          href:"/blocks/footer-preview/navigation"
          variant:"soft"
          scheme:"primary"
          size:"sm"
          rounded:"full"
          iconEnd:"arrow-right"
          "Open full page"
      Tabs variant:"line" scheme:"primary" position:"top" w:"full"
        tab id:"navigation-preview" label:"Preview"
          Device device:"laptop" w:"full" rounded:"lg" border:1
            Iframe:
              src:"/blocks/footer-preview/navigation"
              title:"Navigation Footer preview"
              loading:"lazy"
              sandbox:"scripts same-origin"
        tab id:"navigation-code" label:"Code"
          Code:
            language:"dowe"
            variant:"soft"
            scheme:"surface"
            copyLabel:"Copy Footer"
            copiedLabel:"Copied"
            content:"""
              Footer variant:"solid" scheme:"muted" boxed:true py:{ xs:7 md:5 }
                center
                  Flex direction:{ xs:"column" md:"row" } align:"center" justify:"between" gap:{ xs:5 md:8 } w:"full"
                    Text size:"xs" color:"onMuted"
                      "CompanyName @ 202X. All rights reserved."
                    Flex wrap:true justify:"center" gap:1
                      Button href:"/" variant:"solid" scheme:"muted" size:"sm"
                        "Eleven"
                      Button href:"/" variant:"solid" scheme:"muted" size:"sm"
                        "Twelve"
                      Button href:"/" variant:"solid" scheme:"muted" size:"sm"
                        "Thirteen"
                      Button href:"/" variant:"solid" scheme:"muted" size:"sm"
                        "Fourteen"
                      Button href:"/" variant:"solid" scheme:"muted" size:"sm"
                        "Fifteen"
                    Flex align:"center" justify:"center" gap:1
                      IconButton icon:"play-circle" label:"YouTube" href:"https://youtube.com" variant:"solid" scheme:"muted"
                      IconButton icon:"users-group-rounded" label:"Facebook" href:"https://facebook.com" variant:"solid" scheme:"muted"
                      IconButton icon:"chat-square" label:"Twitter" href:"https://twitter.com" variant:"solid" scheme:"muted"
                      IconButton icon:"camera" label:"Instagram" href:"https://instagram.com" variant:"solid" scheme:"muted"
                      IconButton icon:"link-circle" label:"LinkedIn" href:"https://linkedin.com" variant:"solid" scheme:"muted"
            """
  Section id:"social" p:{ xs:5 md:7 } bg:"softMuted" color:"onSoftMuted"
    Grid columns:1 gap:5
      Flex direction:{ xs:"column" md:"row" } justify:"between" align:"end" gap:3
        Grid columns:1 gap:2
          Text size:"xs" weight:"bold" color:"muted"
            "02 · SOCIAL"
