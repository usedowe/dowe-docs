page FootersPage
  Section id:"footers" py:{ xs:6 md:10 }
    Grid columns:1 gap:4
      Text size:"xs" weight:"bold" spacing:"widest"
        "COPY-READY BLOCKS"
      Title size:{ xs:"3xl" md:"6xl" } weight:"black"
        "Footers"
      Text size:"lg"
        "Six responsive closing patterns built with top, center, and bottom regions plus breakpoint show rules. Preview desktop and mobile sizes, then copy the Footer source."
  Section id:"navigation" p:{ xs:5 md:7 }
    Grid columns:1 gap:5
      Flex direction:{ xs:"column" md:"row" } justify:"between" align:"end" gap:3
        Grid columns:1 gap:2
          Text size:"xs" weight:"bold"
            "01 · NAVIGATION"
          Title size:"2xl" weight:"black"
            "Copyright, links, and social destinations"
        Button:
          href:"/blocks/footer-preview/navigation"
          variant:"solid"
          size:"sm"
          rounded:"full"
          iconEnd:"arrow-right"
          "Open full page"
      Tabs variant:"line" position:"top" w:"full"
        tab id:"navigation-preview" label:"Preview"
          Device device:"laptop" w:"full" rounded:"lg" border:1
            Iframe:
              src:"/blocks/footer-preview/navigation"
              title:"Navigation Footer preview"
              loading:"lazy"
              sandbox:"scripts same-origin"
        tab id:"navigation-code" label:"Code"
          Code:
            language:"dowe"
            variant:"solid"
            scheme:"surface"
            copyLabel:"Copy Footer"
            copiedLabel:"Copied"
            content:"""
              Footer scheme:"muted" boxed:true py:{ xs:7 md:5 }
                top
                  Flex justify:"center" show:{ xs:true md:false }
                    Text size:"xs" color:"mutedText"
                      "CompanyName @ 202X. All rights reserved."
                center
                  Flex direction:"row" align:"center" justify:"between" gap:8 w:"full" show:{ xs:false md:true }
                    Text size:"xs" color:"mutedText"
                      "CompanyName @ 202X. All rights reserved."
                    Flex wrap:true justify:"center" gap:1
                      Button href:"/" scheme:"muted" size:"sm"
                        "Eleven"
                      Button href:"/" scheme:"muted" size:"sm"
                        "Twelve"
                      Button href:"/" scheme:"muted" size:"sm"
                        "Thirteen"
                      Button href:"/" scheme:"muted" size:"sm"
                        "Fourteen"
                      Button href:"/" scheme:"muted" size:"sm"
                        "Fifteen"
                    Flex align:"center" justify:"center" gap:1
                      IconButton icon:"play-circle" label:"YouTube" href:"https://youtube.com" scheme:"muted"
                      IconButton icon:"users-group-rounded" label:"Facebook" href:"https://facebook.com" scheme:"muted"
                      IconButton icon:"chat-square" label:"Twitter" href:"https://twitter.com" scheme:"muted"
                      IconButton icon:"camera" label:"Instagram" href:"https://instagram.com" scheme:"muted"
                      IconButton icon:"link-circle" label:"LinkedIn" href:"https://linkedin.com" scheme:"muted"
                  Flex wrap:true justify:"center" gap:1 show:{ xs:true md:false }
                    Button href:"/" scheme:"muted" size:"sm"
                      "Eleven"
                    Button href:"/" scheme:"muted" size:"sm"
                      "Twelve"
                    Button href:"/" scheme:"muted" size:"sm"
                      "Thirteen"
                bottom
                  Flex align:"center" justify:"center" gap:1 show:{ xs:true md:false }
                    IconButton icon:"play-circle" label:"YouTube" href:"https://youtube.com" scheme:"muted"
                    IconButton icon:"camera" label:"Instagram" href:"https://instagram.com" scheme:"muted"
                    IconButton icon:"link-circle" label:"LinkedIn" href:"https://linkedin.com" scheme:"muted"
            """
