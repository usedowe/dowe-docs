            copyLabel:"Copy Footer"
            copiedLabel:"Copied"
            content:"""
              Footer scheme:"muted" boxed:true py:{ xs:8 md:6 }
                top
                  Grid columns:1 gap:5 w:"full"
                    Grid columns:3 align:"center" show:{ xs:false md:true }
                      Flex justify:"start" wrap:true gap:1
                        Button href:"/" scheme:"muted" size:"sm"
                          "Eleven"
                        Button href:"/" scheme:"muted" size:"sm"
                          "Twelve"
                        Button href:"/" scheme:"muted" size:"sm"
                          "Thirteen"
                      Flex justify:"center"
                        Brand href:"/" label:"WebbyFrames home"
                          Flex align:"center" gap:2
                            Icon name:"widget-5" fill:"mutedText" w:7 h:7
                            Flex direction:"column" align:"center"
                              Text size:"lg" weight:"black" color:"mutedText"
                                "WebbyFrames"
                              Text size:"xs" color:"mutedText"
                                "for Figma"
                      Flex justify:"end" gap:1
                        IconButton icon:"play-circle" label:"YouTube" href:"https://youtube.com" scheme:"muted"
                        IconButton icon:"camera" label:"Instagram" href:"https://instagram.com" scheme:"muted"
                        IconButton icon:"link-circle" label:"LinkedIn" href:"https://linkedin.com" scheme:"muted"
                    Flex direction:"column" align:"center" gap:4 show:{ xs:true md:false }
                      Brand href:"/" label:"WebbyFrames home"
                        Flex align:"center" gap:2
                          Icon name:"widget-5" fill:"mutedText" w:7 h:7
                          Text size:"lg" weight:"black" color:"mutedText"
                            "WebbyFrames"
                      Flex justify:"center" wrap:true gap:1
                        Button href:"/" scheme:"muted" size:"sm"
                          "Eleven"
