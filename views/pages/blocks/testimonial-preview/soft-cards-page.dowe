page SoftCardsTestimonialsPage
  const testimonials:
    value:[
      {
        id:"john"
        quote:"A visual system should make collaboration easier, reduce uncertainty, and help good decisions happen sooner."
        name:"John Carter"
        role:"Head of Marketing"
      },
      {
        id:"matt"
        quote:"The new direction gave our team a shared language and made the work feel simpler from the very first week."
        name:"Matt Cannon"
        role:"Product Director"
      },
      {
        id:"sophie"
        quote:"Clear thinking and careful craft came together in a result that works beautifully for our customers and our team."
        name:"Sophie Moore"
        role:"Lead Developer"
      },
    ]
  Section id:"soft-card-testimonials" bg:"background" color:"backgroundText" boxed:true py:{ xs:8 md:14 } minH:"vh-0"
    Grid columns:1 gap:{ xs:8 md:12 }
      Flex direction:"column" align:"center" gap:3
        Title size:{ xs:"3xl" md:"5xl" } weight:"black"
          "What our clients say"
        Text size:"lg"
          "Short stories from collaborators who found clarity, momentum, and a better way forward."
      Grid columns:{ xs:1 md:3 } gap:5
        each in:testimonials as:testimonial key:testimonial.id
          Card variant:"solid" scheme:"muted" rounded:"xl" p:{ xs:7 md:9 } minH:64
            Flex direction:"column" justify:"between" gap:7 minH:52
              Text size:"lg"
                "{testimonial.quote}"
              Flex align:"center" gap:4
                Box bg:"surface" rounded:"full" w:14 h:14 p:3
                  Icon name:"gallery-bold-duotone" fill:"muted" w:8 h:8
                Grid columns:1 gap:1
                  Text weight:"bold"
                    "{testimonial.name}"
                  Text
                    "{testimonial.role}"
