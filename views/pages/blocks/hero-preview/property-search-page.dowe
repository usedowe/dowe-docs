page PropertySearchHeroPage
  const guestOptions value:[
    { id:"one" value:"one" label:"1 guest" },
    { id:"two" value:"two" label:"2 guests" },
    { id:"family" value:"family" label:"Family or group" },
  ]
  Section:
    id:"property-search-hero"
    bg:"softPrimary"
    color:"onSoftPrimary"
    boxed:true
    py:{ xs:8 md:12 }
    Grid columns:1 gap:6
      Card:
        variant:"solid"
        scheme:"surface"
        rounded:"xl"
        shadow:"xl"
        shadowColor:"muted"
        p:0
        Grid columns:{ xs:1 md:"5fr 6fr" } gap:0 align:"center"
          Flex direction:"column" align:"start" justify:"center" gap:6 p:{ xs:6 md:12 }
            Text size:"xs" weight:"bold" spacing:"widest" color:"primary"
              "STAYS WORTH TRAVELING FOR"
            Title size:{ xs:"4xl" md:"6xl" } weight:"black"
              "Find a place that feels like yours"
            Text size:"lg" color:"muted"
              "Search handpicked homes, coastal escapes, and memorable stays for your next journey."
            Flex direction:{ xs:"column" sm:"row" } align:"center" gap:3 pt:2
              Button variant:"solid" scheme:"primary" size:"lg" rounded:"md"
                "Explore stays"
              Button variant:"ghost" scheme:"primary" size:"lg" rounded:"md"
                "Host your home"
          Box:
            cover:"/assets/blocks/hero/coastal-villa.jpg"
            rounded:"xl"
            minH:{ xs:64 md:80 }
      Card:
        variant:"solid"
        scheme:"surface"
        rounded:"xl"
        shadow:"lg"
        shadowColor:"muted"
        p:{ xs:5 md:4 }
        Grid columns:{ xs:1 md:"2fr 1fr 1fr 1fr auto" } gap:3 align:"end"
          Input:
            label:"Destination"
            placeholder:"City, coast, or landmark"
            variant:"outlined"
            scheme:"primary"
            iconStart:"map"
            w:"full"
          Date value:"2026-09-12" label:"Check in" variant:"outlined" scheme:"primary" w:"full"
          Date value:"2026-09-18" label:"Check out" variant:"outlined" scheme:"primary" w:"full"
          Select label:"Guests" placeholder:"2 guests" variant:"outlined" scheme:"primary" w:"full"
            each in:guestOptions as:option key:option.id
              Option value:option.value label:option.label
          Button variant:"solid" scheme:"primary" size:"lg" iconStart:"magnifier" w:"full" px:8
            "Search"
