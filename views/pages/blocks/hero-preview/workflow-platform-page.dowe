page WorkflowPlatformHeroPage
  const trustedBrands value:[
    { id:"next" label:"Next" },
    { id:"upgrade" label:"Upgrade" },
    { id:"intdeco" label:"Intdeco" },
    { id:"thanos" label:"Thanos" },
    { id:"stackd" label:"Stackd" },
  ]
  Section:
    id:"workflow-platform-hero"
    cover:"/assets/blocks/hero/geometric-grid.jpg"
    boxed:true
    minH:"vh-0"
    py:{ xs:10 md:14 }
    Flex direction:"column" align:"center" justify:"center" gap:0 minH:"vh-32"
      Flex direction:"column" align:"center" gap:0 show:{ xs:false md:true }
        Title size:"7xl" weight:"black"
          "Streamline your workflow,"
        Title size:"7xl" weight:"black"
          "achieve excellence"
      Flex direction:"column" align:"center" gap:0 show:{ xs:true md:false }
        Title size:"4xl" weight:"black"
          "Streamline your workflow, achieve excellence"
      Box h:8
      Flex direction:"column" align:"center" gap:1
        Text size:"lg" color:"muted"
          "Connect planning, collaboration, and delivery"
        Text size:"lg" color:"muted"
          "in one focused workspace."
      Box h:12
      Grid columns:{ xs:1 sm:"1fr 600px auto 1fr" } gap:3 align:"center" w:"full"
        Box show:{ xs:false sm:true }
        Input placeholder:"Your email address" variant:"outlined" scheme:"muted" w:"full"
        Button variant:"solid" scheme:"primary" size:"lg" px:10
          "Get Started"
        Box show:{ xs:false sm:true }
      Box h:8
      Flex align:"center" gap:2
        Icon name:"check-circle" style:"bold" fill:"success"
        Text size:"sm" color:"muted"
          "14-day free trial. No credit card needed."
      Box h:20
      Flex wrap:true justify:"center" align:"center" gap:{ xs:8 md:24 }
        each in:trustedBrands as:brand key:brand.id
          Flex align:"center" gap:3
            Icon name:"layers-minimalistic" style:"bold" fill:"muted" w:10 h:10
            Text size:"3xl" weight:"black" color:"muted"
              "{brand.label}"
