page VideoSplitHeroPage
  Section id:"video-split-hero" bg:"background" color:"onBackground" boxed:true py:{ xs:8 md:12 }
    Grid columns:{ xs:1 md:"5fr 4fr" } gap:{ xs:8 md:14 } align:"center" minH:"vh-16"
      Flex direction:"column" align:"start" justify:"center" gap:5
        Title size:{ xs:"4xl" md:"6xl" } weight:"black"
          "A dedicated team to grow your company"
        Text size:"lg" color:"muted"
          "Introduce the offer with a short message, paired calls to action, and a product story visitors can play when they are ready."
        Flex direction:{ xs:"column" sm:"row" } align:"center" gap:3
          Button variant:"solid" scheme:"primary" size:"lg" rounded:"full" iconEnd:"arrow-right"
            "Get started"
          Button variant:"outlined" scheme:"primary" size:"lg" rounded:"full"
            "Talk to sales"
      Video:
        src:"https://example.com/video.mp4"
        aspect:"horizontal"
        autoplay:false
        variant:"soft"
        scheme:"muted"
        rounded:"xl"
