page SoftwareSolutionsHeroPage
  Section id:"software-solutions-hero" boxed:true minH:"vh-16" py:{ xs:6 md:10 }
    Card:
      cover:"/assets/blocks/hero/technology-analytics.jpg"
      overlay:"rgba(8,16,40,0.76)"
      rounded:"xl"
      minH:"vh-16"
      w:"full"
      p:{ xs:8 md:14 }
      Flex direction:"column" align:"center" justify:"center" gap:0 minH:{ xs:"vh-32" md:"vh-44" }
        Flex direction:"column" align:"center" gap:0 show:{ xs:false md:true }
          Title size:"7xl" weight:"black" color:"onPrimary"
            "Software solutions for"
          Title size:"7xl" weight:"black" color:"onPrimary"
            "the digital age"
        Flex direction:"column" align:"center" gap:0 show:{ xs:true md:false }
          Title size:"4xl" weight:"black" color:"onPrimary"
            "Software solutions for the digital age"
        Box h:10
        Flex direction:"column" align:"center" gap:1
          Text size:"lg" color:"onPrimary"
            "Unite every team around"
          Text size:"lg" color:"onPrimary"
            "one secure source of truth."
        Box h:10
        Button variant:"solid" scheme:"primary" size:"lg" rounded:"md" px:8
          "Our Core Services"
