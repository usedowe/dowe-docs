page SmartSolutionsHeroPage
  Section:
    id:"smart-solutions-hero"
    bg:"background"
    color:"onBackground"
    boxed:true
    minH:"vh-16"
    py:{ xs:8 md:12 }
    Grid columns:{ xs:1 md:"5fr 4fr" } gap:{ xs:8 md:14 } align:"stretch" minH:"vh-16"
      Flex direction:"column" align:"start" justify:"center" gap:5
        Text size:"xs" weight:"bold" spacing:"widest" color:"info"
          "BUILT FOR AMBITIOUS TEAMS"
        Title size:{ xs:"4xl" md:"6xl" } weight:"black"
          "Turn ambitious ideas into steady growth"
        Text size:"lg" color:"muted"
          "Give your team a clear path from first insight to launch, with the context and tools to make every decision count."
        Grid columns:{ xs:1 sm:2 } gap:3 w:"full"
          Button variant:"solid" scheme:"primary" size:"lg" rounded:"full" w:"full"
            "Order now"
          Button variant:"outlined" scheme:"primary" size:"lg" rounded:"full" w:"full"
            "Explore"
        Grid columns:1 gap:2
          Text size:"xs" weight:"bold" color:"muted"
            "TRUSTED BY"
          Flex wrap:true align:"center" gap:5
            Flex align:"center" gap:2
              Icon name:"global" style:"linear" fill:"primary" w:5 h:5
              Text size:"sm" weight:"bold"
                "Google"
            Flex align:"center" gap:2
              Icon name:"play-circle" style:"linear" fill:"primary" w:5 h:5
              Text size:"sm" weight:"bold"
                "YouTube"
            Flex align:"center" gap:2
              Icon name:"users-group-rounded" style:"linear" fill:"primary" w:5 h:5
              Text size:"sm" weight:"bold"
                "Facebook"
      Box:
        cover:"/assets/blocks/hero/consulting-team-wide.jpg"
        rounded:"xl"
        minH:{ xs:64 md:"vh-16" }
        shadow:"xl"
        shadowColor:"muted"
