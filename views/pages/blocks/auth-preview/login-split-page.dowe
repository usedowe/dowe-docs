page LoginSplitAuthPage
  signal form value:{ email:"" password:"" remember:false }
  Section id:"login-split-auth" p:0 minH:"vh-0"
    Grid columns:{ xs:1 md:2 } gap:0 minH:"vh-0"
      Box:
        bg:"muted"
        color:"primary"
        minH:{ xs:40 md:"vh-0" }
        p:{ xs:6 md:12 }
        Flex direction:"column" justify:"center" align:"center" minH:{ xs:40 md:"vh-0" }
          Box bg:"surface" rounded:"full" p:{ xs:5 md:9 } shadow:"xl" shadowColor:"muted"
            Icon name:"shield-user-bold-duotone" fill:"primary" w:{ xs:16 md:24 } h:{ xs:16 md:24 }
      Flex:
        direction:"column"
        justify:"center"
        align:"center"
        p:{ xs:6 md:12 }
        minH:{ xs:"vh-40" md:"vh-0" }
        Flex:
          align:"center"
          justify:"center"
          w:"full"
          Grid columns:1 gap:5 w:"full" maxW:96
            Grid columns:1 gap:2
              Title size:"3xl" weight:"black"
                "Log in"
              Text size:"sm"
                "Welcome back. Enter your details to continue."
            Grid columns:1 gap:4
              Input bind:form.email label:"Email address" placeholder:"you@example.com" helpText:"Use the email associated with your account." variant:"solid" w:"full"
                validate rule:"required" message:"Enter your email address."
                validate rule:"email" message:"Enter a valid email address."
              Password bind:form.password label:"Password" placeholder:"Enter your password" hideStrength:true variant:"solid" w:"full"
              Flex justify:"between" align:"center" gap:2
                Checkbox bind:form.remember label:"Remember me"
                Button href:"/blocks/auth-preview/forgot-password" variant:"solid" size:"xs"
                  "Forgot password?"
              Button w:"full"
                "Log in"
            Grid columns:3 gap:3 align:"center"
              Divider
              Text size:"xs"
                "OR"
              Divider
            Grid columns:{ xs:1 lg:2 } gap:2
              Button variant:"solid" size:"sm" iconStart:"global" w:"full"
                "Continue with Google"
              Button variant:"solid" size:"sm" iconStart:"smartphone" w:"full"
                "Continue with Apple"
            Divider
            Button href:"/blocks/auth-preview/signup-split" variant:"solid" size:"sm"
              "No account yet? Sign up"
