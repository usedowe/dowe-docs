page ForgotPasswordAuthPage
  signal email value:""
  Section id:"forgot-password-auth" bg:"softMuted" boxed:true p:{ xs:5 md:10 } minH:"vh-0"
    Grid columns:{ xs:1 md:3 } align:"center" minH:"vh-0"
      Box show:{ xs:false md:true }
      Card rounded:"xl" shadow:"xl" shadowColor:"muted" p:{ xs:6 md:8 }
        Grid columns:1 gap:5
          Flex direction:"column" align:"center" gap:2
            Box bg:"softPrimary" color:"primary" rounded:"full" p:4
              Icon name:"letter-unread-bold-duotone" fill:"primary" w:10 h:10
            Title size:"3xl" weight:"black"
              "Forgot your password?"
            Text size:"sm" color:"muted"
              "Enter your email and we will send you a secure reset link."
          Input bind:email label:"Email address" placeholder:"you@example.com" variant:"soft" w:"full"
          Button w:"full"
            "Send reset link"
          Button href:"/blocks/auth-preview/login-card" variant:"ghost" size:"sm" iconStart:"arrow-left"
            "Back to log in"
      Box show:{ xs:false md:true }
