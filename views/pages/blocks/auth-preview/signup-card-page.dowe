page SignupCardAuthPage
  signal form value:{ firstName:"" lastName:"" email:"" password:"" accepted:false }
  Section id:"signup-card-auth" bg:"muted" boxed:true p:{ xs:5 md:10 } minH:"vh-0"
    Grid columns:{ xs:1 md:3 } align:"center" minH:"vh-0"
      Box show:{ xs:false md:true }
      Card rounded:"xl" shadow:"xl" shadowColor:"primary" p:{ xs:6 md:8 } border:1
        Grid columns:1 gap:5
          Flex direction:"column" align:"center" gap:2
            Icon name:"shield-check-bold-duotone" fill:"primary" w:12 h:12
            Title size:"3xl" weight:"black"
              "Sign up free"
            Text size:"sm"
              "14-day free access to unlimited resources."
          Grid columns:2 gap:3
            Input bind:form.firstName label:"First name" placeholder:"First name" helpText:"Use the name shown on your account." variant:"solid" w:"full"
              validate rule:"required" message:"Enter your first name."
            Input bind:form.lastName label:"Last name" placeholder:"Last name" helpText:"Use the name shown on your account." variant:"solid" w:"full"
              validate rule:"required" message:"Enter your last name."
          Input bind:form.email label:"Email address" placeholder:"you@example.com" helpText:"Use an email address you can access." variant:"solid" w:"full"
            validate rule:"required" message:"Enter your email address."
            validate rule:"email" message:"Enter a valid email address."
          Password bind:form.password label:"Password" placeholder:"Create a password" hideStrength:false variant:"solid" w:"full"
          Checkbox bind:form.accepted label:"I agree to the terms and privacy policy."
            validate rule:"required" message:"Accept the terms and privacy policy to continue."
          Button w:"full"
            "Create free account"
          Grid columns:3 gap:3 align:"center"
            Divider
            Text size:"xs"
              "OR"
            Divider
          Grid columns:{ xs:1 sm:3 } gap:3
            Button variant:"solid" size:"sm" iconStart:"global" w:"full"
              "Google"
            Button variant:"solid" size:"sm" iconStart:"smartphone" w:"full"
              "Apple"
            Button variant:"solid" size:"sm" iconStart:"chat-round-line" w:"full"
              "Twitter"
          Divider
          Button href:"/blocks/auth-preview/login-card" variant:"solid" size:"sm"
            "Already have an account? Log in"
      Box show:{ xs:false md:true }
