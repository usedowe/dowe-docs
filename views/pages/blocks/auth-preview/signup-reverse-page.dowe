page SignupReverseAuthPage
  signal form value:{ firstName:"" lastName:"" email:"" password:"" accepted:false }
  Section id:"signup-reverse-auth" p:0 minH:"vh-0"
    Grid columns:{ xs:1 md:2 } gap:0 minH:"vh-0"
      Box:
        show:{ xs:true md:false }
        bg:"muted"
        color:"info"
        minH:40
        p:6
        Flex direction:"column" justify:"center" align:"center" minH:40
          Box bg:"surface" rounded:"lg" p:5 shadow:"lg" shadowColor:"muted"
            Icon name:"user-check-rounded-bold-duotone" fill:"info" w:16 h:16
      Flex:
        direction:"column"
        justify:"center"
        align:"center"
        p:{ xs:6 md:12 }
        minH:{ xs:"vh-40" md:"vh-0" }
        Flex:
          align:"center"
          justify:"center"
          w:"full"
          Grid columns:1 gap:5 w:"full" maxW:96
            Grid columns:1 gap:2
              Title size:"3xl" weight:"black"
                "Sign up"
              Text size:"sm"
                "Set up your account in a few quick steps."
            Grid columns:2 gap:3
              Input bind:form.firstName label:"First name" placeholder:"First name" helpText:"Use the name shown on your account." variant:"solid" scheme:"info" w:"full"
                validate rule:"required" message:"Enter your first name."
              Input bind:form.lastName label:"Last name" placeholder:"Last name" helpText:"Use the name shown on your account." variant:"solid" scheme:"info" w:"full"
                validate rule:"required" message:"Enter your last name."
            Input bind:form.email label:"Email address" placeholder:"you@example.com" helpText:"Use an email address you can access." variant:"solid" scheme:"info" w:"full"
              validate rule:"required" message:"Enter your email address."
              validate rule:"email" message:"Enter a valid email address."
            Password bind:form.password label:"Password" placeholder:"Create a password" hideStrength:false variant:"solid" scheme:"info" w:"full"
            Checkbox bind:form.accepted label:"I agree to the terms and privacy policy." scheme:"info"
              validate rule:"required" message:"Accept the terms and privacy policy to continue."
            Button scheme:"info" w:"full"
              "Create account"
            Grid columns:{ xs:1 lg:2 } gap:2
              Button variant:"outlined" scheme:"info" size:"sm" iconStart:"global" w:"full"
                "Continue with Google"
              Button variant:"outlined" scheme:"info" size:"sm" iconStart:"smartphone" w:"full"
                "Continue with Apple"
            Divider
            Button href:"/blocks/auth-preview/login-reverse" variant:"ghost" scheme:"info" size:"sm"
              "Already have an account? Log in"
      Box:
        show:{ xs:false md:true }
        bg:"muted"
        color:"info"
        minH:"vh-0"
        p:12
        Flex direction:"column" justify:"center" align:"center" minH:"vh-0"
          Box bg:"surface" rounded:"lg" p:9 shadow:"xl" shadowColor:"muted"
            Icon name:"user-check-rounded-bold-duotone" fill:"info" w:24 h:24
