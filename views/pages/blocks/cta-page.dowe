page CtasPage
  Section id:"ctas" py:{ xs:6 md:10 }
    Grid columns:1 gap:4
      Text size:"xs" weight:"bold" spacing:"widest"
        "COPY-READY BLOCKS"
      Title size:{ xs:"3xl" md:"6xl" } weight:"black"
        "Call to action"
      Text size:"lg"
        "Seven responsive wireframe CTAs built from real Dowe components and neutral media placeholders."
  Section id:"split-actions" p:{ xs:5 md:7 }
    Grid columns:1 gap:5
      Flex direction:{ xs:"column" md:"row" } justify:"between" align:"end" gap:3
        Grid columns:1 gap:2
          Text size:"xs" weight:"bold"
            "01 · SPLIT ACTIONS"
          Title size:"2xl" weight:"black"
            "A compact headline balanced by two calls to action"
        Button href:"/blocks/cta-preview/split-actions" variant:"solid" size:"sm" rounded:"full" iconEnd:"arrow-right"
          "Open full page"
      Tabs variant:"line" position:"top" w:"full"
        tab id:"split-actions-preview" label:"Preview"
          Device device:"laptop" w:"full" rounded:"lg" border:1
            Iframe src:"/blocks/cta-preview/split-actions" title:"Split actions CTA preview" loading:"lazy" sandbox:"scripts same-origin"
        tab id:"split-actions-code" label:"Code"
          Code:
            language:"dowe"
            variant:"solid"
            scheme:"surface"
            copyLabel:"Copy CTA"
            copiedLabel:"Copied"
            content:"""
              const actions value:[
                { id:"start" label:"Get started" variant:"solid" },
                { id:"sales" label:"Talk to sales" variant:"outlined" },
              ]

              Section id:"split-actions-cta" bg:"background" color:"backgroundText" boxed:true p:{ xs:6 md:10 }
                Grid columns:{ xs:1 md:2 } gap:{ xs:6 md:12 } align:"center" minH:{ xs:72 md:56 }
                  Flex direction:"column" align:{ xs:"center" md:"start" } justify:"center" gap:3
                    Title size:{ xs:"3xl" md:"4xl" } weight:"black"
                      "Create your account today and get started for free!"
                  Grid columns:1 gap:3 w:"full" show:{ xs:true sm:false }
                    each in:actions as:action key:action.id
                      Button variant:action.variant size:"lg" rounded:"full" w:"full"
                        "{action.label}"
                  Flex align:"center" justify:{ xs:"center" md:"end" } gap:3 show:{ xs:false sm:true }
                    each in:actions as:action key:action.id
                      Button variant:action.variant size:"lg" rounded:"full"
                        "{action.label}"
            """
  Section id:"centered-actions" p:{ xs:5 md:7 }
    Grid columns:1 gap:5
      Flex direction:{ xs:"column" md:"row" } justify:"between" align:"end" gap:3
        Grid columns:1 gap:2
          Text size:"xs" weight:"bold"
            "02 · CENTERED ACTIONS"
          Title size:"2xl" weight:"black"
            "A centered conversion message with paired actions"
        Button href:"/blocks/cta-preview/centered-actions" size:"sm" rounded:"full" iconEnd:"arrow-right"
          "Open full page"
      Tabs variant:"line" position:"top" w:"full"
        tab id:"centered-actions-preview" label:"Preview"
          Device device:"laptop" w:"full" rounded:"lg" border:1
            Iframe src:"/blocks/cta-preview/centered-actions" title:"Centered actions CTA preview" loading:"lazy" sandbox:"scripts same-origin"
        tab id:"centered-actions-code" label:"Code"
          Code:
            language:"dowe"
            variant:"solid"
            scheme:"surface"
            copyLabel:"Copy CTA"
            copiedLabel:"Copied"
            content:"""
              const actions value:[
                { id:"start" label:"Get started" variant:"solid" },
                { id:"sales" label:"Talk to sales" variant:"outlined" },
              ]

              Section id:"centered-actions-cta" bg:"background" color:"backgroundText" boxed:true p:{ xs:6 md:12 }
                Flex direction:"column" align:"center" justify:"center" gap:6 minH:{ xs:80 md:"vh-0" }
                  Flex direction:"column" align:"center" gap:3 maxW:96
                    Title size:{ xs:"3xl" md:"5xl" } weight:"black"
                      "Create your account today and get started for free!"
                  Grid columns:1 gap:3 w:"full" show:{ xs:true sm:false }
                    each in:actions as:action key:action.id
                      Button variant:action.variant size:"lg" rounded:"full" w:"full"
                        "{action.label}"
                  Flex align:"center" justify:"center" gap:3 show:{ xs:false sm:true }
                    each in:actions as:action key:action.id
                      Button variant:action.variant size:"lg" rounded:"full"
                        "{action.label}"
            """
  Section id:"media-panel" p:{ xs:5 md:7 }
    Grid columns:1 gap:5
      Flex direction:{ xs:"column" md:"row" } justify:"between" align:"end" gap:3
        Grid columns:1 gap:2
          Text size:"xs" weight:"bold"
            "03 · MEDIA PANEL"
          Title size:"2xl" weight:"black"
            "A soft split panel pairing conversion copy with media"
        Button href:"/blocks/cta-preview/media-panel" variant:"solid" size:"sm" rounded:"full" iconEnd:"arrow-right"
          "Open full page"
      Tabs variant:"line" position:"top" w:"full"
        tab id:"media-panel-preview" label:"Preview"
          Device device:"laptop" w:"full" rounded:"lg" border:1
            Iframe src:"/blocks/cta-preview/media-panel" title:"Media panel CTA preview" loading:"lazy" sandbox:"scripts same-origin"
        tab id:"media-panel-code" label:"Code"
          Code:
            language:"dowe"
            variant:"solid"
            scheme:"surface"
            copyLabel:"Copy CTA"
            copiedLabel:"Copied"
            content:"""
              const actions value:[
                { id:"start" label:"Get started" variant:"solid" },
                { id:"sales" label:"Talk to sales" variant:"outlined" },
              ]

              Section id:"media-panel-cta" bg:"muted" color:"mutedText" boxed:true p:{ xs:6 md:12 }
                Grid columns:{ xs:1 md:2 } gap:{ xs:8 md:14 } align:"center" minH:"vh-0"
                  Flex direction:"column" align:{ xs:"center" md:"start" } justify:"center" gap:5
                    Grid columns:1 gap:3
                      Title size:{ xs:"3xl" md:"5xl" } weight:"black"
                        "Create your account today and get started for free!"
                      Text size:"lg"
                        "Bring your next idea to life with a focused workspace built for clear plans and steady progress."
                    Grid columns:1 gap:3 w:"full" show:{ xs:true sm:false }
                      each in:actions as:action key:action.id
                        Button variant:action.variant size:"lg" rounded:"full" w:"full"
                          "{action.label}"
                    Flex align:"center" gap:3 show:{ xs:false sm:true }
                      each in:actions as:action key:action.id
                        Button variant:action.variant size:"lg" rounded:"full"
                          "{action.label}"
                  Box bg:"surface" rounded:"xl" p:8 minH:{ xs:72 md:96 }
                    Flex direction:"column" align:"center" justify:"center" gap:3 minH:{ xs:56 md:80 }
                      Icon name:"gallery-bold-duotone" fill:"muted" w:16 h:16
                      Text size:"sm"
                        "Image placeholder"
            """
  Section id:"app-download" p:{ xs:5 md:7 }
    Grid columns:1 gap:5
      Flex direction:{ xs:"column" md:"row" } justify:"between" align:"end" gap:3
        Grid columns:1 gap:2
          Text size:"xs" weight:"bold"
            "04 · APP DOWNLOAD"
          Title size:"2xl" weight:"black"
            "Two platform cards with distinct store actions"
        Button href:"/blocks/cta-preview/app-download" size:"sm" rounded:"full" iconEnd:"arrow-right"
          "Open full page"
      Tabs variant:"line" position:"top" w:"full"
        tab id:"app-download-preview" label:"Preview"
          Device device:"laptop" w:"full" rounded:"lg" border:1
            Iframe src:"/blocks/cta-preview/app-download" title:"App download CTA preview" loading:"lazy" sandbox:"scripts same-origin"
        tab id:"app-download-code" label:"Code"
          Code:
            language:"dowe"
            variant:"solid"
            scheme:"surface"
            copyLabel:"Copy CTA"
            copiedLabel:"Copied"
            content:"""
              Section id:"app-download-cta" bg:"background" color:"backgroundText" boxed:true p:{ xs:6 md:12 }
                Grid columns:{ xs:1 md:2 } gap:{ xs:5 md:8 } align:"stretch" minH:"vh-0"
                  Card scheme:"primary" rounded:"xl" p:{ xs:7 md:10 } minH:{ xs:80 md:96 }
                    Flex direction:"column" align:{ xs:"center" md:"start" } justify:"center" gap:5 minH:{ xs:64 md:80 }
                      Title size:{ xs:"3xl" md:"4xl" } weight:"black"
                        "Download our app for iOS and iPadOS"
                      Text size:"lg" color:"primaryText"
                        "Stay connected to your work from every Apple device, wherever the day takes you."
                      Button scheme:"muted" size:"lg" rounded:"full" iconStart:"smartphone"
                        "Download for iOS"
                  Card variant:"outlined" scheme:"muted" rounded:"xl" p:{ xs:7 md:10 } minH:{ xs:80 md:96 }
                    Flex direction:"column" align:{ xs:"center" md:"start" } justify:"center" gap:5 minH:{ xs:64 md:80 }
                      Title size:{ xs:"3xl" md:"4xl" } weight:"black"
                        "Download our app for Android"
                      Text size:"lg"
                        "Take the same focused workflow with you across phones, tablets, and compatible devices."
                      Button size:"lg" rounded:"full" iconStart:"play"
                        "Download for Android"
            """
  Section id:"media-left" p:{ xs:5 md:7 }
    Grid columns:1 gap:5
      Flex direction:{ xs:"column" md:"row" } justify:"between" align:"end" gap:3
        Grid columns:1 gap:2
          Text size:"xs" weight:"bold"
            "05 · MEDIA LEFT"
          Title size:"2xl" weight:"black"
            "A compact media placeholder leading into focused copy"
        Button href:"/blocks/cta-preview/media-left" variant:"solid" size:"sm" rounded:"full" iconEnd:"arrow-right"
          "Open full page"
      Tabs variant:"line" position:"top" w:"full"
        tab id:"media-left-preview" label:"Preview"
          Device device:"laptop" w:"full" rounded:"lg" border:1
            Iframe src:"/blocks/cta-preview/media-left" title:"Media left CTA preview" loading:"lazy" sandbox:"scripts same-origin"
        tab id:"media-left-code" label:"Code"
          Code:
            language:"dowe"
            variant:"solid"
            scheme:"surface"
            copyLabel:"Copy CTA"
            copiedLabel:"Copied"
            content:"""
              const actions value:[
                { id:"start" label:"Get started" variant:"solid" },
                { id:"sales" label:"Talk to sales" variant:"outlined" },
              ]

              Section id:"media-left-cta" bg:"background" color:"backgroundText" boxed:true p:{ xs:6 md:12 }
                Grid columns:{ xs:1 md:2 } gap:{ xs:8 md:14 } align:"center" minH:"vh-0"
                  Box bg:"muted" rounded:"xl" p:8 minH:{ xs:64 md:80 }
                    Flex direction:"column" align:"center" justify:"center" gap:3 minH:{ xs:48 md:64 }
                      Icon name:"gallery-bold-duotone" fill:"muted" w:16 h:16
                      Text size:"sm"
                        "Image placeholder"
                  Flex direction:"column" align:{ xs:"center" md:"start" } justify:"center" gap:5
                    Grid columns:1 gap:3
                      Title size:{ xs:"3xl" md:"5xl" } weight:"black"
                        "Create your account today and get started for free!"
                      Text size:"lg"
                        "Start with a clear plan, invite your team, and turn the next milestone into visible progress."
                    Grid columns:1 gap:3 w:"full" show:{ xs:true sm:false }
                      each in:actions as:action key:action.id
                        Button variant:action.variant size:"lg" rounded:"full" w:"full"
                          "{action.label}"
                    Flex align:"center" gap:3 show:{ xs:false sm:true }
                      each in:actions as:action key:action.id
                        Button variant:action.variant size:"lg" rounded:"full"
                          "{action.label}"
            """
  Section id:"benefit-list" p:{ xs:5 md:7 }
    Grid columns:1 gap:5
      Flex direction:{ xs:"column" md:"row" } justify:"between" align:"end" gap:3
        Grid columns:1 gap:2
          Text size:"xs" weight:"bold"
            "06 · BENEFIT LIST"
          Title size:"2xl" weight:"black"
            "A benefit checklist beside a large media placeholder"
        Button href:"/blocks/cta-preview/benefit-list" size:"sm" rounded:"full" iconEnd:"arrow-right"
          "Open full page"
      Tabs variant:"line" position:"top" w:"full"
        tab id:"benefit-list-preview" label:"Preview"
          Device device:"laptop" w:"full" rounded:"lg" border:1
            Iframe src:"/blocks/cta-preview/benefit-list" title:"Benefit list CTA preview" loading:"lazy" sandbox:"scripts same-origin"
        tab id:"benefit-list-code" label:"Code"
          Code:
            language:"dowe"
            variant:"solid"
            scheme:"surface"
            copyLabel:"Copy CTA"
            copiedLabel:"Copied"
            content:"""
              const benefits value:[
                { id:"interaction" label:"Interaction design" },
                { id:"management" label:"Finding and managing" },
                { id:"architecture" label:"Information architecture" },
                { id:"delivery" label:"Flexible delivery" },
                { id:"testing" label:"Usability testing" },
              ]
              const actions value:[
                { id:"start" label:"Get started" variant:"solid" },
                { id:"sales" label:"Talk to sales" variant:"outlined" },
              ]

              Section id:"benefit-list-cta" bg:"muted" color:"mutedText" boxed:true p:{ xs:6 md:12 }
                Grid columns:{ xs:1 md:2 } gap:{ xs:8 md:14 } align:"center" minH:"vh-0"
                  Flex direction:"column" align:{ xs:"center" md:"start" } justify:"center" gap:6
                    Title size:{ xs:"3xl" md:"5xl" } weight:"black"
                      "Create your account today and get started for free!"
                    Grid columns:{ xs:1 sm:2 } gap:3 w:"full"
                      each in:benefits as:benefit key:benefit.id
                        Flex align:"center" gap:3
                          Icon name:"check-circle-bold" fill:"muted" w:5 h:5
                          Text
                            "{benefit.label}"
                    Grid columns:1 gap:3 w:"full" show:{ xs:true sm:false }
                      each in:actions as:action key:action.id
                        Button variant:action.variant size:"lg" rounded:"full" w:"full"
                          "{action.label}"
                    Flex align:"center" gap:3 show:{ xs:false sm:true }
                      each in:actions as:action key:action.id
                        Button variant:action.variant size:"lg" rounded:"full"
                          "{action.label}"
                  Box bg:"surface" rounded:"xl" p:8 minH:{ xs:72 md:96 }
                    Flex direction:"column" align:"center" justify:"center" gap:3 minH:{ xs:56 md:80 }
                      Icon name:"gallery-bold-duotone" fill:"muted" w:16 h:16
                      Text size:"sm"
                        "Image placeholder"
            """
