import exampleSession from "@/views/store/example-session"

page ServerAuthBlockPage
  signal registerForm value:{ name:"" email:"" password:"" }
  signal loginForm value:{ email:"" password:"" }
  signal message value:""
  init
    request result method:"GET" route:"/api/examples/auth/session" headers:{ Authorization:exampleSession.authorization }
    if result.ok
      set exampleSession value:result.data
    else
      reset exampleSession
  fn register
    request result method:"POST" route:"/api/examples/auth/register" body:registerForm
    if result.ok
      set exampleSession value:result.data
      set registerForm value:{ name:"" email:"" password:"" }
      set message value:"Registered, persisted, cached, and signed in."
    else
      set message value:"Registration failed. Check the Database connection or email."
  fn login
    request result method:"POST" route:"/api/examples/auth/login" body:loginForm
    if result.ok
      set exampleSession value:result.data
      set loginForm value:{ email:"" password:"" }
      set message value:"Logged in with an opaque ULID session."
    else
      set message value:"Login failed."
  fn logout
    request result method:"POST" route:"/api/examples/auth/logout" headers:{ Authorization:exampleSession.authorization }
    if result.ok
      set exampleSession value:result.data
      set message value:"Logged out and revoked in Cache and Database."
    else
      set message value:"The session could not be revoked."
  Section id:"server-auth-introduction" py:{ xs:6 md:10 }
    Grid columns:1 gap:3
      Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
        "SERVER BLOCK / AUTH"
      Title size:{ xs:"3xl" md:"6xl" } weight:"black"
        "Auth state shared with Views"
      Text size:"lg" color:"muted"
        "Register and login create an opaque ULID session, persist it in Database, cache it for fast validation, and update one shared View Store."
  Section id:"server-auth-playground" p:{ xs:5 md:7 }
    Grid columns:1 gap:5
      Card variant:"soft" scheme:"primary" p:{ xs:5 md:7 } rounded:"xl"
        Grid columns:1 gap:4
          Flex justify:"between" align:"center" gap:3 wrap:true
            Grid columns:1 gap:1
              Text size:"xs" weight:"bold" color:"primary"
                "LIVE SESSION"
              Title size:"2xl" weight:"black"
                "One auth state, two sides"
            Chip show:exampleSession.authenticated variant:"soft" scheme:"success" size:"sm"
              "SIGNED IN"
            Chip show:exampleSession.guest variant:"soft" scheme:"warning" size:"sm"
              "GUEST"
          Text show:exampleSession.guest size:"sm" color:"muted"
            "Create an account or sign in. The CRUD block reads this same Store and enables its protected actions."
          Flex show:exampleSession.authenticated direction:"column" gap:1
            Text size:"sm" color:"success"
              "Authenticated as"
            Text size:"sm" color:"success"
              "{exampleSession.user.name}"
            Text size:"sm" color:"muted"
              "Open CRUD to create, update, and delete with this session."
          Text show:exampleSession.authenticated size:"sm" color:"info"
            "{message}"
          Grid columns:{ xs:1 md:2 } gap:4
            Card variant:"outlined" p:4
              Grid columns:1 gap:3
                Text size:"xs" weight:"bold" color:"muted"
                  "REGISTER"
                Input bind:registerForm.name label:"Name" placeholder:"Ada Lovelace" labelFloating:true w:"full"
                Input bind:registerForm.email label:"Email" placeholder:"ada@example.com" labelFloating:true w:"full"
                Password bind:registerForm.password label:"Password" placeholder:"Create a password" labelFloating:true hideStrength:true w:"full"
                Button onClick:register iconStart:"add-circle"
                  "Create account"
            Card variant:"outlined" p:4
              Grid columns:1 gap:3
                Text size:"xs" weight:"bold" color:"muted"
                  "LOGIN"
                Input bind:loginForm.email label:"Email" placeholder:"ada@example.com" labelFloating:true w:"full"
                Password bind:loginForm.password label:"Password" placeholder:"Your password" labelFloating:true hideStrength:true w:"full"
                Button onClick:login variant:"outlined" iconStart:"user"
                  "Sign in"
          Button show:exampleSession.authenticated onClick:logout variant:"ghost" scheme:"danger" iconStart:"logout-2"
            "Log out and revoke session"
  Section id:"server-auth-files" py:{ xs:7 md:10 }
    Grid columns:1 gap:4
      Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
        "SOURCE FILES"
      Title size:"3xl" weight:"black"
        "Cache-aside auth without client secrets"
      Text color:"muted"
        "The token carries only a ULID. Middleware verifies it through Cache first and Database second; the View Store contains display state and the bearer value, never provider credentials."
      Tabs variant:"line" position:"top" w:"full"
        tab id:"view" label:"View"
          Code:
            language:"dowe"
            variant:"soft"
            scheme:"surface"
            copyLabel:"Copy View"
            copiedLabel:"Copied"
            content:"""
              import exampleSession from "@/views/store/example-session"

              fn login
                request result method:"POST" route:"/api/examples/auth/login" body:loginForm
                if result.ok
                  set exampleSession value:result.data

              Text show:exampleSession.authenticated
                "Authenticated as"
              Text show:exampleSession.authenticated
                "{exampleSession.user.name}"
            """
        tab id:"store" label:"Store"
          Code:
            language:"dowe"
            variant:"soft"
            scheme:"surface"
            copyLabel:"Copy store"
            copiedLabel:"Copied"
            content:"""
              import ExampleSessionState from "@/views/types/example-session"

              store exampleSession:
                type:ExampleSessionState
                persistent:true
                value:{ authenticated:false guest:true authorization:"" token:"" user:{ id:"" name:"" email:"" } }
            """
        tab id:"types" label:"Types"
          Code:
            language:"dowe"
            variant:"soft"
            scheme:"surface"
            copyLabel:"Copy types"
            copiedLabel:"Copied"
            content:"""
              type ExampleSessionUser
                id:string
                name:string
                email:string

              type ExampleSessionState
                authenticated:bool
                guest:bool
                authorization:string
                token:string
                user:ExampleSessionUser
            """
        tab id:"middleware" label:"Middleware"
          Code:
            language:"dowe"
            variant:"soft"
            scheme:"surface"
            copyLabel:"Copy middleware"
            copiedLabel:"Copied"
            content:"""
              middleware requireExampleAuth
                bearer token value:req.header.Authorization
                session verified cache:ExamplesCache database:ExamplesDb token:token maxAge:2592000
                if verified.valid
                  next context:{ auth:{ subject:verified.userId session:verified.id authorization:req.header.Authorization token:token } }
                return status:401 json:{ ok:false error:"Unauthorized" }
            """
        tab id:"handler" label:"Handler"
          Code:
            language:"dowe"
            variant:"soft"
            scheme:"surface"
            copyLabel:"Copy handlers"
            copiedLabel:"Copied"
            content:"""
              handler registerExampleUser
                const body value:req.json
                registerExampleUserService result args:{ name:body.name email:body.email password:body.password }
                return status:201 json:{ ok:true data:result }

              handler logoutExampleUser
                logoutExampleUserService result args:{ session:req.context.auth.session }
                return json:{ ok:true data:result }
            """
        tab id:"service" label:"Service"
          Code:
            language:"dowe"
            variant:"soft"
            scheme:"surface"
            copyLabel:"Copy service"
            copiedLabel:"Copied"
            content:"""
              fn loginExampleUserService params:{ email:string password:string }
                findExampleUserRepository user args:{ email:args.email password:args.password }
                createExampleSessionRepository session args:{ userId:user.id }
                str authorization source:"join" values:["Bearer" session.id] delimiter:" "
                return value:{ authenticated:true guest:false authorization:authorization token:session.id user:{ id:user.id name:user.name email:user.email } }
            """
        tab id:"repository" label:"Repository"
          Code:
            language:"dowe"
            variant:"soft"
            scheme:"surface"
            copyLabel:"Copy repository"
            copiedLabel:"Copied"
            content:"""
              fn createExampleSessionRepository params:{ userId:string }
                id session source:"ulid"
                query created conn:ExamplesDb.insert table:"sessions" value:{ id:session userId:args.userId createdAt:now } required:["id" "userId"]
                str sessionKey source:"join" values:["session" session] delimiter:":"
                kv cached conn:ExamplesCache.set key:sessionKey value:{ id:session userId:args.userId }
                return value:{ id:session userId:args.userId }
            """
        tab id:"config" label:"Config"
          Code:
            language:"dowe"
            variant:"soft"
            scheme:"surface"
            copyLabel:"Copy config"
            copiedLabel:"Copied"
            content:"""
              database ExamplesDb provider:"dowe" host:env.DOWE_HOST port:env.DOWE_PORT account:env.DOWE_ACCOUNT secret:env.DOWE_SECRET name:"dowe-docs-examples" entities:[ExampleUsers ExampleBlogs Sessions] seeders:[]
              cache ExamplesCache provider:"dowe" host:env.CACHE_HOST port:env.CACHE_PORT account:env.CACHE_ACCOUNT secret:env.CACHE_SECRET name:"dowe-docs-examples"
            """
        tab id:"users-entity" label:"Users entity"
          Code:
            language:"dowe"
            variant:"soft"
            scheme:"surface"
            copyLabel:"Copy users entity"
            copiedLabel:"Copied"
            content:"""
              entity ExampleUsers
                id:string primary:true
                name:string required:true
                email:string required:true unique:true
                passwordHash:string required:true
                createdAt:timestamp required:true
            """
        tab id:"sessions-entity" label:"Sessions entity"
          Code:
            language:"dowe"
            variant:"soft"
            scheme:"surface"
            copyLabel:"Copy sessions entity"
            copiedLabel:"Copied"
            content:"""
              entity Sessions
                id:string primary:true
                userId:string required:true index:true
                createdAt:timestamp required:true
            """
        tab id:"session-contract" label:"Session contract"
          Code:
            language:"dowe"
            variant:"soft"
            scheme:"surface"
            copyLabel:"Copy session"
            copiedLabel:"Copied"
            content:"""
              id session source:"ulid"
              str authorization source:"join" values:["Bearer" session] delimiter:" "
              kv cached conn:ExamplesCache.set key:sessionKey value:{ id:session userId:user.id }
              return value:{ authenticated:true guest:false authorization:authorization token:session }
            """
