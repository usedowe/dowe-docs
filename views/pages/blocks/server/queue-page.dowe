page ServerQueueBlockPage
  signal eventForm value:{ event:"docs.started" message:"Dowe server block" }
  signal lastId value:""
  signal message value:""
  signal messageVisible value:false
  signal receiptVisible value:false
  fn publishEvent
    request result method:"POST" route:"/api/examples/queue" body:eventForm
    if result.ok
      set lastId value:result.messageId
      set message value:"The event was confirmed by Queue."
      set messageVisible value:true
      set receiptVisible value:true
    else
      set message value:"Provision docs-events first, then publish again."
      set messageVisible value:true
  Section id:"server-queue-introduction" py:{ xs:6 md:10 }
    Grid columns:1 gap:3
      Text size:"xs" weight:"bold" spacing:"widest"
        "SERVER BLOCK / QUEUE"
      Title size:{ xs:"3xl" md:"6xl" } weight:"black"
        "Publish durable work"
      Text size:"lg"
        "A View sends a JSON event to a server handler. The handler uses a server-only Queue connection and returns the provider receipt."
  Section id:"server-queue-playground" p:{ xs:5 md:7 }
    Grid columns:1 gap:5
      Card variant:"solid" scheme:"primary" p:{ xs:5 md:7 } rounded:"xl"
        Grid columns:1 gap:4
          Text size:"xs" weight:"bold" color:"primary"
            "LIVE VIEW + SERVER"
          Title size:"2xl" weight:"black"
            "Publish an application event"
          Text size:"sm"
            "The Queue connection and credentials never leave the server. The View only submits event data and receives ok plus messageId."
          Text show:messageVisible size:"sm" color:"info"
            "{message}"
          Input bind:eventForm.event label:"Event" placeholder:"orders.created" labelFloating:true w:"full"
          Textarea bind:eventForm.message label:"Message" placeholder:"What should the worker process?" rows:4 labelFloating:true w:"full"
          Button onClick:publishEvent iconStart:"inbox"
            "Publish event"
          Text show:receiptVisible size:"sm" color:"success"
            "Receipt: {lastId}"
      Card variant:"outlined" p:5
        Grid columns:1 gap:3
          Text size:"xs" weight:"bold"
            "BEFORE YOU CLICK"
          Text size:"sm"
            "Local development uses Dowe and targets an existing queue. On deploy, the same handler can select RabbitMQ, Cloudflare, or Vercel through its server-only connection; provision the remote queue before publishing."
          Code:
            language:"dowe"
            variant:"solid"
            scheme:"surface"
            copyLabel:"Copy provisioning"
            copiedLabel:"Copied"
            content:"""
              dowe queue init dowe-docs
              dowe queue declare dowe-docs docs-events
            """
  Section id:"server-queue-files" py:{ xs:7 md:10 }
    Grid columns:1 gap:4
      Text size:"xs" weight:"bold" spacing:"widest"
        "SOURCE FILES"
      Title size:"3xl" weight:"black"
        "Explicit connection, explicit destination"
      Text
        "The application publishes to a queue that was already provisioned. Consume, ACK, and NACK stay in the streaming Rust provider API."
      Tabs variant:"line" position:"top" w:"full"
        tab id:"view" label:"View"
          Code:
            language:"dowe"
            variant:"solid"
            scheme:"surface"
            copyLabel:"Copy View"
            copiedLabel:"Copied"
            content:"""
              signal eventForm value:{ event:"docs.started" message:"Dowe server block" }

              fn publishEvent
                request result method:"POST" route:"/api/examples/queue" body:eventForm
                if result.ok
                  set lastId value:result.messageId

              Button onClick:publishEvent
                "Publish event"
            """
        tab id:"handler" label:"Handler"
          Code:
            language:"dowe"
            variant:"solid"
            scheme:"surface"
            copyLabel:"Copy handler"
            copiedLabel:"Copied"
            content:"""
              import { ExamplesQueue } from "@/server/config/examples"

              handler publishExampleEvent
                const body value:req.json
                msg sent conn:ExamplesQueue.publish queue:"docs-events" payload:{ event:body.event payload:{ message:body.message } }
                return json:{ ok:sent.ok messageId:sent.id }
            """
        tab id:"config" label:"Queue config"
          Code:
            language:"dowe"
            variant:"solid"
            scheme:"surface"
            copyLabel:"Copy Queue config"
            copiedLabel:"Copied"
            content:"""
              queue ExamplesQueue provider:"dowe" host:env.QUEUE_HOST port:env.QUEUE_PORT account:env.QUEUE_ACCOUNT secret:env.QUEUE_SECRET vhost:env.QUEUE_VHOST
            """
        tab id:"commands" label:"Provisioning"
          Code:
            language:"dowe"
            variant:"solid"
            scheme:"surface"
            copyLabel:"Copy commands"
            copiedLabel:"Copied"
            content:"""
              dowe queue init dowe-docs
              dowe queue declare dowe-docs docs-events
              dowe queue publish dowe-docs docs-events '{"event":"docs.started","payload":{"message":"Dowe server block"}}'
            """
