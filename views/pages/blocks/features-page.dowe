  Section id:"complete-solutions" p:{ xs:5 md:7 }
    Grid columns:1 gap:5
      Flex direction:{ xs:"column" md:"row" } justify:"between" align:"end" gap:3
        Grid columns:1 gap:2
          Text size:"xs" weight:"bold" color:"muted"
            "05 · COMPLETE SOLUTIONS"
          Title size:"2xl" weight:"black"
            "Three visual product capabilities with supporting copy"
        Button:
          href:"/blocks/features-preview/complete-solutions"
          variant:"soft"
          scheme:"warning"
          size:"sm"
          rounded:"full"
          iconEnd:"arrow-right"
          "Open full page"
      Tabs variant:"line" scheme:"primary" position:"top" w:"full"
        tab id:"complete-solutions-preview" label:"Preview"
          Device device:"laptop" w:"full" rounded:"lg" border:1
            Iframe:
              src:"/blocks/features-preview/complete-solutions"
              title:"Complete solutions features preview"
              loading:"lazy"
              sandbox:"scripts same-origin"
        tab id:"complete-solutions-code" label:"Code"
          Code:
            language:"dowe"
            variant:"soft"
            scheme:"surface"
            copyLabel:"Copy features"
            copiedLabel:"Copied"
            content:"""
              const completeSolutions:
                value:[
                  {
                    id:"interface"
                    title:"Friendly Interface"
                    description:"Give every teammate a clear workspace that feels familiar from the first click."
                    preview:"Workspace"
                  },
                  {
                    id:"files"
                    title:"Files Editor & Viewer"
                    description:"Review assets, compare versions, and keep production files in one focused place."
                    preview:"Assets"
                  },
                  {
                    id:"flexible"
                    title:"Extremely Flexible"
                    description:"Adapt layouts and workflows as your products, channels, and customer needs evolve."
                    preview:"Automation"
                  },
                ]
              Section id:"complete-solutions-features" bg:"surface" color:"onSurface" boxed:true py:{ xs:8 md:12 }
                Grid columns:1 gap:{ xs:8 md:12 }
                  Flex direction:"column" align:"center" gap:3
                    Title size:{ xs:"4xl" md:"6xl" } weight:"black"
                      "The Complete Solutions"
                    Text size:"lg" color:"muted"
                      "Everything your team needs to create, organize, and optimize digital experiences."
                  Grid columns:{ xs:1 md:3 } gap:6
                    each in:completeSolutions as:solution key:solution.id
                      Flex direction:"column" align:"center" gap:5
                        Box bg:"softMuted" rounded:"lg" p:6 w:"full" h:52
                          Box bg:"surface" rounded:"lg" p:4 shadow:"sm" minH:40
                            Grid columns:1 gap:4
                              Flex align:"center" justify:"between"
                                Flex align:"center" gap:2
                                  Icon name:"widget-4" style:"bold-duotone" fill:"primary" w:6 h:6
                                  Text weight:"bold"
                                    "{solution.preview}"
                                Flex gap:2
                                  Icon name:"pen-new-square" fill:"muted" w:5 h:5
                                  Icon name:"add-circle" fill:"muted" w:5 h:5
                              Grid columns:3 gap:2
                                Box bg:"softMuted" rounded:"md" minH:16
                                Box bg:"softWarning" rounded:"md" minH:16
                                Box bg:"softMuted" rounded:"md" minH:16
                              Flex justify:"end"
                                Icon name:"cursor" style:"bold" fill:"onSurface" w:7 h:7
                        Grid columns:1 gap:2 minH:20
                          Title size:"lg" weight:"black"
                            "{solution.title}"
                          Text color:"muted"
                            "{solution.description}"
            """
