          Code:
            language:"dowe"
            variant:"soft"
            scheme:"surface"
            copyLabel:"Copy features"
            copiedLabel:"Copied"
            content:"""
              const onlineCapabilities:
                value:[
                  {
                    id:"marketing"
                    title:"Digital Marketing"
                    description:"Plan campaigns around real customer needs and measurable business outcomes."
                  },
                  {
                    id:"design"
                    title:"Dev and Design"
                    description:"Turn ideas into polished experiences with one coordinated product workflow."
                  },
                  {
                    id:"analytics"
                    title:"Data & Analytics"
                    description:"Make performance visible and turn timely insights into confident decisions."
                  },
                  {
                    id:"content"
                    title:"Content Strategy"
                    description:"Create a durable content system across channels, formats, and customer stages."
                  },
                ]
              Section id:"online-solutions-features" bg:"surface" color:"onSurface" boxed:true py:{ xs:8 md:12 }
                Grid columns:{ xs:1 md:"7fr 5fr" } gap:{ xs:10 md:16 } align:"center"
                  Box bg:"softMuted" p:{ xs:5 md:8 }
                    Grid columns:{ xs:1 sm:2 } gap:5
                      each in:onlineCapabilities as:capability key:capability.id
                        Card variant:"solid" scheme:"surface" rounded:"lg" shadow:"md" p:6 minH:56
                          Flex direction:"column" gap:4
                            Box bg:"softPrimary" rounded:"full" w:14 h:14 p:2
                              Icon name:"stars" style:"line-duotone" fill:"primary" w:10 h:10
                            Title size:"lg" weight:"black"
                              "{capability.title}"
                            Text color:"muted"
                              "{capability.description}"
                  Flex direction:"column" gap:6
                    Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
                      "ONE-STOP SOLUTIONS"
                    Title size:{ xs:"4xl" md:"6xl" } weight:"black"
                      "Cutting-edge solutions for your online business"
                    Text color:"muted"
                      "Bring strategy, design, and technology together to build a business customers understand and trust."
                    Text color:"muted"
                      "Move from isolated tools to a connected system that helps your team learn, adapt, and grow."
