page FooterPreviewPage
  Section id:"footer-preview" boxed:true py:{ xs:8 md:12 }
    Grid columns:1 gap:4
      Text size:"xs" weight:"bold" spacing:"widest"
        "REUSABLE BLOCK"
      Title size:{ xs:"3xl" md:"5xl" } weight:"black"
        "Finish every page with confidence"
      Text size:"lg"
        "Every routed preview reuses this page while its layout owns the Footer variation."
      Flex wrap:true gap:3
        Button href:"/blocks/footer" rounded:"full"
          "Browse all Footers"
        Button href:"/docs/views/layout/footer" variant:"solid" scheme:"muted" rounded:"full"
          "View component reference"
