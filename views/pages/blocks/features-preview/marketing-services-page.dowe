page MarketingServicesFeaturesPage
  const marketingServices:
    value:[
      {
        id:"branding"
        title:"Branding Services"
        description:"Create a clear brand system that keeps every campaign recognizable, useful, and consistent."
      },
      {
        id:"research"
        title:"Market Research"
        description:"Turn customer signals and competitive context into practical decisions your team can act on."
      },
      {
        id:"content"
        title:"Content Creation"
        description:"Produce useful content that earns attention, answers real questions, and supports conversion."
      },
      {
        id:"commerce"
        title:"e-Commerce Solutions"
        description:"Build flexible shopping journeys that connect product discovery, checkout, and retention."
      },
      {
        id:"competition"
        title:"Competitor Analysis"
        description:"Compare positioning, channels, and customer experience to uncover your strongest next move."
      },
      {
        id:"discovery"
        title:"SEO & SMM Services"
        description:"Improve discovery across search and social with one coordinated, measurable growth plan."
      },
    ]
  Section id:"marketing-services-features" bg:"surface" color:"onSurface" boxed:true py:{ xs:8 md:12 }
    Grid columns:1 gap:{ xs:8 md:12 }
      Flex direction:"column" align:"center" gap:3
        Flex direction:"column" align:"center" gap:0 show:{ xs:false md:true }
          Title size:"5xl" weight:"black"
            "Digital marketing that drives"
          Title size:"5xl" weight:"black"
            "results for your business"
        Title size:"4xl" weight:"black" show:{ xs:true md:false }
          "Digital marketing that drives results for your business"
        Text size:"lg" color:"muted"
          "Focused capabilities for building demand, learning faster, and growing with confidence."
      Grid columns:{ xs:1 md:2 } gap:{ xs:7 md:10 }
        each in:marketingServices as:service key:service.id
          Flex align:"start" gap:4 minH:28
            Box bg:"softPrimary" rounded:"full" p:3
              Icon name:"graph-new-up" style:"line-duotone" fill:"primary" w:10 h:10
            Grid columns:1 gap:2
              Title size:"lg" weight:"black"
                "{service.title}"
              Text color:"muted"
                "{service.description}"
