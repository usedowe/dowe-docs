              Box bg:"surface" rounded:"md" px:4 py:3
                Flex align:"center" gap:3
                  Icon name:"check-circle" style:"line-duotone" fill:"muted" w:6 h:6
                  Text color:"muted"
                    "Finish Registration"
        Card variant:"soft" scheme:"muted" rounded:"xl" p:{ xs:5 md:6 } minH:80
          Flex direction:"column" gap:4 minH:64
            Icon name:"monitor-smartphone" style:"line-duotone" fill:"primary" w:7 h:7
            Grid columns:1 gap:2
              Title size:"lg" weight:"black"
