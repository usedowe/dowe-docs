page CustomerCentricFeaturesPage
  const customerBenefits:
    value:[
      {
        id:"connect"
        title:"Easy to Connect"
        description:"Bring every onboarding step together so new customers always know what comes next."
        preview:"Create Free Account"
      },
      {
        id:"dashboard"
        title:"Realtime Dashboard"
        description:"See campaign activity, schedules, and customer progress in one responsive dashboard."
        preview:"Review Live Progress"
      },
      {
        id:"automation"
        title:"Easy Automations"
        description:"Connect the tools your team already trusts and automate repetitive customer work."
        preview:"Launch an Automation"
      },
    ]
  Section id:"customer-centric-features" bg:"surface" color:"surfaceText" boxed:true py:{ xs:8 md:12 }
    Flex direction:"column" align:"center" gap:0
      Flex direction:"column" align:"center" gap:0 show:{ xs:false md:true }
        Title size:"5xl" weight:"black"
          "Build a customer-centric"
        Title size:"5xl" weight:"black"
          "marketing strategy"
      Title size:"4xl" weight:"black" show:{ xs:true md:false }
        "Build a customer-centric marketing strategy"
      Box h:4
      Text size:"lg" color:"muted"
        "Connect every customer touchpoint with a clear, measurable workflow."
      Box h:{ xs:8 md:14 }
      Grid columns:{ xs:1 md:3 } gap:5 w:"full"
        each in:customerBenefits as:benefit key:benefit.id
          Card variant:"soft" scheme:"muted" rounded:"xl" p:{ xs:5 md:6 } minH:80
            Flex direction:"column" gap:4 minH:64
              Box bg:"softPrimary" rounded:"full" w:14 h:14 p:2
                Icon name:"route-line-duotone" fill:"primary" w:10 h:10
              Grid columns:1 gap:2 minH:20
                Title size:"lg" weight:"black"
                  "{benefit.title}"
                Text color:"muted"
                  "{benefit.description}"
              Box h:2
              Box bg:"surface" rounded:"lg" p:4 shadow:"sm" minH:28
                Grid columns:1 gap:3
                  Flex align:"center" gap:3
                    Icon name:"check-circle-bold" fill:"success" w:6 h:6
                    Text weight:"bold"
                      "{benefit.preview}"
                  Grid columns:3 gap:2
                    Box h:8 bg:"softMuted" rounded:"sm"
                    Box h:8 bg:"softPrimary" rounded:"sm"
                    Box h:8 bg:"softMuted" rounded:"sm"
                  Flex justify:"end"
                    Icon name:"cursor-bold" fill:"surfaceText" w:7 h:7
