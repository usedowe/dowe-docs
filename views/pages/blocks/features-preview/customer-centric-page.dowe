                  Box h:8 bg:"softPrimary" rounded:"sm"
                  Box h:8 bg:"softMuted" rounded:"sm"
                  Box h:8 bg:"softMuted" rounded:"sm"
                  Box h:8 bg:"softMuted" rounded:"sm"
