page CustomerCentricFeaturesPage
  Section id:"customer-centric-features" bg:"surface" color:"onSurface" boxed:true py:{ xs:8 md:12 }
    Flex direction:"column" align:"center" gap:0
      Flex direction:"column" align:"center" gap:0 show:{ xs:false md:true }
        Title size:"5xl" weight:"black"
          "Build a customer-centric"
        Title size:"5xl" weight:"black"
          "marketing strategy"
      Title size:"4xl" weight:"black" show:{ xs:true md:false }
        "Build a customer-centric marketing strategy"
      Box h:4
      Text size:"lg" color:"muted"
        "Connect every customer touchpoint with a clear, measurable workflow."
      Box h:{ xs:8 md:14 }
      Grid columns:{ xs:1 md:3 } gap:5 w:"full"
        Card variant:"soft" scheme:"muted" rounded:"xl" p:{ xs:5 md:6 } minH:80
          Flex direction:"column" gap:4 minH:64
            Icon name:"route" style:"line-duotone" fill:"primary" w:7 h:7
            Grid columns:1 gap:2
              Title size:"lg" weight:"black"
                "Easy to Connect"
              Text color:"muted"
                "Bring every onboarding step together so new customers always know what comes next."
            Box h:2
            Grid columns:1 gap:2
              Box bg:"surface" rounded:"md" px:4 py:3 shadow:"sm"
                Flex align:"center" gap:3
                  Icon name:"check-circle" style:"bold" fill:"success" w:6 h:6
