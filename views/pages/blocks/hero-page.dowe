                              "{item.label}"
            """
  Section id:"search" p:{ xs:5 md:7 }
    Grid columns:1 gap:5
      Flex direction:{ xs:"column" md:"row" } justify:"between" align:"end" gap:3
        Grid columns:1 gap:2
          Text size:"xs" weight:"bold" color:"muted"
            "05 · SEARCH FIRST"
          Title size:"2xl" weight:"black"
            "A minimal hero centered around one searchable action"
        Button href:"/blocks/hero-preview/search" variant:"soft" size:"sm" rounded:"full" iconEnd:"arrow-right"
          "Open full page"
      Tabs variant:"line" position:"top" w:"full"
        tab id:"preview" label:"Preview"
          Device device:"laptop" w:"full" rounded:"lg" border:1
            Iframe src:"/blocks/hero-preview/search" title:"Search hero preview" loading:"lazy" sandbox:"scripts same-origin"
        tab id:"hero-code" label:"Hero Code"
          Code:
            language:"dowe"
            variant:"soft"
            scheme:"surface"
            copyLabel:"Copy hero"
            copiedLabel:"Copied"
            content:"""
              signal searchQuery value:""

              Section id:"search-hero" bg:"background" color:"backgroundText" boxed:true py:{ xs:10 md:16 }
                Grid columns:{ xs:1 md:3 } align:"center" minH:"vh-32"
                  Box show:{ xs:false md:true }
                  Flex direction:"column" align:"center" justify:"center" gap:6
                    Title size:{ xs:"4xl" md:"6xl" } weight:"black"
                      "A dedicated team to grow your company"
                    Text size:"lg" color:"muted"
                      "Lead visitors directly to the content, service, or resource they already have in mind."
                    Input:
                      bind:searchQuery
                      label:"Search"
                      labelFloating:true
                      placeholder:"Search for..."
                      iconStart:"magnifier"
                      variant:"soft"
                      scheme:"muted"
                      rounded:"full"
                      w:"full"
                  Box show:{ xs:false md:true }
            """
        tab id:"layout-code" label:"Layout Code"
          Code:
            language:"dowe"
            variant:"soft"
            scheme:"surface"
            copyLabel:"Copy layout"
            copiedLabel:"Copied"
            content:"""
