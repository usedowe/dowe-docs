            content:"""
              Section id:"full-bleed-hero" bg:"muted" color:"mutedText" boxed:true py:{ xs:10 md:14 }
                Grid columns:{ xs:1 md:2 } gap:{ xs:10 md:14 } align:"center" minH:"vh-16"
                  Flex direction:"column" align:"start" justify:"center" gap:5
