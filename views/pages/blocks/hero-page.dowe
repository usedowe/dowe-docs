page HerosPage
  Section id:"heros" py:{ xs:6 md:10 }
    Grid columns:1 gap:4
      Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
        "COPY-READY BLOCKS"
      Title size:{ xs:"3xl" md:"6xl" } weight:"black"
        "Hero"
      Text size:"lg" color:"muted"
        "Ten polished hero pages with clearer hierarchy, responsive composition, and copy-ready Dowe source."
  Section id:"crypto-app" p:{ xs:5 md:7 }
    Grid columns:1 gap:5
      Flex direction:{ xs:"column" md:"row" } justify:"between" align:"end" gap:3
        Grid columns:1 gap:2
          Text size:"xs" weight:"bold" color:"muted"
            "01 · ESSENTIAL SPLIT"
          Title size:"2xl" weight:"black"
            "Focused copy and one action beside a calm media surface"
        Button:
          href:"/blocks/hero-preview/crypto-app"
          variant:"soft"
          scheme:"primary"
          size:"sm"
          rounded:"full"
          iconEnd:"arrow-right"
          "Open full page"
      Tabs variant:"line" scheme:"primary" position:"top" w:"full"
        tab id:"crypto-app-preview" label:"Preview"
          Device device:"laptop" w:"full" rounded:"lg" border:1
            Iframe:
              src:"/blocks/hero-preview/crypto-app"
              title:"Essential split hero preview"
              loading:"lazy"
              sandbox:"scripts same-origin"
        tab id:"crypto-app-code" label:"Code"
          Code:
            language:"dowe"
            variant:"soft"
            scheme:"surface"
            copyLabel:"Copy hero"
            copiedLabel:"Copied"
            content:"""
              Section:
                id:"crypto-app-hero"
                bg:"surface"
                color:"onSurface"
                boxed:true
                minH:"vh-16"
                py:{ xs:8 md:12 }
                Grid columns:{ xs:1 md:"5fr 4fr" } gap:{ xs:8 md:14 } align:"stretch" minH:"vh-16"
                  Flex direction:"column" align:"start" justify:"center" gap:5
                    Text size:"xs" weight:"bold" spacing:"widest" color:"primary"
                      "WORK WITHOUT THE CLUTTER"
                    Title size:{ xs:"4xl" md:"6xl" } weight:"black"
                      "Bring every project into focus"
                    Text size:"lg" color:"muted"
                      "Plan, collaborate, and ship from one calm workspace that keeps priorities visible and every handoff clear."
                    Button variant:"solid" scheme:"primary" size:"lg" rounded:"full" iconEnd:"arrow-right"
                      "Explore the workspace"
                  Box:
                    cover:"/assets/blocks/hero/crypto-wallet.jpg"
                    rounded:"xl"
                    minH:{ xs:64 md:"vh-16" }
                    shadow:"xl"
                    shadowColor:"muted"
            """
  Section id:"smart-solutions" p:{ xs:5 md:7 } bg:"softPrimary" color:"onSoftPrimary"
    Grid columns:1 gap:5
      Flex direction:{ xs:"column" md:"row" } justify:"between" align:"end" gap:3
        Grid columns:1 gap:2
          Text size:"xs" weight:"bold" color:"muted"
            "02 · SPLIT WITH TRUST"
          Title size:"2xl" weight:"black"
            "Two clear actions, customer marks, and a balanced visual"
        Button:
          href:"/blocks/hero-preview/smart-solutions"
          variant:"solid"
          scheme:"primary"
          size:"sm"
          rounded:"full"
          iconEnd:"arrow-right"
          "Open full page"
      Tabs variant:"line" scheme:"primary" position:"top" w:"full"
        tab id:"smart-solutions-preview" label:"Preview"
          Device device:"laptop" w:"full" rounded:"lg" border:1
            Iframe:
              src:"/blocks/hero-preview/smart-solutions"
              title:"Split hero with trust signals preview"
              loading:"lazy"
              sandbox:"scripts same-origin"
        tab id:"smart-solutions-code" label:"Code"
          Code:
            language:"dowe"
            variant:"soft"
            scheme:"surface"
            copyLabel:"Copy hero"
            copiedLabel:"Copied"
            content:"""
              Section:
                id:"smart-solutions-hero"
                bg:"background"
                color:"onBackground"
                boxed:true
                minH:"vh-16"
                py:{ xs:8 md:12 }
                Grid columns:{ xs:1 md:"5fr 4fr" } gap:{ xs:8 md:14 } align:"stretch" minH:"vh-16"
                  Flex direction:"column" align:"start" justify:"center" gap:5
                    Text size:"xs" weight:"bold" spacing:"widest" color:"info"
                      "BUILT FOR AMBITIOUS TEAMS"
                    Title size:{ xs:"4xl" md:"6xl" } weight:"black"
                      "Turn ambitious ideas into steady growth"
                    Text size:"lg" color:"muted"
                      "Give your team a clear path from first insight to launch, with the context and tools to make every decision count."
                    Grid columns:{ xs:1 sm:2 } gap:3 w:"full"
                      Button variant:"solid" scheme:"primary" size:"lg" rounded:"full" w:"full"
                        "Order now"
                      Button variant:"outlined" scheme:"primary" size:"lg" rounded:"full" w:"full"
                        "Explore"
                    Grid columns:1 gap:2
                      Text size:"xs" weight:"bold" color:"muted"
                        "TRUSTED BY"
                      Flex wrap:true align:"center" gap:5
                        Flex align:"center" gap:2
                          Icon name:"global" style:"linear" fill:"primary" w:5 h:5
                          Text size:"sm" weight:"bold"
                            "Google"
                        Flex align:"center" gap:2
                          Icon name:"play-circle" style:"linear" fill:"primary" w:5 h:5
                          Text size:"sm" weight:"bold"
                            "YouTube"
                        Flex align:"center" gap:2
                          Icon name:"users-group-rounded" style:"linear" fill:"primary" w:5 h:5
                          Text size:"sm" weight:"bold"
                            "Facebook"
                  Box:
                    cover:"/assets/blocks/hero/consulting-team-wide.jpg"
                    rounded:"xl"
                    minH:{ xs:64 md:"vh-16" }
                    shadow:"xl"
                    shadowColor:"muted"
