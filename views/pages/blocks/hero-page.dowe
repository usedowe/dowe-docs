page HerosPage
  Section id:"heros" py:{ xs:6 md:10 }
    Grid columns:1 gap:4
      Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
        "COPY-READY BLOCKS"
      Title size:{ xs:"3xl" md:"6xl" } weight:"black"
        "Hero"
      Text size:"lg" color:"muted"
        "Nine polished hero pages with clearer hierarchy, responsive composition, and copy-ready Dowe source."
  Section id:"crypto-app" p:{ xs:5 md:7 }
    Grid columns:1 gap:5
      Flex direction:{ xs:"column" md:"row" } justify:"between" align:"end" gap:3
        Grid columns:1 gap:2
          Text size:"xs" weight:"bold" color:"muted"
            "01 · ESSENTIAL SPLIT"
          Title size:"2xl" weight:"black"
            "Focused copy and one action beside a calm media surface"
        Button:
          href:"/blocks/hero-preview/crypto-app"
          variant:"soft"
          scheme:"primary"
          size:"sm"
          rounded:"full"
          iconEnd:"arrow-right"
          "Open full page"
      Device device:"laptop" w:"full" rounded:"lg" border:1
        Iframe:
          src:"/blocks/hero-preview/crypto-app"
          title:"Essential split hero preview"
          loading:"lazy"
          sandbox:"scripts same-origin"
      Code:
        language:"dowe"
        variant:"soft"
        scheme:"surface"
        copyLabel:"Copy hero"
        copiedLabel:"Copied"
        content:"""
          Section id:"crypto-app-hero" bg:"surface" color:"onSurface" boxed:true minH:"vh-16" py:{ xs:8 md:12 }
            Grid columns:{ xs:1 md:"5fr 4fr" } gap:{ xs:8 md:14 } align:"center" minH:"vh-16"
              Flex direction:"column" align:"start" gap:5
