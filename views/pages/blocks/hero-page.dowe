      Tabs variant:"line" scheme:"primary" position:"top" w:"full"
        tab id:"privacy-download-preview" label:"Preview"
          Device device:"laptop" w:"full" rounded:"lg" border:1
            Iframe:
              src:"/blocks/hero-preview/privacy-download"
              title:"Privacy download hero preview"
              loading:"lazy"
              sandbox:"scripts same-origin"
        tab id:"privacy-download-code" label:"Code"
          Code:
            language:"dowe"
            variant:"soft"
            scheme:"surface"
            copyLabel:"Copy hero"
            copiedLabel:"Copied"
            content:"""
              Section id:"privacy-download-hero" background:"soft" boxed:true minH:"vh-16" py:{ xs:8 md:12 }
                Grid:
                  columns:{ xs:1 md:"21fr 44fr 11fr 58fr 10fr" }
                  gap:{ xs:8 md:8 }
                  align:"stretch"
                  minH:"vh-16"
                  Box show:{ xs:false md:true }
                  Box:
                    show:{ xs:false md:true }
                    cover:"/assets/blocks/hero/privacy-portrait-wide.jpg"
                    rounded:"xl"
                    minH:"vh-16"
                    shadow:"xl"
                    shadowColor:"muted"
                  Box:
                    show:{ xs:true md:false }
                    cover:"/assets/blocks/hero/privacy-portrait-wide.jpg"
                    rounded:"xl"
                    minH:96
                    shadow:"xl"
                    shadowColor:"muted"
                  Box show:{ xs:false md:true }
                  Flex direction:"column" justify:"center" gap:0
                    Flex direction:"column" gap:0 show:{ xs:false md:true }
                      Title size:"5xl" weight:"black"
                        "Keep Your Data"
                      Title size:"5xl" weight:"black"
                        "Private and Safe"
                    Flex direction:"column" gap:0 show:{ xs:true md:false }
                      Title size:"4xl" weight:"black"
                        "Keep Your Data"
                      Title size:"4xl" weight:"black"
                        "Private and Safe"
                    Box h:5 show:{ xs:true md:false }
                    Box h:8 show:{ xs:false md:true }
                    Text size:"lg" color:"muted"
                      "Protect your work with privacy-first controls and a secure experience on every device."
                    Box h:5 show:{ xs:true md:false }
                    Box h:8 show:{ xs:false md:true }
                    Grid columns:{ xs:1 md:"13fr 7fr" } gap:0
                      Grid columns:1 gap:6
                        Card variant:"solid" scheme:"surface" rounded:"lg" shadow:"md" p:5
                          Flex align:"center" gap:4
                            Icon name:"monitor-smartphone" style:"bold" fill:"info" w:12 h:12
