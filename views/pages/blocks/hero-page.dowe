                    Flex direction:"column" align:"center" justify:"center" gap:3 minH:{ xs:44 md:64 }
                      Icon name:"gallery-bold-duotone" fill:"muted" w:16 h:16
                      Text size:"sm" color:"muted"
                        "Image placeholder"
