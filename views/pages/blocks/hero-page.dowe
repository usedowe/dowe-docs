                  "Explore the workspace"
              Box bg:"softPrimary" color:"primary" rounded:"xl" minH:{ xs:56 md:80 } p:{ xs:6 md:10 }
                Flex direction:"column" justify:"center" align:"center" minH:{ xs:44 md:60 }
                  Box bg:"surface" rounded:"lg" p:{ xs:5 md:7 } shadow:"lg" shadowColor:"muted"
                    Icon name:"gallery-wide" style:"bold-duotone" fill:"primary" w:{ xs:14 md:20 } h:{ xs:14 md:20 }
        """
