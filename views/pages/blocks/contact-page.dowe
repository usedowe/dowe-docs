page ContactsPage
  Section id:"contacts" py:{ xs:6 md:10 }
    Grid columns:1 gap:4
      Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
        "COPY-READY BLOCKS"
      Title size:{ xs:"3xl" md:"6xl" } weight:"black"
        "Contact"
      Text size:"lg" color:"muted"
        "Six responsive contact wireframes built from real Dowe forms, layouts, icons, and media placeholders."
  Section id:"details-form" p:{ xs:5 md:7 }
    Grid columns:1 gap:5
      Flex direction:{ xs:"column" md:"row" } justify:"between" align:"end" gap:3
        Grid columns:1 gap:2
          Text size:"xs" weight:"bold" color:"muted"
            "01 · DETAILS + FORM"
          Title size:"2xl" weight:"black"
            "Contact details beside a structured message form"
        Button href:"/blocks/contact-preview/details-form" variant:"soft" size:"sm" rounded:"full" iconEnd:"arrow-right"
          "Open full page"
      Tabs variant:"line" position:"top" w:"full"
        tab id:"details-form-preview" label:"Preview"
          Device device:"laptop" w:"full" rounded:"lg" border:1
            Iframe src:"/blocks/contact-preview/details-form" title:"Contact details and form preview" loading:"lazy" sandbox:"scripts same-origin forms"
        tab id:"details-form-code" label:"Code"
          Code:
            language:"dowe"
            variant:"soft"
            scheme:"surface"
            copyLabel:"Copy contact block"
            copiedLabel:"Copied"
            content:"""
              signal form value:{ name:"" email:"" phone:"" company:"" message:"" }
              const contactDetails value:[
                { id:"email" emailIcon:true phoneIcon:false addressIcon:false value:"contact@company.com" },
                { id:"phone" emailIcon:false phoneIcon:true addressIcon:false value:"(123) 456 – 789" },
                { id:"address" emailIcon:false phoneIcon:false addressIcon:true value:"794 Mcallister St · San Francisco, 94102" },
              ]

              Section id:"contact-details-form" bg:"background" color:"backgroundText" boxed:true p:{ xs:6 md:12 }
                Grid columns:{ xs:1 md:2 } gap:{ xs:8 md:14 } align:"center" minH:"vh-0"
                  Flex direction:"column" align:{ xs:"center" md:"start" } gap:5
                    Grid columns:1 gap:2
                      Text size:"xs" weight:"bold" spacing:"widest" color:"muted"
                        "CONTACT US"
                      Title size:{ xs:"3xl" md:"5xl" } weight:"black"
                        "Get in touch today"
                      Text size:"md" color:"muted"
                        "Share a few details and our team will get back to you with a clear next step."
                    Grid columns:1 gap:3
                      each in:contactDetails as:detail key:detail.id
                        Flex align:"center" gap:3
                          Icon name:"letter" fill:"muted" w:5 h:5 show:detail.emailIcon
                          Icon name:"phone-calling" fill:"muted" w:5 h:5 show:detail.phoneIcon
                          Icon name:"map-point" fill:"muted" w:5 h:5 show:detail.addressIcon
                          Text color:"muted"
                            "{detail.value}"
                  Card variant:"soft" scheme:"muted" rounded:"xl" p:{ xs:5 md:8 }
                    Grid columns:1 gap:4
                      Grid columns:{ xs:1 sm:2 } gap:4
                        Input bind:form.name label:"Name" placeholder:"John Carter" variant:"solid" scheme:"muted" w:"full"
                        Input bind:form.email label:"Email" placeholder:"example@email.com" variant:"solid" scheme:"muted" w:"full"
                        Input bind:form.phone label:"Phone" placeholder:"(123) 456 – 789" variant:"solid" scheme:"muted" w:"full"
                        Input bind:form.company label:"Company" placeholder:"Company" variant:"solid" scheme:"muted" w:"full"
                      Textarea bind:form.message label:"Message" placeholder:"Please type your message here..." rows:5 variant:"solid" scheme:"muted" w:"full"
                      Button rounded:"full" w:{ xs:"full" sm:48 }
                        "Send message"
            """
  Section id:"info-media" p:{ xs:5 md:7 }
    Grid columns:1 gap:5
      Flex direction:{ xs:"column" md:"row" } justify:"between" align:"end" gap:3
        Grid columns:1 gap:2
          Text size:"xs" weight:"bold" color:"muted"
            "02 · INFO + MEDIA"
          Title size:"2xl" weight:"black"
            "A neutral media placeholder paired with contact information"
        Button href:"/blocks/contact-preview/info-media" size:"sm" rounded:"full" iconEnd:"arrow-right"
          "Open full page"
      Tabs variant:"line" position:"top" w:"full"
        tab id:"info-media-preview" label:"Preview"
          Device device:"laptop" w:"full" rounded:"lg" border:1
            Iframe src:"/blocks/contact-preview/info-media" title:"Contact information and media preview" loading:"lazy" sandbox:"scripts same-origin"
        tab id:"info-media-code" label:"Code"
          Code:
            language:"dowe"
            variant:"soft"
            scheme:"surface"
            copyLabel:"Copy contact block"
            copiedLabel:"Copied"
            content:"""
              const contactDetails value:[
                { id:"email" emailIcon:true phoneIcon:false addressIcon:false value:"contact@company.com" },
                { id:"phone" emailIcon:false phoneIcon:true addressIcon:false value:"(123) 456 – 789" },
                { id:"address" emailIcon:false phoneIcon:false addressIcon:true value:"794 Mcallister St · San Francisco, 94102" },
              ]

              Section id:"contact-info-media" bg:"softMuted" color:"softMutedText" boxed:true p:{ xs:6 md:12 }
                Grid columns:{ xs:1 md:2 } gap:{ xs:8 md:14 } align:"center" minH:"vh-0"
                  Box rounded:"xl" p:8 minH:{ xs:64 md:96 }
                    Flex direction:"column" align:"center" justify:"center" gap:3 minH:{ xs:48 md:80 }
                      Icon name:"gallery-bold-duotone" fill:"muted" w:16 h:16
                      Text size:"sm" color:"muted"
                        "Image placeholder"
                  Card rounded:"xl" p:{ xs:6 md:9 }
                    Grid columns:1 gap:5
                      Grid columns:1 gap:2
                        Title size:{ xs:"3xl" md:"4xl" } weight:"black"
                          "Contact us"
                        Text color:"muted"
                          "Prototypes may also be exempted from some requirements that will apply to the final product."
                      Grid columns:1 gap:3
                        each in:contactDetails as:detail key:detail.id
                          Flex align:"center" gap:3
                            Icon name:"letter" fill:"muted" w:5 h:5 show:detail.emailIcon
                            Icon name:"phone-calling" fill:"muted" w:5 h:5 show:detail.phoneIcon
                            Icon name:"map-point" fill:"muted" w:5 h:5 show:detail.addressIcon
                            Text color:"muted"
                              "{detail.value}"
            """
  Section id:"footer-form" p:{ xs:5 md:7 }
    Grid columns:1 gap:5
      Flex direction:{ xs:"column" md:"row" } justify:"between" align:"end" gap:3
        Grid columns:1 gap:2
          Text size:"xs" weight:"bold" color:"muted"
            "03 · FOOTER + FORM"
          Title size:"2xl" weight:"black"
            "A compact message card above a contact footer band"
        Button href:"/blocks/contact-preview/footer-form" variant:"soft" size:"sm" rounded:"full" iconEnd:"arrow-right"
          "Open full page"
      Tabs variant:"line" position:"top" w:"full"
        tab id:"footer-form-preview" label:"Preview"
          Device device:"laptop" w:"full" rounded:"lg" border:1
            Iframe src:"/blocks/contact-preview/footer-form" title:"Contact form and footer preview" loading:"lazy" sandbox:"scripts same-origin forms"
        tab id:"footer-form-code" label:"Code"
          Code:
            language:"dowe"
            variant:"soft"
            scheme:"surface"
            copyLabel:"Copy contact block"
            copiedLabel:"Copied"
            content:"""
              signal form value:{ name:"" email:"" message:"" }
              const footerGroups value:[
                {
                  id:"visit"
                  title:"Visit Us"
                  lineOne:"58 Middle Point Rd"
                  lineTwo:"San Francisco, 94124"
                  lineThree:""
                  showLineThree:false
                },
                {
                  id:"contact"
                  title:"Contact Us"
                  lineOne:"(123) 456 – 789"
                  lineTwo:"(123) 456 – 789"
                  lineThree:"contact@company.com"
                  showLineThree:true
                },
              ]

              Section id:"contact-footer-form" bg:"softMuted" color:"softMutedText" p:0 minH:"vh-0"
                Grid columns:{ xs:1 md:2 } gap:{ xs:6 md:10 } align:"center" p:{ xs:6 md:10 }
                  Box p:8 minH:{ xs:48 md:72 }
                    Flex direction:"column" align:"center" justify:"center" gap:3 minH:{ xs:40 md:64 }
                      Icon name:"gallery-bold-duotone" fill:"muted" w:16 h:16
                      Text size:"sm" color:"muted"
                        "Image placeholder"
                  Card rounded:"xl" p:{ xs:6 md:8 }
                    Grid columns:1 gap:4
                      Grid columns:1 gap:1
                        Title size:"3xl" weight:"black"
                          "Contact us"
                        Text color:"muted"
                          "We want to hear from you"
                      Input bind:form.name placeholder:"Name" variant:"soft" scheme:"muted" w:"full"
                      Input bind:form.email placeholder:"Email" variant:"soft" scheme:"muted" w:"full"
                      Textarea bind:form.message placeholder:"Please type your message here..." rows:5 variant:"soft" scheme:"muted" w:"full"
                      Button rounded:"full" w:"full"
                        "Send message"
                Box bg:"muted" color:"mutedText" p:{ xs:7 md:10 }
                  Grid columns:{ xs:1 sm:2 } gap:8
                    each in:footerGroups as:group key:group.id
                      Grid columns:1 gap:2
                        Title size:"lg" weight:"bold"
                          "{group.title}"
                        Grid columns:1 gap:1
                          Text
                            "{group.lineOne}"
                          Text
                            "{group.lineTwo}"
                          Text show:group.showLineThree
                            "{group.lineThree}"
            """
  Section id:"split-panel" p:{ xs:5 md:7 }
    Grid columns:1 gap:5
      Flex direction:{ xs:"column" md:"row" } justify:"between" align:"end" gap:3
        Grid columns:1 gap:2
          Text size:"xs" weight:"bold" color:"muted"
            "04 · SPLIT PANEL"
          Title size:"2xl" weight:"black"
            "An elevated contact surface against a split background"
        Button href:"/blocks/contact-preview/split-panel" size:"sm" rounded:"full" iconEnd:"arrow-right"
          "Open full page"
      Tabs variant:"line" position:"top" w:"full"
        tab id:"split-panel-preview" label:"Preview"
          Device device:"laptop" w:"full" rounded:"lg" border:1
            Iframe src:"/blocks/contact-preview/split-panel" title:"Split panel contact preview" loading:"lazy" sandbox:"scripts same-origin forms"
        tab id:"split-panel-code" label:"Code"
          Code:
            language:"dowe"
            variant:"soft"
            scheme:"surface"
            copyLabel:"Copy contact block"
            copiedLabel:"Copied"
            content:"""
              signal form value:{ name:"" email:"" phone:"" company:"" message:"" }

              Section id:"contact-split-panel" bg:"background" color:"backgroundText" p:0 minH:"vh-0"
                Grid columns:{ xs:1 md:2 } gap:0 minH:"vh-0"
                  Box p:{ xs:5 md:10 }
                    Card variant:"soft" scheme:"muted" rounded:"xl" p:{ xs:6 md:10 }
                      Grid columns:1 gap:5
                        Grid columns:1 gap:2
                          Title size:{ xs:"3xl" md:"5xl" } weight:"black"
                            "Get in touch today"
                          Text color:"muted"
                            "Tell us what you are building and we will help you find the clearest path forward."
                        Grid columns:{ xs:1 sm:2 } gap:4
                          Input bind:form.name label:"Name" placeholder:"John Carter" variant:"solid" scheme:"muted" w:"full"
                          Input bind:form.email label:"Email" placeholder:"example@email.com" variant:"solid" scheme:"muted" w:"full"
                          Input bind:form.phone label:"Phone" placeholder:"(123) 456 – 789" variant:"solid" scheme:"muted" w:"full"
                          Input bind:form.company label:"Company" placeholder:"Company" variant:"solid" scheme:"muted" w:"full"
                        Textarea bind:form.message label:"Leave us a message" placeholder:"Please type your message here..." rows:5 variant:"solid" scheme:"muted" w:"full"
                        Button rounded:"full" w:{ xs:"full" sm:48 }
                          "Send message"
                  Box bg:"softMuted" p:8 minH:{ xs:64 md:"vh-0" }
                    Flex direction:"column" align:"center" justify:"center" gap:3 minH:{ xs:48 md:"vh-0" }
                      Icon name:"gallery-bold-duotone" fill:"muted" w:16 h:16
                      Text size:"sm" color:"muted"
                        "Image placeholder"
            """
  Section id:"split-panel-secondary" p:{ xs:5 md:7 }
    Grid columns:1 gap:5
      Flex direction:{ xs:"column" md:"row" } justify:"between" align:"end" gap:3
        Grid columns:1 gap:2
          Text size:"xs" weight:"bold" color:"muted"
            "05 · SPLIT PANEL SECONDARY"
          Title size:"2xl" weight:"black"
            "A second routed version of the repeated split reference"
        Button href:"/blocks/contact-preview/split-panel-secondary" variant:"soft" size:"sm" rounded:"full" iconEnd:"arrow-right"
          "Open full page"
      Tabs variant:"line" position:"top" w:"full"
        tab id:"split-panel-secondary-preview" label:"Preview"
          Device device:"laptop" w:"full" rounded:"lg" border:1
            Iframe src:"/blocks/contact-preview/split-panel-secondary" title:"Secondary split panel contact preview" loading:"lazy" sandbox:"scripts same-origin forms"
        tab id:"split-panel-secondary-code" label:"Code"
          Code:
            language:"dowe"
            variant:"soft"
            scheme:"surface"
            copyLabel:"Copy contact block"
            copiedLabel:"Copied"
            content:"""
              signal form value:{ name:"" email:"" phone:"" company:"" message:"" }

              Section id:"contact-split-panel-duplicate" bg:"background" color:"backgroundText" p:0 minH:"vh-0"
                Grid columns:{ xs:1 md:2 } gap:0 minH:"vh-0"
                  Box p:{ xs:5 md:10 }
                    Card variant:"soft" scheme:"muted" rounded:"xl" p:{ xs:6 md:10 }
                      Grid columns:1 gap:5
                        Grid columns:1 gap:2
                          Title size:{ xs:"3xl" md:"5xl" } weight:"black"
                            "Get in touch today"
                          Text color:"muted"
                            "Tell us what you are building and we will help you find the clearest path forward."
                        Grid columns:{ xs:1 sm:2 } gap:4
                          Input bind:form.name label:"Name" placeholder:"John Carter" variant:"solid" scheme:"muted" w:"full"
                          Input bind:form.email label:"Email" placeholder:"example@email.com" variant:"solid" scheme:"muted" w:"full"
                          Input bind:form.phone label:"Phone" placeholder:"(123) 456 – 789" variant:"solid" scheme:"muted" w:"full"
                          Input bind:form.company label:"Company" placeholder:"Company" variant:"solid" scheme:"muted" w:"full"
                        Textarea bind:form.message label:"Leave us a message" placeholder:"Please type your message here..." rows:5 variant:"solid" scheme:"muted" w:"full"
                        Button rounded:"full" w:{ xs:"full" sm:48 }
                          "Send message"
                  Box bg:"softMuted" p:8 minH:{ xs:64 md:"vh-0" }
                    Flex direction:"column" align:"center" justify:"center" gap:3 minH:{ xs:48 md:"vh-0" }
                      Icon name:"gallery-bold-duotone" fill:"muted" w:16 h:16
                      Text size:"sm" color:"muted"
                        "Image placeholder"
            """
  Section id:"social-media" p:{ xs:5 md:7 }
    Grid columns:1 gap:5
      Flex direction:{ xs:"column" md:"row" } justify:"between" align:"end" gap:3
        Grid columns:1 gap:2
          Text size:"xs" weight:"bold" color:"muted"
            "06 · FORM + SOCIALS + MEDIA"
          Title size:"2xl" weight:"black"
            "A centered introduction above contact, social, and media surfaces"
        Button href:"/blocks/contact-preview/social-media" size:"sm" rounded:"full" iconEnd:"arrow-right"
          "Open full page"
      Tabs variant:"line" position:"top" w:"full"
        tab id:"social-media-preview" label:"Preview"
          Device device:"laptop" w:"full" rounded:"lg" border:1
            Iframe src:"/blocks/contact-preview/social-media" title:"Contact form with socials and media preview" loading:"lazy" sandbox:"scripts same-origin forms"
        tab id:"social-media-code" label:"Code"
          Code:
            language:"dowe"
            variant:"soft"
            scheme:"surface"
            copyLabel:"Copy contact block"
            copiedLabel:"Copied"
            content:"""
              signal form value:{ name:"" email:"" phone:"" company:"" message:"" }
              const socialLinks value:[
                { id:"website" website:true community:false photos:false network:false },
                { id:"community" website:false community:true photos:false network:false },
                { id:"photos" website:false community:false photos:true network:false },
                { id:"network" website:false community:false photos:false network:true },
              ]

              Section id:"contact-social-media" bg:"background" color:"backgroundText" boxed:true p:{ xs:6 md:12 }
                Grid columns:1 gap:{ xs:8 md:10 } minH:"vh-0"
                  Flex direction:"column" align:"center" gap:2
                    Title size:{ xs:"3xl" md:"6xl" } weight:"black"
                      "Get in touch today"
                    Text color:"muted"
                      "Share your goals and our team will respond with practical next steps."
                  Grid columns:{ xs:1 md:2 } gap:{ xs:8 md:12 } align:"center"
                    Grid columns:1 gap:4
                      Grid columns:{ xs:1 sm:2 } gap:4
                        Input bind:form.name label:"Name" placeholder:"John Carter" variant:"soft" scheme:"muted" w:"full"
                        Input bind:form.email label:"Email" placeholder:"example@email.com" variant:"soft" scheme:"muted" w:"full"
                        Input bind:form.phone label:"Phone" placeholder:"(123) 456 – 789" variant:"soft" scheme:"muted" w:"full"
                        Input bind:form.company label:"Company" placeholder:"Company" variant:"soft" scheme:"muted" w:"full"
                      Textarea bind:form.message label:"Leave us a message" placeholder:"Please type your message here..." rows:5 variant:"soft" scheme:"muted" w:"full"
                      Flex direction:{ xs:"column" sm:"row" } justify:"between" align:"center" gap:4
                        Button rounded:"full" w:{ xs:"full" sm:48 }
                          "Send message"
                        Flex align:"center" justify:"center" gap:2
                          each in:socialLinks as:social key:social.id
                            IconButton icon:"global" label:"Website" variant:"soft" scheme:"muted" size:"sm" show:social.website
                            IconButton icon:"chat-round" label:"Community" variant:"soft" scheme:"muted" size:"sm" show:social.community
                            IconButton icon:"camera" label:"Photos" variant:"soft" scheme:"muted" size:"sm" show:social.photos
                            IconButton icon:"link-circle" label:"Network" variant:"soft" scheme:"muted" size:"sm" show:social.network
                    Box bg:"softMuted" rounded:"xl" p:8 minH:{ xs:72 md:96 }
                      Flex direction:"column" align:"center" justify:"center" gap:3 minH:{ xs:56 md:80 }
                        Icon name:"gallery-bold-duotone" fill:"muted" w:16 h:16
                        Text size:"sm" color:"muted"
                          "Image placeholder"
            """
