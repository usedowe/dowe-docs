page ContactFooterFormPage
  signal form value:{ name:"" email:"" message:"" }
  const footerGroups value:[
    {
      id:"visit"
      title:"Visit Us"
      lineOne:"58 Middle Point Rd"
      lineTwo:"San Francisco, 94124"
      lineThree:""
      showLineThree:false
    },
    {
      id:"contact"
      title:"Contact Us"
      lineOne:"(123) 456 – 789"
      lineTwo:"(123) 456 – 789"
      lineThree:"contact@company.com"
      showLineThree:true
    },
  ]
  Section id:"contact-footer-form" bg:"muted" color:"mutedText" p:0 minH:"vh-0"
    Grid columns:{ xs:1 md:2 } gap:{ xs:6 md:10 } align:"center" p:{ xs:6 md:10 }
      Box p:8 minH:{ xs:48 md:72 }
        Flex direction:"column" align:"center" justify:"center" gap:3 minH:{ xs:40 md:64 }
          Icon name:"gallery-bold-duotone" fill:"muted" w:16 h:16
          Text size:"sm"
            "Image placeholder"
      Card rounded:"xl" p:{ xs:6 md:8 }
        Grid columns:1 gap:4
          Grid columns:1 gap:1
            Title size:"3xl" weight:"black"
              "Contact us"
            Text
              "We want to hear from you"
          Input bind:form.name placeholder:"Name" variant:"solid" scheme:"muted" w:"full"
          Input bind:form.email placeholder:"Email" variant:"solid" scheme:"muted" w:"full"
          Textarea bind:form.message placeholder:"Please type your message here..." rows:5 variant:"solid" scheme:"muted" w:"full"
          Button rounded:"full" w:"full"
            "Send message"
    Box bg:"muted" color:"mutedText" p:{ xs:7 md:10 }
      Grid columns:{ xs:1 sm:2 } gap:8
        each in:footerGroups as:group key:group.id
          Grid columns:1 gap:2
            Title size:"lg" weight:"bold"
              "{group.title}"
            Grid columns:1 gap:1
              Text
                "{group.lineOne}"
              Text
                "{group.lineTwo}"
              Text show:group.showLineThree
                "{group.lineThree}"
