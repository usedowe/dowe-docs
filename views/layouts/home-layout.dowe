import Logo from "@/views/components/logo"
import Github from "@/views/components/github"
layout HomeLayout
  Scaffold
    appBar
      AppBar variant:"soft" scheme:"background" boxed:true bordered:true position:"fixed"
        start
          Logo
        end
          NavMenu size:"lg"
            item label:"Docs" href:"/docs/dev"
            item label:"Blocks" href:"/blocks/hero"
          Github
    main
      children
      Footer variant:"solid" scheme:"muted" boxed:true py:{ xs:6 md:3 }
        start
          Text size:"xs" color:"onMuted"
            "Dowe @ 2026. All rights reserved."
        end
          Text size:"xs" color:"onMuted"
            "info@dowe.dev"
