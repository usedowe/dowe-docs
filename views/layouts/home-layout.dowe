import Logo from "@/views/components/logo"
import Github from "@/views/components/github"
layout HomeLayout
  meta name:"title" content:"Dowe — AI generates code. Dowe generates systems."
  meta name:"description" content:"Dowe is a Rust compiler and fullstack framework that turns one source model into secure web, desktop, Android, iOS, and server systems."
  meta name:"keywords" content:"Dowe, fullstack framework, Rust compiler, AI development, web, desktop, Android, iOS"
  meta name:"canonical" content:"https://dowe.dev/"
  meta name:"og:title" content:"Dowe — AI generates code. Dowe generates systems."
  meta name:"og:description" content:"Build fullstack systems from one deterministic, compiler-owned source model."
  meta name:"og:image" content:"https://dowe.dev/assets/icons/web/icon-512x512.png"
  meta name:"og:image:alt" content:"Dowe logo"
  meta name:"og:type" content:"website"
  meta name:"og:url" content:"https://dowe.dev/"
  meta name:"og:site_name" content:"Dowe"
  meta name:"twitter:card" content:"summary_large_image"
  meta name:"twitter:title" content:"Dowe — AI generates code. Dowe generates systems."
  meta name:"twitter:description" content:"Build fullstack systems from one deterministic, compiler-owned source model."
  meta name:"twitter:image" content:"https://dowe.dev/assets/icons/web/icon-512x512.png"
  meta name:"twitter:image:alt" content:"Dowe logo"
  meta name:"twitter:site" content:"@usedowe"
  Scaffold
    appBar
      AppBar variant:"soft" scheme:"background" boxed:true bordered:true position:"fixed"
        start
          Logo
        end
          NavMenu size:"lg"
            item label:"Docs" href:"/docs/dev"
            item label:"Blocks" href:"/blocks/hero"
          Github
    main
      children
      Footer variant:"solid" scheme:"muted" boxed:true py:{ xs:6 md:3 }
        start
          Text size:"xs" color:"onMuted"
            "Dowe @ 2026. All rights reserved."
        end
          Text size:"xs" color:"onMuted"
            "info@dowe.dev"
          IconButton:
            icon:"svg-logos:x"
            label:"X"
            href:"https://x.com/usedowe"
            variant:"soft"
            scheme:"muted"
            size:"sm"
          IconButton:
            icon:"svg-logos:discord-icon"
            label:"Discord"
            href:"https://discord.gg/N2cww7sP5s"
            variant:"soft"
            scheme:"muted"
            size:"sm"
