import ViewsNavigation from "@/views/components/views-navigation"
import Logo from "@/views/components/logo"
import Github from "@/views/components/github"
layout ViewsLayout
  meta name:"title" content:"Dowe Views Documentation"
  meta name:"description" content:"Learn Dowe layouts, pages, components, state, routing, and web generation."
  meta name:"og:image" content:"https://dowe.dev/assets/icons/web/icon-512x512.png"
  meta name:"og:image:alt" content:"Dowe logo"
  meta name:"og:type" content:"website"
  meta name:"og:site_name" content:"Dowe"
  meta name:"twitter:card" content:"summary_large_image"
  meta name:"twitter:image" content:"https://dowe.dev/assets/icons/web/icon-512x512.png"
  meta name:"twitter:image:alt" content:"Dowe logo"
  signal openDrawer value:false
  Scaffold boxed:true
    appBar
      AppBar variant:"soft" scheme:"background" boxed:true bordered:true position:"fixed"
        start
          IconButton:
            show:{ xs:true md:false }
            label:"menu"
            variant:"ghost"
            onClick:{ set:openDrawer value:!openDrawer }
            icon:"menu-dots"
          Logo
        center
          NavMenu show:{ xs:false md:true } size:"lg"
            item label:"Dev" href:"/docs/dev"
            item label:"Server" href:"/docs/server"
            item label:"Views" href:"/docs/views"
            item label:"Blocks" href:"/blocks/hero"
        end
          Github
    start
      Sidebar show:{ xs:false md:true } variant:"ghost" scheme:"muted" w:72
        body
          ViewsNavigation
    main
      children
    overlays
      Drawer open:openDrawer
        header
          NavMenu
            item label:"Views" href:"/docs/views"
            item label:"Server" href:"/docs/server"
            item label:"Dev" href:"/docs/dev"
            item label:"Blocks" href:"/blocks/hero"
        body
          ViewsNavigation
