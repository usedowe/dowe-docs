layout AppBarSlotsScrollLayout
  Scaffold
    appBar
      AppBar variant:"soft" scheme:"surface" position:"sticky" boxed:true bordered:true hideOnScroll:true
        top
          Box bg:"primary" px:3 py:2
            Text size:"xs" weight:"bold" color:"background"
              "Release note · AppBar supports full-width top and bottom regions"
        start
          Text weight:"bold"
            "Dowe"
        center
          Text size:"sm" color:"muted"
            "Scroll-aware AppBar"
        end
          Button href:"/examples/appbar-one" variant:"ghost" scheme:"primary" size:"sm"
            "Fixed"
        bottom
          Box bg:"background" px:3 py:2
            Text size:"xs" color:"muted"
              "Scroll down to hide this entire bar. Scroll up to reveal it."
    main
      children
