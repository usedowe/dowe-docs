layout AppBarMobileMenuLayout
  signal mobileMenuOpen value:false
  Scaffold
    appBar
      AppBar position:"fixed" boxed:true bordered:true
        start
          Button onClick:{ set:mobileMenuOpen value:!mobileMenuOpen } variant:"solid" size:"sm"
            "Menu"
        center
          Text weight:"bold"
            "Dowe"
        end
          Button href:"/docs/views/layout/appbar" variant:"solid" size:"sm"
            "AppBar"
        mobileMenu mobileMenuOpen:mobileMenuOpen
          header
            Text weight:"bold"
              "Navigation"
          body
            Button href:"/docs/views" variant:"solid"
              "Views"
            Button href:"/docs/server" variant:"solid"
              "Server"
            Button href:"/docs/views/layout/appbar" variant:"solid"
              "AppBar"
          footer
            Text size:"xs"
              "Mobile navigation"
    main
      children
