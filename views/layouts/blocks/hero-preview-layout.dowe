layout HeroPreviewLayout
  signal openNavigation value:false
  Scaffold
    appBar
      AppBar:
        variant:"solid"
        scheme:"surface"
        position:"fixed"
        boxed:true
        bordered:true
        py:2
        start
          Brand href:"/blocks/hero-preview/crypto-app" label:"Northstar home"
            Flex align:"center" gap:2
              Icon name:"stars-minimalistic" style:"bold-duotone" fill:"primary" w:7 h:7
              Text weight:"black"
                "NORTHSTAR"
        center
          NavMenu variant:"ghost" scheme:"primary" size:"sm" show:{ xs:false md:true }
            item label:"Home" href:"/blocks/hero-preview/crypto-app"
            item label:"About us" href:"/blocks/hero-preview/smart-solutions"
            item label:"Solutions" href:"/blocks/hero-preview/growth-consulting"
            item label:"Contact" href:"/blocks/hero-preview/digital-potential"
        end
          Flex align:"center" gap:2
            Button:
              href:"/blocks/hero-preview/smart-solutions"
              variant:"solid"
              scheme:"primary"
              size:"sm"
              rounded:"full"
              show:{ xs:false md:true }
              "Order now"
            IconButton:
              icon:"hamburger-menu"
              label:"Open navigation"
              variant:"ghost"
              scheme:"primary"
              show:{ xs:true md:false }
              onClick:{ set:openNavigation value:!openNavigation }
    main
      children
    overlays
      Drawer open:openNavigation position:"start" variant:"solid" scheme:"surface" show:{ xs:true md:false }
        header
          Brand href:"/blocks/hero-preview/crypto-app" label:"Northstar home"
            Flex align:"center" gap:2
              Icon name:"stars-minimalistic" style:"bold-duotone" fill:"primary" w:7 h:7
              Text weight:"black"
                "NORTHSTAR"
        body
          SideNav variant:"ghost" scheme:"primary" size:"md" wide:true p:4
            item label:"Home" href:"/blocks/hero-preview/crypto-app" icon:"home"
            item label:"About us" href:"/blocks/hero-preview/smart-solutions" icon:"users-group-rounded"
            item label:"Solutions" href:"/blocks/hero-preview/growth-consulting" icon:"widget-4"
            item label:"Contact" href:"/blocks/hero-preview/digital-potential" icon:"letter"
