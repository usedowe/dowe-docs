layout ScaffoldRailBottomBarLayout
  Scaffold minH:"vh-0"
    start
      Box:
        show:{ xs:false md:true }
        minH:"vh-0"
        w:16
        bg:"softTertiary"
        RailNav:
          variant:"soft"
          scheme:"tertiary"
          showLabels:true
          minH:"vh-0"
          item label:"Rail" href:"/blocks/scaffold-preview/rail-bottom-bar" icon:"widget-4"
    main
      Flex direction:"column" minH:{ xs:"vh-16" md:"vh-0" } justify:"between"
        AppBar variant:"soft" scheme:"primary" bordered:true
          start
            IconButton:
              show:{ xs:true md:false }
              label:"Open navigation"
              variant:"ghost"
              icon:"hamburger-menu"
          center
            Text weight:"bold"
              "AppBar"
        children
    bottomBar
      BottomBar show:{ xs:true md:false } variant:"soft" scheme:"primary" bordered:true
        tab href:"/blocks/scaffold-preview/rail-bottom-bar" label:"BottomBar"
          Icon name:"home"
