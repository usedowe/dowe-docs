import BlocksLayout from "@/views/layouts/blocks-layout"
import AppBarClassicSaasLayout from "@/views/layouts/blocks/appbar-preview/classic-saas-layout"
import AppBarCreativeLayout from "@/views/layouts/blocks/appbar-preview/creative-layout"
import AppBarSocialPillLayout from "@/views/layouts/blocks/appbar-preview/social-pill-layout"
import AppBarFloatingCardLayout from "@/views/layouts/blocks/appbar-preview/floating-card-layout"
import AppBarCenteredPillLayout from "@/views/layouts/blocks/appbar-preview/centered-pill-layout"
import AppBarHostingLayout from "@/views/layouts/blocks/appbar-preview/hosting-layout"
import AppBarDashboardLayout from "@/views/layouts/blocks/appbar-preview/dashboard-layout"
import AppBarAdminLayout from "@/views/layouts/blocks/appbar-preview/admin-layout"
import FooterNavigationLayout from "@/views/layouts/blocks/footer-preview/navigation-layout"
import FooterSocialLayout from "@/views/layouts/blocks/footer-preview/social-layout"
import FooterLegalLayout from "@/views/layouts/blocks/footer-preview/legal-layout"
import FooterBrandLayout from "@/views/layouts/blocks/footer-preview/brand-layout"
import FooterTwoRowLayout from "@/views/layouts/blocks/footer-preview/two-row-layout"
import FooterNewsletterLayout from "@/views/layouts/blocks/footer-preview/newsletter-layout"
import ScaffoldAppFooterLayout from "@/views/layouts/blocks/scaffold-preview/app-footer-layout"
import ScaffoldInsetSidebarLayout from "@/views/layouts/blocks/scaffold-preview/inset-sidebar-layout"
import ScaffoldFullHeightSidebarLayout from "@/views/layouts/blocks/scaffold-preview/full-height-sidebar-layout"
import ScaffoldRailBottomBarLayout from "@/views/layouts/blocks/scaffold-preview/rail-bottom-bar-layout"
import BlankLayout from "@/views/layouts/blocks/blank-layout"
import HeroPreviewLayout from "@/views/layouts/blocks/hero-preview-layout"
import AppBarsPage from "@/views/pages/blocks/app-bar-page"
import AppBarPreviewPage from "@/views/pages/blocks/app-bar-preview-page"
import FootersPage from "@/views/pages/blocks/footer-page"
import FooterPreviewPage from "@/views/pages/blocks/footer-preview-page"
import ScaffoldsPage from "@/views/pages/blocks/scaffold-page"
import ScaffoldPreviewPage from "@/views/pages/blocks/scaffold-preview-page"
import HerosPage from "@/views/pages/blocks/hero-page"
import AuthPage from "@/views/pages/blocks/auth-page"
import FeaturesPage from "@/views/pages/blocks/features-page"
import CryptoAppHeroPage from "@/views/pages/blocks/hero-preview/crypto-app-page"
import SmartSolutionsHeroPage from "@/views/pages/blocks/hero-preview/smart-solutions-page"
import GrowthConsultingHeroPage from "@/views/pages/blocks/hero-preview/growth-consulting-page"
import DigitalPotentialHeroPage from "@/views/pages/blocks/hero-preview/digital-potential-page"
import WorkflowPlatformHeroPage from "@/views/pages/blocks/hero-preview/workflow-platform-page"
import SoftwareSolutionsHeroPage from "@/views/pages/blocks/hero-preview/software-solutions-page"
import LeadCaptureHeroPage from "@/views/pages/blocks/hero-preview/lead-capture-page"
import ContentAudienceHeroPage from "@/views/pages/blocks/hero-preview/content-audience-page"
import PrivacyDownloadHeroPage from "@/views/pages/blocks/hero-preview/privacy-download-page"
import PropertySearchHeroPage from "@/views/pages/blocks/hero-preview/property-search-page"
import LoginSplitAuthPage from "@/views/pages/blocks/auth-preview/login-split-page"
import LoginReverseAuthPage from "@/views/pages/blocks/auth-preview/login-reverse-page"
import LoginCardAuthPage from "@/views/pages/blocks/auth-preview/login-card-page"
import ForgotPasswordAuthPage from "@/views/pages/blocks/auth-preview/forgot-password-page"
import SignupSplitAuthPage from "@/views/pages/blocks/auth-preview/signup-split-page"
import SignupReverseAuthPage from "@/views/pages/blocks/auth-preview/signup-reverse-page"
import SignupCardAuthPage from "@/views/pages/blocks/auth-preview/signup-card-page"
import CustomerCentricFeaturesPage from "@/views/pages/blocks/features-preview/customer-centric-page"
import MarketingServicesFeaturesPage from "@/views/pages/blocks/features-preview/marketing-services-page"
import BrandTransformationFeaturesPage from "@/views/pages/blocks/features-preview/brand-transformation-page"
import OnlineSolutionsFeaturesPage from "@/views/pages/blocks/features-preview/online-solutions-page"
import CompleteSolutionsFeaturesPage from "@/views/pages/blocks/features-preview/complete-solutions-page"
views BlockViews
  group path:"/blocks/" layout:BlocksLayout
    route path:"appbar" page:AppBarsPage
    route path:"footer" page:FootersPage
    route path:"scaffold" page:ScaffoldsPage
    route path:"hero" page:HerosPage
    route path:"auth" page:AuthPage
    route path:"features" page:FeaturesPage
  group path:"/blocks/appbar-preview/classic-saas" layout:AppBarClassicSaasLayout
    route path:"" page:AppBarPreviewPage
  group path:"/blocks/appbar-preview/creative" layout:AppBarCreativeLayout
    route path:"" page:AppBarPreviewPage
  group path:"/blocks/appbar-preview/social-pill" layout:AppBarSocialPillLayout
    route path:"" page:AppBarPreviewPage
  group path:"/blocks/appbar-preview/floating-card" layout:AppBarFloatingCardLayout
    route path:"" page:AppBarPreviewPage
  group path:"/blocks/appbar-preview/centered-pill" layout:AppBarCenteredPillLayout
    route path:"" page:AppBarPreviewPage
  group path:"/blocks/appbar-preview/hosting" layout:AppBarHostingLayout
    route path:"" page:AppBarPreviewPage
  group path:"/blocks/appbar-preview/dashboard" layout:AppBarDashboardLayout
    route path:"" page:AppBarPreviewPage
  group path:"/blocks/appbar-preview/admin" layout:AppBarAdminLayout
    route path:"" page:AppBarPreviewPage
  group path:"/blocks/footer-preview/navigation" layout:FooterNavigationLayout
    route path:"" page:FooterPreviewPage
  group path:"/blocks/footer-preview/social" layout:FooterSocialLayout
    route path:"" page:FooterPreviewPage
  group path:"/blocks/footer-preview/legal" layout:FooterLegalLayout
    route path:"" page:FooterPreviewPage
  group path:"/blocks/footer-preview/brand" layout:FooterBrandLayout
    route path:"" page:FooterPreviewPage
  group path:"/blocks/footer-preview/two-row" layout:FooterTwoRowLayout
    route path:"" page:FooterPreviewPage
  group path:"/blocks/footer-preview/newsletter" layout:FooterNewsletterLayout
    route path:"" page:FooterPreviewPage
  group path:"/blocks/scaffold-preview/app-footer" layout:ScaffoldAppFooterLayout
    route path:"" page:ScaffoldPreviewPage
  group path:"/blocks/scaffold-preview/inset-sidebar" layout:ScaffoldInsetSidebarLayout
    route path:"" page:ScaffoldPreviewPage
  group path:"/blocks/scaffold-preview/full-height-sidebar" layout:ScaffoldFullHeightSidebarLayout
    route path:"" page:ScaffoldPreviewPage
  group path:"/blocks/scaffold-preview/rail-bottom-bar" layout:ScaffoldRailBottomBarLayout
    route path:"" page:ScaffoldPreviewPage
  group path:"/blocks/hero-preview" layout:HeroPreviewLayout
    route path:"crypto-app" page:CryptoAppHeroPage
    route path:"smart-solutions" page:SmartSolutionsHeroPage
    route path:"growth-consulting" page:GrowthConsultingHeroPage
    route path:"digital-potential" page:DigitalPotentialHeroPage
    route path:"workflow-platform" page:WorkflowPlatformHeroPage
    route path:"software-solutions" page:SoftwareSolutionsHeroPage
    route path:"lead-capture" page:LeadCaptureHeroPage
    route path:"content-audience" page:ContentAudienceHeroPage
    route path:"privacy-download" page:PrivacyDownloadHeroPage
    route path:"property-search" page:PropertySearchHeroPage
  group path:"/blocks/auth-preview" layout:BlankLayout
    route path:"login-split" page:LoginSplitAuthPage
    route path:"login-reverse" page:LoginReverseAuthPage
    route path:"login-card" page:LoginCardAuthPage
    route path:"forgot-password" page:ForgotPasswordAuthPage
    route path:"signup-split" page:SignupSplitAuthPage
    route path:"signup-reverse" page:SignupReverseAuthPage
    route path:"signup-card" page:SignupCardAuthPage
  group path:"/blocks/features-preview" layout:BlankLayout
    route path:"customer-centric" page:CustomerCentricFeaturesPage
    route path:"marketing-services" page:MarketingServicesFeaturesPage
    route path:"brand-transformation" page:BrandTransformationFeaturesPage
    route path:"online-solutions" page:OnlineSolutionsFeaturesPage
    route path:"complete-solutions" page:CompleteSolutionsFeaturesPage
