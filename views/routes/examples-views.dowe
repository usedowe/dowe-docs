import AppBarFloatingLayout from "@/views/layouts/examples/appbar-floating-layout"
import AppBarSlotsScrollLayout from "@/views/layouts/examples/appbar-slots-scroll-layout"
import BottomBarLayout from "@/views/layouts/examples/bottombar-layout"
import ScaffoldExampleLayout from "@/views/layouts/examples/scaffold-example-layout"
import AppBarOne from "@/views/pages/examples/appbar-one"
import AppBarTwo from "@/views/pages/examples/appbar-two"
import AppBarSlotsScroll from "@/views/pages/examples/appbar-slots-scroll"
import BottomBarExample from "@/views/pages/examples/bottombar-example"
import ScaffoldExample from "@/views/pages/examples/scaffold-example"
import ExamplesLayout from "@/views/layouts/examples/examples-layout"
views ExamplesViews
  group path:"/examples/appbar-one" layout:ExamplesLayout
    route path:"" page:AppBarOne
  group path:"/examples/appbar-two" layout:AppBarFloatingLayout
    route path:"" page:AppBarTwo
  group path:"/examples/appbar-slots-scroll" layout:AppBarSlotsScrollLayout
    route path:"" page:AppBarSlotsScroll
  group path:"/examples/bottombar" layout:BottomBarLayout
    route path:"" page:BottomBarExample
  group path:"/examples/scaffold" layout:ScaffoldExampleLayout
    route path:"" page:ScaffoldExample
