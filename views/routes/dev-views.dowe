import DevLayout from "@/views/layouts/dev-layout"
import DevPage from "@/views/pages/dev/dev-page"
import DeployPage from "@/views/pages/dev/deploy-page"
import InstallPage from "@/views/pages/dev/install-page"
import AgentPage from "@/views/pages/dev/agent-page"
import TestsPage from "@/views/pages/dev/tests-page"
import IconsPage from "@/views/pages/dev/icons-page"
import ExtensionsPage from "@/views/pages/dev/editor-page"
views DevViews
  group path:"/docs/dev" layout:DevLayout
    route path:"" page:DevPage
    route path:"deploy" page:DeployPage
    route path:"install" page:InstallPage
    route path:"agent" page:AgentPage
    route path:"tests" page:TestsPage
    route path:"icons" page:IconsPage
    route path:"editor" page:ExtensionsPage
    route path:"extensions" page:ExtensionsPage
