import IconDb from "@/server/config/database"

handler listIconCategories
  query categories db:IconDb.query sql:"SELECT slug, label, count FROM icon_categories ORDER BY position"
  return json:{ ok:true data:categories }

handler listIcons
  query icons db:IconDb.query sql:"SELECT id, name, category, style, svg FROM icons WHERE category = ?1 AND style = ?2 AND (length(?3) = 2 OR name LIKE '%' || substr(?3, 3) || '%') ORDER BY name LIMIT 60 OFFSET ((CAST(?4 AS INTEGER) - 1) * 60)" params:[req.params.category, req.params.style, req.params.search, req.params.page]
  query totals db:IconDb.query sql:"SELECT COUNT(*) AS total FROM icons WHERE category = ?1 AND style = ?2 AND (length(?3) = 2 OR name LIKE '%' || substr(?3, 3) || '%')" params:[req.params.category, req.params.style, req.params.search]
  return json:{ ok:true data:{ data:icons total:totals.0.total pageSize:60 } }
