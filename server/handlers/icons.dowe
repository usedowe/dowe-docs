import IconDb from "@/server/config/database"

handler listIconCategories
  query categories conn:IconDb.query sql:"SELECT slug, label, count FROM icon_categories ORDER BY positionKey"
  return json:{ ok:true data:categories }

handler listIcons
  query icons conn:IconDb.query sql:"SELECT key, name, category, style, svg FROM icons WHERE category = ?1 ORDER BY name" params:[req.params.category]
  list styled source:"filterEquals" values:icons field:"style" value:req.params.style
  str search source:"replace" value:req.params.search from:"q-" to:""
  list filtered source:"filterContains" values:styled field:"name" value:search
  parse pageNumber source:"int" value:req.params.page fallback:1
  math pageIndex source:"sub" left:pageNumber right:1
  math safePageIndex source:"max" values:[pageIndex 0]
  math offset source:"mul" left:safePageIndex right:60
  list pageRows source:"skip" values:filtered count:offset
  list rows source:"take" values:pageRows count:60
  list total source:"count" values:filtered
  return json:{ ok:true data:{ data:rows total:total pageSize:60 } }
