        success color:"#16A34A" text:"#E8F5E9" title:"#FFFFFF"
        info color:"#0084D1" text:"#E1F5FE" title:"#FFFFFF"
        warning color:"#D08700" text:"#1F1400" title:"#0D0900"
        danger color:"#E7000B" text:"#FFEBEE" title:"#FFFFFF"
